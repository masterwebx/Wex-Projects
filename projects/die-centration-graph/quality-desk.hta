<html>
<head>
    <title>Quality Desk</title>

    <HTA:APPLICATION
        ID="QualityDeskApp"
        APPLICATIONNAME="Quality Desk"
        BORDER="thin"
        CAPTION="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        WINDOWSTATE="normal"
        SCROLL="no"
    />

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">

    <style>
        body {
            font-family: Segoe UI, Arial;
            margin: 0;
            padding: 20px;
            background: #eef1f5;
            color: #12202b;
        }

        .box {
            background: white;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #d5dde4;
            width: 420px;
        }

        h2 {
            margin: 0 0 8px;
            font-size: 22px;
        }

        p {
            margin: 0 0 10px;
            font-size: 14px;
            color: #3e4a55;
        }

        button {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 700;
            margin-top: 10px;
            margin-right: 8px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
            background: #1d4ed8;
            color: #fff;
        }

        button.secondary {
            background: #fff;
            color: #12202b;
            border: 2px solid #d5dde4;
        }

        #output {
            margin-top: 15px;
            padding: 10px;
            background: #eee;
            border-radius: 6px;
            white-space: pre-wrap;
            font-size: 13px;
        }
    </style>

    <script type="text/javascript">
        function getAppFolder() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.GetParentFolderName(htaFilePath());
        }

        function htaFilePath() {
            var href = String(location.href || "");
            var path = String(location.pathname || "");
            var raw = href;
            if (href.toLowerCase().indexOf("file:") === 0) {
                raw = href.replace(/^file:\/\//i, "");
            } else if (path) {
                raw = path;
            }
            raw = raw.replace(/^\/+/, "");
            try { raw = decodeURIComponent(raw); } catch (e) {}
            raw = raw.replace(/\//g, "\\");
            if (raw.toLowerCase().indexOf("localhost\\") === 0) {
                raw = raw.substring(10);
            }
            return raw;
        }

        function findHtml() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = ["index.html", "centration.html"];
            var i, filePath;
            for (i = 0; i < names.length; i++) {
                filePath = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(filePath)) return filePath;
            }
            return "";
        }

        function findChart() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(fso.BuildPath(getAppFolder(), "vendor"), "chart.umd.min.js");
        }

        function findEdge() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var candidates = [
                "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
                "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"
            ];
            var i;
            for (i = 0; i < candidates.length; i++) {
                if (fso.FileExists(candidates[i])) return candidates[i];
            }
            return "msedge";
        }

        function toFileUrl(winPath) {
            var parts = String(winPath).replace(/\\/g, "/").split("/");
            var out = [];
            var i;
            for (i = 0; i < parts.length; i++) {
                if (i === 0 && /^[A-Za-z]:$/.test(parts[i])) {
                    out.push(parts[i]);
                } else {
                    out.push(encodeURIComponent(parts[i]));
                }
            }
            return "file:///" + out.join("/");
        }

        function showStatus() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var htmlPath = findHtml();
            var chartPath = findChart();
            var lines = [];
            lines.push("Folder:");
            lines.push(folder);
            lines.push("");
            if (htmlPath) {
                lines.push("Found: " + fso.GetFileName(htmlPath));
            } else {
                lines.push("Missing index.html or centration.html");
            }
            if (fso.FileExists(chartPath)) {
                lines.push("Found: vendor\\chart.umd.min.js");
            } else {
                lines.push("Missing vendor\\chart.umd.min.js (Trends charts need this file)");
            }
            document.getElementById("output").innerText = lines.join("\n");
        }

        function openQualityDesk() {
            var htmlPath = findHtml();
            if (!htmlPath) {
                document.getElementById("output").innerText =
                    "index.html or centration.html not found in:\n" + getAppFolder();
                return;
            }
            var url = toFileUrl(htmlPath);
            var edge = findEdge();
            var shell = new ActiveXObject("WScript.Shell");
            try {
                shell.Run('"' + edge + '" --app="' + url + '"', 1, false);
            } catch (e1) {
                try {
                    shell.Run('cmd /c start "" "' + htmlPath + '"', 0, false);
                } catch (e2) {
                    alert("Could not open Quality Desk.\n" + htmlPath);
                    return;
                }
            }
            window.setTimeout(function () { window.close(); }, 400);
        }

        function sizeWindow() {
            var w = 480;
            var h = 360;
            window.resizeTo(w, h);
            window.moveTo(
                Math.max(0, (screen.availWidth - w) / 2),
                Math.max(0, (screen.availHeight - h) / 2)
            );
        }

        window.onload = function () {
            sizeWindow();
            showStatus();
            if (findHtml()) openQualityDesk();
        };
    </script>
</head>

<body>
    <div class="box">
        <h2>Quality Desk</h2>
        <p>This app runs completely offline — no websites, no frames. It opens the local Quality Desk HTML from this folder.</p>

        <button onclick="openQualityDesk()">Open Quality Desk</button>
        <button class="secondary" onclick="window.close()">Quit</button>

        <div id="output"></div>
    </div>
</body>
</html>
