<html>
<head>
    <title>Quality Desk Checks</title>
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">

    <HTA:APPLICATION
        ID="QualityDeskChecks"
        APPLICATIONNAME="Quality Desk Checks"
        ICON="QualityDesk.ico"
        BORDER="thick"
        CAPTION="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        WINDOWSTATE="maximize"
        SCROLL="yes"
    />

    <style>
        html, body { background: #5c6370; height: 100%; margin: 0; }
        body { font-family: Segoe UI, Arial; color: #f3f4f6; font-size: 15px; }
        html.qd-app, body.qd-app { background: #121212; }
        #appRoot { min-height: 100%; background: #121212; }
        header.app { padding: 12px 18px; background: #1a1a1a; border-bottom: 1px solid #2a2f36; overflow: hidden; }
        header.app .brand { float: left; }
        header.app .tools { float: right; }
        h1 { margin: 0; font-size: 20px; }
        h1 .ver { margin-left: 8px; font-size: 13px; color: #9ca3af; font-weight: 700; }
        .tools button, button { border: 0; border-radius: 10px; padding: 8px 14px; font-weight: 700; cursor: pointer; background: #2563eb; color: #fff; font-family: inherit; margin-left: 6px; }
        button.secondary { background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        button.ok { background: #15803d; }
        button:disabled, button.ghost { filter: alpha(opacity=40); opacity: .4; cursor: default; background: #3f3f46; color: #d4d4d8; }
        .wrap { padding: 14px 18px 72px; }
        .status { margin: 0 0 12px; padding: 10px 12px; background: #1f2937; border: 1px solid #334155; border-radius: 8px; white-space: pre-wrap; font-size: 13px; }
        .status.bad { background: #3f1d1d; border-color: #7f1d1d; }
        .lines { margin: 0 0 12px; }
        .lines button { margin: 0 6px 6px 0; min-width: 64px; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .lines button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        .grid { display: table; width: 100%; border-collapse: separate; border-spacing: 12px 0; }
        .col { display: table-cell; vertical-align: top; }
        .col.spec-col { width: 46%; }
        .col.form-col { width: 54%; }
        .col.graph-col { width: 38%; }
        .card { background: #1e1e1e; border: 1px solid #2a2f36; border-radius: 12px; padding: 14px; margin-bottom: 12px; }
        .card h2 { margin: 0 0 10px; font-size: 16px; }
        label.f { display: block; margin: 0 0 8px; font-size: 12px; font-weight: 700; color: #9ca3af; }
        label.f input, label.f select, label.f textarea { display: block; width: 100%; margin-top: 4px; box-sizing: border-box; padding: 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        textarea { min-height: 58px; }
        label.f.need input, label.f.need select, label.f.need textarea {
            border-color: #eab308 !important;
            outline: 2px solid #eab308;
        }
        label.f.need { color: #fbbf24; }
        .date-wrap { position: relative; display: block; }
        .date-wrap input.date-input { display: block; width: 100%; margin-top: 4px; box-sizing: border-box; padding: 8px 36px 8px 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        .date-wrap .date-btn { position: absolute; right: 4px; top: 22px; margin: 0; padding: 4px 8px; font-size: 14px; line-height: 1; background: #262626; border: 1px solid #3f3f46; }
        .date-picker { position: absolute; z-index: 40; left: 0; top: 100%; margin-top: 4px; width: 260px; background: #1a1a1a; border: 2px solid #3f3f46; border-radius: 10px; padding: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.45); }
        .date-picker .dp-head { overflow: hidden; margin-bottom: 8px; }
        .date-picker .dp-head button { float: left; margin: 0 4px 0 0; padding: 4px 10px; background: #262626; }
        .date-picker .dp-title { float: left; width: 140px; text-align: center; font-weight: 700; padding-top: 6px; font-size: 13px; }
        .date-picker .dp-head .dp-next { float: right; margin: 0; }
        .date-picker table { width: 100%; border-collapse: collapse; }
        .date-picker th { color: #9ca3af; font-size: 11px; padding: 4px 0; }
        .date-picker td { text-align: center; padding: 2px; }
        .date-picker td button { width: 100%; margin: 0; padding: 6px 0; background: #262626; font-size: 12px; border-radius: 6px; }
        .date-picker td button.on { background: #2563eb; }
        .date-picker td button.muted { color: #6b7280; }
        .date-picker .dp-foot { margin-top: 8px; overflow: hidden; }
        .date-picker .dp-foot button { margin: 0 6px 0 0; padding: 6px 10px; font-size: 12px; }
        body.light .date-wrap input.date-input { background: #fff; color: #111827; border-color: #d1d5db; }
        body.light .date-wrap .date-btn, body.light .date-picker { background: #fff; border-color: #d1d5db; color: #111827; }
        body.light .date-picker td button, body.light .date-picker .dp-head button { background: #f3f4f6; color: #111827; }
        .date-pick { white-space: nowrap; }
        .date-pick input { display: inline-block; width: 130px; margin-top: 4px; vertical-align: middle; }
        .date-pick button { display: inline-block; margin: 4px 0 0 6px; padding: 8px 12px; vertical-align: middle; }
        table.cal { border-collapse: collapse; width: 100%; margin: 8px 0; }
        table.cal th { padding: 6px; font-size: 12px; color: #9ca3af; }
        table.cal td { padding: 8px; text-align: center; cursor: pointer; border-radius: 8px; }
        table.cal td:hover { background: #2563eb; color: #fff; }
        table.cal td.off { color: #52525b; cursor: default; }
        table.cal td.off:hover { background: transparent; color: #52525b; }
        table.cal td.today { outline: 2px solid #eab308; }
        table.cal td.sel { background: #15803d; color: #fff; }
        .pair { display: table; width: 100%; }
        .pair > div { display: table-cell; width: 50%; padding-right: 8px; }
        .spec { font-size: 13px; }
        .spec b { display: inline-block; min-width: 110px; color: #9ca3af; }
        .spec div { margin: 3px 0; }
        .hits { border: 1px solid #3f3f46; border-radius: 8px; max-height: 160px; overflow: auto; margin-top: 4px; display: none; background: #111; }
        .hits div { padding: 6px 8px; cursor: pointer; }
        .hits div:hover { background: #1d4ed8; color: #fff; }
        .pts input { width: 72px; margin: 0 6px 6px 0; }
        .pf { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 8px; font-size: 12px; }
        .pass { background: #14532d; color: #86efac; }
        .fail { background: #7f1d1d; color: #fecaca; }
        .muted { color: #9ca3af; font-weight: 400; }
        .crumbs { margin: 0 0 14px; color: #9ca3af; font-size: 13px; }
        .crumbs b { color: #f3f4f6; }
        .crumbs a { color: #93c5fd; cursor: pointer; text-decoration: none; }
        .home-grid { display: block; }
        .home-line { display: inline-block; width: 220px; min-height: 110px; margin: 0 12px 12px 0; padding: 18px; vertical-align: top; background: #1e1e1e; border: 1px solid #2a2f36; border-radius: 14px; cursor: pointer; text-align: left; }
        .home-line:hover { border-color: #2563eb; }
        .home-line h3 { margin: 0 0 8px; font-size: 28px; }
        .home-line p { margin: 0; color: #9ca3af; font-size: 13px; font-weight: 400; }
        .reason-btns button { display: block; width: 320px; max-width: 100%; margin: 0 0 12px; padding: 16px; font-size: 18px; }
        .chips { margin: 8px 0; }
        .chip { display: inline-block; min-width: 72px; margin: 0 6px 8px 0; padding: 8px 8px 6px; border-radius: 999px; text-align: center; background: #262626; border: 2px solid #3f3f46; }
        .chip input { width: 48px; border: 0; background: transparent; color: #f3f4f6; text-align: center; padding: 2px 0; font-weight: 700; }
        .chip.under { background: #713f12; border-color: #eab308; }
        .chip.in { background: #14532d; border-color: #22c55e; }
        .chip.over { background: #7f1d1d; border-color: #ef4444; }
        .chip.extreme { outline: 2px solid #fff; }
        .chip.need { border-color: #eab308; outline: 2px solid #eab308; }
        .chip span { display: block; font-size: 9px; color: #d4d4d8; }
        .chip span.ex { color: #fbbf24; font-weight: 800; }
        .pf-huge { display: none; margin: 16px 0 8px; padding: 18px 20px; border-radius: 14px; font-size: 42px; font-weight: 800; text-align: center; letter-spacing: 0.04em; }
        .pf-huge.on { display: block; }
        .pf-huge.pass { background: #14532d; color: #86efac; }
        .pf-huge.fail { background: #7f1d1d; color: #fecaca; }
        .home-line.tone-green h3, .home-line.tone-green p { color: #86efac; }
        .home-line.tone-red h3, .home-line.tone-red p { color: #fca5a5; }
        .home-line.tone-gray h3, .home-line.tone-gray p { color: #9ca3af; }
        .plant-pick button { display: block; width: 360px; max-width: 100%; margin: 0 0 14px; padding: 22px; font-size: 22px; }
        .results { width: 100%; border-collapse: collapse; font-size: 13px; }
        .results th, .results td { padding: 6px 8px; border-bottom: 1px solid #2a2f36; text-align: right; }
        .results th:first-child, .results td:first-child { text-align: left; color: #9ca3af; }
        .results td.ok { color: #86efac; font-weight: 700; }
        .results td.bad { color: #fca5a5; font-weight: 700; }
        .submit-bar { display: none; position: fixed; right: 18px; bottom: 16px; z-index: 12; }
        .submit-bar.on { display: block; }
        .submit-bar button { min-width: 180px; padding: 12px 20px; font-size: 16px; }
        .screen { display: none; }
        .screen.on { display: block; }
        .plant-toggle { margin-left: 10px; }
        .plant-toggle button { min-width: 96px; }
        .plant-toggle button.on { background: #0f766e; border-color: #0f766e; color: #fff; }
        .graph-card { text-align: center; }
        canvas.radial { width: 260px; height: 260px; background: #111; border-radius: 12px; }
        .doc-ack { padding: 12px; border: 1px solid #334155; border-radius: 10px; margin: 0 0 10px; }
        .form { display: none; }
        .form.on { display: block; }
        .tabs { margin: 0 0 12px; }
        .tabs button { margin: 0 6px 6px 0; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .tabs button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        .tabpanel { display: none; }
        .tabpanel.on { display: block; }
        table.list { width: 100%; border-collapse: collapse; font-size: 13px; }
        table.list th, table.list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #2a2f36; vertical-align: top; }
        table.list th { color: #9ca3af; }
        .list-wrap { max-height: 520px; overflow: auto; border: 1px solid #2a2f36; border-radius: 8px; }
        .overlay { display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); z-index: 20; }
        .overlay.on { display: block; }
        .overlay.login { background: #5c6370; z-index: 40; }
        .overlay.login .modal { background: #6b7280; border-color: #9ca3af; color: #f9fafb; box-shadow: 0 18px 40px rgba(15,23,42,.28); margin-top: 10vh; }
        .overlay.login .modal h3 { color: #f9fafb; letter-spacing: 0.02em; margin-bottom: 6px; }
        .overlay.login .muted { color: #e5e7eb; }
        .overlay.login label.f { color: #e5e7eb; }
        .overlay.login label.f input { background: #4b5563; color: #f9fafb; border-color: #9ca3af; }
        .overlay.login button.ok { background: #374151; border: 1px solid #9ca3af; }
        .overlay.login button.secondary { background: #4b5563; color: #f9fafb; border-color: #9ca3af; }
        .login-kicker { font-size: 11px; letter-spacing: 0.18em; font-weight: 800; color: #d1d5db; margin: 0 0 8px; }
        .overlay.raise { z-index: 50; }
        .filter-row { margin: 0 0 10px; }
        .filter-row .f { display: inline-block; width: auto; margin: 0 10px 0 0; vertical-align: middle; }
        .filter-row input, .filter-row select { display: inline-block; width: auto; min-width: 140px; margin: 4px 8px 0 0; vertical-align: middle; padding: 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        .item-tools { margin: 0 0 10px; }
        .item-tools .subtabs { display: inline-block; vertical-align: middle; }
        .item-tools > button { margin: 0 6px 6px 0; vertical-align: middle; }
        .modal { width: 520px; max-width: 92%; margin: 40px auto; background: #1e1e1e; border-radius: 12px; padding: 16px; border: 1px solid #2a2f36; color: #f3f4f6; }
        .modal.wide { width: 780px; }
        .modal h3 { margin: 0 0 10px; }
        .session { font-size: 13px; color: #9ca3af; margin-right: 6px; }
        .subtabs button { margin: 0 6px 6px 0; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .subtabs button.on { background: #0f766e; color: #fff; border-color: #0f766e; }
        table.specs { width: 100%; border-collapse: collapse; font-size: 12px; }
        table.specs th, table.specs td { text-align: left; padding: 5px 6px; border: 1px solid #2a2f36; vertical-align: top; }
        table.specs thead th { background: #1f2937; color: #9ca3af; font-weight: 700; }
        table.specs th.group { text-align: center; background: #111827; }
        table.specs th.mspec, table.specs td.mspec { width: 4.6em; white-space: nowrap; }
        table.specs td.num, table.specs th.num { width: 4.2em; text-align: right; }
        table.specs button { padding: 3px 8px; font-size: 12px; margin: 0 3px 0 0; }
        button.danger { background: #991b1b; }
        .locked { display: none; }
        .who { font-weight: 700; color: #f3f4f6; }
        .type-fields { display: none; }
        .type-fields.on { display: block; }
        .theme-toggle { display: inline-block; margin: 0 8px; color: #9ca3af; font-size: 12px; font-weight: 700; cursor: pointer; vertical-align: middle; }
        .theme-toggle input { display: none; }
        .theme-toggle .track { display: inline-block; position: relative; width: 42px; height: 22px; background: #3f3f46; border-radius: 999px; border: 1px solid #3f3f46; vertical-align: middle; margin: 0 6px; }
        .theme-toggle .track span { display: block; position: absolute; left: 2px; top: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fbbf24; }
        body.light .theme-toggle .track { background: #93c5fd; }
        body.light .theme-toggle .track span { left: 22px; background: #fff; }
        .lookup-card { width: 720px; max-width: 100%; }
        .mspec-ro { margin: 0 0 10px; font-size: 12px; font-weight: 700; color: #9ca3af; }
        .mspec-ro b { display: inline-block; margin-left: 8px; padding: 6px 10px; border-radius: 8px; background: #111; color: #f3f4f6; border: 2px solid #3f3f46; font-size: 15px; }
        .line-checks label { display: inline-block; margin: 0 12px 8px 0; color: #f3f4f6; font-size: 13px; font-weight: 600; }
        .line-checks input { margin-right: 4px; }
        .role-checks, .plant-checks { margin: 8px 0 12px; }
        .role-checks label, .plant-checks label { display: inline-block; margin: 0 12px 8px 0; color: #f3f4f6; font-size: 13px; font-weight: 600; }
        .role-checks input, .plant-checks input { margin-right: 4px; }
        table.results td.neutral { color: #9ca3af; }
        .op-banner { display: none; margin: 0 0 12px; padding: 8px 12px; background: #1e3a5f; border-radius: 8px; color: #93c5fd; font-size: 13px; }
        .op-banner.on { display: block; }
        #debugBox { width: 100%; height: 280px; box-sizing: border-box; font-family: Consolas, monospace; font-size: 12px; background: #0b1220; color: #d1fae5; border: 1px solid #334155; }
        .login-extra { margin-top: 14px; }
        .login-extra button { margin: 0 6px 0 0; }
        .boot-progress { margin-top: 16px; display: none; }
        .boot-progress.on { display: block; }
        #loginFields { display: none; }
        #loginFields.on { display: block; }
        .boot-bar { height: 10px; background: #4b5563; border-radius: 999px; overflow: hidden; border: 1px solid #9ca3af; }
        .boot-bar i { display: block; height: 100%; width: 0; background: #93c5fd; }
        .boot-progress p { margin: 8px 0 0; font-size: 12px; color: #e5e7eb; }
        .work-modal .boot-bar { border-color: #3f3f46; background: #262626; }
        .work-modal .boot-bar i { background: #2563eb; }
        .inbox-btn { position: relative; }
        .badge { display: none; min-width: 16px; padding: 1px 6px; margin-left: 6px; border-radius: 999px; background: #dc2626; color: #fff; font-size: 11px; }
        .badge.on { display: inline-block; }
        .hist-changed { background: #713f12; color: #fde68a; font-weight: 700; }
        .hist-grid { width: auto; min-width: 100%; font-size: 12px; }
        .hist-grid th { white-space: nowrap; }
        .hist-grid td { padding: 4px 8px; white-space: nowrap; }
        .hist-grid td.hist-in { background: #14532d; color: #86efac; }
        .hist-grid td.hist-under { background: #713f12; color: #fde68a; }
        .hist-grid td.hist-over { background: #7f1d1d; color: #fecaca; }
        .hist-grid tr.hist-row-in td { border-left: 3px solid #22c55e; background: #14532d; color: #86efac; }
        .hist-grid tr.hist-row-under td { border-left: 3px solid #eab308; }
        .hist-grid tr.hist-row-over td { border-left: 3px solid #ef4444; background: #7f1d1d; color: #fecaca; }
        .hist-grid tr.hist-row-in td:first-child { border-left-width: 6px; }
        .hist-grid tr.hist-row-under td:first-child { border-left-width: 6px; }
        .hist-grid tr.hist-row-over td:first-child { border-left-width: 6px; }
        .hist-line-tabs { margin: 0 0 10px; }
        .hist-more { padding: 8px; color: #9ca3af; font-size: 12px; }
        .req { color: #f87171; font-weight: 800; margin-left: 2px; }
        .req-note { margin: 10px 0 0; font-size: 12px; color: #9ca3af; }
        .coex-grid { width: 100%; border-collapse: collapse; margin: 8px 0 12px; table-layout: fixed; }
        .coex-grid th, .coex-grid td { border: 1px solid #2a2f36; padding: 4px 6px; vertical-align: middle; }
        .coex-grid th { background: #111827; text-align: center; font-size: 12px; }
        .coex-grid td.lbl { width: 9em; color: #9ca3af; font-size: 12px; font-weight: 700; white-space: nowrap; }
        .coex-grid input { width: 100%; box-sizing: border-box; padding: 6px; font-size: 13px; margin: 0; }
        table.specs input, .hist-edit-grid input {
            width: 100%; max-width: 4.6em; box-sizing: border-box; padding: 3px 4px; font-size: 12px; margin: 0;
        }
        table.specs input.wide, .hist-edit-grid input.wide { max-width: 8.5em; }
        table.specs input.struct { max-width: 4.5em; width: 4.5em; }
        table.specs th.struct, table.specs td.struct { width: 5em; max-width: 5em; }
        table.specs th.ver, table.specs td.ver { width: 4em; text-align: center; white-space: nowrap; }
        table.list input.cell, table.specs input.cell, .hist-grid input.cell {
            width: 100%; max-width: 7.5em; box-sizing: border-box; padding: 2px 4px; font-size: 12px; margin: 0;
        }
        table.list input.cell.wide, table.specs input.cell.wide { max-width: 14em; }
        table.specs.editing input.cell, table.list.editing input.cell, .hist-grid.editing input.cell {
            max-width: none; min-width: 5.5em; width: 100%;
        }
        table.specs.editing input.cell.wide, table.list.editing input.cell.wide { min-width: 12em; }
        .home-section { margin: 0 0 18px; }
        .home-section h3 { margin: 0 0 10px; font-size: 15px; color: #9ca3af; font-weight: 700; }
        body.light .home-section h3 { color: #4b5563; }
        .edit-toolbar { margin: 0 0 10px; }
        .edit-toolbar .muted { margin-left: 8px; font-size: 12px; }
        .profile-scroll, .hist-scroll { overflow-x: auto; max-width: 100%; }
        .hist-edit-grid { width: 100%; border-collapse: collapse; font-size: 12px; }
        .hist-edit-grid th, .hist-edit-grid td { border: 1px solid #2a2f36; padding: 4px 6px; vertical-align: top; }
        .hist-edit-grid th { background: #1f2937; color: #9ca3af; text-align: left; white-space: nowrap; width: 11em; }
        .hist-edit-grid input { max-width: none; }
        .hist-grid th.hist-act, .hist-grid td.hist-act {
            position: sticky; right: 0; background: #1a1a1a; z-index: 2; white-space: nowrap; text-align: right;
        }
        body.light .hist-grid th.hist-act, body.light .hist-grid td.hist-act { background: #fff; }
        body.light .req { color: #dc2626; }
        body.light .coex-grid th { background: #e5e7eb; color: #374151; }
        body.light .coex-grid th, body.light .coex-grid td, body.light .hist-edit-grid th, body.light .hist-edit-grid td { border-color: #e5e7eb; }

        html.qd-app.light, body.qd-app.light, body.light { background: #e8edf3; color: #111827; }
        body.qd-app.light #appRoot, body.light #appRoot { background: #e8edf3; }
        body.light header.app { background: #fff; border-bottom-color: #d1d5db; }
        body.light h1 .ver, body.light .muted, body.light .crumbs, body.light .session, body.light label.f, body.light .theme-toggle, body.light table.list th, body.light .results th:first-child, body.light .results td:first-child, body.light .mspec-ro, body.light .spec b { color: #4b5563; }
        body.light .crumbs b, body.light .who { color: #111827; }
        body.light .crumbs a { color: #1d4ed8; }
        body.light button.secondary { background: #e5e7eb; color: #111827; border-color: #d1d5db; }
        body.light .status { background: #eff6ff; border-color: #93c5fd; color: #1e3a8a; }
        body.light .status.bad { background: #fee2e2; border-color: #fca5a5; color: #991b1b; }
        body.light .card, body.light .home-line, body.light .modal { background: #fff; border-color: #d1d5db; color: #111827; }
        body.light label.f input, body.light label.f select, body.light label.f textarea, body.light .hits, body.light canvas.radial, body.light .mspec-ro b, body.light .filter-row input, body.light .filter-row select { background: #fff; color: #111827; border-color: #d1d5db; }
        body.light .tabs button, body.light .subtabs button, body.light .lines button { background: #e5e7eb; color: #111827; border-color: #d1d5db; }
        body.light .tabs button.on, body.light .lines button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        body.light .chip { background: #f3f4f6; border-color: #d1d5db; }
        body.light .chip input { color: #111827; }
        body.light .chip.under { background: #fef3c7; }
        body.light .chip.in { background: #dcfce7; }
        body.light .chip.over { background: #fee2e2; }
        body.light .chip.extreme { outline-color: #111827; }
        body.light .chip.need { border-color: #d97706; outline-color: #d97706; }
        body.light .hist-changed { background: #fef3c7; color: #92400e; }
        body.light .hist-grid td.hist-in { background: #dcfce7; color: #166534; }
        body.light .hist-grid td.hist-under { background: #fef3c7; color: #92400e; }
        body.light .hist-grid td.hist-over { background: #fee2e2; color: #991b1b; }
        body.light .hist-grid tr.hist-row-in td { background: #dcfce7; color: #166534; }
        body.light .hist-grid tr.hist-row-over td { background: #fee2e2; color: #991b1b; }
        body.light .pass { background: #dcfce7; color: #166534; }
        body.light .fail { background: #fee2e2; color: #991b1b; }
        body.light .pf-huge.pass { background: #dcfce7; color: #166534; }
        body.light .pf-huge.fail { background: #fee2e2; color: #991b1b; }
        body.light .chip span.ex { color: #b45309; }
        body.light .home-line.tone-green h3, body.light .home-line.tone-green p { color: #166534; }
        body.light .home-line.tone-red h3, body.light .home-line.tone-red p { color: #b91c1c; }
        body.light .home-line.tone-gray h3, body.light .home-line.tone-gray p { color: #6b7280; }
        body.light .results th, body.light .results td, body.light table.list th, body.light table.list td, body.light table.specs th, body.light table.specs td, body.light .list-wrap { border-color: #e5e7eb; }
        body.light .results td.ok { color: #166534; }
        body.light .results td.bad { color: #b91c1c; }
        body.light table.specs thead th { background: #f3f4f6; color: #4b5563; }
        body.light table.specs th.group { background: #e5e7eb; }
        body.light .overlay.login { background: #5c6370; }
        body.light .overlay.login .modal { background: #6b7280; border-color: #9ca3af; color: #f9fafb; }
        body.light .overlay.login .muted, body.light .overlay.login label.f { color: #e5e7eb; }
        body.light .overlay.login label.f input { background: #4b5563; color: #f9fafb; border-color: #9ca3af; }
        body.light .line-checks label { color: #111827; }
        body.light .role-checks label, body.light .plant-checks label { color: #111827; }
        body.light .op-banner { background: #dbeafe; color: #1e3a8a; }
        body.light #debugBox { background: #111827; color: #d1fae5; }
    </style>
</head>
<body>
    <div id="loginOverlay" class="overlay login on">
        <div class="modal">
            <div class="login-kicker">WEX QUALITY</div>
            <h3>Quality Desk Checks</h3>
            <p class="muted" id="loginStatus">Starting Quality Desk…</p>
            <div id="loginFields">
            <label class="f">User <input id="loginUser"></label>
            <label class="f">Password <input id="loginPass" type="password" onkeydown="if(event.keyCode==13)doLogin()"></label>
            <button type="button" class="ok" onclick="doLogin()">Sign in</button>
            <div class="login-extra">
                <button type="button" class="secondary" onclick="openNewUserForm()">New User</button>
                <button type="button" class="secondary" onclick="openForgotForm()">Forgot Password</button>
                <button type="button" class="secondary" onclick="openDesk(false)">History</button>
            </div>
            <p class="muted">New accounts wait for an admin to approve. Sessions end after 1 hour idle. Passwords stay hashed on this PC.</p>
            </div>
            <div id="bootProgress" class="boot-progress on">
                <div class="boot-bar"><i id="bootBarFill"></i></div>
                <p id="bootBarText">Starting…</p>
            </div>
        </div>
    </div>
    <script src="qd-check.js" type="text/javascript"></script>
    <script type="text/javascript">
        var aio = { items: [], mspecs: [], users: [], bubble: [], bubbleDead: [], p1: [], rts: [], path: '', loaded: false };
        var currentLine = 'S4';
        var currentSite = 'VISALIA';
        var currentScreen = 'home';
        var checkReason = '';
        var noCheckReason = '';
        var startupAnswers = {};
        var rtsStartupAnswers = {};
        var conCardQueue = [];
        var conCardIndex = 0;
        var openedConCards = {};
        var itemTab = 'foam';
        var docsStore = { docs: [], acks: [] };
        var homeTimer = null;
        var handoffTimer = null;
        var handoffBusy = false;
        var histEdit = { file: "", idx: -1 };
        var histState = { file: "", filtered: [], shown: 0, page: 80, cols: [] };
        var itemModalEditing = false;
        var profileEditMode = false;
        var profileDirty = false;
        var profileLineTab = "";
        var mspecEditMode = false;
        var mspecDirty = false;
        var mspecEditSnapshot = null;
        var itemEditMode = false;
        var itemDirty = false;
        var itemEditSnapshot = null;
        var histEditMode = false;
        var histDirty = false;
        var profileEditSnapshot = null;
        var profilesStore = { VISALIA: {}, GARLAND: {} };
        var specTab = 'foam';
        var session = { user: '', admin: false, last: 0, rec: null };
        var authUsers = [];
        var specHistory = [];
        var idleTimer = null;
        var checkEnteredAt = 0;
        var currentTab = "checks";
        var computing = false;
        var lastCalc = {};
        var computeTimer = null;
        var submitTimer = null;
        var hitsTimer = null;
        var listTimer = null;
        var itemByNo = {};
        var lineCache = {};
        var utfCache = {};
        var deskPackCache = null;
        var deskHtmlStamp = "";
        var docsLoaded = false;
        var lastHomeHtml = "";
        var specHistoryLoaded = false;
        var lastCheckByFile = {};
        var lastChecksLoaded = false;
        var qdProf = { t0: 0, last: 0, flushed: 0, section: "", lines: [], io: { reads: 0, readMs: 0, writes: 0, writeMs: 0, remote: 0, slow: [] } };
        var lastResultsHtml = "";
        var specPaintTarget = null;
        var lastRadialKey = "";
        var skipLeaveGuard = false;
        var pendingFailContext = null;
        var themeMode = "dark";
        var viewAsOperator = false;
        var debugLines = [];
        var sapCache = { path: "", mtime: 0 };
        var openedDocs = {};
        var ackTimers = {};
        var conCardCountdown = 0;
        var conCardTimer = null;
        var docEditId = null;
        var docBrowseTab = "foam";
        var datePickerTarget = null;
        var datePickerView = null;
        var inboxStore = { requests: [] };
        var auditLog = [];

        function $(id) { return document.getElementById(id); }

        function setStatus(msg, bad) {
            var el = $('status');
            el.className = bad ? 'status bad' : 'status';
            el.innerText = msg;
        }

        function getAppFolder() {
            var fso, home;
            if (window.QD_NET_HOME) {
                home = String(window.QD_NET_HOME).replace(/^\s+|\s+$/g, "");
                if (home) return home;
            }
            fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.GetParentFolderName(htaFilePath());
        }

        function htaFilePath() {
            var href = String(location.href || "");
            var path = String(location.pathname || "");
            var raw = href;
            if (href.toLowerCase().indexOf("file:") === 0) raw = href.replace(/^file:\/\//i, "");
            else if (path) raw = path;
            raw = raw.replace(/^\/+/, "");
            try { raw = decodeURIComponent(raw); } catch (e) {}
            raw = raw.replace(/\//g, "\\");
            if (raw.length >= 2 && raw.charAt(1) !== ":" && raw.indexOf("\\\\") !== 0) raw = "\\\\" + raw;
            if (raw.toLowerCase().indexOf("localhost\\") === 0) raw = raw.substring(10);
            return raw;
        }

        function pathIsRemote(path) {
            var p = String(path || "").replace(/\//g, "\\"), fso, drive, key;
            if (p.indexOf("\\\\") === 0) return true;
            if (p.length >= 2 && p.charAt(1) === ":") {
                key = p.charAt(0).toUpperCase();
                if (pathIsRemote.cache && pathIsRemote.cache[key] != null) return pathIsRemote.cache[key];
                try {
                    fso = new ActiveXObject("Scripting.FileSystemObject");
                    drive = fso.GetDrive(p.substring(0, 2));
                    if (!pathIsRemote.cache) pathIsRemote.cache = {};
                    pathIsRemote.cache[key] = !!(drive && drive.DriveType === 3);
                    return pathIsRemote.cache[key];
                } catch (e) {}
            }
            return false;
        }

        function resultsDir() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = fso.BuildPath(getAppFolder(), QD.DISK_DIR);
            if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
            return dir;
        }

        function fileExists(path) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.FileExists(path);
        }

        function peekAttrs(path) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(path)) return 0;
                return fso.GetFile(path).Attributes;
            } catch (e) { return 0; }
        }

        function setAttrs(path, attrs) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (fso.FileExists(path)) fso.GetFile(path).Attributes = attrs;
            } catch (e) {}
        }

        function revealFile(path) {
            var prev = peekAttrs(path);
            if (prev & 6) setAttrs(path, prev & ~6);
            return prev;
        }

        function restoreAttrs(path, prev) {
            if (prev & 6) setAttrs(path, prev);
        }

        function unlockPath(path) {
            if (!fileExists(path)) return;
            setAttrs(path, 0);
            try {
                var sh = new ActiveXObject("WScript.Shell");
                sh.Run('cmd /c icacls "' + path + '" /reset >nul 2>&1', 0, true);
            } catch (e) {}
        }

        function tempDir() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var sh, dir = "";
            try {
                sh = new ActiveXObject("WScript.Shell");
                dir = String(sh.ExpandEnvironmentStrings("%TEMP%") || "");
            } catch (e0) {}
            if (!dir || dir.indexOf("%") >= 0) {
                try { dir = fso.GetSpecialFolder(2).Path; } catch (e1) { dir = getAppFolder(); }
            }
            return dir;
        }

        function profNow() {
            return new Date().getTime();
        }

        function profLocalDir() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var sh, root = "", dir;
            try {
                sh = new ActiveXObject("WScript.Shell");
                root = String(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") || "");
            } catch (e0) {}
            if (!root || root.indexOf("%") >= 0) {
                try { root = fso.GetSpecialFolder(2).Path; } catch (e1) { root = tempDir(); }
            }
            dir = fso.BuildPath(root, "QualityDesk");
            if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
            return dir;
        }

        function profPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(profLocalDir(), "profile.txt");
        }

        function profPad(n) {
            var s = String(Math.round(n == null ? 0 : n)) + " ms";
            while (s.length < 8) s = " " + s;
            return s;
        }

        function profEnsure() {
            if (!qdProf.t0) {
                qdProf.t0 = profNow();
                qdProf.last = qdProf.t0;
            }
        }

        function profAdd(name, ms) {
            var now = profNow();
            profEnsure();
            if (ms == null) ms = now - qdProf.last;
            qdProf.last = now;
            qdProf.lines.push({ name: String(name || ""), step: ms, total: now - qdProf.t0, section: qdProf.section });
        }

        function profMark(name) {
            profAdd(name);
        }

        function profRun(name, fn) {
            var t = profNow(), out;
            try { out = fn(); }
            finally { profAdd(name, profNow() - t); }
            return out;
        }

        function profSection(name) {
            qdProf.section = name;
            profEnsure();
            qdProf.last = profNow();
        }

        function profRecent() {
            var fso, p;
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                p = profPath();
                if (!fso.FileExists(p)) return false;
                return (profNow() - (+new Date(fso.GetFile(p).DateLastModified))) < 120000;
            } catch (eR) { return false; }
        }

        function profHeader() {
            var lines = [], sh, net, when;
            when = new Date();
            lines.push("Quality Desk profile v" + (QD && QD.VERSION ? QD.VERSION : "?"));
            lines.push("When: " + when.toDateString() + " " + when.toTimeString());
            try {
                net = new ActiveXObject("WScript.Network");
                lines.push("PC: " + net.ComputerName + "  user: " + net.UserName);
            } catch (eN) {}
            try { sh = new ActiveXObject("WScript.Shell"); lines.push("TEMP: " + sh.ExpandEnvironmentStrings("%TEMP%")); } catch (eT) {}
            try { lines.push("HTA: " + htaFilePath()); } catch (eH) {}
            try { lines.push("App folder: " + getAppFolder()); } catch (eA) {}
            lines.push("QD_NET_HOME: " + (window.QD_NET_HOME || "(none)"));
            lines.push("QD_RELEASE_CRYPT: " + (window.QD_RELEASE_CRYPT ? "1" : "0"));
            try { lines.push("File: " + profPath()); } catch (eF) {}
            lines.push("");
            return lines.join("\r\n");
        }

        function profFormatFrom(from) {
            var i, r, name, out = [];
            for (i = from; i < qdProf.lines.length; i++) {
                r = qdProf.lines[i];
                name = r.name;
                if (name.length > 46) name = name.substring(0, 46);
                while (name.length < 46) name += " ";
                out.push(profPad(r.step) + "  tot " + profPad(r.total) + "  " + name);
            }
            return out.join("\r\n");
        }

        function profNoteIo(op, path, ms) {
            var io = qdProf.io, remote = false;
            if (ms == null) return;
            try { remote = pathIsRemote(path); } catch (eR) {}
            if (op === "write") {
                io.writes += 1;
                io.writeMs += ms;
            } else {
                io.reads += 1;
                io.readMs += ms;
            }
            if (remote) io.remote += 1;
            if (ms >= 50) io.slow.push({ op: op, ms: ms, path: String(path || "") });
        }

        function profFlush(kind) {
            var fso, path, ts, start, text, i, r, slow, io;
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                path = profPath();
                start = qdProf.flushed || 0;
                if (kind === "begin" && !profRecent()) {
                    ts = fso.CreateTextFile(path, true);
                    ts.Write(profHeader() + "\r\n");
                    ts.Close();
                    qdProf.flushed = 0;
                    start = 0;
                }
                text = "";
                if (kind === "section" && qdProf.section) text += "\r\n--- " + qdProf.section + " ---\r\n";
                if (start < qdProf.lines.length) {
                    text += profFormatFrom(start);
                    if (text) text += "\r\n";
                }
                if (kind === "end") {
                    io = qdProf.io;
                    text += "I/O reads " + io.reads + " / " + Math.round(io.readMs) + " ms";
                    text += "   writes " + io.writes + " / " + Math.round(io.writeMs) + " ms";
                    text += "   remote " + io.remote + "\r\n";
                    if (io.slow.length) {
                        text += "Slow I/O (>=50ms):\r\n";
                        for (i = 0; i < io.slow.length; i++) {
                            r = io.slow[i];
                            text += "  " + profPad(r.ms) + "  " + r.op + "  " + r.path + "\r\n";
                        }
                    }
                    slow = [];
                    for (i = 0; i < qdProf.lines.length; i++) {
                        if (qdProf.lines[i].step >= 50) slow.push(qdProf.lines[i]);
                    }
                    slow.sort(function (a, b) { return b.step - a.step; });
                    text += "\r\nSLOW STEPS (>=50ms):\r\n";
                    if (!slow.length) text += "  (none)\r\n";
                    for (i = 0; i < slow.length && i < 25; i++) text += "  " + profPad(slow[i].step) + "  " + slow[i].name + "\r\n";
                    text += "TOTAL " + Math.round(profNow() - qdProf.t0) + " ms from first mark in this window\r\n";
                    text += "Share this file: " + path + "\r\n";
                }
                if (!text) return path;
                if (!fso.FileExists(path)) {
                    ts = fso.CreateTextFile(path, true);
                    ts.Write(profHeader() + "\r\n" + text);
                    ts.Close();
                } else {
                    ts = fso.OpenTextFile(path, 8, true);
                    ts.Write(text);
                    ts.Close();
                }
                qdProf.flushed = qdProf.lines.length;
                return path;
            } catch (eP) {
                return "";
            }
        }

        function tempFile(tag) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(tempDir(), "qd-" + (tag || "tmp") + "-" + String((new Date()).getTime()) + "-" + String(Math.floor(Math.random() * 100000)) + ".tmp");
        }

        function deleteTemp(path) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (path && fso.FileExists(path)) fso.DeleteFile(path, true);
            } catch (e) {}
        }

        function copyFile(src, dest) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
            fso.CopyFile(src, dest, true);
            return fso.FileExists(dest);
        }

        function streamReadFile(path) {
            var stream = new ActiveXObject("ADODB.Stream");
            stream.Type = 2;
            stream.Charset = "utf-8";
            stream.Open();
            stream.LoadFromFile(path);
            var text = stream.ReadText();
            stream.Close();
            return text;
        }

        function streamWriteFile(path, text) {
            var stream = new ActiveXObject("ADODB.Stream");
            var bin = new ActiveXObject("ADODB.Stream");
            stream.Type = 2;
            stream.Charset = "utf-8";
            stream.Open();
            stream.WriteText(text == null ? "" : String(text));
            stream.Position = 0;
            stream.Type = 1;
            if (stream.Size >= 3) stream.Position = 3;
            bin.Type = 1;
            bin.Open();
            stream.CopyTo(bin);
            bin.SaveToFile(path, 2);
            bin.Close();
            stream.Close();
        }

        function streamReadLocal(path) {
            var src = path, tmp = "";
            if (pathIsRemote(path)) {
                tmp = tempFile("nr");
                if (!copyFile(path, tmp)) throw new Error("Could not copy " + path);
                src = tmp;
            }
            try {
                return streamReadFile(src);
            } finally {
                if (tmp) deleteTemp(tmp);
            }
        }

        function streamWriteLocal(path, text) {
            var dest = path, tmp = "";
            if (pathIsRemote(path)) {
                tmp = tempFile("nw");
                dest = tmp;
            }
            streamWriteFile(dest, text);
            if (tmp) {
                try {
                    if (!copyFile(tmp, path)) throw new Error("Could not copy to " + path);
                } finally {
                    deleteTemp(tmp);
                }
            }
        }

        function fsoReadAll(path) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var ts = fso.OpenTextFile(path, 1);
            var text = ts.AtEndOfStream ? "" : ts.ReadAll();
            ts.Close();
            return text;
        }

        function fsoWriteAll(path, text) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var ts = fso.CreateTextFile(path, true);
            ts.Write(text);
            ts.Close();
        }

        function shouldSealPath(path) {
            var n;
            if (!window.QD_RELEASE_CRYPT || !path) return false;
            n = String(path).toLowerCase().replace(/\//g, "\\");
            if (n.substring(n.length - 9) === "users.dat") return true;
            if (n.indexOf("\\results\\") >= 0) return true;
            if (n.indexOf("\\aio-csv\\") >= 0) return true;
            return false;
        }

        function writeUtf8(path, text, plain) {
            var prev = peekAttrs(path);
            var body = text == null ? "" : String(text);
            var t0 = profNow();
            if ((prev & 6) && fileExists(path)) revealFile(path);
            if (!plain && shouldSealPath(path) && QD && QD.seal) body = QD.seal(body);
            try {
                streamWriteLocal(path, body);
            } catch (e1) {
                var tmp = tempFile("w");
                try {
                    streamWriteLocal(tmp, body);
                    unlockPath(path);
                    if (!copyFile(tmp, path)) throw e1;
                } catch (e2) {
                    fsoWriteAll(path, body);
                }
                deleteTemp(tmp);
            }
            if (prev & 6) restoreAttrs(path, prev);
            utfCache[path] = { mtime: fileMtime(path), text: text == null ? "" : String(text) };
            profNoteIo("write", path, profNow() - t0);
        }

        function peekHead(path, n) {
            var fso, ts, s = "";
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(path)) return "";
                ts = fso.OpenTextFile(path, 1);
                if (!ts.AtEndOfStream) s = ts.Read(n || 8);
                ts.Close();
            } catch (e) { s = ""; }
            return s;
        }

        function fileIsSealed(path) {
            var h = peekHead(path, 8);
            return h.indexOf("QDSEAL") === 0;
        }

        function readUtf8(path, keepSealed) {
            var mt, hit, prev, text, tmp, t0;
            if (!fileExists(path)) return "";
            mt = fileMtime(path);
            hit = utfCache[path];
            if (!keepSealed && hit && hit.mtime === mt) return hit.text;
            t0 = profNow();
            prev = peekAttrs(path);
            if (prev & 6) revealFile(path);
            text = "";
            try {
                text = streamReadLocal(path);
            } catch (e1) {
                tmp = tempFile("r");
                try {
                    if (!copyFile(path, tmp)) throw e1;
                    text = streamReadLocal(tmp);
                } catch (e2) {
                    try { text = fsoReadAll(path); } catch (e3) { text = ""; }
                }
                deleteTemp(tmp);
            }
            if (prev & 6) restoreAttrs(path, prev);
            text = QD.stripBom(text);
            if (!keepSealed && QD && QD.isSealed && QD.isSealed(text)) text = QD.unseal(text);
            if (!keepSealed) utfCache[path] = { mtime: mt, text: text };
            profNoteIo("read", path, profNow() - t0);
            return text;
        }

        function protectPath(path) {
            try { if (fileExists(path)) setAttrs(path, (peekAttrs(path) | 2) & ~4); } catch (e1) {}
        }

        function unhidePath(path) {
            try { if (fileExists(path)) setAttrs(path, peekAttrs(path) & ~2); } catch (e1) {}
        }

        function exposeResultsJs() {
            var fso, folder, e, f, n;
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FolderExists(resultsDir())) return;
                folder = fso.GetFolder(resultsDir());
                e = new Enumerator(folder.Files);
                for (; !e.atEnd(); e.moveNext()) {
                    f = e.item();
                    n = String(f.Name || "").toLowerCase();
                    if (n === "users.dat" || n === "theme.txt") continue;
                    if (n.length < 4 || n.substring(n.length - 3) !== ".js") continue;
                    try { f.Attributes = f.Attributes & ~2; } catch (e1) {}
                }
            } catch (e0) {}
        }

        function usersDatPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), QD.USERS_FILE);
        }

        function historyPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "spec-history.js");
        }

        function localSpecsPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "local-specs.js");
        }

        function touchSession() {
            if (!session.user) return;
            session.last = new Date().getTime();
        }

        function checkIdle() {
            if (!session.user) return;
            var now = new Date().getTime();
            if (checkDirty() && checkEnteredAt && (now - checkEnteredAt) >= QD.CHECK_IDLE_MS) {
                skipLeaveGuard = true;
                clearCheckForm();
                checkReason = "";
                startupAnswers = {};
                checkEnteredAt = 0;
                showTab("checks");
                showScreen("home");
                renderHome();
                skipLeaveGuard = false;
                setStatus("Returned home after 15 minutes idle on quality check.");
                return;
            }
            if ((now - session.last) >= QD.IDLE_MS) logout("Signed out after 1 hour of inactivity.");
        }

        function touchCheckActivity() {
            if (checkDirty()) checkEnteredAt = new Date().getTime();
            touchSession();
        }

        function startIdleWatch() {
            if (idleTimer) window.clearInterval(idleTimer);
            idleTimer = window.setInterval(checkIdle, 30000);
            document.onkeydown = function (ev) {
                touchCheckActivity(ev);
                handleFieldArrowNav(ev);
            };
            document.onclick = touchCheckActivity;
        }

        function visibleNavFields() {
            var nodes = document.getElementsByTagName("*"), out = [], i, el, tag, typ;
            for (i = 0; i < nodes.length; i++) {
                el = nodes[i];
                tag = String(el.tagName || "").toUpperCase();
                if (tag !== "INPUT" && tag !== "SELECT" && tag !== "TEXTAREA") continue;
                if (el.disabled) continue;
                typ = String(el.type || "").toLowerCase();
                if (tag === "INPUT" && (typ === "hidden" || typ === "button" || typ === "submit" || typ === "checkbox" || typ === "radio" || typ === "file")) continue;
                if (el.offsetWidth === 0 && el.offsetHeight === 0) continue;
                out.push(el);
            }
            return out;
        }

        function handleFieldArrowNav(ev) {
            ev = ev || window.event;
            var kc = ev.keyCode || ev.which;
            if (kc !== 37 && kc !== 38 && kc !== 39 && kc !== 40) return;
            var t = ev.srcElement || ev.target;
            if (!t || !t.tagName) return;
            var tag = String(t.tagName).toUpperCase();
            if (tag !== "INPUT" && tag !== "SELECT" && tag !== "TEXTAREA") return;
            if (tag === "TEXTAREA") return;
            if ((kc === 37 || kc === 39) && tag === "INPUT") {
                try {
                    var start = t.selectionStart, endSel = t.selectionEnd, len = String(t.value || "").length;
                    if (start != null && endSel != null && start === endSel) {
                        if (kc === 37 && start > 0) return;
                        if (kc === 39 && start < len) return;
                    }
                } catch (eCaret) {}
            }
            var fields = visibleNavFields(), idx = -1, i, next;
            for (i = 0; i < fields.length; i++) {
                if (fields[i] === t) { idx = i; break; }
            }
            if (idx < 0) return;
            next = (kc === 40 || kc === 39) ? fields[idx + 1] : fields[idx - 1];
            if (!next) return;
            if (ev.preventDefault) ev.preventDefault();
            ev.returnValue = false;
            try {
                next.focus();
                if (next.select && String(next.tagName).toUpperCase() === "INPUT") next.select();
            } catch (eNav) {}
        }

        function isThicknessPointInput(el) {
            if (!el || !el.id) return false;
            return /^(s4t|s1t|pht|ptt|rt)\d+$/i.test(el.id);
        }

        function normalizeThicknessField(el) {
            if (!el || !isThicknessPointInput(el) || !QD.normalizeThicknessEntry) return;
            var next = QD.normalizeThicknessEntry(el.value);
            if (String(next) !== String(el.value)) {
                el.value = next;
                try { scheduleCompute(); } catch (e1) { try { compute(); } catch (e2) {} }
            }
        }

        function bindThicknessConverters() {
            var ids = [], i, el, n;
            for (n = 1; n <= 13; n++) { ids.push("s4t" + n); ids.push("s1t" + n); }
            for (n = 1; n <= 12; n++) { ids.push("pht" + n); ids.push("ptt" + n); }
            ids.push("rt1"); ids.push("rt2"); ids.push("rt3");
            for (i = 0; i < ids.length; i++) {
                el = $(ids[i]);
                if (!el || el.getAttribute("data-thk") === "1") continue;
                el.setAttribute("data-thk", "1");
                el.onblur = (function (node) {
                    return function () { normalizeThicknessField(node); };
                })(el);
            }
        }

        function themePath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "theme.txt");
        }

        function loadTheme() {
            var t = "dark";
            try { if (fileExists(themePath())) t = QD.trim(readUtf8(themePath())).toLowerCase(); } catch (e) {}
            setTheme(t === "light" ? "light" : "dark", true);
        }

        function setTheme(mode, skipWrite) {
            themeMode = mode === "light" ? "light" : "dark";
            document.documentElement.className = "qd-app" + (themeMode === "light" ? " light" : "");
            document.body.className = "qd-app" + (themeMode === "light" ? " light" : "");
            if ($("themeToggle")) $("themeToggle").checked = themeMode === "light";
            if (!skipWrite) {
                try { writeUtf8(themePath(), themeMode); } catch (e1) {}
            }
            lastRadialKey = "";
            if (currentScreen === "checkform") {
                try { compute(); } catch (e2) {}
            }
        }

        function toggleTheme() {
            setTheme(themeMode === "light" ? "dark" : "light");
        }

        function rebuildItemIndex() {
            itemByNo = {};
            var i, it, key;
            for (i = 0; i < aio.items.length; i++) {
                it = aio.items[i];
                if (!it || it.deleted) continue;
                key = QD.canonItem(it.item);
                if (key) itemByNo[key] = it;
            }
        }

        function fileMtime(path) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(path)) return 0;
                return +new Date(fso.GetFile(path).DateLastModified);
            } catch (e) { return 0; }
        }

        function loadAuthUsers() {
            var path = usersDatPath();
            var parsed = [];
            if (fileExists(path)) {
                try { parsed = QD.parseUsersDat(readUtf8(path)); } catch (e1) { parsed = []; }
            }
            if (parsed.length) {
                authUsers = parsed;
                return authUsers;
            }
            if (!authUsers.length) authUsers = [QD.makeUserRecord(QD.SEED_USER, "QCLAB", true, false)];
            try { saveAuthUsers(); } catch (e2) {}
            return authUsers;
        }

        function saveAuthUsers() {
            var path = usersDatPath();
            writeUtf8(path, QD.formatUsersDat(authUsers));
            protectPath(path);
        }

        function loadSpecHistory() {
            var fso, path;
            if (specHistoryLoaded) return;
            fso = new ActiveXObject("Scripting.FileSystemObject");
            path = historyPath();
            window.QD_SPEC_HISTORY = [];
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (e) {}
            }
            specHistory = window.QD_SPEC_HISTORY || [];
            specHistoryLoaded = true;
        }

        function saveSpecHistory() {
            var path = historyPath();
            writeUtf8(path, "window.QD_SPEC_HISTORY=" + JSON.stringify(specHistory) + ";");
            protectPath(path);
        }

        function addHistory(kind, key, why, before, after) {
            specHistory.push(QD.specHistoryEntry(kind, key, session.user, why, before, after));
            saveSpecHistory();
        }

        function saveLocalSpecs() {
            writeUtf8(localSpecsPath(), "window.QD_LOCAL_SPECS=" + JSON.stringify({
                mspecs: aio.mspecs, bubble: aio.bubble, bubbleDead: aio.bubbleDead, p1: aio.p1, rts: aio.rts
            }) + ";");
        }

        function applyLocalSpecs() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = localSpecsPath();
            window.QD_LOCAL_SPECS = null;
            if (!fso.FileExists(path)) return;
            try { eval(readUtf8(path)); } catch (e) { return; }
            var loc = window.QD_LOCAL_SPECS || {};
            if (loc.mspecs && loc.mspecs.length) aio.mspecs = loc.mspecs;
            if (loc.bubble && loc.bubble.length) aio.bubble = loc.bubble;
            if (loc.bubbleDead && loc.bubbleDead.length) aio.bubbleDead = loc.bubbleDead;
            if (loc.p1 && loc.p1.length) aio.p1 = loc.p1;
            if (loc.rts && loc.rts.length) aio.rts = loc.rts;
        }

        function writeManifest() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = resultsDir();
            var files = [];
            var names = ["manifest.js", "lookup.js", "sap.js"].concat((function () {
                var out = [], i;
                for (i = 0; i < QD.LINE_FILES.length; i++) out.push(QD.LINE_FILES[i] + ".js");
                return out;
            })());
            var i, p;
            for (i = 1; i < names.length; i++) {
                p = fso.BuildPath(dir, names[i]);
                if (fso.FileExists(p)) files.push(names[i]);
            }
            writeUtf8(fso.BuildPath(dir, "manifest.js"), QD.diskManifestScript(files));
            unhidePath(fso.BuildPath(dir, "manifest.js"));
        }

        function findSapCsv() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = ["SAP.csv", "sap.csv", "Sap.csv"];
            var i, p;
            for (i = 0; i < names.length; i++) {
                p = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(p)) return p;
            }
            return "";
        }

        function publishSapCsv() {
            var path = findSapCsv();
            if (!path) return false;
            var mtime = fileMtime(path);
            if (sapCache.path === path && sapCache.mtime === mtime) return false;
            var csv = readUtf8(path);
            if (!QD.trim(csv)) return false;
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            writeUtf8(fso.BuildPath(resultsDir(), "sap.js"), QD.sapDiskScript({
                name: fso.GetFileName(path),
                csv: csv,
                writtenAt: (new Date()).toISOString(),
                mtime: mtime
            }));
            unhidePath(fso.BuildPath(resultsDir(), "sap.js"));
            sapCache = { path: path, mtime: mtime };
            writeManifest();
            dbg("Published " + fso.GetFileName(path) + " for Quality Desk");
            return true;
        }

        function isAdmin() { return !!(session.user && session.admin && !viewAsOperator); }

        function maximizeWindow() {
            try {
                window.moveTo(0, 0);
                window.resizeTo(screen.availWidth, screen.availHeight);
            } catch (eMax) {}
        }

        function qualityDeskHtaCount() {
            var n = 0;
            try {
                var loc = GetObject("winmgmts:\\\\.\\root\\cimv2");
                var q = loc.ExecQuery("SELECT CommandLine FROM Win32_Process WHERE Name='mshta.exe'");
                var en = new Enumerator(q);
                var folder = getAppFolder().toLowerCase();
                var folderUrl = folder.replace(/\\/g, "/");
                for (; !en.atEnd(); en.moveNext()) {
                    var cmd = String(en.item().CommandLine || "").toLowerCase();
                    if (!cmd) continue;
                    if (cmd.indexOf("qualitydesk") >= 0 || cmd.indexOf("quality-desk") >= 0) n += 1;
                    else if ((cmd.indexOf(folder) >= 0 || cmd.indexOf(folderUrl) >= 0) && cmd.indexOf(".hta") >= 0) n += 1;
                }
            } catch (eC) {}
            return n;
        }

        function claimHtaInstance() {
            if (qualityDeskHtaCount() > 1) {
                try { (new ActiveXObject("WScript.Shell")).AppActivate("Quality Desk Checks"); } catch (eA) {}
                try { window.close(); } catch (eC) {}
                return false;
            }
            return true;
        }

        function handoffPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = [QD.HANDOFF_FILE, "diegraph2.txt", "DIEGRAPH2.TXT", "copy-for-graph.txt"];
            var i, p;
            for (i = 0; i < names.length; i++) {
                p = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(p)) return p;
            }
            return "";
        }

        function deleteHandoff(path) {
            if (!path) return;
            try { (new ActiveXObject("Scripting.FileSystemObject")).DeleteFile(path, true); } catch (eD) {}
        }

        function importHandoffIfPresent(quiet) {
            var path;
            if (handoffBusy) return false;
            try { path = handoffPath(); } catch (eP) { return false; }
            if (!path) return false;
            handoffBusy = true;
            showWork("Copy for Graph", "Reading " + path + "…", 8);
            window.setTimeout(function () {
                var text, pack;
                try { text = readUtf8(path); } catch (eR) {
                    handoffBusy = false;
                    hideWork();
                    if (!quiet) setStatus("Could not read " + path + "\n" + eR.message, true);
                    return;
                }
                pack = QD.importLegacyChecks(text);
                if (!pack || !pack.count) {
                    deleteHandoff(path);
                    handoffBusy = false;
                    hideWork();
                    if (!quiet) setStatus("Copy for Graph file had no checks. Removed " + path + ".", true);
                    return;
                }
                importLegacyWrite(pack, path, ["s4", "s1", "s3", "coex", "mono", "p1", "rts", "gcoex", "gmono"], 0, 0, 0, function () {
                    deleteHandoff(path);
                    handoffBusy = false;
                });
            }, 20);
            return true;
        }

        function startHandoffWatch() {
            if (handoffTimer) window.clearInterval(handoffTimer);
            handoffTimer = window.setInterval(function () {
                try { importHandoffIfPresent(true); } catch (eH) {}
            }, 15000);
        }

        function canUseInbox() {
            var u = sessionUser();
            return !!(u && (u.admin || QD.userIsSupervisor(u) || QD.userIsLead(u)));
        }

        function copyDebugAuto() {
            if ($("debugBox")) {
                $("debugBox").value = debugLines.join("\r\n");
                $("debugBox").select();
                try { document.execCommand("copy"); } catch (e) {}
            }
        }

        function dbg(msg, bad) {
            var line = (new Date()).toLocaleTimeString() + "  " + String(msg == null ? "" : msg);
            debugLines.push(line);
            if (debugLines.length > 400) debugLines = debugLines.slice(debugLines.length - 400);
            if ($("debugBox")) $("debugBox").value = debugLines.join("\r\n");
            try { if (window.Debug && window.Debug.write) window.Debug.write(line + "\n"); } catch (e0) {}
            if (bad) setStatus(String(msg), true);
        }

        function openDebug() {
            if (!session.admin) return;
            if ($("debugBox")) $("debugBox").value = debugLines.join("\r\n");
            $("debugOverlay").className = "overlay on";
        }

        function copyDebug() {
            if ($("debugBox")) $("debugBox").select();
            try { document.execCommand("copy"); setStatus("Debug log copied."); } catch (e) { setStatus("Select the log and copy it.", true); }
        }

        function toggleOperatorView() {
            if (!session.admin) return;
            viewAsOperator = !viewAsOperator;
            if ($("opBanner")) $("opBanner").className = "op-banner" + (viewAsOperator ? " on" : "");
            if ($("btnViewOp")) $("btnViewOp").innerText = viewAsOperator ? "Back to admin" : "View as operator";
            syncAdminChrome();
            lastHomeHtml = "";
            if (currentTab === "checks") renderHome();
            else if (currentTab === "users" || currentTab === "mspecs" || currentTab === "items" || currentTab === "audit" || currentTab === "profiles") goHome();
            else if (currentTab === "history") renderAdminHistory();
            dbg(viewAsOperator ? "View as operator on" : "Back to admin");
        }

        function syncAdminChrome() {
            var admin = isAdmin();
            var realAdmin = !!(session.user && session.admin);
            var els = document.getElementsByTagName("*"), i, el, cls;
            for (i = 0; i < els.length; i++) {
                el = els[i];
                cls = String(el.className || "");
                if (cls.indexOf("admin-only") >= 0) el.style.display = admin ? "" : "none";
                if (cls.indexOf("real-admin") >= 0) el.style.display = realAdmin ? "" : "none";
            }
            if ($("btnViewOp")) $("btnViewOp").style.display = realAdmin ? "" : "none";
            if ($("btnDebug")) $("btnDebug").style.display = realAdmin ? "" : "none";
            updateNav();
        }

        function requireAdmin() {
            if (!isAdmin()) { alert("Only admins can do that."); return false; }
            return true;
        }

        function showApp() {
            loadTheme();
            $("loginOverlay").className = "overlay login";
            $("appRoot").style.display = "block";
            $("sessionWho").innerText = session.user + (session.admin ? " (admin)" : "");
            setStatus("Welcome, " + session.user + ".");
            syncAdminChrome();
            if ($("user")) $("user").value = session.user;
            startIdleWatch();
            touchSession();
            dbg("Signed in " + session.user + (session.admin ? " admin" : ""));
        }

        function hideApp(msg) {
            session.user = "";
            session.admin = false;
            session.rec = null;
            viewAsOperator = false;
            if ($("opBanner")) $("opBanner").className = "op-banner";
            if ($("btnViewOp")) $("btnViewOp").innerText = "View as operator";
            document.documentElement.className = "";
            document.body.className = "";
            $("appRoot").style.display = "none";
            $("loginOverlay").className = "overlay login on";
            if ($("loginPass")) $("loginPass").value = "";
            if (msg) $("loginStatus").innerText = msg;
            if ($("bootProgress") && $("bootProgress").className.indexOf(" on") < 0) showLoginFields();
        }

        function setBoot(text, pct) {
            if ($("bootProgress")) $("bootProgress").className = "boot-progress on";
            if ($("bootBarText")) $("bootBarText").innerText = text || "";
            if ($("bootBarFill")) $("bootBarFill").style.width = Math.max(0, Math.min(100, pct || 0)) + "%";
        }

        function showLoginFields() {
            if ($("loginFields")) $("loginFields").className = "on";
            try { if ($("loginUser")) $("loginUser").focus(); } catch (eF) {}
        }

        function hideLoginFields() {
            if ($("loginFields")) $("loginFields").className = "";
        }

        function hideBoot() {
            if ($("bootProgress")) $("bootProgress").className = "boot-progress";
            if ($("loginStatus")) {
                var st = $("loginStatus").innerText || "";
                if (!st || /Starting Quality Desk|Starting…/i.test(st)) {
                    $("loginStatus").innerText = "Sign in to look up items and submit checks. History is available without a login.";
                }
            }
            showLoginFields();
            profAdd("boot.loginFieldsShown");
            try { dbg("profile: " + profFlush()); } catch (ePf) {}
            window.setTimeout(function () {
                try {
                    if (aio.loaded && aio.items && aio.items.length && !fileExists(cachePath())) saveAioCache();
                } catch (eCache) {}
            }, 80);
        }

        function showWork(title, text, pct) {
            if ($("workOverlay")) $("workOverlay").className = "overlay on";
            if ($("workTitle")) $("workTitle").innerText = title || "Working";
            if ($("workBarText")) $("workBarText").innerText = text || "";
            if ($("workBarFill")) $("workBarFill").style.width = Math.max(0, Math.min(100, pct || 0)) + "%";
        }

        function setWork(text, pct) {
            if ($("workBarText")) $("workBarText").innerText = text || "";
            if ($("workBarFill")) $("workBarFill").style.width = Math.max(0, Math.min(100, pct || 0)) + "%";
        }

        function hideWork() {
            if ($("workOverlay")) $("workOverlay").className = "overlay";
        }

        function doLogin() {
            var name = QD.trim($("loginUser").value);
            var pass = $("loginPass").value;
            profSection("login");
            try { profFlush("section"); } catch (ePs) {}
            try { loadAuthUsers(); } catch (e0) {}
            profAdd("login.findUser");
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) {
                try { loadInbox(); } catch (eIn) {}
                if (QD.findPendingNewUser(inboxStore.requests, name)) {
                    $("loginStatus").innerText = "Your account is waiting for admin approval.";
                    return;
                }
                $("loginStatus").innerText = "Unknown user or wrong password.";
                auditAs(name, "login-fail", "unknown user");
                return;
            }
            if (!QD.verifyPassword(rec, pass)) {
                $("loginStatus").innerText = "Unknown user or wrong password.";
                auditAs(name, "login-fail", "bad password");
                return;
            }
            if (!rec.hash) {
                $("loginStatus").innerText = "This user has no password. An admin must set one.";
                return;
            }
            session.user = rec.name;
            session.admin = !!rec.admin;
            session.rec = rec;
            currentSite = rec.plant === "GARLAND" ? "GARLAND" : "VISALIA";
            if (rec.plant === "BOTH" || rec.admin) currentSite = "VISALIA";
            touchSession();
            $("loginStatus").innerText = "";
            $("loginOverlay").className = "overlay login";
            profRun("login.showApp", function () { showApp(); });
            setStatus("Welcome, " + rec.name + ".");
            function finishLogin() {
                hideWork();
                if (rec.mustChange) {
                    $("pwOverlay").className = "overlay on";
                    $("pwTitle").innerText = "Set your password";
                }
                try { profRun("login.fillUsers", function () { fillUsers(); }); } catch (eU) {}
                try { profRun("login.renderLists", function () { renderLists(); }); } catch (e2) {}
                try { profRun("login.setSite", function () { setSite(currentSite, true); }); } catch (e3) {}
                try { profRun("login.importHandoff", function () { importHandoffIfPresent(true); }); } catch (eHandoff) {}
                audit("login", rec.name);
                if (pendingForUser().length) profRun("login.goDocs", function () { goDocs(true); });
                else profRun("login.goHome", function () { goHome(); });
                window.setTimeout(function () { fillLastChecksLazy(); }, 0);
                try { profFlush("end"); } catch (ePe) {}
            }
            if (aio.loaded) {
                profAdd("login.aioAlreadyLoaded", 0);
                finishLogin();
                return;
            }
            showWork("Loading Quality Desk", "Reading lookup files…", 12);
            window.setTimeout(function () {
                try { profRun("login.loadAio", function () { loadAio(false, false); }); } catch (e1) {
                    setStatus("Signed in, but lookup files could not be opened.\n" + e1.message, true);
                }
                finishLogin();
            }, 0);
        }

        function logout(msg) {
            if (session.user) audit("logout", session.user);
            hideApp(msg || "Signed out.");
        }

        function findAio() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = ["Quality AIO.xlsm", "Quality_AIO.xlsm", "Quality AIO.xlsx"];
            var i, p;
            for (i = 0; i < names.length; i++) {
                p = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(p)) return p;
            }
            return "";
        }

        function findHtml() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = ["index.html", "centration.html", "qualitydesk.html"];
            var i, p;
            if (window.QD_RELEASE_CRYPT) {
                p = materializeDeskHtml();
                if (p) return p;
            }
            for (i = 0; i < names.length; i++) {
                p = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(p)) return p;
            }
            return "";
        }

        function loadReleasePack() {
            var fso, path, raw, pack, mt;
            if (deskPackCache) return deskPackCache;
            fso = new ActiveXObject("Scripting.FileSystemObject");
            path = fso.BuildPath(getAppFolder(), QD.CORE_FILE);
            if (!fso.FileExists(path)) return null;
            raw = readUtf8(path);
            if (!raw) return null;
            if (QD.isSealed(raw)) raw = QD.unseal(raw);
            pack = QD.splitPack(raw);
            if (pack) {
                mt = fileMtime(path);
                deskPackCache = pack;
                deskHtmlStamp = String(mt);
            }
            return pack;
        }

        function resultsStamp() {
            var fso, folder, e, f, max = 0, t;
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FolderExists(resultsDir())) return 0;
                folder = fso.GetFolder(resultsDir());
                e = new Enumerator(folder.Files);
                for (; !e.atEnd(); e.moveNext()) {
                    f = e.item();
                    t = +new Date(f.DateLastModified);
                    if (t > max) max = t;
                }
            } catch (e0) {}
            return max;
        }

        function materializeDeskHtml() {
            var pack, fso, dest, html, srcVendor, destVendor, folder, e, f, name, text, src, dst, stamp, stampPath, prev;
            fso = new ActiveXObject("Scripting.FileSystemObject");
            dest = fso.BuildPath(tempDir(), "qd-desk");
            stamp = fileMtime(fso.BuildPath(getAppFolder(), QD.CORE_FILE)) + "|" + resultsStamp();
            stampPath = fso.BuildPath(dest, "qd-stamp.txt");
            if (fso.FileExists(fso.BuildPath(dest, "index.html"))) {
                try { prev = fsoReadAll(stampPath); } catch (eSt) { prev = ""; }
                if (prev === stamp) return fso.BuildPath(dest, "index.html");
            }
            pack = loadReleasePack();
            if (!pack || !pack.web) return "";
            if (!fso.FolderExists(dest)) fso.CreateFolder(dest);
            if (!fso.FolderExists(fso.BuildPath(dest, "results"))) fso.CreateFolder(fso.BuildPath(dest, "results"));
            if (!fso.FolderExists(fso.BuildPath(dest, "vendor"))) fso.CreateFolder(fso.BuildPath(dest, "vendor"));
            srcVendor = fso.BuildPath(getAppFolder(), "vendor\\chart.umd.min.js");
            destVendor = fso.BuildPath(dest, "vendor\\chart.umd.min.js");
            if (fso.FileExists(srcVendor) && !fso.FileExists(destVendor)) copyFile(srcVendor, destVendor);
            if (fso.FolderExists(resultsDir())) {
                folder = fso.GetFolder(resultsDir());
                e = new Enumerator(folder.Files);
                for (; !e.atEnd(); e.moveNext()) {
                    f = e.item();
                    name = String(f.Name || "");
                    if (/^(users\.dat|theme\.txt)$/i.test(name)) continue;
                    src = f.Path;
                    dst = fso.BuildPath(dest, "results\\" + name);
                    if (fso.FileExists(dst) && fileMtime(dst) >= fileMtime(src)) continue;
                    text = readUtf8(src);
                    writeUtf8(dst, text, true);
                }
            }
            html = pack.web;
            if (!fso.FileExists(fso.BuildPath(dest, "index.html"))) {
                writeUtf8(fso.BuildPath(dest, "index.html"), html, true);
            }
            try { fsoWriteAll(stampPath, stamp); } catch (eW) {}
            return fso.BuildPath(dest, "index.html");
        }

        function rangeValues(rng) {
            var values = rng.Value;
            var vb, r, c, r0, r1, c0, c1, row, out;
            if (values === undefined || values === null) return [];
            if (typeof values === "string" || typeof values === "number") return [[values]];
            try {
                vb = new VBArray(values);
                r0 = vb.lbound(1); r1 = vb.ubound(1);
                c0 = vb.lbound(2); c1 = vb.ubound(2);
                out = [];
                for (r = r0; r <= r1; r++) {
                    row = [];
                    for (c = c0; c <= c1; c++) row.push(vb.getItem(r, c));
                    out.push(row);
                }
                return out;
            } catch (e) {
                if (values && values.length) return values;
                return [];
            }
        }

        function sheetValues(ws) {
            return rangeValues(ws.UsedRange);
        }

        function listObjectRows(ws, tableName) {
            try {
                var lo = ws.ListObjects(tableName);
                return rowsFromValues(rangeValues(lo.Range));
            } catch (e) {
                return [];
            }
        }

        function rowsFromValues(raw, headerMap) {
            var rows = [];
            var headers = [];
            var r, c, obj, key;
            if (!raw || !raw.length) return rows;
            for (c = 0; c < raw[0].length; c++) headers.push(String(raw[0][c] == null ? "" : raw[0][c]));
            for (r = 1; r < raw.length; r++) {
                obj = {};
                for (c = 0; c < headers.length; c++) {
                    key = headerMap && headerMap[headers[c]] ? headerMap[headers[c]] : headers[c];
                    if (key) obj[key] = raw[r][c] == null ? "" : raw[r][c];
                }
                rows.push(obj);
            }
            return rows;
        }

        function rowsFromSheet(ws, headerMap) {
            return rowsFromValues(sheetValues(ws), headerMap);
        }

        function loadAioExcel(path) {
            var xl = new ActiveXObject("Excel.Application");
            var wb, items = [], mspecs = [], users = [], rts = [], p1 = [];
            xl.Visible = false;
            xl.DisplayAlerts = false;
            try { xl.AskToUpdateLinks = false; } catch (e0) {}
            try {
                wb = xl.Workbooks.Open(path, 0, true);
                items = normalizeItems(listObjectRows(wb.Worksheets("Master Database"), "Table114"));
                if (!items.length) items = normalizeItems(rowsFromSheet(wb.Worksheets("Master Database")));
                mspecs = normalizeMspecs(listObjectRows(wb.Worksheets("Master Sheet"), "Table7"));
                if (!mspecs.length) mspecs = normalizeMspecs(rowsFromSheet(wb.Worksheets("Master Sheet")));
                rts = normalizeRts(listObjectRows(wb.Worksheets("Master Sheet"), "Table86"));
                p1 = normalizeP1(listObjectRows(wb.Worksheets("Master Sheet"), "Table97"));
                users = normalizeUsers(sheetValues(wb.Worksheets("User List")));
                wb.Close(false);
            } finally {
                try { xl.Quit(); } catch (e1) {}
            }
            return { items: items, mspecs: mspecs, users: users, rts: rts, p1: p1 };
        }

        function normalizeItems(rows) {
            var out = [], i, r, item;
            for (i = 0; i < rows.length; i++) {
                r = rows[i];
                item = QD.canonItem(r["Item #"] || r["Item"] || r["Item_"] );
                if (!item) continue;
                out.push({
                    item: item,
                    type: QD.itemType({
                        type: r.Type || r.type,
                        bubbleType: r["Bubble Type"] || r.BubbleType,
                        slits: r["# Slits"] || r["Slits"],
                        shots: r["# Shots"] || r.Shots,
                        soft: r.Soft,
                        parent: r["Parent Material"] || r.Parent,
                        thickness: r.Thickness,
                        length: r.Length,
                        footage: r.Footage,
                        mspec: r.MSPEC
                    }),
                    description: QD.trim(r.Description || r["Item Description"]),
                    length: r.Length,
                    width: r.Width,
                    slits: r["# Slits"] || r["Slits"],
                    footage: r.Footage,
                    perf: r.Perf,
                    bubbleType: r["Bubble Type"] || r.BubbleType,
                    color: r.Color || r.color,
                    barcodeLabel: r["Barcode Label"] || r.BarcodeLabel || r.Barcode,
                    boxLabel: r["Box Label"] || r.BoxLabel,
                    parent: r["Parent Material"] || r.Parent,
                    mspec: QD.canonMspec(r.MSPEC || r["MSPEC #"]),
                    thickness: r.Thickness,
                    density: r.Density,
                    shots: r["# Shots"] || r.Shots,
                    soft: r.Soft
                });
            }
            return QD.mergeItemRows(out);
        }

        function normalizeMspecs(rows) {
            var out = [], i, r, key;
            for (i = 0; i < rows.length; i++) {
                r = rows[i];
                key = QD.canonMspec(r["MSPEC #"] || r.MSPEC);
                if (!key) continue;
                r["MSPEC #"] = key;
                out.push(QD.lookupToDeskRow(r));
            }
            return out;
        }

        function normalizeRts(rows) {
            var out = [], i, r, product;
            for (i = 0; i < (rows || []).length; i++) {
                r = rows[i];
                product = QD.trim(r.Product || r.product || r["Product label"]);
                if (!product || /^product$/i.test(product)) continue;
                out.push({ product: product, min: r.Min, target: r.Target, max: r.Max });
            }
            return out;
        }

        function normalizeP1(rows) {
            var out = [], i, r, thk;
            for (i = 0; i < (rows || []).length; i++) {
                r = rows[i];
                thk = QD.trim(r.Thickness || r.thickness);
                if (!thk || /^thickness$/i.test(thk)) continue;
                out.push({
                    thickness: thk,
                    density: r.Density,
                    min: r.Min,
                    max: r.Max,
                    ccMin: r["CC Min"],
                    ccMax: r["CC Max"],
                    thickMin: r["Thick Min"],
                    thickMax: r["Thick Max"],
                    thickTarget: r["Thick Target"]
                });
            }
            return out;
        }

        function normalizeUsers(values) {
            var out = [], r, v;
            if (!values) return out;
            for (r = 1; r < values.length; r++) {
                v = QD.trim(values[r][0]);
                if (v) out.push(v);
            }
            return out;
        }

        function cachePath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "aio-cache.js");
        }

        function warmLookupDir(create) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = fso.BuildPath(tempDir(), "qd-lookup");
            if (create && !fso.FolderExists(dir)) fso.CreateFolder(dir);
            return dir;
        }

        function warmLookupPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(warmLookupDir(false), "aio.js");
        }

        function warmLookupStampPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(warmLookupDir(false), "stamp.txt");
        }

        function extraLookupPath(name) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), name);
        }

        function lookupWarmStamp() {
            return [
                lookupCsvStamp(),
                aio.path ? fileMtime(aio.path) : 0,
                fileMtime(localSpecsPath()),
                fileMtime(extraLookupPath("local-items.js")),
                fileMtime(extraLookupPath("local-users.js"))
            ].join("|");
        }

        function aioSnapshot() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var mtime = aio.path && fso.FileExists(aio.path) ? String(fso.GetFile(aio.path).DateLastModified) : "";
            return {
                path: aio.path, mtime: mtime, items: aio.items, mspecs: aio.mspecs, users: aio.users,
                bubble: aio.bubble, bubbleDead: aio.bubbleDead, p1: aio.p1, rts: aio.rts
            };
        }

        function applyAioSnapshot(data) {
            if (!data) return false;
            aio.items = data.items || [];
            aio.mspecs = data.mspecs || [];
            aio.users = data.users || [];
            aio.bubble = data.bubble || [];
            aio.bubbleDead = data.bubbleDead || [];
            aio.p1 = data.p1 || [];
            aio.rts = data.rts || [];
            if (data.path) aio.path = data.path;
            aio.loaded = aio.items.length > 0 || aio.mspecs.length > 0 || aio.bubble.length > 0 || aio.p1.length > 0 || aio.rts.length > 0;
            return aio.loaded;
        }

        function clearWarmLookup() {
            var fso, dir, p1, p2;
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                dir = fso.BuildPath(tempDir(), "qd-lookup");
                p1 = fso.BuildPath(dir, "aio.js");
                p2 = fso.BuildPath(dir, "stamp.txt");
                if (fso.FileExists(p1)) fso.DeleteFile(p1, true);
                if (fso.FileExists(p2)) fso.DeleteFile(p2, true);
            } catch (e0) {}
        }

        function saveWarmLookup() {
            var fso, path, stampPath;
            fso = new ActiveXObject("Scripting.FileSystemObject");
            warmLookupDir(true);
            path = warmLookupPath();
            stampPath = warmLookupStampPath();
            writeUtf8(path, JSON.stringify(aioSnapshot()), true);
            try { fsoWriteAll(stampPath, lookupWarmStamp()); } catch (eW) {}
        }

        function loadWarmLookup() {
            var fso, path, stampPath, prev, raw;
            try {
                fso = new ActiveXObject("Scripting.FileSystemObject");
                path = warmLookupPath();
                stampPath = warmLookupStampPath();
                if (!fso.FileExists(path) || !fso.FileExists(stampPath)) return false;
                try { prev = QD.trim(fsoReadAll(stampPath)); } catch (eS) { prev = ""; }
                if (!prev || prev !== lookupWarmStamp()) return false;
                raw = readUtf8(path);
                if (!raw) return false;
                window.QD_AIO = JSON.parse(raw);
                if (!window.QD_AIO || !applyAioSnapshot(window.QD_AIO)) return false;
                aio.warm = true;
                return true;
            } catch (e0) {
                return false;
            }
        }

        function saveAioCache() {
            writeUtf8(cachePath(), "window.QD_AIO=" + JSON.stringify(aioSnapshot()) + ";");
        }

        function lookupCsvStamp() {
            var keys = ["items", "mspecs", "users", "rts", "p1", "bubble"], i, p, m = 0, t;
            if (lookupCsvStamp.cache) return lookupCsvStamp.cache;
            for (i = 0; i < keys.length; i++) {
                p = findCsvFile(QD.CSV_FILES[keys[i]] || []);
                if (!p) continue;
                t = fileMtime(p);
                if (t > m) m = t;
            }
            lookupCsvStamp.cache = m;
            return m;
        }

        function loadAioCache() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = cachePath();
            var csvM, cacheM;
            if (!fso.FileExists(path)) return false;
            cacheM = fileMtime(path);
            csvM = lookupCsvStamp();
            if (csvM && cacheM && csvM > cacheM) return false;
            window.QD_AIO = null;
            eval(readUtf8(path));
            if (!window.QD_AIO || !window.QD_AIO.items || !window.QD_AIO.items.length) return false;
            if (!window.QD_AIO.mspecs || !window.QD_AIO.mspecs.length) return false;
            if (aio.path && window.QD_AIO.mtime) {
                if (fso.FileExists(aio.path) && String(fso.GetFile(aio.path).DateLastModified) !== window.QD_AIO.mtime) return false;
            }
            if (!applyAioSnapshot(window.QD_AIO)) return false;
            aio.warm = false;
            return true;
        }

        function csvPathMap() {
            var fso, folder, dirs, map, d, e, f, name;
            if (csvPathMap.cache) return csvPathMap.cache;
            fso = new ActiveXObject("Scripting.FileSystemObject");
            folder = getAppFolder();
            dirs = [fso.BuildPath(folder, "aio-csv"), folder];
            map = {};
            for (d = 0; d < dirs.length; d++) {
                if (!fso.FolderExists(dirs[d])) continue;
                e = new Enumerator(fso.GetFolder(dirs[d]).Files);
                for (; !e.atEnd(); e.moveNext()) {
                    f = e.item();
                    name = String(f.Name || "").toLowerCase();
                    if (name && !map[name]) map[name] = f.Path;
                }
            }
            csvPathMap.cache = map;
            return map;
        }

        function findCsvFile(names) {
            var map = csvPathMap(), i, n;
            for (i = 0; i < names.length; i++) {
                n = String(names[i] || "").toLowerCase();
                if (n && map[n]) return map[n];
            }
            return "";
        }

        function loadBubbleFile() {
            var path = findCsvFile(QD.CSV_FILES.bubble);
            if (!path) return { specs: [], deadCells: [], source: "" };
            var parsed = QD.parseBubbleSpecs(readUtf8(path));
            parsed.source = path;
            return parsed;
        }

        function loadAioCsv() {
            var itemPath = findCsvFile(QD.CSV_FILES.items);
            var specPath = findCsvFile(QD.CSV_FILES.mspecs);
            var userPath = findCsvFile(QD.CSV_FILES.users);
            var rtsPath = findCsvFile(QD.CSV_FILES.rts);
            var p1Path = findCsvFile(QD.CSV_FILES.p1);
            var bubble = loadBubbleFile();
            if (!itemPath && !specPath && !userPath && !rtsPath && !p1Path && !bubble.source) return null;
            var items = itemPath ? normalizeItems(QD.parseCsv(readUtf8(itemPath)).rows) : [];
            var mspecs = specPath ? normalizeMspecs(QD.parseCsv(readUtf8(specPath)).rows) : [];
            var rts = rtsPath ? QD.parseRtsSpecs(readUtf8(rtsPath)) : [];
            var p1 = p1Path ? QD.parseP1Specs(readUtf8(p1Path)) : [];
            var users = [];
            if (userPath) {
                var parsed = QD.parseCsv(readUtf8(userPath));
                var i, row, name;
                for (i = 0; i < parsed.rows.length; i++) {
                    row = parsed.rows[i];
                    name = QD.trim(row[parsed.headers[0]] || row.User || row.Name);
                    if (name && !/^enter your name/i.test(name)) users.push(name);
                }
            }
            return {
                items: items, mspecs: mspecs, users: users, rts: rts, p1: p1,
                bubble: bubble.specs || [], bubbleDead: bubble.deadCells || [],
                source: itemPath || specPath || rtsPath || p1Path || bubble.source || userPath
            };
        }

        function loadLocalExtras() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var extraItems = [], extraUsers = [];
            var ip = fso.BuildPath(resultsDir(), "local-items.js");
            var up = fso.BuildPath(resultsDir(), "local-users.js");
            window.QD_LOCAL = { items: [], users: [] };
            if (fso.FileExists(ip)) { try { eval(readUtf8(ip)); } catch (e1) {} }
            if (fso.FileExists(up)) { try { eval(readUtf8(up)); } catch (e2) {} }
            extraItems = (window.QD_LOCAL && window.QD_LOCAL.items) || [];
            extraUsers = (window.QD_LOCAL && window.QD_LOCAL.users) || [];
            aio.items = QD.mergeItems(aio.items, extraItems);
            aio.users = QD.mergeUsers(aio.users, extraUsers);
        }

        function saveLocalItems() {
            writeUtf8((new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "local-items.js"),
                "window.QD_LOCAL=window.QD_LOCAL||{items:[],users:[]};QD_LOCAL.items=" + JSON.stringify(localItemsOnly()) + ";");
        }

        function saveLocalUsers() {
            writeUtf8((new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "local-users.js"),
                "window.QD_LOCAL=window.QD_LOCAL||{items:[],users:[]};QD_LOCAL.users=" + JSON.stringify(aio.localUsers || []) + ";");
        }

        function localItemsOnly() {
            var out = [], i;
            for (i = 0; i < aio.items.length; i++) if (aio.items[i].local) out.push(aio.items[i]);
            return out;
        }

        function applySpecBundle(data) {
            aio.bubble = (data && data.bubble) || aio.bubble || [];
            aio.bubbleDead = (data && data.bubbleDead) || aio.bubbleDead || [];
            aio.p1 = (data && data.p1) || aio.p1 || [];
            aio.rts = (data && data.rts) || aio.rts || [];
        }

        function seedSpecVersions(skipWrite) {
            var lists = [aio.mspecs, aio.bubble, aio.p1, aio.rts], i, j, changed = false;
            for (i = 0; i < lists.length; i++) {
                for (j = 0; j < (lists[i] || []).length; j++) {
                    if (!QD.trim(lists[i][j].version)) {
                        QD.ensureSpecVersion(lists[i][j]);
                        changed = true;
                    }
                }
            }
            if (changed && !skipWrite) {
                try { saveLocalSpecs(); } catch (eSeed) {}
            }
        }

        function afterAioLoad(source, skipWrite, quiet) {
            if (!quiet) setWork("Merging local extras…", 55);
            if (!aio.warm) {
                profRun("aio.loadLocalExtras", function () { loadLocalExtras(); });
                profRun("aio.applyLocalSpecs", function () { applyLocalSpecs(); });
                profRun("aio.seedSpecVersions", function () { seedSpecVersions(!!quiet); });
            } else {
                profAdd("aio.warmSkipExtras", 0);
            }
            profRun("aio.loadSpecHistory", function () { loadSpecHistory(); });
            aio.loaded = aio.items.length > 0 || aio.mspecs.length > 0 || aio.bubble.length > 0 || aio.p1.length > 0 || aio.rts.length > 0;
            profRun("aio.rebuildItemIndex", function () { rebuildItemIndex(); });
            if (!aio.warm) {
                try { profRun("aio.saveWarmLookup", function () { saveWarmLookup(); }); } catch (eW) {}
            }
            if (!skipWrite) {
                if (!quiet) setWork("Writing lookup files…", 75);
                profRun("aio.writeLookupFile", function () { writeLookupFile(); });
                profRun("aio.ensureLineFiles", function () { ensureLineFiles(); });
                try { profRun("aio.publishSapCsv", function () { publishSapCsv(); }); } catch (eSap) { dbg("SAP.csv: " + eSap.message, false); }
                profRun("aio.writeManifest", function () { writeManifest(); });
            } else {
                profRun("aio.ensureLineFiles", function () { ensureLineFiles(); });
            }
            profRun("aio.exposeResultsJs", function () { exposeResultsJs(); });
            if (!quiet) {
                fillUsers();
                renderCurrentTab();
                setWork("Ready", 100);
                setStatus(source);
            }
            dbg(source);
        }

        function loadAio(force, quiet) {
            aio.path = findAio();
            aio.items = []; aio.mspecs = []; aio.users = []; aio.bubble = []; aio.bubbleDead = []; aio.p1 = []; aio.rts = []; aio.loaded = false;
            aio.warm = false;
            if (force) {
                try {
                    var fso = new ActiveXObject("Scripting.FileSystemObject");
                    if (fso.FileExists(cachePath())) fso.DeleteFile(cachePath(), true);
                } catch (e0) {}
                clearWarmLookup();
            }
            if (!force && profRun("aio.loadWarmLookup", function () { return loadWarmLookup(); })) {
                afterAioLoad("Loaded specs from memory cache (" + aio.items.length + " items, " + aio.mspecs.length + " MSPECs).\n" + (aio.path || ""), true, quiet);
                return true;
            }
            if (!force && profRun("aio.loadAioCache", function () { return loadAioCache(); })) {
                afterAioLoad("Loaded specs from cache (" + aio.items.length + " items, " + aio.mspecs.length + " MSPECs).\n" + (aio.path || ""), true, quiet);
                return true;
            }
            var csv = profRun("aio.loadAioCsv", function () { return loadAioCsv(); });
            if (csv && (csv.items.length || csv.mspecs.length || csv.users.length || csv.bubble.length || csv.p1.length || csv.rts.length)) {
                aio.items = csv.items;
                aio.mspecs = csv.mspecs;
                aio.users = csv.users;
                applySpecBundle(csv);
                afterAioLoad("Loaded lookup CSVs (" + aio.items.length + " items, " + aio.mspecs.length + " foam, " + aio.bubble.length + " bubble, " + aio.p1.length + " P1, " + aio.rts.length + " RTS).\n" + csv.source, true, quiet);
                return true;
            }
            if (!aio.path) {
                var bubbleOnly = loadBubbleFile();
                if (bubbleOnly.source) {
                    aio.bubble = bubbleOnly.specs;
                    aio.bubbleDead = bubbleOnly.deadCells;
                    afterAioLoad("Loaded BubbleSpecs.csv only. Export AIO tables for foam/P1/RTS items.\n" + bubbleOnly.source, true, quiet);
                    return true;
                }
                setStatus("No lookup data. Put Quality AIO.xlsm next to this HTA, or run ExportAioCsv to create aio-csv\\MasterDatabase.csv.\n" + getAppFolder(), true);
                renderLists();
                return false;
            }
            setStatus("Reading Quality AIO.xlsm…");
            try {
                var data = loadAioExcel(aio.path);
                aio.items = data.items;
                aio.mspecs = data.mspecs;
                aio.users = data.users;
                applySpecBundle(data);
                var extra = loadBubbleFile();
                if (extra.source) {
                    aio.bubble = extra.specs;
                    aio.bubbleDead = extra.deadCells;
                }
                afterAioLoad("Loaded Quality AIO (" + aio.items.length + " items, " + aio.mspecs.length + " foam MSPECs).\n" + aio.path, true, quiet);
                if (!aio.items.length) setStatus("Opened Quality AIO.xlsm but read 0 items. Run ExportAioCsv in the workbook and keep aio-csv next to the HTA.", true);
                return aio.items.length > 0;
            } catch (e) {
                setStatus("Could not read Quality AIO.xlsm. Excel must be installed, or export CSVs with ExportAioCsv.\n" + e.message, true);
                return false;
            }
        }

        function writeLookupFile() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = fso.BuildPath(resultsDir(), "lookup.js");
            writeUtf8(path, QD.diskScript("lookup", {
                lookupRows: aio.mspecs,
                users: aio.users
            }));
            unhidePath(path);
            writeManifest();
        }

        function ensureLineFiles() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var i, key, path;
            for (i = 0; i < QD.LINE_FILES.length; i++) {
                key = QD.LINE_FILES[i];
                path = fso.BuildPath(resultsDir(), key + ".js");
                if (!fso.FileExists(path)) writeLineRows(key, []);
            }
        }

        function readLineRows(fileKey, force) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = fso.BuildPath(resultsDir(), fileKey + ".js");
            var mtime = fileMtime(path);
            var cached = lineCache[fileKey];
            if (!force && cached && cached.mtime === mtime) return cached.rows;
            window.QD_DISK = { lines: {}, lookupRows: [], users: [] };
            if (!fso.FileExists(path)) {
                lineCache[fileKey] = { mtime: 0, rows: [] };
                return [];
            }
            var text = readUtf8(path);
            try { eval(text); } catch (e) {
                var recovered = QD.parseDiskJson(text, fileKey);
                if (recovered) {
                    window.QD_DISK.lines[fileKey] = recovered;
                    dbg("results/" + fileKey + ".js recovered after eval: " + e.message);
                } else {
                    dbg("results/" + fileKey + ".js eval: " + e.message, false);
                    lineCache[fileKey] = { mtime: mtime, rows: [] };
                    return [];
                }
            }
            var rows = (window.QD_DISK.lines[fileKey] && window.QD_DISK.lines[fileKey].rows) || [];
            lineCache[fileKey] = { mtime: mtime, rows: rows };
            return rows;
        }

        function writeLineRows(fileKey, rows) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = fso.BuildPath(resultsDir(), fileKey + ".js");
            writeUtf8(path, QD.diskScript(fileKey, {
                file: fileKey,
                rows: rows || []
            }));
            unhidePath(path);
            lineCache[fileKey] = { mtime: fileMtime(path), rows: rows || [] };
            noteLastRow(fileKey, rows || []);
            try { saveLastChecks(); } catch (eLc) {}
            writeManifest();
            if (fileKey === "gcoex") {
                try { backupGarlandCoex(rows || []); } catch (eBk) { dbg("garland backup: " + eBk.message, false); }
            }
        }

        function backupGarlandCoex(rows) {
            var folder = QD.GARLAND_BACKUP_DIR;
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path, prev = "", merged;
            if (!fso.FolderExists(folder)) return false;
            path = fso.BuildPath(folder, QD.GARLAND_BACKUP_FILE);
            if (fso.FileExists(path)) {
                try { prev = readUtf8(path); } catch (eR) { prev = ""; }
                if (QD.isSealed(prev)) prev = QD.unseal(prev);
            }
            merged = QD.garlandBackupMerge(prev, rows);
            if (!merged || !merged.added) return false;
            writeUtf8(path, merged.csv);
            dbg("Garland COEX backup +" + merged.added + " to OneDrive");
            return true;
        }

        function legacyRowKey(r) {
            return [r["Date/Time"] || "", r.Line || "", r["Item #"] || "", r["Pass/Fail"] || "", r["Reason for Check"] || ""].join("|");
        }

        function fillMissingLegacyFields(prev, incoming) {
            var key, i;
            if (!prev || !incoming) return false;
            var changed = false;
            for (key in incoming) {
                if (!incoming.hasOwnProperty(key) || key.charAt(0) === '_') continue;
                if (QD.trim(prev[key]) === "" && QD.trim(incoming[key]) !== "") {
                    prev[key] = incoming[key];
                    changed = true;
                }
            }
            for (i = 1; i <= 13; i++) {
                key = "T" + i;
                if (QD.trim(prev[key]) === "" && QD.trim(incoming[key]) !== "") {
                    prev[key] = incoming[key];
                    changed = true;
                }
            }
            return changed;
        }

        function importLegacyWrite(pack, path, keys, idx, added, total, done) {
            var key, incoming, existing, seen, i, r, k, map, changed;
            if (idx >= keys.length) {
                setWork("Updating lookup…", 96);
                try { writeLookupFile(); } catch (eL) {}
                hideWork();
                lastHomeHtml = "";
                try { renderHome(); } catch (eH) {}
                if (currentTab === "history") try { renderAdminHistory(); } catch (eHist) {}
                audit("legacy-import", added + " new of " + total + " from " + path);
                setStatus("Imported " + added + " new check" + (added === 1 ? "" : "s") + " (" + total + " in file). Existing rows missing T1–T13 were filled in.");
                if (done) done();
                return;
            }
            key = keys[idx];
            incoming = pack[key] || [];
            setWork("Writing " + key + " (" + incoming.length + " rows)…", 30 + Math.round((idx / keys.length) * 60));
            window.setTimeout(function () {
                if (incoming.length) {
                    existing = readLineRows(key).slice();
                    seen = {};
                    map = {};
                    for (i = 0; i < existing.length; i++) {
                        k = legacyRowKey(existing[i]);
                        seen[k] = true;
                        map[k] = existing[i];
                    }
                    for (i = 0; i < incoming.length; i++) {
                        r = incoming[i];
                        k = legacyRowKey(r);
                        total += 1;
                        if (seen[k]) {
                            fillMissingLegacyFields(map[k], r);
                            continue;
                        }
                        seen[k] = true;
                        existing.push(r);
                        added += 1;
                    }
                    writeLineRows(key, existing);
                }
                importLegacyWrite(pack, path, keys, idx + 1, added, total, done);
            }, 20);
        }

        function fillUsers() {
            var sel = $("user");
            if (!sel) return;
            if (sel.tagName !== "SELECT") {
                sel.value = session.user || "";
                return;
            }
            sel.options.length = 0;
            if (session.user) {
                sel.options.add(new Option(session.user, session.user));
                sel.value = session.user;
                sel.disabled = true;
            } else {
                sel.options.add(new Option("", ""));
                sel.disabled = false;
            }
        }

        function esc(s) {
            return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
        }

        function sessionUser() {
            return session.rec || QD.findUserRecord(authUsers, session.user);
        }

        function docsPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "docs.js");
        }

        function inboxPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "inbox.js");
        }

        function auditPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "audit.js");
        }

        function loadInbox() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = inboxPath();
            window.QD_INBOX = { requests: [] };
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (e) {}
            }
            inboxStore = window.QD_INBOX || { requests: [] };
            if (!inboxStore.requests) inboxStore.requests = [];
        }

        function saveInbox() {
            writeUtf8(inboxPath(), "window.QD_INBOX=" + JSON.stringify(inboxStore) + ";");
        }

        function loadAudit() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = auditPath();
            window.QD_AUDIT = [];
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (e) {}
            }
            auditLog = window.QD_AUDIT || [];
        }

        function saveAudit() {
            writeUtf8(auditPath(), "window.QD_AUDIT=" + JSON.stringify(auditLog) + ";");
        }

        function auditAs(user, action, detail) {
            try {
                loadAudit();
                auditLog.push(QD.auditEntry(action, user, detail));
                if (auditLog.length > 2500) auditLog = auditLog.slice(auditLog.length - 2500);
                saveAudit();
            } catch (eAud) {}
        }

        function audit(action, detail) {
            auditAs(session.user || "", action, detail || "");
        }

        function loadDocs(force) {
            if (docsLoaded && !force) return;
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = docsPath();
            window.QD_DOCS = { docs: [], acks: [] };
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (e) {}
            }
            docsStore = window.QD_DOCS || { docs: [], acks: [] };
            if (!docsStore.docs) docsStore.docs = [];
            if (!docsStore.acks) docsStore.acks = [];
            docsLoaded = true;
        }

        function saveDocs() {
            writeUtf8(docsPath(), "window.QD_DOCS=" + JSON.stringify(docsStore) + ";");
            docsLoaded = true;
        }

        function assignedLineIds() {
            var out = [], list = QD.linesForSite(currentSite), i;
            for (i = 0; i < list.length; i++) {
                if (QD.userCanSeeLine(sessionUser(), list[i].id, currentSite)) out.push(list[i].id);
            }
            return out;
        }

        function pendingForUser() {
            loadDocs();
            /* Use line ids only — Garland COEX (G-COEX) must not match Visalia COEX docs via the shared "COEX" label. */
            return QD.pendingDocs(docsStore.docs, docsStore.acks, session.user, assignedLineIds());
        }

        function docsLocked() {
            return !!(session.user && pendingForUser().length);
        }

        function updateNav() {
            var lock = docsLocked();
            var admin = isAdmin();
            if ($("homeTabBtn")) $("homeTabBtn").style.display = lock ? "none" : "";
            if ($("usersTabBtn")) $("usersTabBtn").style.display = (!lock && admin) ? "" : "none";
            if ($("mspecsTabBtn")) $("mspecsTabBtn").style.display = lock ? "none" : "";
            if ($("itemsTabBtn")) $("itemsTabBtn").style.display = lock ? "none" : "";
            if ($("auditTabBtn")) $("auditTabBtn").style.display = (!lock && admin) ? "" : "none";
            if ($("histTabBtn")) $("histTabBtn").style.display = (!lock && session.user) ? "" : "none";
            if ($("profilesTabBtn")) $("profilesTabBtn").style.display = lock ? "none" : "";
            if ($("docsTabBtn")) $("docsTabBtn").style.display = "";
            if ($("plantToggle")) $("plantToggle").style.display = lock ? "none" : "";
            syncInboxBadge();
        }

        function lastCheckPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "last-check.js");
        }

        function slimLastCheck(row) {
            if (!row) return null;
            return {
                "Date/Time": row["Date/Time"],
                "Reason for Check": row["Reason for Check"],
                "No Check Reason": row["No Check Reason"],
                "Pass/Fail": row["Pass/Fail"],
                Notes: row.Notes,
                "Item #": row["Item #"] || row.Item,
                Line: row.Line,
                User: row.User
            };
        }

        function loadLastChecks() {
            if (lastChecksLoaded) return;
            lastChecksLoaded = true;
            window.QD_LAST_CHECK = null;
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (fso.FileExists(lastCheckPath())) eval(readUtf8(lastCheckPath()));
            } catch (eL) {}
            lastCheckByFile = window.QD_LAST_CHECK || lastCheckByFile || {};
        }

        function saveLastChecks() {
            loadLastChecks();
            writeUtf8(lastCheckPath(), "window.QD_LAST_CHECK=" + JSON.stringify(lastCheckByFile || {}) + ";");
        }

        function noteLastRow(fileKey, rows) {
            if (!fileKey) return;
            loadLastChecks();
            if (rows && rows.length) lastCheckByFile[fileKey] = slimLastCheck(rows[rows.length - 1]);
            else delete lastCheckByFile[fileKey];
        }

        function lastRowFor(lineId) {
            var info = QD.lineInfo(lineId, currentSite);
            if (!info) return null;
            loadLastChecks();
            return lastCheckByFile[info.file] || null;
        }

        function fillLastChecksLazy() {
            var keys = QD.LINE_FILES.slice(), i = 0, changed = false;
            loadLastChecks();
            function next() {
                var key, rows;
                if (i >= keys.length) {
                    if (changed) {
                        try { saveLastChecks(); } catch (eS) {}
                        lastHomeHtml = "";
                        if (currentTab === "checks" && currentScreen === "home") renderHome();
                    }
                    return;
                }
                key = keys[i];
                i += 1;
                if (lastCheckByFile[key]) {
                    window.setTimeout(next, 0);
                    return;
                }
                try {
                    rows = readLineRows(key);
                    if (rows && rows.length) {
                        noteLastRow(key, rows);
                        changed = true;
                        lastHomeHtml = "";
                        if (currentTab === "checks" && currentScreen === "home") renderHome();
                    }
                } catch (eR) {}
                window.setTimeout(next, 0);
            }
            window.setTimeout(next, 0);
        }

        function ensureCurrentLineForSite() {
            var info = QD.lineInfo(currentLine, currentSite);
            var list, i;
            if (info) {
                currentLine = info.id;
                return;
            }
            list = QD.linesForSite(currentSite) || [];
            for (i = 0; i < list.length; i++) {
                if (QD.userCanSeeLine(sessionUser(), list[i].id, currentSite)) {
                    currentLine = list[i].id;
                    return;
                }
            }
            currentLine = list.length ? list[0].id : (currentSite === "GARLAND" ? "G-COEX" : "COEX");
        }

        function setSite(site, force) {
            var sit = String(site || 'VISALIA').toUpperCase();
            if (!QD.userCanSeeSite(sessionUser(), sit) && !force) return;
            if (!force && !confirmLeaveCheck()) return;
            currentSite = sit;
            ensureCurrentLineForSite();
            if ($("plantSwitchBtn")) {
                $("plantSwitchBtn").style.display = (QD.userCanSeeSite(sessionUser(), "VISALIA") && QD.userCanSeeSite(sessionUser(), "GARLAND")) ? "" : "none";
            }
            if (sit === "GARLAND") specTab = "bubble";
            renderCrumbs();
            lastHomeHtml = "";
            if (currentTab === "checks") renderHome();
            else renderCurrentTab();
        }

        function renderCrumbs() {
            var el = $("crumbs");
            if (!el) return;
            var label = QD.lineLabel(currentLine, currentSite);
            var html = "<a onclick=\"goHome()\">Home</a>";
            if (currentScreen !== "home" && currentScreen !== "docs" && currentScreen !== "plant") {
                html += " / <a onclick=\"goReason()\">Quality Check " + esc(label) + "</a>";
            }
            el.innerHTML = html;
        }

        function checkDirty() {
            if (currentTab !== "checks") return false;
            return currentScreen === "checkform" || currentScreen === "itempick" || currentScreen === "startup"
                || currentScreen === "nocheck" || currentScreen === "lineup" || currentScreen === "rtsStartup";
        }

        function confirmLeaveCheck() {
            if (skipLeaveGuard) return true;
            if (!checkDirty()) return true;
            if (!confirm("Leave this quality check? Unsaved entries will be lost.")) return false;
            clearCheckForm();
            checkReason = "";
            startupAnswers = {};
            checkEnteredAt = 0;
            return true;
        }

        function leaveGuarded(fn) {
            skipLeaveGuard = true;
            try { fn(); } finally { skipLeaveGuard = false; }
        }

        function showScreen(id) {
            currentScreen = id;
            var map = { home: "screenHome", docs: "screenDocs", plant: "screenPlant", reason: "screenReason", nocheck: "screenNoCheck", lineup: "screenLineUp", itempick: "screenItem", startup: "screenStartup", rtsStartup: "screenRtsStartup", checkform: "screenCheck" };
            var key, el;
            for (key in map) {
                if (!map.hasOwnProperty(key)) continue;
                el = $(map[key]);
                if (el) el.className = "screen" + (key === id ? " on" : "");
            }
            if ($("submitBar")) $("submitBar").className = "submit-bar" + (id === "nocheck" || id === "lineup" || id === "checkform" ? " on" : "");
            if (id === "checkform" || id === "itempick" || id === "startup" || id === "nocheck" || id === "lineup" || id === "rtsStartup") {
                if (!checkEnteredAt) checkEnteredAt = new Date().getTime();
            } else {
                checkEnteredAt = 0;
            }
            renderCrumbs();
            syncSubmitBtn();
        }

        function goHome() {
            if (!confirmLeaveCheck()) return;
            if (pendingForUser().length) { leaveGuarded(function () { goDocs(true); }); return; }
            leaveGuarded(function () {
                showTab("checks");
                showScreen("home");
                renderHome();
            });
        }

        function goPlantPick() {
            if (!confirmLeaveCheck()) return;
            leaveGuarded(function () {
                showTab("checks");
                showScreen("plant");
            });
        }

        function pickPlant(site) {
            leaveGuarded(function () {
                setSite(site);
                goHome();
            });
        }

        function goDocs(blocking) {
            if (docsLocked() || blocking) {
                showTab("docs");
                renderDocsTab(true);
                return;
            }
            showTab("docs");
            renderDocsTab(false);
        }

        function goReason() {
            if (pendingForUser().length) { goDocs(true); return; }
            showTab("checks");
            var last = lastRowFor(currentLine);
            if ($("rtsStartupBtnWrap")) $("rtsStartupBtnWrap").style.display = (currentLine === "RTS") ? "" : "none";
            if (QD.needsLineUp(last)) {
                checkReason = "LINE UP";
                if ($("reason")) $("reason").value = "LINE UP";
                showScreen("lineup");
                return;
            }
            checkReason = "";
            showScreen("reason");
        }

        function pickReason(reason) {
            checkReason = reason;
            if ($("reason")) $("reason").value = reason;
            if (reason === "NO CHECK") {
                noCheckReason = "";
                if ($("noCheckReason")) $("noCheckReason").selectedIndex = 0;
                showScreen("nocheck");
                return;
            }
            showScreen("itempick");
            if ($("item")) { $("item").value = ""; $("item").focus(); }
            $("hits").style.display = "none";
        }

        function confirmItem() {
            var it = selectedItem();
            if (!it) { setStatus("Enter an item # for this line.", true); return; }
            if (!QD.itemAllowedOnLine(it, currentLine, currentSite)) {
                setStatus("That item is not for " + QD.lineLabel(currentLine, currentSite) + ".", true);
                return;
            }
            var last = lastRowFor(currentLine);
            if (QD.needsStartup(last, it.item, new Date(), session.user)) {
                startupAnswers = {};
                renderStartup();
                showScreen("startup");
                return;
            }
            proceedToCheckForm();
        }

        function renderStartup() {
            var it = selectedItem();
            var includePerf = startupIncludePerf();
            var includeCoex = startupIncludeCoexSpeeds();
            var html = "<h2>Changeover checklist</h2><p class='muted'>Required when the item number changes or a different operator starts checks on the same item.</p>", i, row;
            for (i = 0; i < QD.STARTUP_ITEMS.length; i++) {
                row = QD.STARTUP_ITEMS[i];
                html += "<label class='f'>" + esc(row.text);
                html += " <select id='su_" + row.id + "' onchange='startupChanged()'><option value=''></option><option value='YES'>Yes</option><option value='NO'>No</option></select></label>";
            }
            if (includePerf) {
                row = QD.STARTUP_PERF_ITEM;
                html += "<label class='f'>" + esc(row.text);
                html += " <select id='su_" + row.id + "' onchange='startupChanged()'><option value=''></option><option value='PASS'>Pass</option><option value='FAIL'>Fail</option></select></label>";
            }
            if (includeCoex) {
                html += "<h3>COEX speeds for new bubble type</h3><p class='muted'>Enter line speed and Extruder A/B/C speeds for " + esc(it && it.bubbleType ? it.bubbleType : "this bubble") + ".</p>";
                html += "<label class='f'>Line speed <input id='su_lineSpeed' onkeyup='startupChanged()'></label>";
                html += "<table class='coex-grid'><thead><tr><th></th><th>Extruder A</th><th>Extruder B</th><th>Extruder C</th></tr></thead><tbody>";
                html += "<tr><td class='lbl'>Extruder Speed</td>";
                html += "<td><input id='su_A_speed' onkeyup='startupChanged()'></td>";
                html += "<td><input id='su_B_speed' onkeyup='startupChanged()'></td>";
                html += "<td><input id='su_C_speed' onkeyup='startupChanged()'></td></tr>";
                html += "<tr><td class='lbl'>Melt Pump 1 speed</td>";
                html += "<td><input id='su_A_meltPump1' onkeyup='startupChanged()'></td>";
                html += "<td><input id='su_B_meltPump1' onkeyup='startupChanged()'></td>";
                html += "<td><input id='su_C_meltPump1' onkeyup='startupChanged()'></td></tr>";
                html += "<tr><td class='lbl'>Melt Pump 2 speed</td>";
                html += "<td><input id='su_A_meltPump2' onkeyup='startupChanged()'></td>";
                html += "<td><input id='su_B_meltPump2' onkeyup='startupChanged()'></td>";
                html += "<td><input id='su_C_meltPump2' onkeyup='startupChanged()'></td></tr>";
                html += "</tbody></table>";
            }
            html += "<button type='button' class='ok' id='startupNext' disabled onclick='finishStartup()'>Continue to check</button>";
            $("startupBox").innerHTML = html;
            startupChanged();
        }

        function startupIncludePerf() {
            var it = selectedItem();
            if ((currentLine === "S1" || currentLine === "S3") && QD.itemHasPerf(it)) return true;
            return QD.bubbleStartupIncludePerf(currentLine, it);
        }

        function startupIncludeCoexSpeeds() {
            var last = lastRowFor(currentLine);
            return QD.needsCoexSpeeds(currentLine, last, selectedItem(), aio.items);
        }

        function startupChanged() {
            var i, row, el;
            for (i = 0; i < QD.STARTUP_ITEMS.length; i++) {
                row = QD.STARTUP_ITEMS[i];
                el = $("su_" + row.id);
                startupAnswers[row.id] = el ? el.value : "";
            }
            if (startupIncludePerf()) {
                el = $("su_" + QD.STARTUP_PERF_ITEM.id);
                startupAnswers[QD.STARTUP_PERF_ITEM.id] = el ? el.value : "";
            }
            if (startupIncludeCoexSpeeds()) {
                for (i = 0; i < QD.COEX_CHANGEOVER_FIELDS.length; i++) {
                    row = QD.COEX_CHANGEOVER_FIELDS[i];
                    el = $("su_" + row.id);
                    startupAnswers[row.id] = el ? el.value : "";
                }
            }
            if ($("startupNext")) $("startupNext").disabled = !QD.startupComplete(startupAnswers, startupIncludePerf(), startupIncludeCoexSpeeds());
        }

        function finishStartup() {
            if (!QD.startupComplete(startupAnswers, startupIncludePerf(), startupIncludeCoexSpeeds())) { setStatus("Answer every changeover question.", true); return; }
            proceedToCheckForm();
        }

        function proceedToCheckForm() {
            loadDocs();
            var it = selectedItem();
            conCardQueue = QD.pendingConCardsForCheck(docsStore.docs, docsStore.acks, session.user, currentLine, it ? it.item : val("item"));
            conCardIndex = 0;
            openedConCards = {};
            conCardCountdown = 0;
            if (conCardTimer) { window.clearInterval(conCardTimer); conCardTimer = null; }
            if (conCardQueue.length) {
                showConCardOverlay();
                return;
            }
            enterCheckForm();
        }

        function showConCardOverlay() {
            var d = conCardQueue[conCardIndex];
            var html = "<p class='muted'>Review this Construction Card before continuing the quality check.</p>";
            if (d) {
                html += "<div class='doc-ack'><b>" + esc(d.name) + "</b> · v" + esc(d.version);
                html += "<div><button type='button' class='secondary' onclick=\"openConCardThenPrompt('" + String(d.id).replace(/'/g, "") + "')\">Open document</button>";
                html += openedConCards[d.id] ? " <span class='muted'>Opened — confirm below</span>" : " <span class='muted'>Open first</span>";
                html += "</div></div>";
            }
            if ($("conCardBody")) $("conCardBody").innerHTML = html;
            if ($("conCardOverlay")) $("conCardOverlay").className = "overlay on";
            var btn = $("conCardAckBtn");
            if (btn) {
                if (d && openedConCards[d.id] && conCardCountdown > 0) {
                    btn.disabled = true;
                    btn.innerText = "Confirm (" + conCardCountdown + "s)";
                } else if (d && openedConCards[d.id]) {
                    btn.disabled = false;
                    btn.innerText = "I have read this";
                } else {
                    btn.disabled = true;
                    btn.innerText = "I have read this";
                }
            }
        }

        function startConCardCountdown() {
            if (conCardTimer) window.clearInterval(conCardTimer);
            conCardCountdown = 10;
            conCardTimer = window.setInterval(function () {
                conCardCountdown -= 1;
                if (conCardCountdown <= 0) {
                    conCardCountdown = 0;
                    window.clearInterval(conCardTimer);
                    conCardTimer = null;
                }
                showConCardOverlay();
            }, 1000);
            showConCardOverlay();
        }

        function openConCardThenPrompt(id) {
            var d = findDoc(id);
            if (!d) return;
            openDocLink(d.url);
            openedConCards[id] = true;
            startConCardCountdown();
        }

        function ackConCard() {
            var d = conCardQueue[conCardIndex];
            if (!d) { enterCheckForm(); return; }
            if (!openedConCards[d.id]) { alert("Open the Construction Card first."); return; }
            if (conCardCountdown > 0) return;
            if (!confirm("Did you read this Construction Card?")) return;
            docsStore.acks.push({ docId: d.id, version: d.version, user: session.user, at: (new Date()).toISOString() });
            saveDocs();
            audit("concard-ack", d.name + " v" + d.version);
            conCardIndex += 1;
            if (conCardIndex < conCardQueue.length) showConCardOverlay();
            else {
                if ($("conCardOverlay")) $("conCardOverlay").className = "overlay";
                enterCheckForm();
            }
        }

        function openRtsStartup() {
            rtsStartupAnswers = {};
            renderRtsStartup();
            showScreen("rtsStartup");
        }

        function renderRtsStartup() {
            var html = "<h2>RTS Startup Checklist</h2><p class='muted'>Complete every station action. Submit sends to supervisor/lead inbox.</p>";
            html += "<table class='list'><tr><th>Action</th><th>St 0</th><th>St 1</th><th>St 2</th><th>St 3</th><th>Printhead</th></tr>";
            var i, j, act, st, sid;
            for (i = 0; i < QD.RTS_STARTUP_ACTIONS.length; i++) {
                act = QD.RTS_STARTUP_ACTIONS[i];
                html += "<tr><td>" + esc(act.text) + "</td>";
                if (act.stations) {
                    for (j = 0; j < QD.RTS_STARTUP_STATIONS.length; j++) {
                        st = QD.RTS_STARTUP_STATIONS[j];
                        sid = act.id + "_s" + st;
                        html += "<td><select id='rsu_" + sid + "' onchange='rtsStartupChanged()'><option value=''></option><option value='PASS'>Pass</option><option value='FAIL'>Fail</option></select></td>";
                    }
                    html += "<td></td>";
                } else {
                    html += "<td colspan='4'></td><td><select id='rsu_" + act.id + "' onchange='rtsStartupChanged()'><option value=''></option><option value='PASS'>Pass</option><option value='FAIL'>Fail</option></select></td>";
                }
                html += "</tr>";
            }
            html += "</table>";
            html += "<button type='button' class='ok' id='rtsStartupSubmit' disabled onclick='submitRtsStartup()'>Submit to inbox</button>";
            html += "<button type='button' class='secondary' onclick='goReason()'>Back</button>";
            if ($("rtsStartupBox")) $("rtsStartupBox").innerHTML = html;
            rtsStartupChanged();
        }

        function rtsStartupChanged() {
            var i, j, act, st, el, sid;
            for (i = 0; i < QD.RTS_STARTUP_ACTIONS.length; i++) {
                act = QD.RTS_STARTUP_ACTIONS[i];
                if (act.stations) {
                    for (j = 0; j < QD.RTS_STARTUP_STATIONS.length; j++) {
                        st = QD.RTS_STARTUP_STATIONS[j];
                        sid = act.id + "_s" + st;
                        el = $("rsu_" + sid);
                        rtsStartupAnswers[sid] = el ? el.value : "";
                    }
                } else {
                    el = $("rsu_" + act.id);
                    rtsStartupAnswers[act.id] = el ? el.value : "";
                }
            }
            if ($("rtsStartupSubmit")) $("rtsStartupSubmit").disabled = !QD.rtsStartupComplete(rtsStartupAnswers);
        }

        function submitRtsStartup() {
            if (!QD.rtsStartupComplete(rtsStartupAnswers)) { setStatus("Complete every RTS startup action.", true); return; }
            loadInbox();
            var req = QD.makeInboxRequest("rtsStartup", session.user, {
                plant: currentSite, line: "RTS", detail: "RTS startup checklist"
            });
            req.answers = rtsStartupAnswers;
            inboxStore.requests.push(req);
            saveInbox();
            audit("rts-startup-submit", "RTS " + currentSite);
            setStatus("RTS startup checklist submitted to inbox.");
            goReason();
        }

        function enterCheckForm() {
            setLine(currentLine);
            if ($("mspecWrap")) $("mspecWrap").style.display = "none";
            if ($("desc")) $("desc").style.display = "none";
            onItemChange();
            appendCheckLinks();
            showScreen("checkform");
        }

        function renderHome() {
            var box = $("homeLines");
            if (!box) return;
            var list = QD.linesForSite(currentSite) || [];
            var groups = QD.HOME_GROUPS || [];
            var html = "", g, i, info, last, tone, section, shown;
            for (g = 0; g < groups.length; g++) {
                section = "";
                shown = 0;
                for (i = 0; i < list.length; i++) {
                    info = list[i];
                    if ((info.homeGroup || "") !== groups[g].id) continue;
                    if (!QD.userCanSeeLine(sessionUser(), info.id, currentSite)) continue;
                    last = lastRowFor(info.id);
                    tone = QD.homeStatusTone(last);
                    section += "<div class='home-line tone-" + tone + "' onclick=\"openLine('" + info.id + "')\"><h3>" + esc(info.label) + "</h3><p>" + esc(QD.lastCheckLabel(last)) + "</p></div>";
                    shown += 1;
                }
                if (shown) html += "<div class='home-section'><h3>" + esc(groups[g].title) + "</h3>" + section + "</div>";
            }
            if (!html) html = "<p class='muted'>No lines assigned to you at this plant.</p>";
            if (html === lastHomeHtml) return;
            lastHomeHtml = html;
            box.innerHTML = html;
            renderCrumbs();
        }

        function openLine(id) {
            if (!confirmLeaveCheck()) return;
            currentLine = id;
            setLine(id);
            goReason();
        }

        function startHomePoll() {
            if (homeTimer) window.clearInterval(homeTimer);
            homeTimer = null;
        }

        function openDocLink(url) {
            if (!url) return;
            try { (new ActiveXObject("WScript.Shell")).Run('"' + url + '"', 1, false); }
            catch (e1) {
                try { (new ActiveXObject("WScript.Shell")).Run('cmd /c start "" "' + url + '"', 0, false); } catch (e2) {}
            }
        }

        function findDoc(id) {
            var i;
            loadDocs();
            for (i = 0; i < docsStore.docs.length; i++) if (docsStore.docs[i].id === id) return docsStore.docs[i];
            return null;
        }

        function renderDocsTab(blocking) {
            var pending = pendingForUser();
            var lock = blocking || pending.length;
            if ($("docReviewWrap")) $("docReviewWrap").style.display = (lock || !isAdmin()) ? "block" : "none";
            if ($("docAdminWrap")) $("docAdminWrap").style.display = !lock && isAdmin() ? "block" : "none";
            if (lock) renderDocAck(true);
            else if (!isAdmin()) renderDocBrowse();
            else {
                if ($("docAckBox")) $("docAckBox").innerHTML = "";
                renderDocTable();
            }
            updateNav();
        }

        function docAckBtnLabel(id) {
            var st = openedDocs[id];
            if (!st || !st.opened) return "I have read this";
            if (st.countdown > 0) return "Confirm (" + st.countdown + "s)";
            return "I have read this";
        }

        function docAckBtnEnabled(id) {
            var st = openedDocs[id];
            return !!(st && st.opened && st.countdown <= 0);
        }

        function startDocAckCountdown(id, rerender) {
            if (ackTimers[id]) window.clearInterval(ackTimers[id]);
            ackTimers[id] = window.setInterval(function () {
                if (!openedDocs[id]) {
                    window.clearInterval(ackTimers[id]);
                    ackTimers[id] = null;
                    return;
                }
                openedDocs[id].countdown -= 1;
                if (openedDocs[id].countdown <= 0) {
                    openedDocs[id].countdown = 0;
                    window.clearInterval(ackTimers[id]);
                    ackTimers[id] = null;
                }
                if (rerender === "browse") renderDocBrowse();
                else renderDocAck(rerender === true);
            }, 1000);
        }

        function renderDocAck(blocking) {
            var pending = pendingForUser();
            var html = blocking ? "<h2>Documents to review</h2><p class='muted'>Open each document. After it opens, confirm that you read it. Quality checks stay locked until every assigned document is acknowledged. Review again every 3 months, or when the version changes.</p>" : "<h2>My documents</h2><p class='muted'>You are caught up. Open a document any time to review it again.</p>";
            var i, d, st;
            if (!pending.length && blocking) html += "<p>You are caught up.</p><button type='button' class='ok' onclick='goHome()'>Continue</button>";
            for (i = 0; i < pending.length; i++) {
                d = pending[i];
                st = openedDocs[d.id];
                html += "<div class='doc-ack'><b>" + esc(d.name) + "</b> · " + esc(d.type) + " · " + esc(d.line) + " · v" + esc(d.version);
                html += "<div><button type='button' class='secondary' onclick=\"openDocThenPrompt('" + String(d.id).replace(/'/g, "") + "')\">Open document</button> ";
                html += "<button type='button' class='ok' id='ackBtn_" + String(d.id).replace(/'/g, "") + "' " + (docAckBtnEnabled(d.id) ? "" : "disabled ") + "onclick=\"ackDoc('" + String(d.id).replace(/'/g, "") + "')\">" + esc(docAckBtnLabel(d.id)) + "</button>";
                html += st && st.opened ? " <span class='muted'>Opened — confirm you read it</span>" : " <span class='muted'>Open first</span>";
                html += "</div></div>";
            }
            if ($("docAckBox")) $("docAckBox").innerHTML = html;
        }

        function renderDocBrowse() {
            loadDocs();
            var docs = QD.docsForAssignedLines(docsStore.docs, assignedLineIds());
            var pending = pendingForUser();
            var pendingIds = {}, i, d, st, pi, section, secDocs, secLabel;
            for (i = 0; i < pending.length; i++) pendingIds[pending[i].id] = true;
            var sections = [{ id: "foam", label: "Foam" }, { id: "bubble", label: "Bubble" }, { id: "p1", label: "P1" }, { id: "rts", label: "RTS" }];
            var html = "<h2>My documents</h2><p class='muted'>Browse documents for your assigned lines. Open any document; ones needing review require acknowledgement after 10 seconds.</p>";
            html += "<div class='subtabs' id='docBrowseTabs'>";
            for (i = 0; i < sections.length; i++) {
                html += "<button type='button' data-docsec='" + sections[i].id + "'" + (docBrowseTab === sections[i].id ? " class='on'" : "") + " onclick=\"setDocBrowseTab('" + sections[i].id + "')\">" + sections[i].label + "</button>";
            }
            html += "</div>";
            secDocs = [];
            for (i = 0; i < docs.length; i++) {
                if (QD.docAppliesToSection(docs[i].line, docBrowseTab)) secDocs.push(docs[i]);
            }
            secLabel = docBrowseTab.charAt(0).toUpperCase() + docBrowseTab.slice(1);
            if (!secDocs.length) html += "<p class='muted'>No " + secLabel + " documents for your lines.</p>";
            for (i = 0; i < secDocs.length; i++) {
                d = secDocs[i];
                st = openedDocs[d.id];
                html += "<div class='doc-ack'><b>" + esc(d.name) + "</b> · " + esc(d.type) + " · " + esc(d.line) + " · v" + esc(d.version);
                html += "<div><button type='button' class='secondary' onclick=\"openDocThenPrompt('" + String(d.id).replace(/'/g, "") + "',true)\">Open document</button>";
                if (pendingIds[d.id]) {
                    html += " <button type='button' class='ok' " + (docAckBtnEnabled(d.id) ? "" : "disabled ") + "onclick=\"ackDoc('" + String(d.id).replace(/'/g, "") + "')\">" + esc(docAckBtnLabel(d.id)) + "</button>";
                    html += st && st.opened ? " <span class='muted'>Opened — confirm you read it</span>" : " <span class='muted'>Open first</span>";
                }
                html += "</div></div>";
            }
            if ($("docAckBox")) $("docAckBox").innerHTML = html;
        }

        function setDocBrowseTab(id) {
            docBrowseTab = id || "foam";
            renderDocBrowse();
        }

        function openDocThenPrompt(id, browse) {
            var d = findDoc(id);
            if (!d) return;
            openDocLink(d.url);
            openedDocs[id] = { opened: true, countdown: 10 };
            startDocAckCountdown(id, browse ? "browse" : true);
            if (browse) renderDocBrowse();
            else renderDocAck(true);
        }

        function ackDoc(id) {
            var d = findDoc(id);
            if (!d) return;
            var st = openedDocs[id];
            if (!st || !st.opened) {
                alert("Open the document first, then confirm that you read it.");
                return;
            }
            if (st.countdown > 0) return;
            if (!confirm("Did you read this document?")) return;
            finishAck(id);
        }

        function finishAck(id) {
            var d = findDoc(id);
            if (!d) return;
            docsStore.acks.push({ docId: d.id, version: d.version, user: session.user, at: (new Date()).toISOString() });
            saveDocs();
            audit("doc-ack", d.name + " v" + d.version);
            delete openedDocs[id];
            if (pendingForUser().length) {
                renderDocsTab(true);
            } else {
                openedDocs = {};
                updateNav();
                if (isAdmin() && currentTab === "docs") renderDocsTab(false);
                else goHome();
            }
        }

        function checkLinkLabel(id) {
            var i, f;
            for (i = 0; i < QD.CHECK_LINK_FIELDS.length; i++) {
                f = QD.CHECK_LINK_FIELDS[i];
                if (f.id === id) return f.label;
            }
            return id || "";
        }

        function renderDocTable() {
            loadDocs(true);
            var html = "<tr><th>Name</th><th>Line</th><th>Type</th><th>Check link</th><th>Linked items</th><th>Link</th><th>Version</th>";
            if (isAdmin()) html += "<th></th>";
            html += "</tr>";
            var i, d, n = 0;
            for (i = 0; i < docsStore.docs.length; i++) {
                d = docsStore.docs[i];
                html += "<tr><td>" + esc(d.name) + "</td><td>" + esc(d.line) + "</td><td>" + esc(d.type) + "</td><td>" + esc(d.checkLink ? checkLinkLabel(d.checkLink) : "") + "</td><td>" + esc(d.linkedItems || "") + "</td><td><a href='#' onclick=\"openDocLink('" + String(d.url || '').replace(/'/g, "") + "');return false;\">Open</a></td><td>" + esc(d.version) + "</td>";
                if (isAdmin()) html += "<td><button type='button' onclick=\"editDoc('" + String(d.id).replace(/'/g, "") + "')\">Edit</button><button type='button' class='secondary' onclick=\"bumpDoc('" + String(d.id).replace(/'/g, "") + "')\">Bump version</button><button type='button' class='danger' onclick=\"deleteDoc('" + String(d.id).replace(/'/g, "") + "')\">Delete</button></td>";
                html += "</tr>";
                n += 1;
            }
            if ($("docTable")) $("docTable").innerHTML = html;
            if ($("docCount")) $("docCount").innerText = n + " document" + (n === 1 ? "" : "s");
        }

        function resetDocForm() {
            docEditId = null;
            if ($("docSaveBtn")) $("docSaveBtn").innerText = "Add document";
            if ($("docName")) $("docName").value = "";
            if ($("docUrl")) $("docUrl").value = "";
            if ($("docLinkedItems")) $("docLinkedItems").value = "";
            if ($("docCheckLink")) $("docCheckLink").selectedIndex = 0;
            if ($("docVer")) $("docVer").value = "1";
            fillDocLineChecks("*");
        }

        function editDoc(id) {
            if (!requireAdmin()) return;
            var d = findDoc(id);
            if (!d) return;
            docEditId = id;
            $("docName").value = d.name || "";
            fillDocLineChecks(d.line || "*");
            $("docType").value = d.type || "Work Instruction";
            $("docUrl").value = d.url || "";
            $("docVer").value = d.version || "1";
            if ($("docLinkedItems")) $("docLinkedItems").value = d.linkedItems || "";
            if ($("docCheckLink")) $("docCheckLink").value = d.checkLink || "";
            syncDocTypeFields();
            if ($("docSaveBtn")) $("docSaveBtn").innerText = "Save";
        }

        function saveDocForm() {
            if (docEditId) saveDocEdit();
            else addDoc();
        }

        function saveDocEdit() {
            if (!requireAdmin() || !docEditId) return;
            var name = QD.trim($("docName").value);
            var line = collectDocLines();
            var type = $("docType").value;
            var url = QD.trim($("docUrl").value);
            var ver = QD.trim($("docVer").value) || "1";
            var linkedItems = $("docLinkedItems") ? QD.trim($("docLinkedItems").value) : "";
            var checkLink = $("docCheckLink") ? $("docCheckLink").value : "";
            if (!name || !url) { setStatus("Document name and link are required.", true); return; }
            loadDocs();
            var i, d;
            for (i = 0; i < docsStore.docs.length; i++) {
                if (docsStore.docs[i].id === docEditId) {
                    d = docsStore.docs[i];
                    d.name = name; d.line = line; d.type = type; d.url = url; d.version = ver;
                    if (type === "Construction Card") d.linkedItems = linkedItems;
                    else delete d.linkedItems;
                    if (checkLink) d.checkLink = checkLink;
                    else delete d.checkLink;
                    audit("doc-edit", name + " v" + ver);
                }
            }
            saveDocs();
            resetDocForm();
            renderDocTable();
            setStatus("Document saved.");
        }

        function syncDocTypeFields() {
            var type = $("docType") ? $("docType").value : "";
            if ($("docLinkedWrap")) $("docLinkedWrap").style.display = type === "Construction Card" ? "" : "none";
            if ($("docCheckLinkWrap")) $("docCheckLinkWrap").style.display = "";
        }

        function collectDocLines() {
            return collectLineChecks("docLineBox");
        }

        function fillDocCheckLinkSelect() {
            var sel = $("docCheckLink");
            if (!sel) return;
            var cur = sel.value, i, f, fields;
            fields = QD.checkLinkFieldsForDocLines(collectDocLines());
            sel.options.length = 0;
            sel.options.add(new Option("", ""));
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                sel.options.add(new Option(f.label, f.id));
            }
            if (cur) sel.value = cur;
        }

        function fillDocLineChecks(selected) {
            var box = $("docLineBox");
            if (!box) return;
            var want = String(selected || "*").toUpperCase();
            var all = want === "*";
            var parts = want.split(/[,;]+/);
            var html = "<label><input type='checkbox' data-line='*' onclick='docLineAllClicked(this)'" + (all ? " checked" : "") + "> All lines</label>";
            var opts = [{ id: "S4", label: "S4" }, { id: "S1", label: "S1" }, { id: "S3", label: "S3" }, { id: "COEX", label: "COEX" }, { id: "MONO", label: "MONO" }, { id: "P1", label: "P1" }, { id: "RTS", label: "RTS" }, { id: "G-COEX", label: "Garland COEX" }];
            var i, j, o, checked;
            for (i = 0; i < opts.length; i++) {
                o = opts[i];
                checked = all;
                if (!all) {
                    for (j = 0; j < parts.length; j++) if (QD.trim(parts[j]) === o.id) checked = true;
                }
                html += "<label><input type='checkbox' data-line='" + o.id + "' onclick='docLineChanged()'" + (checked && !all ? " checked" : "") + "> " + o.label + "</label>";
            }
            box.innerHTML = html;
            fillDocCheckLinkSelect();
        }

        function docLineAllClicked(el) {
            lineAllClicked(el);
            fillDocCheckLinkSelect();
        }

        function docLineChanged() {
            var box = $("docLineBox");
            if (box) {
                var inputs = box.getElementsByTagName("input"), i, j, allIn;
                for (i = 0; i < inputs.length; i++) {
                    if (inputs[i].getAttribute("data-line") !== "*" && inputs[i].checked) {
                        allIn = box.getElementsByTagName("input");
                        for (j = 0; j < allIn.length; j++) {
                            if (allIn[j].getAttribute("data-line") === "*") allIn[j].checked = false;
                        }
                        break;
                    }
                }
            }
            fillDocCheckLinkSelect();
        }

        function addDoc() {
            if (!requireAdmin()) return;
            var name = QD.trim($("docName").value);
            var line = collectDocLines();
            var type = $("docType").value;
            var url = QD.trim($("docUrl").value);
            var ver = QD.trim($("docVer").value) || "1";
            var linkedItems = $("docLinkedItems") ? QD.trim($("docLinkedItems").value) : "";
            var checkLink = $("docCheckLink") ? $("docCheckLink").value : "";
            if (!name || !url) { setStatus("Document name and link are required.", true); return; }
            loadDocs();
            var rec = { id: "d" + (new Date()).getTime(), name: name, line: line, type: type, url: url, version: ver };
            if (type === "Construction Card" && linkedItems) rec.linkedItems = linkedItems;
            if (checkLink) rec.checkLink = checkLink;
            docsStore.docs.push(rec);
            saveDocs();
            audit("doc-add", name + " v" + ver);
            resetDocForm();
            renderDocTable();
        }

        function bumpDoc(id) {
            if (!requireAdmin()) return;
            loadDocs();
            var i, d, n;
            for (i = 0; i < docsStore.docs.length; i++) {
                if (docsStore.docs[i].id === id) {
                    d = docsStore.docs[i];
                    n = parseFloat(d.version);
                    d.version = isFinite(n) ? String(n + 1) : String(d.version) + ".1";
                    audit("doc-version", d.name + " v" + d.version);
                }
            }
            saveDocs();
            renderDocTable();
        }

        function deleteDoc(id) {
            if (!requireAdmin()) return;
            if (!confirm("Delete this document?")) return;
            loadDocs();
            var i, next = [];
            for (i = 0; i < docsStore.docs.length; i++) if (docsStore.docs[i].id !== id) next.push(docsStore.docs[i]);
            docsStore.docs = next;
            saveDocs();
            audit("doc-delete", id);
            renderDocTable();
        }

        function collectLiveInput() {
            var calc = lastCalc || {};
            var input = collectCheckInput(calc);
            input.itemObj = selectedItem();
            input.user = session.user;
            input.reason = checkReason || val("reason");
            input.noCheckReason = noCheckReason || val("noCheckReason");
            if (input.reason === "NO CHECK") input.notes = val("noNotes") || val("notes");
            else if (input.reason === "LINE UP") input.notes = val("upNotes") || val("notes");
            else input.notes = val("checkNotes") || val("notes");
            return input;
        }

        function pointFieldIds(prefix, n) {
            var out = [], i;
            for (i = 1; i <= n; i++) out.push(prefix + i);
            return out;
        }

        function missingLabelMap() {
            var reason = checkReason || val("reason");
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            var fmap = checkLinkFieldMap();
            var map = {
                "Additional reason": "noCheckReason",
                "Reason for Check": "reason",
                "Notes": (reason === "NO CHECK" ? "noNotes" : (reason === "LINE UP" ? "upNotes" : "checkNotes")),
                "Item #": "item",
                "Gram Weight": "bweight",
                "Basis Weight": "bweight",
                "Slit Width": "bwidth",
                "Web Width": "bweb",
                "Dead Cells and Air Transfers Post Vacuum Test": "bdeadPost",
                "Perf Strength Left": "bperfLeft",
                "Perf Strength Right": "bperfRight",
                "Delam Check": "bdelam",
                "Work Order #": "bprod",
                "Bundle #": "broll",
                "Color": "bcolor",
                "Weight (g)": "s4weight",
                "Sheet Length": "s4sheet",
                "Delamination": "rdelam",
                "Blistering": "rdelam",
                "Length": form === "p1" ? "plength" : "rlength",
                "Parent MFG Date": "rdate"
            };
            var fields = QD.CHECK_FIELDS[form] || [];
            var i, f, id;
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                if (f.kind === "points") continue;
                id = fmap[f.key];
                if (id) map[f.label] = id;
            }
            if (form === "p1" && QD.isDoubleShot((selectedItem() || {}).shots)) {
                fields = QD.CHECK_FIELDS.p1Double || [];
                for (i = 0; i < fields.length; i++) {
                    f = fields[i];
                    id = fmap[f.key];
                    if (id && f.kind !== "points") map[f.label] = id;
                }
                if (fmap.length) map["Head Length"] = fmap.length;
                if (fmap.width) map["Head Width"] = fmap.width;
            }
            map["T Point 1"] = "rt1";
            map["T Point 2"] = "rt2";
            map["T Point 3"] = "rt3";
            return map;
        }

        function emptyPointIds(label) {
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            var out = [], prefix = "", n = 0, i, el;
            if (label === "Thickness points") {
                if (form === "s4") prefix = "s4t";
                else if (form === "s1s3") prefix = "s1t";
                else if (form === "rts") return emptyPointIds("T Point");
                n = 13;
            } else if (label === "Head thickness points") { prefix = "pht"; n = 12; }
            else if (label === "Tail thickness points") { prefix = "ptt"; n = 12; }
            else if (label.indexOf("T Point") === 0) {
                if (QD.trim(val("rt1")) === "") out.push("rt1");
                if (QD.trim(val("rt2")) === "") out.push("rt2");
                if (QD.trim(val("rt3")) === "") out.push("rt3");
                return out;
            }
            if (!prefix || !n) return out;
            for (i = 1; i <= n; i++) {
                el = $(prefix + i);
                if (!el || QD.trim(el.value) === "") out.push(prefix + i);
            }
            return out;
        }

        function missingFieldIds() {
            var reason = checkReason || val("reason");
            var input = collectLiveInput();
            var miss = QD.missingCheckFields(currentLine, reason, input);
            var map = missingLabelMap();
            var ids = [], i, id, extra, j;
            for (i = 0; i < miss.length; i++) {
                if (miss[i] === "Thickness points" || miss[i] === "Head thickness points" || miss[i] === "Tail thickness points") {
                    extra = emptyPointIds(miss[i]);
                    for (j = 0; j < extra.length; j++) ids.push(extra[j]);
                } else {
                    id = map[miss[i]];
                    if (id) ids.push(id);
                }
            }
            return { miss: miss, ids: ids };
        }

        function labelHasClass(node, token) {
            return (" " + String(node.className || "") + " ").indexOf(" " + token + " ") >= 0;
        }

        function highlightField(id) {
            var el = $(id);
            if (!el) return;
            var node = el, cls;
            try {
                el.style.borderColor = "#eab308";
                el.style.outline = "2px solid #eab308";
            } catch (eH) {}
            while (node && node !== document.body) {
                if (node.tagName === "LABEL") {
                    cls = String(node.className || "");
                    if (labelHasClass(node, "chip")) {
                        if (QD.trim(el.value) === "") node.className = cls.replace(/\s*need/g, "") + " need";
                        return;
                    }
                    if (labelHasClass(node, "f") || labelHasClass(node, "date-field")) {
                        node.className = cls.replace(/\s*need/g, "") + " need";
                        return;
                    }
                }
                node = node.parentNode;
            }
        }

        function hintMissing() {
            var info = missingFieldIds(), i;
            clearHint();
            for (i = 0; i < info.ids.length; i++) highlightField(info.ids[i]);
        }

        function clearHint() {
            var labs = document.getElementsByTagName("label"), i, cls, inputs, j;
            for (i = 0; i < labs.length; i++) {
                cls = String(labs[i].className || "");
                if (cls.indexOf("need") >= 0) labs[i].className = cls.replace(/\s*need/g, "");
            }
            inputs = document.getElementsByTagName("input");
            for (j = 0; j < inputs.length; j++) { inputs[j].style.borderColor = ""; inputs[j].style.outline = ""; }
            inputs = document.getElementsByTagName("select");
            for (j = 0; j < inputs.length; j++) { inputs[j].style.borderColor = ""; inputs[j].style.outline = ""; }
            inputs = document.getElementsByTagName("textarea");
            for (j = 0; j < inputs.length; j++) inputs[j].style.borderColor = "";
        }

        function syncSubmitBtn() {
            var btn = $("submitBtn");
            if (!btn) return;
            if (currentScreen !== "nocheck" && currentScreen !== "lineup" && currentScreen !== "checkform") {
                btn.className = "ghost";
                btn.setAttribute("data-ready", "0");
                return;
            }
            if (!QD.lineInfo(currentLine, currentSite)) {
                btn.className = "ghost";
                btn.setAttribute("data-ready", "0");
                return;
            }
            var info = missingFieldIds();
            var ready = info.miss.length === 0;
            btn.className = ready ? "ok" : "ghost";
            btn.setAttribute("data-ready", ready ? "1" : "0");
            if (ready) clearHint();
        }

        function scheduleCompute() {
            if (computeTimer) window.clearTimeout(computeTimer);
            computeTimer = window.setTimeout(function () {
                computeTimer = null;
                compute();
            }, 50);
        }

        function scheduleSubmit() {
            if (submitTimer) window.clearTimeout(submitTimer);
            submitTimer = window.setTimeout(function () {
                submitTimer = null;
                syncSubmitBtn();
            }, 50);
        }

        function scheduleHits() {
            if (hitsTimer) window.clearTimeout(hitsTimer);
            hitsTimer = window.setTimeout(function () {
                hitsTimer = null;
                showHits();
            }, 80);
        }

        function scheduleList(fn) {
            if (listTimer) window.clearTimeout(listTimer);
            listTimer = window.setTimeout(function () {
                listTimer = null;
                fn();
            }, 120);
        }

        function clearListFilter(id, fn) {
            if (listTimer) { window.clearTimeout(listTimer); listTimer = null; }
            if ($(id)) $(id).value = "";
            if (typeof fn === "function") fn();
        }

        function bindFormWatch() {
            var root = $("tabChecks");
            if (!root || root.getAttribute("data-watch") === "1") return;
            root.setAttribute("data-watch", "1");
            root.onkeyup = function () { scheduleCompute(); scheduleSubmit(); };
            root.onchange = function () { scheduleCompute(); scheduleSubmit(); };
        }

        function syncEditToolbars() {
            if ($("mspecEditBtn")) $("mspecEditBtn").style.display = mspecEditMode ? "none" : "";
            if ($("mspecSaveBtn")) $("mspecSaveBtn").style.display = (mspecEditMode && mspecDirty) ? "" : "none";
            if ($("mspecCancelBtn")) $("mspecCancelBtn").style.display = mspecEditMode ? "" : "none";
            if ($("itemEditBtn")) $("itemEditBtn").style.display = itemEditMode ? "none" : "";
            if ($("itemSaveBtn")) $("itemSaveBtn").style.display = (itemEditMode && itemDirty) ? "" : "none";
            if ($("itemCancelBtn")) $("itemCancelBtn").style.display = itemEditMode ? "" : "none";
            if ($("histEditBtn")) $("histEditBtn").style.display = histEditMode ? "none" : "";
            if ($("histSaveBtn")) $("histSaveBtn").style.display = (histEditMode && histDirty) ? "" : "none";
            if ($("histCancelBtn")) $("histCancelBtn").style.display = histEditMode ? "" : "none";
        }

        function exitAllEditModes() {
            if (profileEditMode) cancelProfileEditMode(true);
            if (mspecEditMode) {
                if (mspecEditSnapshot) {
                    try {
                        aio.mspecs = mspecEditSnapshot.mspecs;
                        aio.bubble = mspecEditSnapshot.bubble;
                        aio.p1 = mspecEditSnapshot.p1;
                        aio.rts = mspecEditSnapshot.rts;
                    } catch (eM) {}
                }
                mspecEditMode = false; mspecDirty = false; mspecEditSnapshot = null;
            }
            if (itemEditMode) {
                if (itemEditSnapshot) {
                    try { aio.items = itemEditSnapshot; } catch (eI) {}
                }
                itemEditMode = false; itemDirty = false; itemEditSnapshot = null;
            }
            if (histEditMode) { histEditMode = false; histDirty = false; }
            syncEditToolbars();
        }

        function showTab(id) {
            if (id !== currentTab && !confirmLeaveCheck()) return;
            if (docsLocked() && id !== "docs") {
                leaveGuarded(function () { goDocs(true); });
                return;
            }
            if (id !== currentTab) exitAllEditModes();
            currentTab = id;
            var i, tabs = $("mainTabs").getElementsByTagName("button"), tab;
            for (i = 0; i < tabs.length; i++) {
                tab = tabs[i].getAttribute("data-tab");
                if (!tab) continue;
                tabs[i].className = (tab === id) ? "on" : "";
            }
            $("tabChecks").className = "tabpanel" + (id === "checks" ? " on" : "");
            $("tabUsers").className = "tabpanel" + (id === "users" ? " on" : "");
            $("tabMspecs").className = "tabpanel" + (id === "mspecs" ? " on" : "");
            $("tabItems").className = "tabpanel" + (id === "items" ? " on" : "");
            if ($("tabDocs")) $("tabDocs").className = "tabpanel" + (id === "docs" ? " on" : "");
            if ($("tabAudit")) $("tabAudit").className = "tabpanel" + (id === "audit" ? " on" : "");
            if ($("tabHistory")) $("tabHistory").className = "tabpanel" + (id === "history" ? " on" : "");
            if ($("tabProfiles")) $("tabProfiles").className = "tabpanel" + (id === "profiles" ? " on" : "");
            if (id === "mspecs" && currentSite === "GARLAND") specTab = "bubble";
            renderCurrentTab();
            if ($("submitBar") && id !== "checks") $("submitBar").className = "submit-bar";
        }

        function renderCurrentTab() {
            if (currentTab === "users") renderUserTable();
            else if (currentTab === "mspecs") renderMspecTable();
            else if (currentTab === "items") renderItemTable();
            else if (currentTab === "docs") renderDocsTab(docsLocked());
            else if (currentTab === "audit") renderAuditTable();
            else if (currentTab === "history") renderAdminHistory();
            else if (currentTab === "profiles") renderProfiles();
            else if (currentTab === "checks" && currentScreen === "home") renderHome();
        }

        function renderLists() {
            renderCurrentTab();
        }

        function histBtn(kind, key) {
            return "<button type='button' class='secondary' onclick=\"viewHistory('" + esc(kind) + "','" + String(key).replace(/'/g, "") + "')\">View history</button>";
        }

        function editBtn(kind, key) {
            return "";
        }

        function markMspecDirty() {
            mspecDirty = true;
            if ($("mspecSaveBtn") && mspecEditMode) $("mspecSaveBtn").style.display = "";
        }

        function markItemDirty() {
            itemDirty = true;
            if ($("itemSaveBtn") && itemEditMode) $("itemSaveBtn").style.display = "";
        }

        function mspecCell(kind, key, field, value, editing) {
            if (!editing) return esc(value == null ? "" : value);
            return "<input class='cell' data-mk='" + esc(kind) + "' data-mid='" + String(key).replace(/'/g, "") + "' data-mf='" + String(field).replace(/'/g, "") + "' value='" + esc(value == null ? "" : value) + "' oninput='markMspecDirty()'>";
        }

        function itemCell(item, field, value, editing, wide) {
            if (!editing) return esc(value == null ? "" : value);
            return "<input class='cell" + (wide ? " wide" : "") + "' data-ii='" + String(item).replace(/'/g, "") + "' data-if='" + String(field).replace(/'/g, "") + "' value='" + esc(value == null ? "" : value) + "' oninput='markItemDirty()'>";
        }

        function setMspecEditMode(on) {
            if (on && !requireAdmin()) return;
            if (!on && mspecDirty && !confirm("Discard unsaved MSPEC edits?")) return;
            if (on) {
                mspecEditSnapshot = {
                    mspecs: JSON.parse(JSON.stringify(aio.mspecs || [])),
                    bubble: JSON.parse(JSON.stringify(aio.bubble || [])),
                    p1: JSON.parse(JSON.stringify(aio.p1 || [])),
                    rts: JSON.parse(JSON.stringify(aio.rts || []))
                };
            } else if (mspecEditSnapshot) {
                aio.mspecs = mspecEditSnapshot.mspecs;
                aio.bubble = mspecEditSnapshot.bubble;
                aio.p1 = mspecEditSnapshot.p1;
                aio.rts = mspecEditSnapshot.rts;
                mspecEditSnapshot = null;
            }
            mspecEditMode = !!on;
            mspecDirty = false;
            syncEditToolbars();
            renderMspecTable();
        }

        function setItemEditMode(on) {
            if (on && !requireAdmin()) return;
            if (!on && itemDirty && !confirm("Discard unsaved item edits?")) return;
            if (on) {
                itemEditSnapshot = JSON.parse(JSON.stringify(aio.items || []));
            } else if (itemEditSnapshot) {
                aio.items = itemEditSnapshot;
                itemEditSnapshot = null;
            }
            itemEditMode = !!on;
            itemDirty = false;
            syncEditToolbars();
            renderItemTable();
        }

        function saveMspecEdits() {
            if (!requireAdmin() || !mspecEditMode) return;
            if (!mspecDirty) { alert("No changes to save."); return; }
            var why = QD.trim(window.prompt("Why are you changing these specs? (required)", "") || "");
            if (!why) { alert("Explain why these specs are changing."); return; }
            var table = $("mspecTable");
            if (!table) return;
            var inputs = table.getElementsByTagName("input"), i, el, kind, key, field, row, before, after, changed = 0, touched = {};
            var groups = {};
            for (i = 0; i < inputs.length; i++) {
                el = inputs[i];
                kind = el.getAttribute("data-mk");
                key = el.getAttribute("data-mid");
                field = el.getAttribute("data-mf");
                if (!kind || !key || !field) continue;
                if (!groups[kind + "||" + key]) groups[kind + "||" + key] = { kind: kind, key: key, fields: {} };
                groups[kind + "||" + key].fields[field] = el.value;
            }
            for (i in groups) {
                if (!groups.hasOwnProperty(i)) continue;
                kind = groups[i].kind; key = groups[i].key;
                row = findSpecRow(kind, key);
                if (!row) continue;
                before = JSON.parse(JSON.stringify(row));
                after = {};
                var f, dirty = false;
                for (f in groups[i].fields) {
                    if (!groups[i].fields.hasOwnProperty(f)) continue;
                    if (String(row[f] == null ? "" : row[f]) !== String(groups[i].fields[f])) dirty = true;
                    row[f] = groups[i].fields[f];
                    after[f] = row[f];
                }
                if (!dirty) continue;
                QD.ensureSpecVersion(row);
                row.version = QD.bumpSpecVersion(row.version);
                after.version = row.version;
                addHistory(kind, key, why, before, after);
                audit("spec-edit", kind + " " + key + " v" + row.version);
                changed += 1;
            }
            var bpInputs = table.getElementsByTagName("input"), bpi, bpel, bpKey, bpField, bpRow, bpSt, bpParts, bpCur, bpPi, bpChanged = 0;
            for (bpi = 0; bpi < bpInputs.length; bpi++) {
                bpel = bpInputs[bpi];
                bpKey = bpel.getAttribute("data-bp");
                bpField = bpel.getAttribute("data-bpf");
                if (!bpKey || !bpField) continue;
                bpRow = findSpecRow("bubble", bpKey);
                if (!bpRow) continue;
                bpSt = ensureBubbleProfile(bpRow);
                bpParts = String(bpField).split(".");
                bpCur = bpSt;
                for (bpPi = 0; bpPi < bpParts.length - 1; bpPi++) {
                    if (!bpCur[bpParts[bpPi]]) bpCur[bpParts[bpPi]] = {};
                    bpCur = bpCur[bpParts[bpPi]];
                }
                if (String(bpCur[bpParts[bpParts.length - 1]] == null ? "" : bpCur[bpParts[bpParts.length - 1]]) !== String(bpel.value)) {
                    bpCur[bpParts[bpParts.length - 1]] = bpel.value;
                    bpChanged += 1;
                }
            }
            if (bpChanged) {
                saveProfiles();
                try { audit("profile-edit", "bubble MSPEC profile fields x" + bpChanged); } catch (eAud) {}
                changed += bpChanged;
            }
            if (changed) saveLocalSpecs();
            mspecEditMode = false;
            mspecDirty = false;
            mspecEditSnapshot = null;
            syncEditToolbars();
            renderMspecTable();
            setStatus(changed ? ("Saved " + changed + " MSPEC change(s).") : "No field values changed.");
        }

        function saveItemEdits() {
            if (!requireAdmin() || !itemEditMode) return;
            if (!itemDirty) { alert("No changes to save."); return; }
            var why = QD.trim(window.prompt("Why are you changing these items? (required)", "") || "");
            if (!why) { alert("Explain why these items are changing."); return; }
            var table = $("itemTable");
            if (!table) return;
            var inputs = table.getElementsByTagName("input"), i, el, item, field, groups = {}, it, before, after, changed = 0, f, dirty, parts;
            for (i = 0; i < inputs.length; i++) {
                el = inputs[i];
                item = el.getAttribute("data-ii");
                field = el.getAttribute("data-if");
                if (!item || !field) continue;
                if (!groups[item]) groups[item] = {};
                groups[item][field] = el.value;
            }
            for (item in groups) {
                if (!groups.hasOwnProperty(item)) continue;
                it = QD.findItem(aio.items, item);
                if (!it) continue;
                before = JSON.parse(JSON.stringify(it));
                dirty = false;
                for (f in groups[item]) {
                    if (!groups[item].hasOwnProperty(f)) continue;
                    if (f === "parents") {
                        parts = String(groups[item][f] || "").split(",");
                        var cleaned = [], p;
                        for (p = 0; p < parts.length; p++) {
                            var t = QD.trim(parts[p]);
                            if (t) cleaned.push(t);
                        }
                        var oldP = (it.parents && it.parents.length) ? it.parents.join(", ") : (it.parent || "");
                        var newP = cleaned.join(", ");
                        if (QD.trim(oldP) !== QD.trim(newP)) dirty = true;
                        it.parents = cleaned;
                        it.parent = cleaned.length ? cleaned[0] : "";
                    } else {
                        if (String(it[f] == null ? "" : it[f]) !== String(groups[item][f])) dirty = true;
                        it[f] = groups[item][f];
                    }
                }
                if (!dirty) continue;
                it.local = true;
                QD.ensureSpecVersion(it);
                it.version = QD.bumpSpecVersion(it.version || "1.0.0");
                after = JSON.parse(JSON.stringify(it));
                addHistory("item", item, why, before, after);
                audit("item-edit", item + " v" + it.version);
                changed += 1;
            }
            if (changed) {
                aio.items = QD.mergeItems(aio.items, []);
                rebuildItemIndex();
                saveLocalItems();
            }
            itemEditMode = false;
            itemDirty = false;
            itemEditSnapshot = null;
            syncEditToolbars();
            renderItemTable();
            setStatus(changed ? ("Saved " + changed + " item change(s).") : "No field values changed.");
        }



        function itemFilterMatch(it, q, by) {
            if (!q) return true;
            q = q.toLowerCase();
            if (by === "Item #") return String(it.item || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Description") return String(it.description || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Type") return String(QD.itemType(it) || "").toLowerCase().indexOf(q) >= 0;
            if (by === "MSPEC") return String(it.mspec || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Width" || by === "Slit Width") return String(it.width || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Color") return String(it.color || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Footage") return String(it.footage || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Perf") return String(it.perf || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Bubble type") return String(it.bubbleType || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Length") return String(it.length || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Density") return String(it.density || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Shots") return String(it.shots || "").toLowerCase().indexOf(q) >= 0;
            if (by === "Parents") return String((it.parents && it.parents.length) ? it.parents.join(", ") : (it.parent || "")).toLowerCase().indexOf(q) >= 0;
            if (by === "Thickness") return String(it.thickness || "").toLowerCase().indexOf(q) >= 0;
            return String(it.item || "").toLowerCase().indexOf(q) >= 0 || String(it.description || "").toLowerCase().indexOf(q) >= 0;
        }

        function fillMspecFilterBy() {
            var sel = $("mspecFilterBy");
            if (!sel) return;
            var opts = specTab === "foam" ? ["MSPEC", "AF#"] : (specTab === "bubble" ? ["Product", "Line", "Abbr"] : (specTab === "p1" ? ["Thickness", "Density"] : ["Product"]));
            var cur = sel.value, i;
            sel.options.length = 0;
            for (i = 0; i < opts.length; i++) sel.options.add(new Option(opts[i], opts[i]));
            if (cur) sel.value = cur;
            if (!sel.value && sel.options.length) sel.selectedIndex = 0;
        }

        function fillItemFilterBy() {
            var sel = $("itemFilterBy");
            if (!sel) return;
            var opts = itemTab === "foam" ? ["Item #", "Description", "MSPEC", "Width", "Footage", "Perf"]
                : (itemTab === "bubble" ? ["Item #", "Description", "Slit Width", "Footage", "Perf", "Bubble type", "Color"]
                : (itemTab === "p1" ? ["Item #", "Description", "Length", "Width", "Density", "Shots"]
                : ["Item #", "Description", "Parents", "Length", "Width", "Thickness"]));
            var cur = sel.value, i;
            sel.options.length = 0;
            for (i = 0; i < opts.length; i++) sel.options.add(new Option(opts[i], opts[i]));
            if (cur) sel.value = cur;
            if (!sel.value && sel.options.length) sel.selectedIndex = 0;
        }

        function mspecFilterMatch(row, q, by, kind) {
            if (!q) return true;
            q = q.toLowerCase();
            if (kind === "foam") {
                if (by === "MSPEC") return String(row["MSPEC #"] || "").toLowerCase().indexOf(q) >= 0;
                if (by === "AF#") return String(row["AF#"] || "").toLowerCase().indexOf(q) >= 0;
                return String(row["MSPEC #"] || "").toLowerCase().indexOf(q) >= 0;
            }
            if (kind === "bubble") {
                if (by === "Product") return String(row.product || "").toLowerCase().indexOf(q) >= 0;
                if (by === "Line") return String(row.family || "").toLowerCase().indexOf(q) >= 0;
                if (by === "Abbr") return String(row.abbreviation || "").toLowerCase().indexOf(q) >= 0;
                return (String(row.family) + " " + row.abbreviation + " " + row.product).toLowerCase().indexOf(q) >= 0;
            }
            if (kind === "p1") {
                if (by === "Thickness") return String(row.thickness || "").toLowerCase().indexOf(q) >= 0;
                if (by === "Density") return String(row.density || "").toLowerCase().indexOf(q) >= 0;
            }
            if (kind === "rts") return String(row.product || "").toLowerCase().indexOf(q) >= 0;
            return true;
        }

        function renderUserTable() {
            loadAuthUsers();
            var q = ($("userFilter") && $("userFilter").value || "").toLowerCase();
            var by = ($("userFilterBy") && $("userFilterBy").value) || "User";
            var html = "<tr><th>User</th><th>Admin</th><th>Supervisor</th><th>Lead</th><th>Plant</th><th>Lines</th><th>Password</th>";
            if (isAdmin()) html += "<th></th>";
            html += "</tr>";
            var i, u, n = 0;
            for (i = 0; i < authUsers.length; i++) {
                u = authUsers[i];
                if (currentSite === "GARLAND" && String(u.plant || "").toUpperCase() === "VISALIA" && !u.admin) continue;
                if (currentSite === "VISALIA" && String(u.plant || "").toUpperCase() === "GARLAND" && !u.admin) continue;
                if (q) {
                    var hit = false;
                    if (by === "User") hit = String(u.name).toLowerCase().indexOf(q) >= 0;
                    else if (by === "Plant") hit = String(u.plant || "").toLowerCase().indexOf(q) >= 0;
                    else if (by === "Lines") hit = String(u.lines || "").toLowerCase().indexOf(q) >= 0;
                    if (!hit) continue;
                }
                html += "<tr><td>" + esc(u.name) + "</td><td>" + (u.admin ? "Yes" : "") + "</td><td>" + (u.supervisor ? "Yes" : "") + "</td><td>" + (u.lead ? "Yes" : "") + "</td><td>" + esc(u.plant || "VISALIA") + "</td><td>" + esc(u.lines || "*") + "</td><td>" + (u.hash ? "Set" : "Missing") + "</td>";
                if (isAdmin()) {
                    html += "<td>";
                    html += "<button type='button' class='secondary' onclick=\"editUserRoles('" + String(u.name).replace(/'/g, "") + "')\">Roles</button>";
                    html += "<button type='button' class='secondary' onclick=\"resetUserPass('" + String(u.name).replace(/'/g, "") + "')\">Set password</button>";
                    html += "<button type='button' class='secondary' onclick=\"assignUserLines('" + String(u.name).replace(/'/g, "") + "')\">Lines</button>";
                    if (String(u.name).toUpperCase() !== String(session.user).toUpperCase()) {
                        html += "<button type='button' class='danger' onclick=\"deleteUser('" + String(u.name).replace(/'/g, "") + "')\">Delete</button>";
                    }
                    html += "</td>";
                }
                html += "</tr>";
                n += 1;
            }
            if ($("userTable")) $("userTable").innerHTML = html;
            if ($("userCount")) $("userCount").innerText = n + " user" + (n === 1 ? "" : "s");
        }

        function setSpecTab(id) {
            specTab = id;
            var i, tabs = $("specTabs").getElementsByTagName("button");
            for (i = 0; i < tabs.length; i++) tabs[i].className = (tabs[i].getAttribute("data-spec") === id) ? "on" : "";
            fillMspecFilterBy();
            renderMspecTable();
        }

        function renderMspecTable() {
            fillMspecFilterBy();
            if ($("specTabs")) {
                var btns = $("specTabs").getElementsByTagName("button"), i;
                for (i = 0; i < btns.length; i++) {
                    btns[i].className = (btns[i].getAttribute("data-spec") === specTab) ? "on" : "";
                    if (currentSite === "GARLAND") btns[i].style.display = btns[i].getAttribute("data-spec") === "bubble" ? "" : "none";
                    else btns[i].style.display = "";
                }
            }
            if (currentSite === "GARLAND") specTab = "bubble";
            if ($("mspecProfileExtra")) $("mspecProfileExtra").style.display = (specTab === "bubble") ? "" : "none";
            if (specTab === "bubble") return renderBubbleTable();
            if (specTab === "p1") return renderP1Table();
            if (specTab === "rts") return renderRtsTable();
            var q = QD.trim(($("mspecFilter") && $("mspecFilter").value) || "").toLowerCase();
            var by = ($("mspecFilterBy") && $("mspecFilterBy").value) || "MSPEC";
            var html = "<thead><tr>";
            html += "<th class='group' colspan='12'>Quality Specs</th><th rowspan='3'></th></tr><tr>";
            html += "<th class='mspec' rowspan='2'>MSPEC</th><th rowspan='2'>AF#</th><th rowspan='2'>Ver</th>";
            html += "<th class='group' colspan='3'>Gauge</th><th rowspan='2'>Range</th>";
            html += "<th class='group' colspan='2'>Cell</th><th class='group' colspan='3'>Density</th></tr><tr>";
            html += "<th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th>";
            html += "<th class='num'>Min</th><th class='num'>Max</th>";
            html += "<th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th></tr></thead><tbody>";
            var i, r, key, n = 0;
            for (i = 0; i < aio.mspecs.length; i++) {
                r = aio.mspecs[i];
                key = QD.foamKey(r);
                if (q && !mspecFilterMatch(r, q, by, "foam")) continue;
                var ed = mspecEditMode && isAdmin();
                html += "<tr><td class='mspec'>" + esc(key) + "</td><td>" + mspecCell("foam", key, "AF#", r["AF#"], ed) + "</td><td>" + esc(r.version || "1.0.0") + "</td>";
                html += "<td class='num'>" + mspecCell("foam", key, "Lower Control", r["Lower Control"], ed) + "</td><td class='num'>" + mspecCell("foam", key, "Target", r.Target, ed) + "</td><td class='num'>" + mspecCell("foam", key, "Upper Control", r["Upper Control"], ed) + "</td>";
                html += "<td class='num'>" + mspecCell("foam", key, "Thickness Range Max", r["Thickness Range Max"], ed) + "</td>";
                html += "<td class='num'>" + mspecCell("foam", key, "Cell Count Min", r["Cell Count Min"], ed) + "</td><td class='num'>" + mspecCell("foam", key, "Cell Count Max", r["Cell Count Max"], ed) + "</td>";
                html += "<td class='num'>" + mspecCell("foam", key, "Density Min", r["Density Min"], ed) + "</td><td class='num'>" + mspecCell("foam", key, "Density Target", r["Density Target"], ed) + "</td><td class='num'>" + mspecCell("foam", key, "Density Max", r["Density Max"], ed) + "</td>";
                html += "<td>" + histBtn("foam", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if ($("mspecTable")) { $("mspecTable").className = "specs" + (mspecEditMode ? " editing" : ""); $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " foam MSPEC" + (n === 1 ? "" : "s");
        }

        function bubbleLineIdForFamily(family) {
            var f = String(family || "").toUpperCase();
            if (currentSite === "GARLAND") return "G-COEX";
            if (f === "MONO") return "MONO";
            return "COEX";
        }

        function bubbleProfileForRow(r) {
            var plant = plantProfiles(), lineId = bubbleLineIdForFamily(r.family), lp, list, i, name;
            if (!plant[lineId]) return null;
            lp = plant[lineId];
            list = lp.structures || [];
            name = String(r.abbreviation || r.product || "").toUpperCase();
            for (i = 0; i < list.length; i++) {
                if (String(list[i].name || "").toUpperCase() === name) return list[i];
            }
            return null;
        }

        function ensureBubbleProfile(r) {
            var plant = plantProfiles(), lineId = bubbleLineIdForFamily(r.family), lp, st, name;
            if (!plant[lineId]) plant[lineId] = QD.emptyLineProfile();
            lp = plant[lineId];
            st = bubbleProfileForRow(r);
            if (st) return st;
            name = String(r.abbreviation || r.product || "").replace(/^\s+|\s+$/g, "") || "Structure";
            st = QD.emptyCoexStructure(name);
            lp.structures.push(st);
            return st;
        }

        function profileCell(st, path, editing, key) {
            var parts, cur, i, val = "";
            if (!st) st = { A: {}, B: {}, C: {} };
            parts = String(path).split(".");
            cur = st;
            for (i = 0; i < parts.length; i++) {
                if (cur == null) { cur = null; break; }
                cur = cur[parts[i]];
            }
            val = cur == null ? "" : cur;
            if (!editing) return esc(val);
            return "<input class='cell' data-bp='" + esc(key) + "' data-bpf='" + esc(path) + "' value='" + esc(val) + "' oninput='markMspecDirty()'>";
        }

        function renderBubbleTable() {
            var q = QD.trim(($("mspecFilter") && $("mspecFilter").value) || "").toLowerCase();
            var by = ($("mspecFilterBy") && $("mspecFilterBy").value) || "Product";
            var html = "<thead><tr>";
            html += "<th class='group' colspan='8'>Quality Specs</th>";
            html += "<th class='group' colspan='10'>Basic Profile Settings</th><th rowspan='3'></th></tr><tr>";
            html += "<th rowspan='2'>Line</th><th rowspan='2'>Abbr</th><th rowspan='2'>Product</th><th rowspan='2'>Ver</th><th rowspan='2'>Calc gauge</th>";
            html += "<th class='group' colspan='3'>Weight</th>";
            html += "<th rowspan='2'>Line speed</th>";
            html += "<th class='group' colspan='3'>Extruder A</th><th class='group' colspan='3'>Extruder B</th><th class='group' colspan='3'>Extruder C</th></tr><tr>";
            html += "<th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th>";
            html += "<th class='num'>Spd</th><th class='num'>MP1</th><th class='num'>MP2</th>";
            html += "<th class='num'>Spd</th><th class='num'>MP1</th><th class='num'>MP2</th>";
            html += "<th class='num'>Spd</th><th class='num'>MP1</th><th class='num'>MP2</th></tr></thead><tbody>";
            var i, r, key, n = 0, st;
            try { loadProfiles(); } catch (eLp) {}
            for (i = 0; i < aio.bubble.length; i++) {
                r = aio.bubble[i];
                key = QD.bubbleKey(r);
                if (!QD.bubbleFamilyAllowed(r.family, currentSite)) continue;
                if (q && !mspecFilterMatch(r, q, by, "bubble")) continue;
                var edB = mspecEditMode && isAdmin();
                st = bubbleProfileForRow(r) || { lineSpeed: "", A: {}, B: {}, C: {} };
                html += "<tr><td>" + esc(r.family) + "</td><td>" + esc(r.abbreviation) + "</td><td>" + mspecCell("bubble", key, "product", r.product, edB) + "</td><td>" + esc(r.version || "1.0.0") + "</td><td class='num'>" + mspecCell("bubble", key, "calcGauge", r.calcGauge, edB) + "</td>";
                html += "<td class='num'>" + mspecCell("bubble", key, "min", r.min, edB) + "</td><td class='num'>" + mspecCell("bubble", key, "target", r.target, edB) + "</td><td class='num'>" + mspecCell("bubble", key, "max", r.max, edB) + "</td>";
                html += "<td class='num'>" + profileCell(st, "lineSpeed", edB, key) + "</td>";
                html += "<td class='num'>" + profileCell(st, "A.speed", edB, key) + "</td><td class='num'>" + profileCell(st, "A.meltPump1", edB, key) + "</td><td class='num'>" + profileCell(st, "A.meltPump2", edB, key) + "</td>";
                html += "<td class='num'>" + profileCell(st, "B.speed", edB, key) + "</td><td class='num'>" + profileCell(st, "B.meltPump1", edB, key) + "</td><td class='num'>" + profileCell(st, "B.meltPump2", edB, key) + "</td>";
                html += "<td class='num'>" + profileCell(st, "C.speed", edB, key) + "</td><td class='num'>" + profileCell(st, "C.meltPump1", edB, key) + "</td><td class='num'>" + profileCell(st, "C.meltPump2", edB, key) + "</td>";
                html += "<td>" + histBtn("bubble", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if (aio.bubbleDead.length) {
                html += "<thead><tr><th colspan='8'>Max dead cells</th></tr><tr><th colspan='2'>Type</th><th colspan='3'>Abbreviations</th><th class='num'>Max</th><th colspan='2'></th></tr></thead><tbody>";
                for (i = 0; i < aio.bubbleDead.length; i++) {
                    r = aio.bubbleDead[i];
                    html += "<tr><td colspan='2'>" + esc(r.bubbleType) + "</td><td colspan='3'>" + esc(r.abbreviations) + "</td><td class='num'>" + esc(r.maxDead) + "</td><td colspan='2'></td></tr>";
                }
                html += "</tbody>";
            }
            if ($("mspecTable")) { $("mspecTable").className = "specs" + (mspecEditMode ? " editing" : ""); $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " bubble spec" + (n === 1 ? "" : "s");
        }

        function renderP1Table() {
            var q = ($("mspecFilter") && $("mspecFilter").value || "").toLowerCase();
            var by = ($("mspecFilterBy") && $("mspecFilterBy").value) || "Thickness";
            var html = "<thead><tr><th class='group' colspan='11'>Quality Specs</th></tr><tr><th>Thickness</th><th>Ver</th><th class='group' colspan='3'>Density</th><th class='group' colspan='2'>Cell</th><th class='group' colspan='3'>Thickness</th><th></th></tr>";
            html += "<tr><th></th><th></th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th class='num'>Min</th><th class='num'>Max</th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th></th></tr></thead><tbody>";
            var i, r, key, n = 0;
            for (i = 0; i < aio.p1.length; i++) {
                r = aio.p1[i];
                key = QD.p1Key(r);
                if (q && !mspecFilterMatch(r, q, by, "p1")) continue;
                var edP = mspecEditMode && isAdmin();
                html += "<tr><td>" + esc(r.thickness) + "</td><td>" + esc(r.version || "1.0.0") + "</td><td class='num'>" + mspecCell("p1", key, "min", r.min, edP) + "</td><td class='num'>" + mspecCell("p1", key, "density", r.density, edP) + "</td><td class='num'>" + mspecCell("p1", key, "max", r.max, edP) + "</td>";
                html += "<td class='num'>" + mspecCell("p1", key, "ccMin", r.ccMin, edP) + "</td><td class='num'>" + mspecCell("p1", key, "ccMax", r.ccMax, edP) + "</td>";
                html += "<td class='num'>" + mspecCell("p1", key, "thickMin", r.thickMin, edP) + "</td><td class='num'>" + mspecCell("p1", key, "thickTarget", r.thickTarget, edP) + "</td><td class='num'>" + mspecCell("p1", key, "thickMax", r.thickMax, edP) + "</td>";
                html += "<td>" + histBtn("p1", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if ($("mspecTable")) { $("mspecTable").className = "specs" + (mspecEditMode ? " editing" : ""); $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " P1 spec" + (n === 1 ? "" : "s");
        }

        function renderRtsTable() {
            var q = ($("mspecFilter") && $("mspecFilter").value || "").toLowerCase();
            var by = ($("mspecFilterBy") && $("mspecFilterBy").value) || "Product";
            var html = "<thead><tr><th class='group' colspan='5'>Quality Specs</th></tr><tr><th>Product</th><th>Ver</th><th class='group' colspan='3'>Thickness</th><th></th></tr>";
            html += "<tr><th></th><th></th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th></th></tr></thead><tbody>";
            var i, r, key, n = 0;
            for (i = 0; i < aio.rts.length; i++) {
                r = aio.rts[i];
                key = QD.rtsKey(r);
                if (q && !mspecFilterMatch(r, q, by, "rts")) continue;
                var edR = mspecEditMode && isAdmin();
                html += "<tr><td>" + esc(r.product) + "</td><td>" + esc(r.version || "1.0.0") + "</td><td class='num'>" + mspecCell("rts", key, "min", r.min, edR) + "</td><td class='num'>" + mspecCell("rts", key, "target", r.target, edR) + "</td><td class='num'>" + mspecCell("rts", key, "max", r.max, edR) + "</td>";
                html += "<td>" + histBtn("rts", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if ($("mspecTable")) { $("mspecTable").className = "specs" + (mspecEditMode ? " editing" : ""); $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " RTS spec" + (n === 1 ? "" : "s");
        }

        function setItemTab(id) {
            itemTab = id;
            var i, tabs = $("itemTabs") ? $("itemTabs").getElementsByTagName("button") : [];
            for (i = 0; i < tabs.length; i++) tabs[i].className = (tabs[i].getAttribute("data-item") === id) ? "on" : "";
            fillItemFilterBy();
            renderItemTable();
        }

        function itemMatchesTab(typ) {
            if (itemTab === "foam") return typ === "FOAM";
            if (itemTab === "bubble") return typ === "BUBBLE";
            if (itemTab === "p1") return typ === "PLANK";
            if (itemTab === "rts") return typ === "LAM";
            return true;
        }

        function renderItemTable() {
            fillItemFilterBy();
            if ($("itemTabs")) {
                var btns = $("itemTabs").getElementsByTagName("button"), i, kind;
                for (i = 0; i < btns.length; i++) {
                    kind = btns[i].getAttribute("data-item");
                    if (!kind) continue;
                    btns[i].className = (kind === itemTab) ? "on" : "";
                    if (currentSite === "GARLAND") btns[i].style.display = kind === "bubble" ? "" : "none";
                    else btns[i].style.display = "";
                }
            }
            if (currentSite === "GARLAND") itemTab = "bubble";
            var q = QD.trim(($("itemFilter") && $("itemFilter").value) || "").toLowerCase();
            var by = ($("itemFilterBy") && $("itemFilterBy").value) || "Item #";
            var html = "", i, it, n = 0, shown = 0, typ, cap = 200;
            function itemActions(rec) {
                var safe = String(rec.item).replace(/'/g, "");
                var cell = "<td><button type='button' class='secondary' onclick=\"viewItem('" + safe + "')\">View</button>";
                if (isAdmin() && itemEditMode) {
                    cell += "<button type='button' class='danger' onclick=\"deleteItem('" + safe + "')\">Delete</button>";
                }
                return cell + "</td>";
            }
            if (itemTab === "foam") {
                html += "<tr><th>Item #</th><th>Description</th><th>MSPEC</th><th>Width</th><th>Footage</th><th>Perf</th><th></th></tr>";
                for (i = 0; i < aio.items.length; i++) {
                    it = aio.items[i];
                    if (it.deleted) continue;
                    typ = QD.itemType(it);
                    if (!itemMatchesTab(typ)) continue;
                    if (currentSite === "GARLAND" && typ !== "BUBBLE") continue;
                    if (!itemFilterMatch(it, q, by)) continue;
                    n += 1;
                    if (shown >= cap) continue;
                    shown += 1;
                    var edI = itemEditMode && isAdmin();
                    html += "<tr><td>" + esc(it.item) + "</td><td>" + itemCell(it.item, "description", it.description, edI, true) + "</td><td>" + itemCell(it.item, "mspec", it.mspec, edI) + "</td><td>" + itemCell(it.item, "width", it.width, edI) + "</td><td>" + itemCell(it.item, "footage", it.footage, edI) + "</td><td>" + itemCell(it.item, "perf", it.perf, edI) + "</td>" + itemActions(it) + "</tr>";
                }
            } else if (itemTab === "bubble") {
                html += "<tr><th>Item #</th><th>Description</th><th>Slit Width</th><th>Footage</th><th>Perf</th><th>Bubble type</th><th>Color</th><th></th></tr>";
                for (i = 0; i < aio.items.length; i++) {
                    it = aio.items[i];
                    if (it.deleted) continue;
                    typ = QD.itemType(it);
                    if (!itemMatchesTab(typ)) continue;
                    if (currentSite === "GARLAND" && typ !== "BUBBLE") continue;
                    if (!itemFilterMatch(it, q, by)) continue;
                    n += 1;
                    if (shown >= cap) continue;
                    shown += 1;
                    var edI = itemEditMode && isAdmin();
                    html += "<tr><td>" + esc(it.item) + "</td><td>" + itemCell(it.item, "description", it.description, edI, true) + "</td><td>" + itemCell(it.item, "width", it.width, edI) + "</td><td>" + itemCell(it.item, "footage", it.footage, edI) + "</td><td>" + itemCell(it.item, "perf", it.perf, edI) + "</td><td>" + itemCell(it.item, "bubbleType", it.bubbleType, edI) + "</td><td>" + itemCell(it.item, "color", it.color || "", edI) + "</td>" + itemActions(it) + "</tr>";
                }
            } else if (itemTab === "p1") {
                html += "<tr><th>Item #</th><th>Description</th><th>Length</th><th>Width</th><th>Density</th><th>Shots</th><th></th></tr>";
                for (i = 0; i < aio.items.length; i++) {
                    it = aio.items[i];
                    if (it.deleted) continue;
                    typ = QD.itemType(it);
                    if (!itemMatchesTab(typ)) continue;
                    if (!itemFilterMatch(it, q, by)) continue;
                    n += 1;
                    if (shown >= cap) continue;
                    shown += 1;
                    var edI = itemEditMode && isAdmin();
                    html += "<tr><td>" + esc(it.item) + "</td><td>" + itemCell(it.item, "description", it.description, edI, true) + "</td><td>" + itemCell(it.item, "length", it.length, edI) + "</td><td>" + itemCell(it.item, "width", it.width, edI) + "</td><td>" + itemCell(it.item, "density", it.density, edI) + "</td><td>" + itemCell(it.item, "shots", it.shots, edI) + "</td>" + itemActions(it) + "</tr>";
                }
            } else {
                html += "<tr><th>Item #</th><th>Description</th><th>Parents</th><th>Length</th><th>Width</th><th>Thickness</th><th></th></tr>";
                for (i = 0; i < aio.items.length; i++) {
                    it = aio.items[i];
                    if (it.deleted) continue;
                    typ = QD.itemType(it);
                    if (!itemMatchesTab(typ)) continue;
                    if (!itemFilterMatch(it, q, by)) continue;
                    n += 1;
                    if (shown >= cap) continue;
                    shown += 1;
                    var edI = itemEditMode && isAdmin();
                    var parentsTxt = (it.parents && it.parents.length) ? it.parents.join(", ") : (it.parent || "");
                    html += "<tr><td>" + esc(it.item) + "</td><td>" + itemCell(it.item, "description", it.description, edI, true) + "</td><td>" + itemCell(it.item, "parents", parentsTxt, edI, true) + "</td><td>" + itemCell(it.item, "length", it.length, edI) + "</td><td>" + itemCell(it.item, "width", it.width, edI) + "</td><td>" + itemCell(it.item, "thickness", it.thickness, edI) + "</td>" + itemActions(it) + "</tr>";
                }
            }
            if (!shown) html += "<tr><td colspan='8' class='muted'>No matching items.</td></tr>";
            if ($("itemTable")) $("itemTable").innerHTML = html;
            if ($("itemCount")) $("itemCount").innerText = n + " item" + (n === 1 ? "" : "s") + (n > shown ? " (showing first " + shown + ")" : "");
        }

        function openAddUserScreen() {
            if (!requireAdmin()) return;
            if ($("newUser")) $("newUser").value = "";
            if ($("newUserPass")) $("newUserPass").value = "";
            if ($("newUserOperator")) $("newUserOperator").checked = true;
            if ($("newUserAdmin")) $("newUserAdmin").checked = false;
            if ($("newUserSupervisor")) $("newUserSupervisor").checked = false;
            if ($("newUserLead")) $("newUserLead").checked = false;
            fillPlantChecks("newUserPlantBox", "VISALIA");
            fillLineChecks("newUserLineBox", "VISALIA", "*");
            $("addUserOverlay").className = "overlay on";
            if ($("newUser")) $("newUser").focus();
        }

        function closeAddUserScreen() {
            if ($("addUserOverlay")) $("addUserOverlay").className = "overlay";
        }

        function addUser() {
            if (!requireAdmin()) return;
            var name = QD.trim($("newUser").value);
            var pass = $("newUserPass") ? $("newUserPass").value : "";
            var admin = $("newUserAdmin") && $("newUserAdmin").checked;
            var supervisor = $("newUserSupervisor") && $("newUserSupervisor").checked;
            var lead = $("newUserLead") && $("newUserLead").checked;
            if (!name) { setStatus("Type a user name.", true); return; }
            if (!pass) { setStatus("Every user must have a password.", true); return; }
            loadAuthUsers();
            if (QD.findUserRecord(authUsers, name)) { setStatus("User already exists.", true); return; }
            var plant = collectPlantChecks("newUserPlantBox");
            var lines = collectLineChecks("newUserLineBox") || "*";
            authUsers.push(QD.makeUserRecord(name, pass, admin, false, plant, lines, supervisor, lead));
            saveAuthUsers();
            aio.users = QD.mergeUsers(aio.users, [name]);
            aio.localUsers = QD.mergeUsers(aio.localUsers || [], [name]);
            $("newUser").value = "";
            if ($("newUserPass")) $("newUserPass").value = "";
            if ($("newUserOperator")) $("newUserOperator").checked = true;
            if ($("newUserAdmin")) $("newUserAdmin").checked = false;
            if ($("newUserSupervisor")) $("newUserSupervisor").checked = false;
            if ($("newUserLead")) $("newUserLead").checked = false;
            saveLocalUsers();
            audit("user-add", name);
            renderUserTable();
            closeAddUserScreen();
            setStatus("Added user " + name + ". They can sign in now.");
        }

        function collectPlantChecks(boxId) {
            var box = $(boxId);
            if (!box) return "VISALIA";
            var vis = false, gar = false, inputs = box.getElementsByTagName("input"), i, el;
            for (i = 0; i < inputs.length; i++) {
                el = inputs[i];
                if (!el.checked) continue;
                if (el.getAttribute("data-plant") === "VISALIA") vis = true;
                if (el.getAttribute("data-plant") === "GARLAND") gar = true;
            }
            if (vis && gar) return "BOTH";
            if (gar) return "GARLAND";
            return "VISALIA";
        }

        function fillPlantChecks(boxId, selected) {
            var box = $(boxId);
            if (!box) return;
            var sit = String(selected || "VISALIA").toUpperCase();
            var vis = sit === "VISALIA" || sit === "BOTH";
            var gar = sit === "GARLAND" || sit === "BOTH";
            box.innerHTML = "<label><input type='checkbox' data-plant='VISALIA'" + (vis ? " checked" : "") + " onclick=\"plantCheckChanged('" + boxId + "')\"> Visalia</label>"
                + "<label><input type='checkbox' data-plant='GARLAND'" + (gar ? " checked" : "") + " onclick=\"plantCheckChanged('" + boxId + "')\"> Garland</label>";
        }

        function plantCheckChanged(boxId) {
            var lineBox = boxId === "newUserPlantBox" ? "newUserLineBox" : "editUserLineBox";
            fillLineChecks(lineBox, collectPlantChecks(boxId), collectLineChecks(lineBox));
        }

        function collectLineChecks(boxId) {
            var box = $(boxId);
            if (!box) return "*";
            var inputs = box.getElementsByTagName("input"), i, el, out = [];
            for (i = 0; i < inputs.length; i++) {
                el = inputs[i];
                if (!el.checked) continue;
                if (el.getAttribute("data-line") === "*") return "*";
                out.push(el.getAttribute("data-line"));
            }
            return out.length ? out.join(",") : "*";
        }

        function fillLineChecks(boxId, plant, selected) {
            var box = $(boxId);
            if (!box) return;
            var sit = String(plant || "VISALIA").toUpperCase();
            var want = String(selected || "*").toUpperCase();
            var all = want === "*";
            var parts = want.split(/[,;]+/);
            var html = "<label><input type='checkbox' data-line='*' onclick='lineAllClicked(this)'" + (all ? " checked" : "") + "> All lines</label>";
            var opts = sit === "GARLAND"
                ? [{ id: "COEX", label: "COEX" }]
                : [{ id: "S4", label: "S4" }, { id: "S1", label: "S1" }, { id: "S3", label: "S3" }, { id: "COEX", label: "COEX" }, { id: "MONO", label: "MONO" }, { id: "P1", label: "P1" }, { id: "RTS", label: "RTS" }];
            if (sit === "BOTH") opts.push({ id: "G-COEX", label: "Garland COEX" });
            var i, o, checked, j;
            for (i = 0; i < opts.length; i++) {
                o = opts[i];
                checked = all;
                if (!all) {
                    for (j = 0; j < parts.length; j++) if (QD.trim(parts[j]) === o.id) checked = true;
                }
                html += "<label><input type='checkbox' data-line='" + o.id + "'" + (checked && !all ? " checked" : "") + "> " + o.label + "</label>";
            }
            box.innerHTML = html;
        }

        function lineAllClicked(el) {
            if (!el || !el.checked) return;
            var inputs = el.parentNode.parentNode.getElementsByTagName("input"), i;
            for (i = 0; i < inputs.length; i++) {
                if (inputs[i] !== el) inputs[i].checked = false;
            }
        }

        function assignUserLines(name) {
            if (!requireAdmin()) return;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            $("editUserName").value = rec.name;
            fillPlantChecks("editUserPlantBox", rec.plant || "VISALIA");
            fillLineChecks("editUserLineBox", rec.plant || "VISALIA", rec.lines || "*");
            $("linesOverlay").className = "overlay on";
        }

        function saveAssignedLines() {
            var name = $("editUserName").value;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            rec.plant = collectPlantChecks("editUserPlantBox") || "VISALIA";
            rec.lines = collectLineChecks("editUserLineBox") || "*";
            saveAuthUsers();
            $("linesOverlay").className = "overlay";
            audit("user-lines", name + " " + rec.plant + " " + rec.lines);
            renderUserTable();
            dbg("Lines for " + name + ": " + rec.plant + " " + rec.lines);
        }

        function toggleAdmin(name) {
            if (!requireAdmin()) return;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            if (String(rec.name).toUpperCase() === String(session.user).toUpperCase() && rec.admin) {
                alert("You cannot remove your own admin access.");
                return;
            }
            rec.admin = !rec.admin;
            saveAuthUsers();
            audit("user-admin", rec.name + (rec.admin ? " granted" : " removed"));
            renderUserTable();
        }

        function editUserRoles(name) {
            if (!requireAdmin()) return;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            if ($("roleUserName")) $("roleUserName").value = rec.name;
            if ($("roleOperator")) $("roleOperator").checked = true;
            if ($("roleAdmin")) $("roleAdmin").checked = !!rec.admin;
            if ($("roleSupervisor")) $("roleSupervisor").checked = !!rec.supervisor;
            if ($("roleLead")) $("roleLead").checked = !!rec.lead;
            if ($("rolesOverlay")) $("rolesOverlay").className = "overlay on";
        }

        function saveUserRoles() {
            if (!requireAdmin()) return;
            var name = $("roleUserName") ? $("roleUserName").value : "";
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            var nextAdmin = $("roleAdmin") && $("roleAdmin").checked;
            if (String(rec.name).toUpperCase() === String(session.user).toUpperCase() && rec.admin && !nextAdmin) {
                alert("You cannot remove your own admin access.");
                return;
            }
            rec.admin = !!nextAdmin;
            rec.supervisor = !!($("roleSupervisor") && $("roleSupervisor").checked);
            rec.lead = !!($("roleLead") && $("roleLead").checked);
            saveAuthUsers();
            if ($("rolesOverlay")) $("rolesOverlay").className = "overlay";
            audit("user-roles", rec.name + " admin=" + (rec.admin ? "1" : "0") + " supervisor=" + (rec.supervisor ? "1" : "0") + " lead=" + (rec.lead ? "1" : "0"));
            renderUserTable();
            setStatus("Updated roles for " + rec.name + ".");
        }

        function resetUserPass(name) {
            if (!requireAdmin()) return;
            var pass = prompt("New password for " + name + ":");
            if (pass == null) return;
            if (!QD.trim(pass)) { alert("Password is required."); return; }
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            var next = QD.makeUserRecord(name, pass, rec.admin, false);
            rec.salt = next.salt;
            rec.hash = next.hash;
            rec.mustChange = false;
            saveAuthUsers();
            audit("user-password", name);
            renderUserTable();
            setStatus("Password set for " + name);
        }

        function deleteUser(name) {
            if (!requireAdmin()) return;
            if (!confirm("Delete user " + name + "?")) return;
            loadAuthUsers();
            var i, next = [];
            for (i = 0; i < authUsers.length; i++) if (String(authUsers[i].name).toUpperCase() !== String(name).toUpperCase()) next.push(authUsers[i]);
            authUsers = next;
            saveAuthUsers();
            audit("user-delete", name);
            renderUserTable();
        }

        function changeOwnPassword() {
            $("pwOverlay").className = "overlay on";
            $("pwTitle").innerText = "Change password";
            $("pwOld").value = "";
            $("pwNew").value = "";
            $("pwNew2").value = "";
        }

        function saveOwnPassword() {
            var oldp = $("pwOld").value;
            var a = $("pwNew").value;
            var b = $("pwNew2").value;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, session.user);
            if (!rec) return;
            if (rec.hash && !rec.mustChange && !QD.verifyPassword(rec, oldp)) {
                alert("Current password is wrong.");
                return;
            }
            if (!QD.trim(a)) { alert("New password is required."); return; }
            if (a !== b) { alert("New passwords do not match."); return; }
            var next = QD.makeUserRecord(rec.name, a, rec.admin, false);
            rec.salt = next.salt;
            rec.hash = next.hash;
            rec.mustChange = false;
            saveAuthUsers();
            $("pwOverlay").className = "overlay";
            audit("password-change", rec.name);
            setStatus("Password saved.");
        }

        function findSpecRow(kind, key) {
            var i;
            if (kind === "foam") {
                for (i = 0; i < aio.mspecs.length; i++) if (QD.foamKey(aio.mspecs[i]) === key) return aio.mspecs[i];
            } else if (kind === "bubble") {
                for (i = 0; i < aio.bubble.length; i++) if (QD.bubbleKey(aio.bubble[i]) === key) return aio.bubble[i];
            } else if (kind === "p1") {
                for (i = 0; i < aio.p1.length; i++) if (QD.p1Key(aio.p1[i]) === key) return aio.p1[i];
            } else if (kind === "rts") {
                for (i = 0; i < aio.rts.length; i++) if (QD.rtsKey(aio.rts[i]) === key) return aio.rts[i];
            }
            return null;
        }

        function specFields(kind) {
            if (kind === "foam") return [
                { key: "AF#", label: "AF#" }, { key: "Lower Control", label: "Gauge min" }, { key: "Target", label: "Gauge target" },
                { key: "Upper Control", label: "Gauge max" }, { key: "Thickness Range Max", label: "Range max" },
                { key: "Cell Count Min", label: "Cell min" }, { key: "Cell Count Max", label: "Cell max" },
                { key: "Density Min", label: "Density min" }, { key: "Density Target", label: "Density target" }, { key: "Density Max", label: "Density max" }
            ];
            if (kind === "bubble") return [
                { key: "product", label: "Product" }, { key: "calcGauge", label: "Calc gauge" },
                { key: "min", label: "Min" }, { key: "target", label: "Target" }, { key: "max", label: "Max" }
            ];
            if (kind === "p1") return [
                { key: "density", label: "Density target" }, { key: "min", label: "Density min" }, { key: "max", label: "Density max" },
                { key: "ccMin", label: "Cell min" }, { key: "ccMax", label: "Cell max" },
                { key: "thickMin", label: "Thick min" }, { key: "thickTarget", label: "Thick target" }, { key: "thickMax", label: "Thick max" }
            ];
            return [
                { key: "min", label: "Min" }, { key: "target", label: "Target" }, { key: "max", label: "Max" }
            ];
        }

        var specEdit = { kind: "", key: "", before: null };

                function openSpecEdit(kind, key) {
            if (!requireAdmin()) return;
            if (!mspecEditMode) { alert("Turn on Edit mode on the MSPECs tab first."); return; }
            var row = findSpecRow(kind, key);
            if (!row) return;
            specEdit.kind = kind;
            specEdit.key = key;
            specEdit.before = JSON.parse(JSON.stringify(row));
            var fields = specFields(kind);
            var html = "<p class='muted'>Editing " + esc(kind) + " " + esc(key) + " · compact table (same style as Profiles)</p>";
            html += "<div class='profile-scroll'><table class='hist-edit-grid'>";
            var i, f;
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                html += "<tr><th>" + esc(f.label) + "</th><td><input id='se_" + f.key.replace(/\s+/g, "_") + "' value='" + esc(row[f.key]) + "'></td></tr>";
            }
            html += "<tr><th>Why are you changing this?</th><td><textarea id='se_why'></textarea></td></tr>";
            html += "</table></div>";
            $("specEditFields").innerHTML = html;
            $("specEditOverlay").className = "overlay on";
        }

        function closeSpecEdit() { $("specEditOverlay").className = "overlay"; }

        function saveSpecEdit() {
            if (!requireAdmin()) return;
            var why = QD.trim($("se_why") ? $("se_why").value : "");
            if (!why) { alert("Explain why this spec is changing."); return; }
            var row = findSpecRow(specEdit.kind, specEdit.key);
            if (!row) return;
            var fields = specFields(specEdit.kind);
            var i, f, el, after = {};
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                el = $("se_" + f.key.replace(/\s+/g, "_"));
                if (el) row[f.key] = el.value;
                after[f.key] = row[f.key];
            }
            QD.ensureSpecVersion(row);
            row.version = QD.bumpSpecVersion(row.version);
            after.version = row.version;
            addHistory(specEdit.kind, specEdit.key, why, specEdit.before, after);
            saveLocalSpecs();
            audit("spec-edit", specEdit.kind + " " + specEdit.key + " v" + row.version);
            closeSpecEdit();
            renderMspecTable();
            setStatus("Saved " + specEdit.kind + " spec " + specEdit.key + " as v" + row.version + ".");
        }

        function specSnapshotHtml(fields, data, changed) {
            var html = "<table class='list hist-grid'>", i, f, mark = {}, cls;
            if (changed) {
                for (i = 0; i < changed.length; i++) mark[changed[i]] = 1;
            }
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                cls = mark[f.key] ? " class='hist-changed'" : "";
                html += "<tr" + cls + "><td>" + esc(f.label) + "</td><td>" + esc(data ? data[f.key] : "") + "</td></tr>";
            }
            if (data && data.version) html += "<tr><td>Version</td><td>" + esc(data.version) + "</td></tr>";
            html += "</table>";
            return html;
        }

        function viewHistory(kind, key) {
            var row = findSpecRow(kind, key);
            var rows = QD.historyForSpec(specHistory, kind, key);
            var fields = specFields(kind);
            var html = "<h3>" + esc(kind) + " " + esc(key) + " · v" + esc((row && row.version) || "1.0.0") + "</h3>";
            if (row) {
                html += "<div class='card'><div><b>Current spec</b></div>" + specSnapshotHtml(fields, row, null) + "</div>";
            }
            if (!rows.length) html += "<p class='muted'>No edits yet. First uploaded as 1.0.0.</p>";
            var i, r, changed;
            for (i = rows.length - 1; i >= 0; i--) {
                r = rows[i];
                changed = QD.specChangedKeys(r.before, r.after);
                html += "<div class='card'><div><b>" + esc(r.at) + "</b> — " + esc(r.user);
                html += (r.after && r.after.version) ? (" · v" + esc(r.after.version)) : "";
                html += "</div><div>Why: " + esc(r.why) + "</div>";
                html += specSnapshotHtml(fields, r.after || {}, changed);
                html += "</div>";
            }
            $("histBody").innerHTML = html;
            $("histOverlay").className = "overlay on";
        }

        function closeHistory() { $("histOverlay").className = "overlay"; }

        function openItemModal(preset, editing) {
            if (editing && !itemEditMode) { alert("Turn on Edit mode on the Item database tab first."); return; }
            itemModalEditing = !!editing;
            $("newItem").value = preset || $("item").value || "";
            $("newItem").disabled = !!editing;
            $("newDesc").value = "";
            setv("newMspecF", ""); setv("newMspecL", "");
            setv("newWidthB", ""); setv("newWidthF", ""); setv("newWidthL", ""); setv("newWidthP", "");
            setv("newLengthL", ""); setv("newLengthP", "");
            setv("newFootageB", ""); setv("newFootageF", "");
            setv("newPerfB", ""); setv("newPerfF", "");
            setv("newSlits", ""); setv("newSlitsF", ""); setv("newBubble", ""); setv("newColorB", ""); setv("newBarcode", ""); setv("newBoxLabel", ""); setv("newParent", "");
            setv("newThk", ""); setv("newDens", ""); setv("newShots", ""); setv("newSoft", "");
            $("newType").value = editing ? "" : (QD.lineItemType(QD.resolveLineId(currentSite, currentLine)) || "");
            $("itemModalTitle").innerText = editing ? "Edit item #" : "Add item #";
            if (editing && preset) {
                var it = QD.findItem(aio.items, preset);
                if (it) {
                    $("newType").value = QD.itemType(it);
                    $("newDesc").value = it.description || "";
                    setv("newMspecF", it.mspec); setv("newMspecL", it.mspec);
                    setv("newWidthB", it.width); setv("newWidthF", it.width); setv("newWidthL", it.width); setv("newWidthP", it.width);
                    setv("newLengthL", it.length); setv("newLengthP", it.length);
                    setv("newFootageB", it.footage); setv("newFootageF", it.footage);
                    setv("newPerfB", it.perf); setv("newPerfF", it.perf);
                    setv("newSlits", it.slits); setv("newSlitsF", it.slits); setv("newBubble", it.bubbleType); setv("newColorB", it.color || "");
                    setv("newBarcode", it.barcodeLabel || ""); setv("newBoxLabel", it.boxLabel || ""); setv("newParent", it.parent);
                    setv("newThk", it.thickness); setv("newDens", it.density); setv("newShots", it.shots); setv("newSoft", it.soft);
                }
            }
            syncItemTypeFields();
            $("itemOverlay").className = "overlay on";
            $("newType").focus();
        }

        function syncItemTypeFields() {
            var t = $("newType").value;
            $("fieldsBubble").className = "type-fields" + (t === "BUBBLE" ? " on" : "");
            $("fieldsFoam").className = "type-fields" + (t === "FOAM" ? " on" : "");
            $("fieldsLam").className = "type-fields" + (t === "LAM" ? " on" : "");
            $("fieldsPlank").className = "type-fields" + (t === "PLANK" ? " on" : "");
            $("itemTypeHint").innerText = t && QD.ITEM_TYPES[t] ? ("Used on " + QD.ITEM_TYPES[t].lines) : "Pick a type first.";
        }

        function setv(id, v) { var el = $(id); if (el) el.value = v == null ? "" : v; }
        function getv(id) { var el = $(id); return el ? el.value : ""; }

        function closeItemModal() {
            if ($("newItem")) $("newItem").disabled = false;
            $("itemOverlay").className = "overlay";
        }

        function saveNewItem() {
            var item = QD.canonItem($("newItem").value);
            var typ = $("newType").value;
            if (!typ) { alert("Pick a type first."); return; }
            if (!item) { alert("Item # is required."); return; }
            if (!itemModalEditing && QD.findItem(aio.items, item)) {
                alert("Item # " + item + " already exists. Use a different number.");
                return;
            }
            var whyItem = "";
            var beforeItem = null;
            if (itemModalEditing) {
                whyItem = QD.trim(window.prompt("Why are you changing this item?", "") || "");
                if (!whyItem) { alert("Explain why this item is changing."); return; }
                beforeItem = JSON.parse(JSON.stringify(QD.findItem(aio.items, item) || {}));
            }
            var existed = !!QD.findItem(aio.items, item);
            var rec = {
                item: item,
                type: typ,
                description: QD.trim($("newDesc").value),
                mspec: typ === "FOAM" ? QD.canonMspec(getv("newMspecF")) : (typ === "LAM" ? QD.canonMspec(getv("newMspecL")) : ""),
                width: typ === "BUBBLE" ? getv("newWidthB") : typ === "FOAM" ? getv("newWidthF") : typ === "LAM" ? getv("newWidthL") : getv("newWidthP"),
                length: typ === "LAM" ? getv("newLengthL") : typ === "PLANK" ? getv("newLengthP") : "",
                footage: typ === "BUBBLE" ? getv("newFootageB") : typ === "FOAM" ? getv("newFootageF") : "",
                perf: typ === "BUBBLE" ? getv("newPerfB") : typ === "FOAM" ? getv("newPerfF") : "",
                slits: typ === "BUBBLE" ? getv("newSlits") : typ === "FOAM" ? getv("newSlitsF") : "",
                bubbleType: typ === "BUBBLE" ? getv("newBubble") : "",
                color: typ === "BUBBLE" ? getv("newColorB") : "",
                barcodeLabel: typ === "BUBBLE" ? getv("newBarcode") : "",
                boxLabel: typ === "BUBBLE" ? getv("newBoxLabel") : "",
                parent: typ === "LAM" ? getv("newParent") : "",
                thickness: typ === "LAM" ? getv("newThk") : "",
                density: typ === "PLANK" ? getv("newDens") : "",
                shots: typ === "PLANK" ? getv("newShots") : "",
                soft: typ === "PLANK" ? getv("newSoft") : "",
                local: true
            };
            if (!existed) rec.pendingApproval = true;
            aio.items = QD.mergeItems(aio.items, [rec]);
            rebuildItemIndex();
            saveLocalItems();
            if (!existed) {
                loadInbox();
                var inboxLine = typ === "BUBBLE" ? "COEX" : (typ === "FOAM" ? "S4" : (typ === "PLANK" ? "P1" : "RTS"));
                var req = QD.makeInboxRequest("itemChange", session.user, {
                    plant: currentSite, line: inboxLine, item: item, detail: "New " + typ + " item"
                });
                req.changeType = "newItem";
                req.itemType = typ;
                inboxStore.requests.push(req);
                saveInbox();
            }
            if (itemModalEditing) {
                var afterItem = QD.findItem(aio.items, item) || rec;
                QD.ensureSpecVersion(afterItem);
                afterItem.version = QD.bumpSpecVersion(afterItem.version || "1.0.0");
                addHistory("item", item, whyItem, beforeItem, afterItem);
                audit("item-edit", item + " v" + afterItem.version);
            }
            closeItemModal();
            $("item").value = item;
            renderLists();
            onItemChange();
            audit(existed ? "item-edit" : "item-add", item + " " + typ);
            setStatus(existed ? ("Saved item " + item + " (" + typ + ")") : ("Saved item " + item + " — waiting for supervisor approval."));
        }

        function revertItemChange(req) {
            if (!req || req.type !== "itemChange") return;
            var it, idx, i;
            if (req.changeType === "addParent") {
                it = QD.findItem(aio.items, req.item);
                if (!it) return;
                if (it.parents) {
                    idx = it.parents.indexOf(req.parent);
                    if (idx >= 0) it.parents.splice(idx, 1);
                }
                if (it.parent === req.parent) it.parent = (it.parents && it.parents.length) ? it.parents[0] : "";
                it.local = true;
                aio.items = QD.mergeItems(aio.items, [it]);
                rebuildItemIndex();
                saveLocalItems();
            } else if (req.changeType === "newItem") {
                for (i = 0; i < aio.items.length; i++) {
                    it = aio.items[i];
                    if (QD.canonItem(it.item) === QD.canonItem(req.item) && it.local) {
                        it.deleted = true;
                        it.pendingApproval = false;
                    }
                }
                aio.items = QD.mergeItems(aio.items, []);
                rebuildItemIndex();
                saveLocalItems();
            }
        }

        function deleteItem(item) {
            if (!requireAdmin()) return;
            if (!confirm("Delete item " + item + "?")) return;
            var i, it;
            for (i = 0; i < aio.items.length; i++) {
                it = aio.items[i];
                if (QD.canonItem(it.item) === QD.canonItem(item)) it.deleted = true;
            }
            aio.items = QD.mergeItems(aio.items, []);
            var extra = localItemsOnly();
            extra.push({ item: item, deleted: true, local: true });
            writeUtf8((new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "local-items.js"),
                "window.QD_LOCAL=window.QD_LOCAL||{items:[],users:[]};QD_LOCAL.items=" + JSON.stringify(extra) + ";");
            rebuildItemIndex();
            renderLists();
            audit("item-delete", item);
            setStatus("Deleted item " + item);
        }

        function fillReasons() {
            var sel = $("reason");
            if (!sel) return;
            if (sel.tagName !== "SELECT") {
                if (checkReason) sel.value = checkReason;
                return;
            }
            var info = QD.lineInfo(currentLine, currentSite);
            var list = QD.REASONS[(info && info.reasons) || "foam"];
            var i, cur = sel.value;
            sel.options.length = 0;
            for (i = 0; i < list.length; i++) sel.options.add(new Option(list[i], list[i]));
            if (cur) sel.value = cur;
        }

        function setLine(id) {
            currentLine = QD.resolveLineId(currentSite, id);
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            var i, btns = document.getElementById("lineBtns");
            if (btns) {
                btns = btns.getElementsByTagName("button");
                for (i = 0; i < btns.length; i++) btns[i].className = (btns[i].getAttribute("data-line") === info.label) ? "on" : "";
            }
            if ($("formS4")) $("formS4").className = "form" + (form === "s4" ? " on" : "");
            if ($("formS1")) $("formS1").className = "form" + (form === "s1s3" ? " on" : "");
            if ($("formBubble")) $("formBubble").className = "form" + (form === "bubble" ? " on" : "");
            if ($("formP1")) $("formP1").className = "form" + (form === "p1" ? " on" : "");
            if ($("formRts")) $("formRts").className = "form" + (form === "rts" ? " on" : "");
            if ($("lineLabel")) $("lineLabel").innerText = info ? info.label : id;
            if ($("radialCard")) $("radialCard").style.display = (info && (info.id === "S4" || info.id === "S1" || info.id === "S3")) ? "block" : "none";
            syncS1Fields(selectedItem());
            syncBubbleFields(selectedItem());
            syncFoamSlits(selectedItem());
            if (form !== "s4" && form !== "s1s3") {
                lastResultsHtml = "";
                if ($("resultsBox")) $("resultsBox").innerHTML = "";
                if ($("thkMinMax")) $("thkMinMax").innerHTML = "";
            }
            fillReasons();
            if ($("item")) onItemChange();
        }

        function selectedItem() {
            var q = $("item") ? $("item").value : "";
            var key = QD.canonItem(q);
            if (key && itemByNo[key]) return itemByNo[key];
            return QD.findItem(aio.items, q);
        }

        function selectedSpec() {
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            var it = selectedItem();
            if (form === "rts") {
                var parent = val("rparent") || (it && it.parent);
                return QD.findRtsSpec(aio.rts, parent);
            }
            if (form === "p1") return QD.findP1Spec(aio.p1, it);
            if (form !== "s4" && form !== "s1s3") return null;
            var mspec = it ? it.mspec : "";
            if (!mspec && $("mspec")) mspec = $("mspec").value;
            return QD.findMspec(aio.mspecs, mspec);
        }

        function showHits() {
            var box = $("hits");
            var q = $("item").value;
            var hits = QD.searchItems(aio.items, q, 20, QD.lineItemType(QD.resolveLineId(currentSite, currentLine)));
            var html = "", i, it;
            for (i = 0; i < hits.length; i++) {
                it = hits[i];
                html += "<div onclick=\"pickItem('" + String(it.item).replace(/'/g, "") + "')\">" + it.item + " — " + (it.description || "") + "</div>";
            }
            box.innerHTML = html || "<div class='muted'>No matching items</div>";
            box.style.display = q ? "block" : "none";
        }

        function pickItem(item) {
            $("item").value = item;
            $("hits").style.display = "none";
            onItemChange();
        }

        function specLine(label, value) {
            if (value == null || value === "") return "";
            return "<div><b>" + label + "</b> " + esc(value) + "</div>";
        }

        function itemInfoHtml(it, lineId) {
            if (!it) return "<div class='muted'>Type an item # to see item information.</div>";
            var line = lineId || currentLine;
            var info = QD.lineInfo(line, currentSite);
            var form = info ? info.form : "";
            var typ = QD.itemType(it);
            var html = "";
            html += specLine("Item", it.item);
            html += specLine("Description", it.description);
            if (typ === "BUBBLE" || form === "bubble") {
                html += specLine("Bubble type", it.bubbleType);
                html += specLine("Color", it.color);
                if (QD.itemHasSlits(it)) html += specLine("# Slits", it.slits);
                html += specLine("Barcode label", it.barcodeLabel);
                html += specLine("Box label", it.boxLabel);
                return html;
            }
            if (typ === "PLANK" || form === "p1") {
                html += specLine("# Shots", it.shots);
                return html;
            }
            if (typ === "LAM" || form === "rts") {
                html += specLine("Parent", val("rparent") || it.parent);
                return html;
            }
            if (it.mspec) html += specLine("MSPEC", it.mspec);
            else {
                var sp = selectedSpec();
                if (sp && sp["MSPEC #"]) html += specLine("MSPEC", sp["MSPEC #"]);
            }
            if (QD.itemHasSlits(it)) html += specLine("# Slits", it.slits);
            return html;
        }

        function specResultClass(res, ok) {
            if (res == null || res === "" || res === "—") return "neutral";
            if (ok === false) return "bad";
            return "ok";
        }

        function paintSpecTable(it, spec, calc) {
            calc = calc || {};
            if (!it) {
                lastResultsHtml = "";
                if ($("resultsBox")) $("resultsBox").innerHTML = "";
                return;
            }
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            var hideResult = !!specPaintTarget;
            var html = hideResult
                ? "<table class='results'><tr><th></th><th>MIN</th><th>TARGET</th><th>MAX</th></tr>"
                : "<table class='results'><tr><th></th><th>MIN</th><th>TARGET</th><th>MAX</th><th>RESULT</th></tr>";
            function row(label, mn, tg, mx, res, ok) {
                var show = (res == null || res === "") ? "—" : res;
                html += "<tr><td>" + label + "</td><td>" + (mn == null || mn === "" ? "—" : mn) + "</td><td>" + (tg == null || tg === "" ? "—" : tg) + "</td><td>" + (mx == null || mx === "" ? "—" : mx) + "</td>";
                if (!hideResult) html += "<td class='" + specResultClass(show, ok) + "'>" + show + "</td>";
                html += "</tr>";
            }
            if (form === "s4" || form === "s1s3") {
                var lo = spec ? QD.num(spec["Lower Control"]) : NaN;
                var hi = spec ? QD.num(spec["Upper Control"]) : NaN;
                var tg = spec ? QD.num(spec.Target) : NaN;
                var avg = calc.avg;
                row("Gauge (avg)", lo, tg, hi, isFinite(avg) ? avg.toFixed(3) : "", calc.avgPf);
                var rmax = spec ? QD.num(spec["Thickness Range Max"]) : NaN;
                row("Thk range", "—", "—", rmax, isFinite(calc.range) ? calc.range.toFixed(1) : "", calc.rangePf);
                var dlo = spec ? QD.num(spec["Density Min"]) : NaN, dt = spec ? QD.num(spec["Density Target"]) : NaN, dhi = spec ? QD.num(spec["Density Max"]) : NaN;
                row("Density", dlo, dt, dhi, isFinite(calc.density) ? calc.density.toFixed(3) : "", calc.densPf);
                var widthTarget = QD.num(it.width);
                var widthMin = isFinite(widthTarget) ? widthTarget - (form === "s4" ? 1.5 : 0.5) : NaN;
                var widthId = form === "s4" ? "s4width" : "s1width";
                row("Width", widthMin, widthTarget, "—", val(widthId), calc.widthPf);
                if (form === "s1s3" && QD.itemHasPerf(it)) {
                    var perfT = QD.num(it.perf);
                    var pad = isFinite(perfT) && perfT > 20 ? 0.5 : 0.25;
                    row("Perf", isFinite(perfT) ? perfT - pad : "—", perfT, isFinite(perfT) ? perfT + pad : "—", val("s1perf"), calc.perfPf);
                }
                if (currentLine === "S1") {
                    var wMinS1 = QD.itemHasPerf(it) ? 20 : 25;
                    row("Winder tension", wMinS1, "—", "—", val("s1winder"), calc.winderPf);
                    row("Bumper roll pressure", 20, "—", "—", val("s1bumper"), calc.bumperPf);
                }
                if (form === "s1s3" && QD.itemIsUline(it)) {
                    row("Diameter (ULINE)", QD.ULINE_DIAM_MIN, "—", QD.ULINE_DIAM_MAX, val("s1diam"), calc.diamPf);
                }
                if (form === "s4" && isFinite(QD.num(it.length)) && QD.num(it.length) > 0) {
                    row("Sheet Length", QD.num(it.length), "—", "—", val("s4sheet"), calc.sheetPf);
                }
            } else if (form === "bubble") {
                var fam = QD.bubbleFamily(currentLine);
                var liveW = specPaintTarget ? "" : val("bweight");
                var liveOk = calc.weightPf === "Fail" ? false : (liveW ? true : null);
                var pair = QD.bubbleWeightPair(aio.bubble, it.bubbleType);
                var co = pair.coex || QD.bubbleWeightForLine(aio.bubble, "COEX", it.bubbleType);
                var mo = pair.mono || QD.bubbleWeightForLine(aio.bubble, "MONO", it.bubbleType);
                function wCell(bw, field) {
                    if (!bw || bw[field] == null || bw[field] === "") return "—";
                    if (typeof bw[field] === "number" && !isFinite(bw[field])) return "—";
                    return bw[field];
                }
                if (QD.bubbleFamilyAllowed("COEX", currentSite)) {
                    row("COEX weight", wCell(co, "min"), wCell(co, "target"), wCell(co, "max"), fam === "COEX" ? liveW : "", fam === "COEX" ? liveOk : null);
                }
                if (QD.bubbleFamilyAllowed("MONO", currentSite)) {
                    row("MONO weight", wCell(mo, "min"), wCell(mo, "target"), wCell(mo, "max"), fam === "MONO" ? liveW : "", fam === "MONO" ? liveOk : null);
                }
                var dead = QD.deadCellMaxFromFile(aio.bubbleDead, it.bubbleType);
                if (!isFinite(dead)) dead = QD.deadCellMax(it.bubbleType);
                if (isFinite(dead)) row("Dead Cells and Air Transfers Post Vacuum Test", "—", "—", dead, val("bdeadPost"), calc.postPf === "Fail" ? false : (val("bdeadPost") ? true : null));
                var wT = QD.num(it.width);
                if (QD.itemNeedsSlitWidth(it) && isFinite(wT)) row("Slit width", (wT - 0.25).toFixed(2), wT, (wT + 0.25).toFixed(2), val("bwidth"), calc.widthPf === "Fail" ? false : (val("bwidth") ? true : null));
                if (QD.itemHasSlits(it)) row("# Slits", it.slits, it.slits, it.slits, val("bslits"), calc.slitsPf === "Fail" ? false : (val("bslits") ? true : null));
                row("Web width", (QD.WEB_WIDTH_TARGET - QD.WEB_WIDTH_TOL).toFixed(1), QD.WEB_WIDTH_TARGET, (QD.WEB_WIDTH_TARGET + QD.WEB_WIDTH_TOL).toFixed(1), val("bweb"), calc.webWidthPf === "Fail" ? false : (val("bweb") ? true : null));
                var fT = QD.num(it.footage);
                if (isFinite(fT)) row("Footage", fT, "—", "—", val("bfootage"), calc.footagePf === "Fail" ? false : (val("bfootage") ? true : null));
                if (QD.itemHasPerf(it)) {
                    var pT = QD.num(it.perf);
                    row("Perf", isFinite(pT) ? pT - 0.25 : "—", pT, isFinite(pT) ? pT + 0.25 : "—", val("bperfw"), calc.perfWidthPf === "Fail" ? false : (val("bperfw") ? true : null));
                    row("Perf Strength Left", QD.PERF_STRENGTH_MIN, "—", QD.PERF_STRENGTH_MAX, val("bperfLeft"), calc.perfLeftPf === "Fail" ? false : (val("bperfLeft") ? true : null));
                    row("Perf Strength Right", QD.PERF_STRENGTH_MIN, "—", QD.PERF_STRENGTH_MAX, val("bperfRight"), calc.perfRightPf === "Fail" ? false : (val("bperfRight") ? true : null));
                }
                if (QD.itemIsUline(it)) row("Diameter (ULINE)", QD.ULINE_DIAM_MIN, "—", QD.ULINE_DIAM_MAX, val("bdiam"), val("bdiam") ? true : null);
            } else if (form === "p1") {
                var p1s = spec || QD.findP1Spec(aio.p1, it);
                if (p1s) {
                    row("Thickness (frac)", QD.formatThkFraction(p1s.thickMin), QD.formatThkFraction(p1s.thickTarget), QD.formatThkFraction(p1s.thickMax), isFinite(calc.avgSingle) ? QD.formatThkFraction(calc.avgSingle) : "—", null);
                    row("Thickness (dec)", p1s.thickMin, p1s.thickTarget, p1s.thickMax, isFinite(calc.avgSingle) ? calc.avgSingle.toFixed(3) : "", true);
                    row("Density", p1s.min, p1s.density, p1s.max, isFinite(calc.density) ? calc.density.toFixed(3) : "", calc.densityPf !== "Fail");
                    var wMin = QD.num(it.width);
                    if (isFinite(wMin)) row("Width min", (wMin + 0.5).toFixed(1), "—", "—", val("pwidth"), calc.widthPf !== "Fail");
                }
            } else if (form === "rts") {
                var rtsSpec = spec || QD.findRtsSpec(aio.rts, val("rparent") || it.parent);
                if (rtsSpec) {
                    row("Thickness (frac)", QD.formatThkFraction(rtsSpec.min), QD.formatThkFraction(rtsSpec.target), QD.formatThkFraction(rtsSpec.max), "—", null);
                    var thkRes = [];
                    if (QD.trim(val("rt1")) !== "") thkRes.push(QD.formatThkFraction(val("rt1")));
                    if (QD.trim(val("rt2")) !== "") thkRes.push(QD.formatThkFraction(val("rt2")));
                    if (QD.trim(val("rt3")) !== "") thkRes.push(QD.formatThkFraction(val("rt3")));
                    row("Thickness (dec)", rtsSpec.min, rtsSpec.target, rtsSpec.max, thkRes.length ? thkRes.join(", ") : "", calc.thkPf === "Fail" ? false : (thkRes.length ? true : null));
                }
            }
            html += "</table>";
            var box = specPaintTarget || $("resultsBox");
            if (specPaintTarget) {
                specPaintTarget.innerHTML = html;
                return;
            }
            if (box && html !== lastResultsHtml) {
                lastResultsHtml = html;
                box.innerHTML = html;
            }
        }

        function viewLineForItem(it) {
            var typ = itemTab === "bubble" ? "BUBBLE" : (itemTab === "p1" ? "PLANK" : (itemTab === "rts" ? "LAM" : (itemTab === "foam" ? "FOAM" : QD.itemType(it))));
            var info;
            if (typ === "BUBBLE") return currentSite === "GARLAND" ? "G-COEX" : "COEX";
            if (typ === "PLANK") return "P1";
            if (typ === "LAM") return "RTS";
            info = QD.lineInfo(currentLine, currentSite);
            if (info && (info.form === "s4" || info.form === "s1s3")) return currentLine;
            return "S4";
        }

        function viewItem(itemNo) {
            var it = itemByNo[QD.canonItem(itemNo)] || QD.findItem(aio.items, itemNo);
            if (!it) { setStatus("Item not found.", true); return; }
            var lineId = viewLineForItem(it);
            var prevLine = currentLine;
            var spec = null;
            var typ = QD.itemType(it);
            if (typ === "PLANK") spec = QD.findP1Spec(aio.p1, it);
            else if (typ === "LAM") spec = QD.findRtsSpec(aio.rts, it.parent);
            else spec = QD.findMspec(aio.mspecs, it.mspec);
            if ($("itemViewInfo")) $("itemViewInfo").innerHTML = itemInfoHtml(it, lineId);
            specPaintTarget = $("itemViewSpec");
            currentLine = lineId;
            try { paintSpecTable(it, spec, {}); } catch (eV) {}
            currentLine = prevLine;
            specPaintTarget = null;
            if ($("itemViewOverlay")) $("itemViewOverlay").className = "overlay on";
        }

        function closeItemView() {
            if ($("itemViewOverlay")) $("itemViewOverlay").className = "overlay";
        }

        function itemSpecHtml(it, spec, lineId) {
            return itemInfoHtml(it, lineId);
        }

        function lookupTypeFilter() {
            return currentSite === "GARLAND" ? "BUBBLE" : "";
        }

        function showLookupHits() {
            var box = $("lookupHits");
            if (!box || !$("lookupItem")) return;
            var q = $("lookupItem").value;
            var hits = QD.searchItems(aio.items, q, 20, lookupTypeFilter());
            var html = "", i, it;
            for (i = 0; i < hits.length; i++) {
                it = hits[i];
                html += "<div onclick=\"pickLookup('" + String(it.item).replace(/'/g, "") + "')\">" + esc(it.item) + " — " + esc(it.description || "") + "</div>";
            }
            box.innerHTML = html || "<div class='muted'>No matching items</div>";
            box.style.display = q ? "block" : "none";
        }

        function pickLookup(item) {
            if ($("lookupItem")) $("lookupItem").value = item;
            if ($("lookupHits")) $("lookupHits").style.display = "none";
            renderLookup();
        }

        function renderLookup() {
            var box = $("lookupCard");
            if (!box) return;
            var q = $("lookupItem") ? $("lookupItem").value : "";
            var it = itemByNo[QD.canonItem(q)] || QD.findItem(aio.items, q);
            if (it && lookupTypeFilter() && QD.itemType(it) !== lookupTypeFilter()) it = null;
            var spec = it ? QD.findMspec(aio.mspecs, it.mspec) : null;
            box.innerHTML = itemInfoHtml(it, it && QD.itemType(it) === "BUBBLE" ? "COEX" : currentLine);
        }

        function scheduleLookup() {
            if (hitsTimer) window.clearTimeout(hitsTimer);
            hitsTimer = window.setTimeout(function () {
                hitsTimer = null;
                showLookupHits();
                renderLookup();
            }, 80);
        }

        function fillRtsParentSelect(it, selected) {
            var sel = $("rparent");
            if (!sel) return;
            var parents = (it && it.parents && it.parents.length) ? it.parents.slice() : (it && it.parent ? [it.parent] : []);
            var cur = selected || sel.value, i;
            sel.options.length = 0;
            sel.options.add(new Option("", ""));
            for (i = 0; i < parents.length; i++) sel.options.add(new Option(parents[i], parents[i]));
            if (cur && parents.indexOf(cur) >= 0) sel.value = cur;
            else if (it && it.parent) sel.value = it.parent;
        }

        function saveItemParent(itemNo, parent) {
            var it = QD.findItem(aio.items, itemNo);
            if (!it) return;
            if (!it.parents) it.parents = it.parent ? [it.parent] : [];
            if (it.parents.indexOf(parent) < 0) it.parents.push(parent);
            if (!it.parent) it.parent = parent;
            it.local = true;
            aio.items = QD.mergeItems(aio.items, [it]);
            rebuildItemIndex();
            saveLocalItems();
            loadInbox();
            var req = QD.makeInboxRequest("itemChange", session.user, {
                plant: currentSite, line: "RTS", item: itemNo, detail: "Add parent " + parent
            });
            req.changeType = "addParent";
            req.parent = parent;
            inboxStore.requests.push(req);
            saveInbox();
            audit("item-parent-add", itemNo + " -> " + parent);
        }

        function openParentPicker() {
            var it = selectedItem();
            if (!it) return;
            if ($("parentPickerSearch")) $("parentPickerSearch").value = "";
            renderParentPickerList();
            $("parentPickerOverlay").className = "overlay on";
        }

        function renderParentPickerList() {
            var q = $("parentPickerSearch") ? $("parentPickerSearch").value.toLowerCase() : "";
            var html = "", i, it;
            for (i = 0; i < aio.items.length; i++) {
                it = aio.items[i];
                if (it.deleted || QD.itemType(it) !== "FOAM") continue;
                if (q && String(it.item).toLowerCase().indexOf(q) < 0 && String(it.description || "").toLowerCase().indexOf(q) < 0) continue;
                html += "<div onclick=\"pickParentMaterial('" + String(it.item).replace(/'/g, "") + "')\">" + esc(it.item) + " — " + esc(it.description || "") + "</div>";
            }
            if ($("parentPickerList")) $("parentPickerList").innerHTML = html || "<div class='muted'>No matching FOAM items</div>";
        }

        function pickParentMaterial(parent) {
            var it = selectedItem();
            if (!it || !parent) return;
            saveItemParent(it.item, parent);
            fillRtsParentSelect(it, parent);
            $("parentPickerOverlay").className = "overlay";
            onRtsParentChange();
            setStatus("Parent material added. Waiting for supervisor approval.");
        }

        function addRtsParent() {
            openParentPicker();
        }

        function onRtsParentChange() {
            var it = selectedItem();
            if ($("specBox")) $("specBox").innerHTML = itemInfoHtml(it, currentLine);
            compute();
        }

        function syncBubbleFields(it) {
            if ($("bcohWrap")) $("bcohWrap").style.display = QD.itemDescHasCohAdh(it) ? "" : "none";
            if ($("bdiamWrap")) $("bdiamWrap").style.display = QD.itemIsUline(it) ? "" : "none";
            var showSlit = QD.itemNeedsSlitWidth(it);
            var showSlits = QD.itemHasSlits(it);
            var showPerf = QD.itemHasPerf(it);
            if ($("bwidthWrap")) $("bwidthWrap").style.display = showSlit ? "" : "none";
            if ($("bslitsWrap")) $("bslitsWrap").style.display = showSlits ? "" : "none";
            if ($("bperfwWrap")) $("bperfwWrap").style.display = showPerf ? "" : "none";
            if ($("bperfStrWrap")) $("bperfStrWrap").style.display = showPerf ? "" : "none";
            if ($("bbarcodeWrap")) $("bbarcodeWrap").style.display = (it && QD.trim(it.barcodeLabel)) ? "" : "none";
            if ($("bboxWrap")) $("bboxWrap").style.display = (it && QD.trim(it.boxLabel)) ? "" : "none";
            if ($("bbarcodeShow") && it) $("bbarcodeShow").innerText = it.barcodeLabel || "";
            if ($("bboxShow") && it) $("bboxShow").innerText = it.boxLabel || "";
            layoutBubblePairs(it, showSlit, showSlits, showPerf);
            syncBubbleColor();
        }

        function layoutBubblePairs(it, showSlit, showSlits, showPerf) {
            var top = $("bpairTop"), mid = $("bpairMid"), slits = $("bslitsWrap"), web = $("bwebWrap");
            var width = $("bwidthWrap"), foot = $("bfootageWrap"), perf = $("bperfwWrap"), pad = $("bperfPad");
            if (!top || !mid || !web || !foot) return;
            if (showSlits && !showSlit) {
                /* pic1: # Slits + Footage on one row; Web Width alone below */
                top.appendChild(slits);
                top.appendChild(foot);
                mid.appendChild(web);
                if (pad) mid.appendChild(pad);
                if (width) width.style.display = "none";
            } else {
                /* # Slits + Web Width; Slit Width + Footage when slit width shown */
                if (showSlits && slits) top.appendChild(slits);
                top.appendChild(web);
                if (showSlit && width) {
                    width.style.display = "";
                    mid.appendChild(width);
                }
                mid.appendChild(foot);
                if (pad && $("bpairPerfMeta")) $("bpairPerfMeta").appendChild(pad);
            }
            if (perf && $("bpairPerfMeta")) {
                $("bpairPerfMeta").style.display = showPerf ? "" : "none";
                $("bpairPerfMeta").insertBefore(perf, $("bpairPerfMeta").firstChild);
            }
        }

        function syncBubbleColor() {
            var el = $("bcolor");
            if (!el) return;
            var v = String(el.value || "").toUpperCase();
            var map = { CLEAR: "#e5e7eb", GREEN: "#4ade80", PINK: "#f9a8d4", GRAY: "#9ca3af", GREY: "#9ca3af" };
            el.style.color = map[v] || "";
        }

        function syncFoamSlits(it) {
            var show = QD.itemHasSlits(it);
            if ($("s4slitsWrap")) $("s4slitsWrap").style.display = show ? "" : "none";
            if ($("s1slitsWrap")) $("s1slitsWrap").style.display = show ? "" : "none";
        }

        function syncS1Fields(it) {
            if ($("s1winderWrap")) $("s1winderWrap").style.display = (currentLine === "S1" || currentLine === "S3") ? "" : "none";
            if ($("s1bumperWrap")) $("s1bumperWrap").style.display = (currentLine === "S1" || currentLine === "S3") ? "" : "none";
            if ($("s1diamWrap")) $("s1diamWrap").style.display = QD.itemIsUline(it) ? "" : "none";
            if ($("s1perfWrap")) $("s1perfWrap").style.display = QD.itemHasPerf(it) ? "" : "none";
        }

        function checkLinkFieldMap() {
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            if (form === "s4") return { bundle: "s4bundle", width: "s4width", footage: "s4foot", weight: "s4weight", cellMd: "s4md", cellCd: "s4cd", points: "s4t1" };
            if (form === "s1s3") return { bundle: "s1bundle", width: "s1width", footage: "s1foot", perf: "s1perf", weight: "s1weight", cellMd: "s1md", cellCd: "s1cd", winderTension: "s1winder", bumperPressure: "s1bumper", diameter: "s1diam", points: "s1t1" };
            if (form === "bubble") return { cohAdh: "bcoh", deadPost: "bdeadPost", width: "bwidth", webWidth: "bweb", footage: "bfootage", perfWidth: "bperfw", perfLeft: "bperfLeft", perfRight: "bperfRight", weight: "bweight", color: "bcolor", delam: "bdelam", prodNo: "bprod", rollNo: "broll", diameter: "bdiam" };
            if (form === "p1") return { length: "plength", width: "pwidth", cellMd: "pmd", cellCd: "pcd", weight: "pweight", headPoints: "pht1", tailPoints: "ptt1" };
            if (form === "rts") return { parent: "rparent", parentDate: "rdate", shift: "rshift", width: "rwidth", length: "rlength", color: "rcolor", delam: "rdelam", alligator: "rallig", tattoo: "rtattoo" };
            return {};
        }

        function activeFormHeading() {
            var forms = ["formS4", "formS1", "formBubble", "formP1", "formRts"], i, el, h2;
            for (i = 0; i < forms.length; i++) {
                el = $(forms[i]);
                if (el && String(el.className || "").indexOf(" on") >= 0) {
                    h2 = el.getElementsByTagName("h2")[0];
                    if (h2) return h2;
                }
            }
            return null;
        }

        function insertFieldLabelLink(lab, field, link) {
            var node = field, before = field;
            while (node && node !== lab) {
                before = node;
                node = node.parentNode;
            }
            if (before && before.parentNode === lab) lab.insertBefore(link, before);
            else lab.insertBefore(link, lab.firstChild);
        }

        function appendCheckLinks() {
            var links = document.getElementsByClassName("wi-link"), i;
            while (links.length) links[0].parentNode.removeChild(links[0]);
            loadDocs();
            var fmap = checkLinkFieldMap(), docs = docsStore.docs, d, el, lab, fid;
            var link, url, h2, matchLines;
            matchLines = [currentLine];
            for (i = 0; i < docs.length; i++) {
                d = docs[i];
                if (!d || !d.checkLink) continue;
                if (!QD.docMatchesUserLines(d.line, matchLines)) continue;
                url = d.url || "";
                if (d.checkLink === "entries") {
                    h2 = activeFormHeading();
                    if (!h2) continue;
                    h2.appendChild(document.createTextNode(" "));
                    link = document.createElement("a");
                    link.href = "#";
                    link.className = "wi-link";
                    link.style.color = "#93c5fd";
                    link.style.textDecoration = "underline";
                    link.style.fontWeight = "400";
                    link.appendChild(document.createTextNode(d.name || "Instructions"));
                    link.onclick = (function (u) { return function () { openDocLink(u); return false; }; })(url);
                    h2.appendChild(link);
                    continue;
                }
                fid = fmap[d.checkLink];
                if (!fid) continue;
                el = $(fid);
                if (!el) continue;
                lab = el.parentNode;
                if (!lab || lab.tagName !== "LABEL") continue;
                link = document.createElement("a");
                link.href = "#";
                link.className = "wi-link";
                link.style.color = "#93c5fd";
                link.style.textDecoration = "underline";
                link.style.fontWeight = "400";
                link.style.marginLeft = "6px";
                link.appendChild(document.createTextNode(d.name || "Instructions"));
                link.onclick = (function (u) {
                    return function () { openDocLink(u); return false; };
                })(url);
                insertFieldLabelLink(lab, el, link);
            }
        }

        function onItemChange() {
            var it = selectedItem();
            if ($("desc")) { $("desc").innerText = it ? (it.description || "") : ""; $("desc").style.display = "none"; }
            if ($("mspec")) $("mspec").value = (it && it.mspec) ? it.mspec : "";
            if ($("mspecText")) $("mspecText").innerText = (it && it.mspec) ? it.mspec : "";
            if ($("mspecWrap")) $("mspecWrap").style.display = "none";
            if (QD.lineInfo(currentLine, currentSite) && QD.lineInfo(currentLine, currentSite).form === "rts") fillRtsParentSelect(it);
            if ($("specBox")) $("specBox").innerHTML = itemInfoHtml(it, currentLine);
            syncS4SheetVisibility(it);
            syncP1Double(it);
            syncBubbleFields(it);
            syncS1Fields(it);
            syncFoamSlits(it);
            if ($("checkNotes") && $("notes")) $("checkNotes").value = $("notes").value;
            appendCheckLinks();
            compute();
        }

        function syncS4SheetVisibility(it) {
            var wrap = $("s4sheetWrap");
            if (!wrap) return;
            var info = QD.lineInfo(currentLine, currentSite);
            var len = it ? QD.num(it.length) : NaN;
            var need = !!(info && info.form === "s4" && isFinite(len) && len > 0);
            wrap.style.display = need ? "" : "none";
        }

        function syncP1Double(it) {
            var wrap = $("p1TailWrap");
            if (!wrap) return;
            var info = QD.lineInfo(currentLine, currentSite);
            var dbl = !!(info && info.form === "p1" && QD.isDoubleShot(it && it.shots));
            wrap.style.display = dbl ? "block" : "none";
        }

        function val(id) { return $(id) ? $(id).value : ""; }

        function getRdate() {
            var raw = $("rdate") ? QD.trim($("rdate").value) : "";
            if (!raw) return "";
            var d = QD.parseLooseDate(raw);
            if (!d) return "";
            var mm = d.getMonth() + 1, dd = d.getDate();
            return d.getFullYear() + "-" + (mm < 10 ? "0" : "") + mm + "-" + (dd < 10 ? "0" : "") + dd;
        }

        function setRdate(iso) {
            var el = $("rdate");
            if (!el) return;
            if (!iso) { el.value = ""; return; }
            var d = QD.parseLooseDate(iso);
            if (!d) { el.value = ""; return; }
            var mm = d.getMonth() + 1, dd = d.getDate();
            el.value = (mm < 10 ? "0" : "") + mm + "/" + (dd < 10 ? "0" : "") + dd + "/" + d.getFullYear();
        }

        var datePickerMonth = null;

        function pad2(n) { return (n < 10 ? "0" : "") + n; }

        function toggleDatePicker(forceClose) {
            var box = $("rdatePicker");
            if (!box) return;
            if (forceClose === true || box.style.display === "block") {
                box.style.display = "none";
                return;
            }
            var cur = QD.parseLooseDate(val("rdate")) || new Date();
            datePickerMonth = new Date(cur.getFullYear(), cur.getMonth(), 1);
            renderDatePicker();
            box.style.display = "block";
        }

        function shiftDatePicker(delta) {
            if (!datePickerMonth) datePickerMonth = new Date();
            datePickerMonth = new Date(datePickerMonth.getFullYear(), datePickerMonth.getMonth() + delta, 1);
            renderDatePicker();
        }

        function pickDateDay(y, m, d) {
            setRdate(y + "-" + pad2(m) + "-" + pad2(d));
            toggleDatePicker(true);
            compute();
            scheduleSubmit();
        }

        function renderDatePicker() {
            var box = $("rdatePicker");
            if (!box || !datePickerMonth) return;
            var y = datePickerMonth.getFullYear(), m = datePickerMonth.getMonth();
            var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            var selected = QD.parseLooseDate(val("rdate"));
            var first = new Date(y, m, 1);
            var start = first.getDay();
            var daysIn = new Date(y, m + 1, 0).getDate();
            var prevDays = new Date(y, m, 0).getDate();
            var html = "<div class='dp-head'>";
            html += "<button type='button' onclick='shiftDatePicker(-1)'>&lt;</button>";
            html += "<div class='dp-title'>" + months[m] + " " + y + "</div>";
            html += "<button type='button' class='dp-next' onclick='shiftDatePicker(1)'>&gt;</button>";
            html += "</div><table><tr><th>Su</th><th>Mo</th><th>Tu</th><th>We</th><th>Th</th><th>Fr</th><th>Sa</th></tr><tr>";
            var i, day, cellY, cellM, cellD, cls, isSel, total = 0;
            for (i = 0; i < start; i++) {
                cellD = prevDays - start + i + 1;
                cellM = m === 0 ? 12 : m;
                cellY = m === 0 ? y - 1 : y;
                html += "<td><button type='button' class='muted' onclick='pickDateDay(" + cellY + "," + cellM + "," + cellD + ")'>" + cellD + "</button></td>";
                total += 1;
            }
            for (day = 1; day <= daysIn; day++) {
                if (total > 0 && total % 7 === 0) html += "</tr><tr>";
                isSel = selected && selected.getFullYear() === y && selected.getMonth() === m && selected.getDate() === day;
                cls = isSel ? "on" : "";
                html += "<td><button type='button'" + (cls ? " class='" + cls + "'" : "") + " onclick='pickDateDay(" + y + "," + (m + 1) + "," + day + ")'>" + day + "</button></td>";
                total += 1;
            }
            day = 1;
            while (total % 7 !== 0) {
                cellM = m + 2 > 12 ? 1 : m + 2;
                cellY = m + 2 > 12 ? y + 1 : y;
                html += "<td><button type='button' class='muted' onclick='pickDateDay(" + cellY + "," + cellM + "," + day + ")'>" + day + "</button></td>";
                day += 1;
                total += 1;
            }
            html += "</tr></table><div class='dp-foot'>";
            html += "<button type='button' class='secondary' onclick='setRdate(\"\");toggleDatePicker(true);compute();'>Clear</button>";
            html += "<button type='button' class='secondary' onclick='toggleDatePicker(true)'>Close</button>";
            html += "</div>";
            box.innerHTML = html;
        }

        function onRdateTyped() {
            scheduleCompute();
            scheduleSubmit();
        }

        function collectPoints(prefix, n) {
            var out = [], i;
            for (i = 1; i <= n; i++) out.push(val(prefix + i));
            return out;
        }

        function mark(id, pf) {
            var el = $(id);
            if (!el) return;
            el.innerText = pf || "";
            el.className = "pf " + (String(pf).toLowerCase() === "fail" ? "fail" : (pf ? "pass" : ""));
        }

        function setOverallPf(pf, ready) {
            var el = $("overallPf");
            if (!el) return;
            var text = QD.trim(pf);
            if (!ready || !text) {
                el.className = "pf-huge";
                el.innerText = "";
                return;
            }
            el.className = "pf-huge on " + (text.toLowerCase() === "fail" ? "fail" : "pass");
            el.innerText = text.toUpperCase();
        }

        function chipLabel(prefix, index, label, extreme) {
            var el = $(prefix + index);
            var wrap = el ? el.parentNode : null;
            var sp;
            if (!wrap || String(wrap.className || "").indexOf("chip") < 0) return;
            sp = wrap.getElementsByTagName("span")[0];
            if (!sp) return;
            sp.className = extreme ? "ex" : "";
            sp.innerText = label;
        }

        function resetChipLabels(prefix, n) {
            var i, el, wrap;
            for (i = 1; i <= n; i++) {
                el = $(prefix + i);
                wrap = el ? el.parentNode : null;
                if (wrap && String(wrap.className || "").indexOf("chip") >= 0) wrap.className = "chip";
                chipLabel(prefix, i, "T" + i, false);
            }
        }

        function paintThickness(pts, lo, hi, range, rmax, dens, spec, it, widthPf, pf) {
            var info = QD.lineInfo(currentLine, currentSite);
            var prefix = currentLine === "S4" ? "s4t" : "s1t";
            var ext = QD.pointExtremes(pts);
            var i, el, wrap, band, extreme, label, filled = 0;
            for (i = 0; i < 13; i++) {
                if (QD.trim(pts[i]) !== "") filled += 1;
            }
            for (i = 0; i < 13; i++) {
                el = $(prefix + (i + 1));
                if (!el) continue;
                wrap = el.parentNode;
                band = QD.pointBand(pts[i], lo, hi);
                extreme = filled === 13 && (i === ext.minIndex || i === ext.maxIndex);
                if (wrap && wrap.className && String(wrap.className).indexOf("chip") >= 0) {
                    var keepNeed = labelHasClass(wrap, "need");
                    wrap.className = "chip" + (band ? " " + band : "") + (extreme ? " extreme" : "") + (keepNeed ? " need" : "");
                    label = "T" + (i + 1);
                    if (extreme) label += i === ext.minIndex ? " · MIN" : " · MAX";
                    chipLabel(prefix, i + 1, label, extreme);
                } else {
                    el.style.background = band === "over" ? "#7f1d1d" : (band === "under" ? "#713f12" : (band === "in" ? "#14532d" : ""));
                    el.style.color = "#fff";
                }
            }
            if ($("thkMinMax")) {
                $("thkMinMax").innerHTML = filled === 13 && ext.minIndex >= 0
                    ? ("MIN <b>" + ext.min.toFixed(3) + " (T" + (ext.minIndex + 1) + ")</b> &nbsp; MAX <b>" + ext.max.toFixed(3) + " (T" + (ext.maxIndex + 1) + ")</b>")
                    : "";
            }
            var showGraph = currentLine === "S4" || currentLine === "S1" || currentLine === "S3";
            if ($("radialCard")) $("radialCard").style.display = showGraph ? "block" : "none";
            var cv = $("radialCanvas");
            if (cv && showGraph) {
                cv.style.display = "block";
                var key = (pts || []).join(",") + "|" + lo + "|" + hi + "|" + themeMode;
                if (key !== lastRadialKey) {
                    lastRadialKey = key;
                    try { QD.drawCentration(cv, pts, lo, hi, themeMode); } catch (e) {}
                }
            } else if (cv) cv.style.display = "none";
        }

        function compute() {
            try { bindThicknessConverters(); } catch (eBindTh) {}
            if (computing) return lastCalc || {};
            computing = true;
            try {
                lastCalc = computeNow();
                try { syncSubmitBtn(); } catch (eSync) {}
                return lastCalc;
            } finally {
                computing = false;
            }
        }

        function computeNow() {
            var info = QD.lineInfo(currentLine, currentSite);
            var spec = selectedSpec();
            var it = selectedItem();
            var flags = [];
            var avg, range, dens, pf;
            if (!info) return {};
            if (info.form === "s4" || info.form === "s1s3") {
                syncFoamSlits(it);
                var pts = collectPoints(info.form === "s4" ? "s4t" : "s1t", 13);
                avg = QD.avg(pts);
                range = QD.rangeMil(pts);
                dens = info.form === "s4" ? QD.densityS4(val("s4weight"), avg) : QD.densityS1(val("s1weight"), avg);
                $("avgOut").innerText = isFinite(avg) ? avg.toFixed(4) : "";
                $("rangeOut").innerText = isFinite(range) ? range.toFixed(1) : "";
                $("densOut").innerText = isFinite(dens) ? dens.toFixed(3) : "";
                var lo = spec ? QD.num(spec["Lower Control"]) : NaN;
                var hi = spec ? QD.num(spec["Upper Control"]) : NaN;
                var rmax = spec ? QD.num(spec["Thickness Range Max"]) : NaN;
                var widthTarget = it ? QD.num(it.width) : NaN;
                var widthMin = isFinite(widthTarget) ? widthTarget - (info.form === "s4" ? 1.5 : 0.5) : NaN;
                var widthPf = QD.inRange(val(info.form === "s4" ? "s4width" : "s1width"), widthMin, Infinity);
                var lenPf = null, perfPf = null, s1DiamPf = null, winderPf = null, bumperPf = null;
                flags.push(QD.pf(widthPf));
                mark("widthMark", QD.pf(widthPf));
                var avgPf = QD.inRange(avg, lo, hi);
                flags.push(QD.pf(avgPf));
                mark("avgMark", QD.pf(avgPf));
                var rangePf = !isFinite(range) || !isFinite(rmax) ? null : range <= rmax;
                flags.push(QD.pf(rangePf));
                mark("rangeMark", QD.pf(rangePf));
                if (info.form === "s4") {
                    var lenMin = it ? QD.num(it.length) : NaN;
                    lenPf = val("s4sheet") === "" ? null : QD.inRange(val("s4sheet"), lenMin, Infinity);
                    flags.push(QD.pf(lenPf));
                    mark("sheetMark", QD.pf(lenPf));
                }
                if (info.form === "s1s3") {
                    var perfT2 = it ? QD.num(it.perf) : NaN;
                    var pad2 = isFinite(perfT2) && perfT2 > 20 ? 0.5 : 0.25;
                    perfPf = val("s1perf") === "" || !isFinite(perfT2) || perfT2 === 0 ? null : QD.inRange(val("s1perf"), perfT2 - pad2, perfT2 + pad2);
                    flags.push(QD.pf(perfPf));
                    mark("perfMark", QD.pf(perfPf));
                    if (val("s1bundleFit") === "FAIL") flags.push("Fail");
                    if (currentLine === "S1" || currentLine === "S3") {
                        var wMin = QD.itemHasPerf(it) ? 20 : 25;
                        winderPf = QD.inRange(val("s1winder"), wMin, Infinity);
                        bumperPf = QD.inRange(val("s1bumper"), 20, Infinity);
                        flags.push(QD.pf(winderPf));
                        flags.push(QD.pf(bumperPf));
                    }
                    if (QD.itemIsUline(it)) {
                        var diam = QD.num(val("s1diam"));
                        s1DiamPf = QD.inRange(diam, QD.ULINE_DIAM_MIN, QD.ULINE_DIAM_MAX);
                        flags.push(QD.pf(s1DiamPf));
                    }
                }
                if (QD.itemHasSlits(it)) {
                    var slitsIdFoam = info.form === "s4" ? "s4slits" : "s1slits";
                    if (QD.trim(val(slitsIdFoam)) !== "") {
                        flags.push(QD.pf(QD.slitsExactMatch(val(slitsIdFoam), it.slits)));
                    }
                }
                pf = QD.overallFromFlags(currentLine, val("reason") || checkReason, flags);
                syncS4SheetVisibility(it);
                var filledPts = 0, fi;
                for (fi = 0; fi < pts.length; fi++) if (QD.trim(pts[fi]) !== "") filledPts += 1;
                var sheetNeeded = info.form === "s4" && it && isFinite(QD.num(it.length)) && QD.num(it.length) > 0;
                var widthId = info.form === "s4" ? "s4width" : "s1width";
                var weightId = info.form === "s4" ? "s4weight" : "s1weight";
                var readyFoam = filledPts === 13
                    && QD.trim(val(widthId)) !== ""
                    && QD.trim(val(weightId)) !== ""
                    && (!sheetNeeded || QD.trim(val("s4sheet")) !== "");
                if (QD.itemHasSlits(it)) {
                    readyFoam = readyFoam && QD.trim(val(info.form === "s4" ? "s4slits" : "s1slits")) !== "";
                }
                if (info.form === "s1s3" && (currentLine === "S1" || currentLine === "S3")) {
                    readyFoam = readyFoam && QD.trim(val("s1winder")) !== "" && QD.trim(val("s1bumper")) !== "";
                }
                if (info.form === "s1s3" && QD.itemIsUline(it)) {
                    readyFoam = readyFoam && QD.trim(val("s1diam")) !== "";
                }
                if (info.form === "s1s3" && QD.itemHasPerf(it)) {
                    readyFoam = readyFoam && QD.trim(val("s1perf")) !== "";
                }
                setOverallPf(pf, readyFoam);
                paintThickness(pts, lo, hi, range, rmax, dens, spec, it, widthPf, pf);
                var foamCalc = {
                    avg: avg, range: range, density: dens, widthPf: widthPf !== false,
                    avgPf: avgPf !== false, rangePf: rangePf !== false,
                    densPf: QD.inRange(dens, spec ? QD.num(spec["Density Min"]) : NaN, spec ? QD.num(spec["Density Max"]) : NaN) !== false,
                    sheetPf: info.form === "s4" ? (lenPf !== false) : true,
                    perfPf: info.form === "s1s3" ? (perfPf !== false) : true,
                    diamPf: info.form === "s1s3" && QD.itemIsUline(it) ? (s1DiamPf !== false) : true,
                    winderPf: (currentLine === "S1" || currentLine === "S3") ? (winderPf === false ? false : (QD.trim(val("s1winder")) ? true : null)) : null,
                    bumperPf: (currentLine === "S1" || currentLine === "S3") ? (bumperPf === false ? false : (QD.trim(val("s1bumper")) ? true : null)) : null
                };
                paintSpecTable(it, spec, foamCalc);
                return { avg: avg, range: range, density: dens, passFail: pf, points: pts, widthPf: QD.pf(widthPf) };
            }
            if (info.form === "bubble") {
                var bs = it ? QD.bubbleWeightForLine(aio.bubble, currentLine, it.bubbleType) : null;
                var bw = bs ? { min: QD.num(bs.min), target: QD.num(bs.target), max: QD.num(bs.max) } : null;
                var deadMax = it ? QD.deadCellMaxFromFile(aio.bubbleDead, it.bubbleType) : NaN;
                if (!isFinite(deadMax) && it) deadMax = QD.deadCellMax(it.bubbleType);
                var needsSlit = QD.itemNeedsSlitWidth(it);
                var wPf = needsSlit && it && it.width ? QD.inRange(val("bwidth"), QD.num(it.width) - 0.25, QD.num(it.width) + 0.25) : null;
                var webPf = QD.inRange(val("bweb"), QD.WEB_WIDTH_TARGET - QD.WEB_WIDTH_TOL, QD.WEB_WIDTH_TARGET + QD.WEB_WIDTH_TOL);
                var fPf = it && it.footage ? QD.inRange(val("bfootage"), QD.num(it.footage), Infinity) : null;
                var pTarget = it ? QD.num(it.perf) : NaN;
                var pPf = !isFinite(pTarget) ? "N/A" : QD.pf(QD.inRange(val("bperfw"), pTarget - 0.25, pTarget + 0.25));
                var leftPf = val("bperfLeft") === "" ? "" : QD.pf(QD.inRange(val("bperfLeft"), QD.PERF_STRENGTH_MIN, QD.PERF_STRENGTH_MAX));
                var rightPf = val("bperfRight") === "" ? "" : QD.pf(QD.inRange(val("bperfRight"), QD.PERF_STRENGTH_MIN, QD.PERF_STRENGTH_MAX));
                var wtPf = (bw && QD.trim(val("bweight")) !== "")
                    ? QD.pf(QD.inRange(val("bweight"), bw.min, isFinite(bw.max) ? bw.max : Infinity))
                    : "";
                var post = QD.num(val("bdeadPost")) || 0;
                var postPf = isFinite(deadMax) ? QD.pf(post <= deadMax) : "";
                var diamPf = "";
                if (QD.itemIsUline(it) && QD.trim(val("bdiam")) !== "") {
                    diamPf = QD.pf(QD.inRange(val("bdiam"), QD.ULINE_DIAM_MIN, QD.ULINE_DIAM_MAX));
                }
                syncBubbleFields(it);
                var slitsPf = "";
                if (QD.itemHasSlits(it) && QD.trim(val("bslits")) !== "") {
                    slitsPf = QD.pf(QD.slitsExactMatch(val("bslits"), it.slits));
                }
                flags = [QD.pf(webPf), QD.pf(fPf), pPf, leftPf, rightPf, wtPf, postPf, val("bdelam")];
                if (needsSlit) flags.unshift(QD.pf(wPf));
                if (slitsPf) flags.push(slitsPf);
                if (QD.itemDescHasCohAdh(it)) flags.push(val("bcoh"));
                if (diamPf) flags.push(diamPf);
                pf = QD.overallFromFlags(currentLine, val("reason"), flags);
                var bubbleIds = ["bweb", "bfootage", "bweight", "bdeadPost", "bcolor", "bdelam", "bprod", "broll"];
                if (needsSlit) bubbleIds.push("bwidth");
                if (QD.itemHasSlits(it)) bubbleIds.push("bslits");
                if (QD.itemDescHasCohAdh(it)) bubbleIds.push("bcoh");
                if (QD.itemHasPerf(it)) { bubbleIds.push("bperfw"); bubbleIds.push("bperfLeft"); bubbleIds.push("bperfRight"); }
                if (QD.itemIsUline(it)) bubbleIds.push("bdiam");
                var readyBubble = true, bi;
                for (bi = 0; bi < bubbleIds.length; bi++) {
                    if (QD.trim(val(bubbleIds[bi])) === "") readyBubble = false;
                }
                setOverallPf(pf, readyBubble);
                mark("bwidthMark", needsSlit ? QD.pf(wPf) : "");
                mark("bwebMark", QD.pf(webPf));
                mark("bfootMark", QD.pf(fPf));
                mark("bslitsMark", slitsPf);
                mark("bperfMark", pPf);
                mark("bperfLeftMark", leftPf);
                mark("bperfRightMark", rightPf);
                mark("bwtMark", wtPf);
                var bubbleCalc = { widthPf: needsSlit ? QD.pf(wPf) : "", webWidthPf: QD.pf(webPf), footagePf: QD.pf(fPf), perfWidthPf: pPf, perfLeftPf: leftPf, perfRightPf: rightPf, weightPf: wtPf, postPf: postPf, slitsPf: slitsPf };
                paintSpecTable(it, spec, bubbleCalc);
                return { passFail: pf, widthPf: needsSlit ? QD.pf(wPf) : "", webWidthPf: QD.pf(webPf), footagePf: QD.pf(fPf), perfWidthPf: pPf, perfLeftPf: leftPf, perfRightPf: rightPf, weightPf: wtPf, postPf: postPf, deadMax: deadMax };
            }
            if (info.form === "p1") {
                var headPoints = collectPoints("pht", 12);
                var tailPoints = collectPoints("ptt", 12);
                var dbl = QD.isDoubleShot(it && it.shots);
                syncP1Double(it);
                var avgS = QD.avg(headPoints);
                var length = QD.num(val("plength")), width = QD.num(val("pwidth")), wt = QD.num(val("pweight"));
                var vol = (isFinite(avgS) && isFinite(length) && isFinite(width)) ? (avgS * width * length) / 6912 : NaN;
                dens = (isFinite(wt) && isFinite(vol) && vol) ? wt / vol : NaN;
                var lenT = it ? QD.num(it.length) : NaN;
                var widT = it ? QD.num(it.width) : NaN;
                var densT = QD.num(it && it.density);
                var lPf = QD.pf(QD.inRange(length, lenT, isFinite(lenT) ? lenT + 5 : NaN));
                var wPf2 = QD.pf(QD.inRange(width, widT, isFinite(widT) ? widT + 5 : NaN));
                var dPf = QD.pf(!isFinite(dens) || !isFinite(densT) ? null : dens >= densT);
                flags = [lPf, wPf2, dPf];
                var headFilled = 0, tailFilled = 0, pi;
                for (pi = 0; pi < 12; pi++) {
                    if (QD.trim(headPoints[pi]) !== "") headFilled += 1;
                    if (QD.trim(tailPoints[pi]) !== "") tailFilled += 1;
                }
                if (dbl) {
                    flags.push(QD.pf(QD.inRange(val("ptailLength"), lenT, isFinite(lenT) ? lenT + 5 : NaN)));
                    flags.push(QD.pf(QD.inRange(val("ptailWidth"), widT, isFinite(widT) ? widT + 5 : NaN)));
                }
                pf = QD.overallFromFlags(currentLine, val("reason"), flags);
                $("pavgOut").innerText = isFinite(avgS) ? avgS.toFixed(3) : "";
                $("pvolOut").innerText = isFinite(vol) ? vol.toFixed(3) : "";
                $("pdensOut").innerText = isFinite(dens) ? dens.toFixed(3) : "";
                var readyP1 = headFilled === 12
                    && QD.trim(val("plength")) !== "" && QD.trim(val("pwidth")) !== "" && QD.trim(val("pweight")) !== "";
                if (dbl) {
                    readyP1 = readyP1 && tailFilled === 12
                        && QD.trim(val("ptailLength")) !== "" && QD.trim(val("ptailWidth")) !== "";
                }
                setOverallPf(pf, readyP1);
                paintSpecTable(it, spec, { avgSingle: avgS, density: dens, widthPf: wPf2, densityPf: dPf });
                return {
                    passFail: pf, avgSingle: avgS, volume: vol, density: dens,
                    lengthPf: lPf, widthPf: wPf2, densityPf: dPf,
                    headPoints: headPoints, tailPoints: tailPoints
                };
            }
            if (info.form === "rts") {
                var rtsSpec = QD.findRtsSpec(aio.rts, val("rparent") || (it && it.parent));
                var t1 = QD.num(val("rt1")), t2 = QD.num(val("rt2")), t3 = QD.num(val("rt3"));
                var thkLo = rtsSpec ? QD.num(rtsSpec.min) : (spec ? QD.num(spec["Lower Control"] || spec.Target) : NaN);
                var thkHi = rtsSpec ? QD.num(rtsSpec.max) : (spec ? QD.num(spec["Upper Control"] || spec.Target) : NaN);
                if (!isFinite(thkLo) && it) thkLo = QD.num(it.thickness);
                if (!isFinite(thkHi) && it) thkHi = QD.num(it.thickness);
                var thkPf = QD.pf(QD.allThkInRange([val("rt1"), val("rt2"), val("rt3")], thkLo, thkHi));
                var widT2 = it ? QD.num(it.width) : NaN;
                var lenT2 = it ? QD.num(it.length) : NaN;
                var wPf3 = QD.pf(QD.inRange(val("rwidth"), widT2, Infinity));
                var lPf2 = QD.pf(QD.inRange(val("rlength"), lenT2, Infinity));
                var mfgPf = QD.pf(QD.mfgDatePf(getRdate()));
                mark("rmfgMark", mfgPf);
                flags = [thkPf, wPf3, lPf2, mfgPf, val("rdelam"), val("rallig"), val("rtattoo")];
                pf = QD.overallFromFlags(currentLine, val("reason"), flags);
                var thkMarkEl = $("rthkMark");
                if (thkMarkEl) {
                    var thkParts = [];
                    if (QD.trim(val("rt1")) !== "") thkParts.push(QD.formatThkFraction(t1));
                    if (QD.trim(val("rt2")) !== "") thkParts.push(QD.formatThkFraction(t2));
                    if (QD.trim(val("rt3")) !== "") thkParts.push(QD.formatThkFraction(t3));
                    thkMarkEl.innerText = thkParts.length ? thkParts.join(", ") + (thkPf ? " " + thkPf : "") : "";
                    thkMarkEl.className = "pf " + (String(thkPf).toLowerCase() === "fail" ? "fail" : (thkParts.length && thkPf ? "pass" : ""));
                }
                var rtsIds = ["rparent", "rshift", "rwidth", "rlength", "rcolor", "rdelam", "rallig", "rtattoo", "rt1", "rt2", "rt3"];
                var readyRts = getRdate() !== "";
                var ri;
                for (ri = 0; ri < rtsIds.length; ri++) {
                    if (QD.trim(val(rtsIds[ri])) === "") readyRts = false;
                }
                setOverallPf(pf, readyRts);
                paintSpecTable(it, rtsSpec, { thkPf: thkPf });
                return { passFail: pf, t1: val("rt1"), t2: val("rt2"), t3: val("rt3"), thkPf: thkPf, widthPf: wPf3, lengthPf: lPf2, mfgPf: mfgPf, tattoo: val("rtattoo") };
            }
            return {};
        }

        function collectCheckInput(calc) {
            calc = calc || {};
            var info = QD.lineInfo(currentLine, currentSite);
            var it = selectedItem();
            var spec = selectedSpec();
            var reason = val("reason");
            var input = {
                line: currentLine,
                item: val("item"),
                description: it ? it.description : ($("desc") ? $("desc").innerText : ""),
                mspec: spec ? spec["MSPEC #"] : val("mspec"),
                user: session.user || val("user"),
                reason: reason,
                notes: val("notes"),
                passFail: calc ? calc.passFail : "",
                itemLength: it ? it.length : "",
                itemObj: it,
                shots: it ? it.shots : ""
            };
            if (!info) return input;
            if (info.form === "s4") {
                input.bundle = val("s4bundle"); input.width = val("s4width"); input.footage = val("s4foot");
                input.weight = val("s4weight");
                input.perfOn = val("s4perfOn"); input.cellMd = val("s4md"); input.cellCd = val("s4cd");
                input.avg = calc.avg; input.range = calc.range; input.density = calc.density;
                input.points = calc.points;                 input.sheetLength = val("s4sheet");
                input.slits = QD.itemHasSlits(it) ? val("s4slits") : "";
            } else if (info.form === "s1s3") {
                input.bundle = val("s1bundle"); input.width = val("s1width"); input.footage = val("s1foot");
                input.weight = val("s1weight");
                input.perf = val("s1perf"); input.bundleFit = val("s1bundleFit"); input.tape = val("s1tape");
                input.cellMd = val("s1md"); input.cellCd = val("s1cd");
                input.avg = calc.avg; input.range = calc.range; input.density = calc.density;
                input.points = calc.points; input.diameter = val("s1diam");
                input.winderTension = val("s1winder"); input.bumperPressure = val("s1bumper");
                input.slits = QD.itemHasSlits(it) ? val("s1slits") : "";
            } else if (info.form === "bubble") {
                input.cohAdh = val("bcoh");
                input.width = QD.itemNeedsSlitWidth(it) ? val("bwidth") : (it ? (it.width || "") : "");
                input.webWidth = val("bweb"); input.footage = val("bfootage");
                input.perfWidth = val("bperfw"); input.perfLeft = val("bperfLeft"); input.perfRight = val("bperfRight");
                input.weight = val("bweight");
                input.diameter = val("bdiam");
                input.deadPost = val("bdeadPost");
                input.color = val("bcolor"); input.delam = val("bdelam");
                input.prodNo = val("bprod"); input.rollNo = val("broll");
                input.bubbleType = it ? it.bubbleType : "";
                input.slits = QD.itemHasSlits(it) ? val("bslits") : "";
                input.barcodeLabel = it ? (it.barcodeLabel || "") : "";
                input.boxLabel = it ? (it.boxLabel || "") : "";
                input.lineSpeed = startupAnswers.lineSpeed || "";
                input.A_speed = startupAnswers.A_speed || "";
                input.A_meltPump1 = startupAnswers.A_meltPump1 || "";
                input.A_meltPump2 = startupAnswers.A_meltPump2 || "";
                input.B_speed = startupAnswers.B_speed || "";
                input.B_meltPump1 = startupAnswers.B_meltPump1 || "";
                input.B_meltPump2 = startupAnswers.B_meltPump2 || "";
                input.C_speed = startupAnswers.C_speed || "";
                input.C_meltPump1 = startupAnswers.C_meltPump1 || "";
                input.C_meltPump2 = startupAnswers.C_meltPump2 || "";
                input.widthPf = calc.widthPf; input.webWidthPf = calc.webWidthPf; input.footagePf = calc.footagePf;
                input.perfWidthPf = calc.perfWidthPf; input.perfLeftPf = calc.perfLeftPf; input.perfRightPf = calc.perfRightPf;
                input.weightPf = calc.weightPf; input.postPf = calc.postPf;
                input.deadMax = calc.deadMax;
            } else if (info.form === "p1") {
                input.length = val("plength"); input.width = val("pwidth"); input.cellMd = val("pmd"); input.cellCd = val("pcd");
                input.weight = val("pweight"); input.volume = calc.volume; input.density = calc.density;
                input.avgSingle = calc.avgSingle;
                input.shots = it ? it.shots : "";
                input.headPoints = collectPoints("pht", 12);
                input.tailPoints = collectPoints("ptt", 12);
                input.tailLength = val("ptailLength"); input.tailWidth = val("ptailWidth");
                input.lengthPf = calc.lengthPf; input.widthPf = calc.widthPf; input.densityPf = calc.densityPf;
            } else if (info.form === "rts") {
                input.parent = val("rparent"); input.parentDate = getRdate(); input.shift = val("rshift");
                input.width = val("rwidth"); input.length = val("rlength"); input.color = val("rcolor");
                input.delam = val("rdelam"); input.blister = val("rdelam"); input.alligator = val("rallig");
                input.tattoo = val("rtattoo");
                input.t1 = calc.t1; input.t2 = calc.t2; input.t3 = calc.t3;
                input.thkPf = calc.thkPf; input.widthPf = calc.widthPf; input.lengthPf = calc.lengthPf;
                input.mfgPf = calc.mfgPf;
            }
            return input;
        }

        function clearCheckForm() {
            checkEnteredAt = 0;
            var ids = ["item", "mspec", "notes", "checkNotes", "s4bundle", "s4width", "s4foot", "s4md", "s4cd", "s4weight", "s4sheet",
                "s1bundle", "s1width", "s1foot", "s1perf", "s1md", "s1cd", "s1weight", "s1diam", "s1winder", "s1bumper",
                "bwidth", "bweb", "bfootage", "bperfw", "bperfLeft", "bperfRight", "bweight", "bdiam", "bdeadPost", "bcolor", "bdelam", "bprod", "broll",
                "plength", "pwidth", "pmd", "pcd", "pweight", "ptailLength", "ptailWidth",
                "rparent", "rdate", "rwidth", "rlength", "rt1", "rt2", "rt3"];
            var i, el;
            for (i = 0; i < ids.length; i++) { el = $(ids[i]); if (el) el.value = ""; }
            setRdate("");
            toggleDatePicker(true);
            for (i = 1; i <= 13; i++) {
                el = $("s4t" + i); if (el) el.value = "";
                el = $("s1t" + i); if (el) el.value = "";
            }
            for (i = 1; i <= 12; i++) {
                el = $("pht" + i); if (el) el.value = "";
                el = $("ptt" + i); if (el) el.value = "";
            }
            resetChipLabels("s4t", 13);
            resetChipLabels("s1t", 13);
            resetChipLabels("pht", 12);
            resetChipLabels("ptt", 12);
            var sels = ["s4perfOn", "s1bundleFit", "s1tape", "bcoh", "rshift", "rdelam", "rallig", "rtattoo", "rcolor"];
            for (i = 0; i < sels.length; i++) { el = $(sels[i]); if (el) el.selectedIndex = 0; }
            if ($("mspecText")) $("mspecText").innerText = "";
            if ($("thkMinMax")) $("thkMinMax").innerHTML = "";
            setOverallPf("", false);
            $("desc").innerText = "";
            $("specBox").innerHTML = "<div class='muted'>Item information appears after you look up an item.</div>";
            $("hits").style.display = "none";
            lastResultsHtml = "";
            if ($("resultsBox")) $("resultsBox").innerHTML = "";
            fillUsers();
            compute();
        }

        function submitCheck() {
            if (!session.user) { setStatus("Sign in first.", true); return; }
            if (pendingForUser().length) { goDocs(true); return; }
            var info = QD.lineInfo(currentLine, currentSite);
            var it = selectedItem();
            var calc = compute();
            var reason = checkReason || val("reason");
            var input = collectLiveInput();
            input.passFail = calc.passFail || (reason === "NO CHECK" ? (input.noCheckReason || "NO CHECK") : (reason === "LINE UP" ? "LINE UP" : calc.passFail));
            if (reason === "NO CHECK") {
                input.reason = "NO CHECK";
                input.notes = val("noNotes");
            }
            if (reason === "LINE UP") {
                input.reason = "LINE UP";
                input.notes = val("upNotes");
            }
            var missing = QD.missingCheckFields(currentLine, reason, input);
            if (missing.length) {
                hintMissing();
                setStatus("Fill required fields before submit: " + missing.join(", ") + ".", true);
                return;
            }
            if (!QD.skipReason(currentLine, reason) && !it) { setStatus("Look up an item # from Quality AIO.", true); return; }
            if (!QD.skipReason(currentLine, reason) && it && !QD.itemAllowedOnLine(it, currentLine, currentSite)) {
                setStatus("That item is not for this line.", true);
                return;
            }
            if (!aio.loaded && !QD.skipReason(currentLine, reason)) { setStatus("Load Quality AIO.xlsm first.", true); return; }
            var row = QD.buildRow(input);
            if (row && input.noCheckReason) row["No Check Reason"] = input.noCheckReason;
            if (row) row.__site = currentSite;
            var rows = QD.appendLineRows(readLineRows(info.file), row);
            writeLineRows(info.file, rows);
            writeLookupFile();
            audit("check-submit", QD.lineLabel(currentLine, currentSite) + " " + reason + (it ? (" " + it.item) : ""));
            var failed = String(input.passFail || "").toLowerCase() === "fail" && !QD.skipReason(currentLine, reason);
            var failLine = currentLine;
            var failItem = it ? it.item : input.item;
            clearCheckForm();
            checkReason = "";
            noCheckReason = "";
            startupAnswers = {};
            setStatus("Saved " + QD.lineLabel(currentLine, currentSite) + " check.");
            if (failed) {
                pendingFailContext = { line: failLine, item: failItem, plant: currentSite, at: (new Date()).toISOString() };
                openFailFollowUp();
                return;
            }
            leaveGuarded(function () { goHome(); });
        }

        function openFailFollowUp() {
            var ctx = pendingFailContext || {};
            if ($("failDisposition")) $("failDisposition").selectedIndex = 0;
            if ($("failDeviation")) $("failDeviation").value = "NO";
            syncFailDeviation();
            if ($("failStatus")) {
                $("failStatus").innerText = "This " + QD.lineLabel(ctx.line, ctx.plant) + " check failed"
                    + (ctx.item ? " on item " + ctx.item : "") + ". Choose disposition before continuing.";
            }
            $("failOverlay").className = "overlay on";
        }

        function syncFailDeviation() {
            var hint = $("failDevHint");
            if (hint) hint.style.display = val("failDeviation") === "YES" ? "block" : "none";
        }

        function submitFailFollowUp() {
            var disp = QD.trim(val("failDisposition"));
            var dev = val("failDeviation") === "YES";
            var ctx = pendingFailContext || {};
            if (!disp) { alert("Choose a material disposition."); return; }
            audit("fail-disposition", QD.lineLabel(ctx.line, ctx.plant) + " " + (ctx.item || "") + " " + disp + (dev ? " + deviation requested" : ""));
            if (dev) {
                try {
                    loadInbox();
                    inboxStore.requests.push(QD.makeInboxRequest("deviation", session.user, {
                        plant: ctx.plant,
                        line: ctx.line,
                        item: ctx.item,
                        disposition: disp,
                        detail: "Deviation for process profile after failed check",
                        checkAt: ctx.at
                    }));
                    saveInbox();
                    syncInboxBadge();
                } catch (eDev) { dbg("Deviation request failed: " + eDev.message, false); }
            }
            $("failOverlay").className = "overlay";
            pendingFailContext = null;
            setStatus("Disposition " + disp + " recorded" + (dev ? ". Deviation sent to admin inbox." : "."));
            leaveGuarded(function () { goHome(); });
        }

        function toFileUrl(winPath) {
            var parts = String(winPath).replace(/\\/g, "/").split("/");
            var out = [], i;
            for (i = 0; i < parts.length; i++) {
                if (i === 0 && /^[A-Za-z]:$/.test(parts[i])) out.push(parts[i]);
                else out.push(encodeURIComponent(parts[i]));
            }
            return "file:///" + out.join("/");
        }

        function findEdge() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var cands = [
                "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
                "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"
            ];
            var i;
            for (i = 0; i < cands.length; i++) if (fso.FileExists(cands[i])) return cands[i];
            return "msedge";
        }

        function edgeProfileDir() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = fso.BuildPath(getAppFolder(), "edge-profile");
            if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
            return dir;
        }

        function deskIsOpen(htmlPath) {
            try {
                var loc = GetObject("winmgmts:\\\\.\\root\\cimv2");
                var q = loc.ExecQuery("SELECT CommandLine FROM Win32_Process WHERE Name='msedge.exe'");
                var en = new Enumerator(q);
                var folder = getAppFolder().toLowerCase();
                var html = String(htmlPath || "").toLowerCase();
                var htmlUrl = html.replace(/\\/g, "/");
                var folderUrl = folder.replace(/\\/g, "/");
                var profile = edgeProfileDir().toLowerCase();
                var profileUrl = profile.replace(/\\/g, "/");
                for (; !en.atEnd(); en.moveNext()) {
                    var cmd = String(en.item().CommandLine || "").toLowerCase();
                    if (!cmd) continue;
                    if (cmd.indexOf(profile) >= 0 || cmd.indexOf(profileUrl) >= 0) return true;
                    if (html && (cmd.indexOf(html) >= 0 || cmd.indexOf(htmlUrl) >= 0)) return true;
                    if ((cmd.indexOf(folder) >= 0 || cmd.indexOf(folderUrl) >= 0) && (cmd.indexOf(".html") >= 0 || cmd.indexOf("--app") >= 0)) return true;
                }
            } catch (e) {}
            return false;
        }

        function focusExistingDesk() {
            try { return !!(new ActiveXObject("WScript.Shell")).AppActivate("Quality Desk History"); }
            catch (eF) { return false; }
        }

        function openDesk(quietIfOpen) {
            var htmlPath = findHtml();
            if (!htmlPath) { setStatus("index.html or centration.html not found next to this HTA.", true); return; }
            try { publishSapCsv(); } catch (eSap) { dbg("SAP.csv: " + eSap.message, false); }
            if (deskIsOpen(htmlPath) || focusExistingDesk()) {
                if (!quietIfOpen) setStatus("Quality Desk is already open. Use Reload from disk on that window.");
                focusExistingDesk();
                return;
            }
            var url = toFileUrl(htmlPath);
            var edge = findEdge();
            var profile = edgeProfileDir();
            var shell = new ActiveXObject("WScript.Shell");
            try { shell.Run('"' + edge + '" --user-data-dir="' + profile + '" --app="' + url + '"', 3, false); }
            catch (e1) {
                try { shell.Run('cmd /c start "" "' + htmlPath + '"', 3, false); }
                catch (e2) { setStatus("Could not open Quality Desk.\n" + htmlPath, true); }
            }
        }

        function findInboxReq(id) {
            var i;
            loadInbox();
            for (i = 0; i < inboxStore.requests.length; i++) {
                if (inboxStore.requests[i].id === id) return inboxStore.requests[i];
            }
            return null;
        }

        function syncInboxBadge() {
            var n = 0, el = $("inboxBadge");
            try {
                loadInbox();
                n = QD.pendingInbox(inboxStore.requests, sessionUser()).length;
            } catch (eB) {}
            if ($("btnInbox")) $("btnInbox").style.display = canUseInbox() ? "" : "none";
            if (el) {
                el.innerText = n ? String(n) : "";
                el.className = "badge" + (n ? " on" : "");
            }
        }

        function openInbox() {
            if (!canUseInbox()) { alert("Inbox is for admins, supervisors, and leads."); return; }
            renderInbox();
            $("inboxOverlay").className = "overlay on";
        }

        function closeInbox() { $("inboxOverlay").className = "overlay"; }

        function viewInboxDetail(id) {
            var req = findInboxReq(id);
            if (!req || !req.answers) return;
            var html = "<p><b>" + esc(req.name) + "</b> · " + esc(req.at) + "</p>";
            html += "<table class='list'><tr><th>Action</th><th>St 0</th><th>St 1</th><th>St 2</th><th>St 3</th><th>Printhead</th></tr>";
            var i, j, act, st, sid, v;
            for (i = 0; i < QD.RTS_STARTUP_ACTIONS.length; i++) {
                act = QD.RTS_STARTUP_ACTIONS[i];
                html += "<tr><td>" + esc(act.text) + "</td>";
                if (act.stations) {
                    for (j = 0; j < QD.RTS_STARTUP_STATIONS.length; j++) {
                        st = QD.RTS_STARTUP_STATIONS[j];
                        sid = act.id + "_s" + st;
                        v = req.answers[sid] || "";
                        html += "<td>" + esc(v) + "</td>";
                    }
                    html += "<td></td>";
                } else {
                    v = req.answers[act.id] || "";
                    html += "<td colspan='4'></td><td>" + esc(v) + "</td>";
                }
                html += "</tr>";
            }
            html += "</table>";
            if ($("inboxDetailBody")) $("inboxDetailBody").innerHTML = html;
            $("inboxDetailOverlay").className = "overlay on";
        }

        function renderInbox() {
            loadInbox();
            var pending = QD.pendingInbox(inboxStore.requests, sessionUser());
            var html = "", i, r, label;
            if (!pending.length) html = "<p class='muted'>No pending requests.</p>";
            for (i = 0; i < pending.length; i++) {
                r = pending[i];
                label = r.type === "newUser" ? "New user" : (r.type === "deviation" ? "Deviation request" : (r.type === "rtsStartup" ? "RTS startup checklist" : (r.type === "itemChange" ? "Item change" : "Forgot password")));
                html += "<div class='card'><div><b>" + label + "</b> — " + esc(r.name) + "</div>";
                html += "<div class='muted'>" + esc(r.at) + "</div>";
                if (r.type === "deviation") {
                    html += "<div class='muted'>" + esc(QD.lineLabel(r.line, r.plant)) + " · " + esc(r.plant);
                    html += (r.item ? " · item " + esc(r.item) : "") + " · " + esc(r.disposition) + "</div>";
                    if (r.detail) html += "<div class='muted'>" + esc(r.detail) + "</div>";
                    html += "<button type='button' class='ok' onclick=\"approveInbox('" + String(r.id).replace(/'/g, "") + "')\">Approve</button> ";
                    html += "<button type='button' class='danger' onclick=\"denyInbox('" + String(r.id).replace(/'/g, "") + "')\">Deny</button>";
                } else if (r.type === "rtsStartup") {
                    html += "<div class='muted'>" + esc(r.plant) + " · RTS</div>";
                    if (r.detail) html += "<div class='muted'>Checklist submitted</div>";
                    html += "<button type='button' class='secondary' onclick=\"viewInboxDetail('" + String(r.id).replace(/'/g, "") + "')\">View details</button> ";
                    html += "<button type='button' class='ok' onclick=\"approveInbox('" + String(r.id).replace(/'/g, "") + "')\">Acknowledge</button> ";
                    html += "<button type='button' class='danger' onclick=\"denyInbox('" + String(r.id).replace(/'/g, "") + "')\">Deny</button>";
                } else if (r.type === "itemChange") {
                    html += "<div class='muted'>" + esc(r.plant) + " · " + esc(r.line) + " · item " + esc(r.item) + "</div>";
                    html += "<div class='muted'>Change: " + esc(r.changeType || "") + (r.parent ? " · parent " + esc(r.parent) : "") + "</div>";
                    if (r.detail) html += "<div class='muted'>" + esc(r.detail) + "</div>";
                    html += "<button type='button' class='ok' onclick=\"approveInbox('" + String(r.id).replace(/'/g, "") + "')\">Approve</button> ";
                    html += "<button type='button' class='danger' onclick=\"denyInbox('" + String(r.id).replace(/'/g, "") + "')\">Deny</button>";
                } else if (r.type === "newUser") {
                    html += "<button type='button' class='ok' onclick=\"approveInbox('" + String(r.id).replace(/'/g, "") + "')\">Approve</button> ";
                    html += "<button type='button' class='danger' onclick=\"denyInbox('" + String(r.id).replace(/'/g, "") + "')\">Deny</button>";
                } else {
                    html += "<button type='button' class='ok' onclick=\"issueTempPass('" + String(r.id).replace(/'/g, "") + "')\">Issue temporary password</button> ";
                    html += "<button type='button' class='danger' onclick=\"denyInbox('" + String(r.id).replace(/'/g, "") + "')\">Dismiss</button>";
                }
                html += "</div>";
            }
            if ($("inboxBody")) $("inboxBody").innerHTML = html;
            syncInboxBadge();
        }

        function approveInbox(id) {
            var req = findInboxReq(id);
            if (!req || req.status !== "pending") return;
            var u = sessionUser();
            if (req.type === "newUser" || req.type === "reset") {
                if (!requireAdmin()) return;
            } else if (req.type === "deviation" || req.type === "rtsStartup" || req.type === "itemChange") {
                if (!QD.userCanApprovePlant(u, req.plant)) { alert("Not authorized for this plant."); return; }
            } else if (!canUseInbox()) return;
            if (req.type === "itemChange") {
                var it = QD.findItem(aio.items, req.item);
                if (it && it.pendingApproval) delete it.pendingApproval;
                req.status = "done";
                saveInbox();
                if (it && it.local) {
                    aio.items = QD.mergeItems(aio.items, [it]);
                    saveLocalItems();
                }
                audit("item-change-approved", (req.changeType || "") + " " + (req.item || ""));
                setStatus("Item change approved.");
                renderInbox();
                renderItemTable();
                return;
            }
            if (req.type === "deviation") {
                req.status = "done";
                saveInbox();
                audit("deviation-approved", QD.lineLabel(req.line, req.plant) + " " + (req.item || "") + " " + (req.disposition || ""));
                setStatus("Deviation approved for " + (req.item || QD.lineLabel(req.line, req.plant)) + ".");
                renderInbox();
                return;
            }
            if (req.type === "rtsStartup") {
                req.status = "done";
                saveInbox();
                audit("rts-startup-approved", req.name + " " + req.plant);
                setStatus("RTS startup checklist acknowledged.");
                renderInbox();
                return;
            }
            if (req.type === "newUser") {
                loadAuthUsers();
                if (QD.findUserRecord(authUsers, req.name)) {
                    alert("User already exists.");
                } else if (!req.hash || !req.salt) {
                    alert("That request has no password on file. Ask the person to request again.");
                    return;
                } else {
                    authUsers.push({
                        name: req.name, admin: false, salt: req.salt, hash: req.hash, mustChange: false,
                        plant: req.plant || "VISALIA", lines: "*"
                    });
                    saveAuthUsers();
                    aio.users = QD.mergeUsers(aio.users, [req.name]);
                    aio.localUsers = QD.mergeUsers(aio.localUsers || [], [req.name]);
                    try { saveLocalUsers(); } catch (eU) {}
                }
                req.status = "approved";
                saveInbox();
                audit("user-approved", req.name);
                setStatus("Approved new user " + req.name + ".");
            }
            renderInbox();
            renderUserTable();
        }

        function issueTempPass(id) {
            if (!requireAdmin()) return;
            var req = findInboxReq(id);
            if (!req || req.status !== "pending") return;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, req.name);
            if (!rec) {
                alert("No user named " + req.name + ".");
                req.status = "denied";
                saveInbox();
                renderInbox();
                return;
            }
            var tmp = QD.tempPassword();
            var next = QD.makeUserRecord(rec.name, tmp, rec.admin, true, rec.plant, rec.lines);
            rec.salt = next.salt;
            rec.hash = next.hash;
            rec.mustChange = true;
            saveAuthUsers();
            req.status = "done";
            saveInbox();
            audit("temp-password", rec.name);
            renderInbox();
            alert("Temporary password for " + rec.name + ":\n\n" + tmp + "\n\nGive this to the user. They must change it the next time they sign in.");
        }

        function denyInbox(id) {
            if (!canUseInbox()) return;
            var req = findInboxReq(id);
            if (!req) return;
            if ((req.type === "deviation" || req.type === "rtsStartup" || req.type === "itemChange") && !QD.userCanApprovePlant(sessionUser(), req.plant)) {
                alert("Not authorized for this plant.");
                return;
            }
            if (req.type === "itemChange") revertItemChange(req);
            if ((req.type === "newUser" || req.type === "reset") && !requireAdmin()) return;
            req.status = "denied";
            saveInbox();
            audit("inbox-denied", req.name + " " + req.type);
            renderInbox();
            if (req.type === "itemChange") renderItemTable();
        }

        function openNewUserForm() {
            if ($("nuName")) $("nuName").value = "";
            if ($("nuPass")) $("nuPass").value = "";
            if ($("nuPass2")) $("nuPass2").value = "";
            if ($("nuStatus")) $("nuStatus").innerText = "";
            $("newUserOverlay").className = "overlay raise on";
        }

        function requestNewUser() {
            var name = QD.trim($("nuName") ? $("nuName").value : "");
            var pass = $("nuPass") ? $("nuPass").value : "";
            var pass2 = $("nuPass2") ? $("nuPass2").value : "";
            if (!name || !pass) { $("nuStatus").innerText = "Username and password are required."; return; }
            if (pass !== pass2) { $("nuStatus").innerText = "Passwords do not match."; return; }
            try { loadAuthUsers(); } catch (eA) {}
            if (QD.findUserRecord(authUsers, name)) { $("nuStatus").innerText = "That username already exists."; return; }
            try { loadInbox(); } catch (eI) {}
            if (QD.findPendingNewUser(inboxStore.requests, name)) { $("nuStatus").innerText = "That username is already waiting for approval."; return; }
            var rec = QD.makeUserRecord(name, pass, false, false);
            inboxStore.requests.push(QD.makeInboxRequest("newUser", name, { salt: rec.salt, hash: rec.hash, plant: "VISALIA" }));
            saveInbox();
            auditAs(name, "new-user-request", name);
            $("newUserOverlay").className = "overlay raise";
            $("loginStatus").innerText = "Account request sent. An admin must approve it before you can sign in.";
        }

        function openForgotForm() {
            if ($("fpName")) $("fpName").value = $("loginUser") ? $("loginUser").value : "";
            if ($("fpStatus")) $("fpStatus").innerText = "";
            $("forgotOverlay").className = "overlay raise on";
        }

        function requestReset() {
            var name = QD.trim($("fpName") ? $("fpName").value : "");
            if (!name) { $("fpStatus").innerText = "Enter your username."; return; }
            try { loadInbox(); } catch (eI) {}
            inboxStore.requests.push(QD.makeInboxRequest("reset", name, {}));
            saveInbox();
            auditAs(name, "password-reset-request", name);
            $("forgotOverlay").className = "overlay raise";
            $("loginStatus").innerText = "Password reset sent to admins. They will give you a temporary password.";
        }

        function fileLineInfo(fileKey) {
            var i, list = QD.LINES;
            for (i = 0; i < list.length; i++) {
                if (list[i].file === fileKey) return list[i];
            }
            return null;
        }

        function userCanSeeHistFile(fileKey) {
            var info, user;
            if (isAdmin()) return true;
            info = fileLineInfo(fileKey);
            user = sessionUser();
            if (!info || !user) return false;
            return QD.userCanSeeLine({ admin: false, plant: user.plant, lines: user.lines }, info.id, info.site);
        }

        function histLineButtons() {
            var html = "", i, info, list = QD.LINES, file, label;
            for (i = 0; i < list.length; i++) {
                info = list[i];
                if (!userCanSeeHistFile(info.file)) continue;
                label = info.site === "GARLAND" ? "Garland " + info.label : info.label;
                file = info.file;
                html += "<button type='button'" + (histState.file === file ? " class='on'" : "") + " onclick=\"selectHistLine('" + file + "')\">" + esc(label) + "</button>";
            }
            return html || "<span class='muted'>No lines assigned.</span>";
        }

        function histRowChanged(row) {
            return !!(row && (row.__edited || row.__editNotes));
        }

        function histCellText(row, key) {
            if (!row) return "";
            if (key === "Date/Time") {
                var when = QD.formatDateTime ? QD.formatDateTime(row[key]) : QD.formatClock(row[key]);
                if (histRowChanged(row)) when += " *edited";
                return when;
            }
            return String(QD.histValue(row, key) == null ? "" : QD.histValue(row, key));
        }

        function histViewColumns(file, rows) {
            var base = QD.histColumnsForLine(file) || [], seen = {}, out = [], i, r, k, v;
            for (i = 0; i < base.length; i++) {
                if (!base[i] || seen[base[i]]) continue;
                seen[base[i]] = 1;
                out.push(base[i]);
            }
            for (i = 0; i < (rows || []).length; i++) {
                r = rows[i];
                if (!r) continue;
                for (k in r) {
                    if (!r.hasOwnProperty(k) || !k || k.charAt(0) === "_") continue;
                    if (seen[k]) continue;
                    v = r[k];
                    if (v == null || String(v) === "") continue;
                    seen[k] = 1;
                    out.push(k);
                }
            }
            return out;
        }

        function histRowSearchText(row, fileKey, cols) {
            var parts = [], i, key, v;
            if (!row) return "";
            parts.push(String(fileKey || ""));
            parts.push(QD.formatClock(row["Date/Time"]));
            for (i = 0; i < (cols || []).length; i++) {
                key = cols[i];
                if (key === "Date/Time") continue;
                v = QD.histValue(row, key);
                if (v == null || v === "") continue;
                parts.push(String(v));
            }
            return parts.join(" ").toLowerCase();
        }

        function clearHistFilters() {
            if ($("histTextFilter")) $("histTextFilter").value = "";
            if (histState.file) selectHistLine(histState.file);
            else renderAdminHistory();
        }

        function selectHistLine(file) {
            histState.file = file || "";
            histState.filtered = [];
            histState.shown = 0;
            renderAdminHistory();
        }

        function bindHistScroll() {
            var wrap = $("histAdminWrap");
            if (!wrap || wrap.getAttribute("data-hist-scroll") === "1") return;
            wrap.setAttribute("data-hist-scroll", "1");
            wrap.onscroll = function () {
                if (wrap.scrollTop + wrap.clientHeight >= wrap.scrollHeight - 80) loadMoreHistRows();
            };
        }

        function histRowHtml(rec, cols, admin) {
            var r = rec.row, cls = [], c, key, actions, rowBand;
            rowBand = QD.histRowBand(r);
            if (rowBand) cls.push("hist-row-" + rowBand);
            if (histRowChanged(r)) cls.push("hist-changed");
            var html = "<tr" + (cls.length ? " class='" + cls.join(" ") + "'" : "") + ">";
            for (c = 0; c < cols.length; c++) {
                key = cols[c];
                if (admin && histEditMode) {
                    html += "<td><input class='cell' data-hf='" + rec.file + "' data-hi='" + rec.idx + "' data-hk='" + String(key).replace(/'/g, "") + "' value='" + esc(histCellText(r, key)) + "' oninput='markHistDirty()'></td>";
                } else {
                    html += "<td>" + esc(histCellText(r, key)) + "</td>";
                }
            }
            if (admin) {
                actions = histEditMode ? ("<button type='button' class='danger' onclick=\"deleteHistRow('" + rec.file + "'," + rec.idx + ")\">Delete</button>") : "";
                html += "<td class='hist-act'>" + actions + "</td>";
            }
            return html + "</tr>";
        }

        function loadMoreHistRows() {
            if (!histState.file || !histState.filtered.length) return;
            if (histState.shown >= histState.filtered.length) return;
            var admin = isAdmin();
            var cols = histState.cols || histViewColumns(histState.file, readLineRows(histState.file));
            var table = $("histAdminTable");
            if (!table) return;
            var tbody = table.tBodies.length ? table.tBodies[0] : table;
            var html = "", i, rec, end = histState.shown + histState.page;
            if (end > histState.filtered.length) end = histState.filtered.length;
            for (i = histState.shown; i < end; i++) {
                rec = histState.filtered[i];
                html += histRowHtml(rec, cols, admin);
            }
            histState.shown = end;
            tbody.innerHTML = tbody.innerHTML + html;
            if ($("histAdminCount")) {
                $("histAdminCount").innerText = histState.filtered.length + " check" + (histState.filtered.length === 1 ? "" : "s")
                    + (histState.shown < histState.filtered.length ? " (showing " + histState.shown + " — scroll for more)" : "");
            }
            if ($("histMoreHint")) {
                $("histMoreHint").style.display = histState.shown < histState.filtered.length ? "" : "none";
            }
        }

        function renderAdminHistory() {
            if (!session.user) { goHome(); return; }
            bindHistScroll();
            if ($("histLineTabs")) $("histLineTabs").innerHTML = histLineButtons();
            if ($("histAdminHelp")) {
                $("histAdminHelp").innerText = isAdmin()
                    ? "Pick a line. Use Edit mode to change values in the table. Save asks for notes."
                    : "Pick a line. Rows load in pages as you scroll. Row color follows the Pass/Fail column.";
            }
            var file = histState.file;
            var q = QD.trim(($("histTextFilter") && $("histTextFilter").value) || "").toLowerCase();
            var cols, html, i, rec, r, blob, admin, rows;
            admin = isAdmin();
            if (!file) {
                if ($("histAdminTable")) $("histAdminTable").innerHTML = "<tr><td class='muted'>Choose a line to load history.</td></tr>";
                if ($("histAdminCount")) $("histAdminCount").innerText = "";
                if ($("histMoreHint")) $("histMoreHint").style.display = "none";
                return;
            }
            cols = histViewColumns(file, rows = readLineRows(file));
            histState.cols = cols;
            histState.filtered = [];
            for (i = rows.length - 1; i >= 0; i--) {
                r = rows[i];
                if (!r) continue;
                rec = { file: file, idx: i, row: r };
                if (q) {
                    blob = histRowSearchText(r, file, cols);
                    if (blob.indexOf(q) < 0) continue;
                }
                histState.filtered.push(rec);
            }
            html = "<tr>";
            for (i = 0; i < cols.length; i++) html += "<th>" + esc(cols[i]) + "</th>";
            if (admin) html += "<th class='hist-act'></th>";
            html += "</tr>";
            if (!histState.filtered.length) html += "<tr><td colspan='" + (cols.length + (admin ? 1 : 0)) + "' class='muted'>No matching checks.</td></tr>";
            if ($("histAdminTable")) $("histAdminTable").innerHTML = html;
            histState.shown = 0;
            histState.page = QD.HIST_PAGE || 80;
            if (histState.filtered.length) loadMoreHistRows();
            else if ($("histAdminCount")) $("histAdminCount").innerText = "0 checks";
        }

        function histFieldValue(row, key) {
            if (!row) return "";
            if (key === "Date/Time") return QD.formatDateTime ? QD.formatDateTime(row[key]) : QD.formatClock(row[key]);
            return row[key] == null ? "" : String(row[key]);
        }

                function markHistDirty() {
            histDirty = true;
            if ($("histSaveBtn") && histEditMode) $("histSaveBtn").style.display = "";
        }

        function setHistEditMode(on) {
            if (on && !requireAdmin()) return;
            if (!on && histDirty && !confirm("Discard unsaved history edits?")) return;
            histEditMode = !!on;
            histDirty = false;
            if ($("histEditToolbar")) $("histEditToolbar").style.display = isAdmin() ? "" : "none";
            syncEditToolbars();
            renderAdminHistory();
        }

        function saveHistEdits() {
            if (!requireAdmin() || !histEditMode) return;
            if (!histDirty) { alert("No changes to save."); return; }
            var notes = QD.trim(window.prompt("Notes for these history edits (required):", "") || "");
            if (!notes) { alert("Notes are required."); return; }
            var table = $("histAdminTable");
            if (!table) return;
            var inputs = table.getElementsByTagName("input"), i, el, file, idx, key, val, row, changed = 0, files = {};
            for (i = 0; i < inputs.length; i++) {
                el = inputs[i];
                file = el.getAttribute("data-hf");
                idx = parseInt(el.getAttribute("data-hi"), 10);
                key = el.getAttribute("data-hk");
                if (!file || !key || isNaN(idx)) continue;
                if (!files[file]) files[file] = readLineRows(file, true);
                row = files[file][idx];
                if (!row) continue;
                val = el.value;
                if (String(row[key] == null ? "" : row[key]) !== String(val)) {
                    row[key] = val;
                    row.__edited = 1;
                    row.__editNotes = notes;
                    row.__editBy = session.user;
                    row.__editAt = (new Date()).toISOString();
                    changed += 1;
                }
            }
            for (file in files) if (files.hasOwnProperty(file)) writeLineRows(file, files[file]);
            if (changed) audit("hist-edit", "inline " + changed + " field(s) — " + notes);
            histEditMode = false;
            histDirty = false;
            syncEditToolbars();
            renderAdminHistory();
            setStatus(changed ? ("Saved " + changed + " history field change(s).") : "No field values changed.");
        }

function openHistEdit(file, idx) {
            if (!requireAdmin()) return;
            var rows = readLineRows(file);
            var row = rows[idx];
            if (!row) return;
            histEdit = { file: file, idx: idx };
            var cols = histViewColumns(file, rows), html = "", i, key, seen = {}, v;
            html += "<div class='hist-scroll'><table class='hist-edit-grid'>";
            for (i = 0; i < cols.length; i++) {
                key = cols[i];
                seen[key] = 1;
                html += "<tr><th>" + esc(key) + "</th><td><input data-hist=\"" + esc(key) + "\" value=\"" + esc(histFieldValue(row, key)) + "\"></td></tr>";
            }
            for (i = 1; i <= 13; i++) {
                key = "T" + i;
                if (seen[key]) continue;
                v = row[key];
                if (v == null || String(v) === "") continue;
                html += "<tr><th>" + key + "</th><td><input data-hist=\"" + key + "\" value=\"" + esc(v) + "\"></td></tr>";
            }
            html += "</table></div>";
            if ($("histEditFields")) $("histEditFields").innerHTML = html;
            if ($("histEditNotes")) $("histEditNotes").value = "";
            if ($("histEditOverlay")) $("histEditOverlay").className = "overlay on";
        }

        function saveHistEdit() {
            if (!requireAdmin()) return;
            var notes = QD.trim($("histEditNotes") ? $("histEditNotes").value : "");
            if (!notes) { alert("Enter notes describing what you changed."); return; }
            var rows = readLineRows(histEdit.file, true);
            var row = rows[histEdit.idx];
            if (!row) return;
            var box = $("histEditFields");
            var inputs = box ? box.getElementsByTagName("input") : [];
            var i, key, val, before = [];
            for (i = 0; i < inputs.length; i++) {
                key = inputs[i].getAttribute("data-hist");
                if (!key) continue;
                val = inputs[i].value;
                if (key === "Date/Time") {
                    if (QD.trim(val) === QD.trim(QD.formatClock(row[key]))) continue;
                }
                if (String(row[key] == null ? "" : row[key]) !== String(val)) {
                    before.push(key + ": " + (row[key] == null ? "" : row[key]) + " → " + val);
                    row[key] = val;
                }
            }
            row.__edited = 1;
            row.__editNotes = notes;
            row.__editBy = session.user;
            row.__editAt = (new Date()).toISOString();
            writeLineRows(histEdit.file, rows);
            if ($("histEditOverlay")) $("histEditOverlay").className = "overlay";
            audit("hist-edit", histEdit.file + " #" + histEdit.idx + " " + notes + (before.length ? " | " + before.join("; ") : ""));
            renderAdminHistory();
            lastHomeHtml = "";
            setStatus("Saved history change. " + notes);
        }

        function deleteHistRow(file, idx) {
            if (!requireAdmin()) return;
            var notes = prompt("Notes for deleting this check (required):");
            if (notes == null) return;
            notes = QD.trim(notes);
            if (!notes) { alert("Notes are required to delete a history entry."); return; }
            var rows = readLineRows(file, true);
            var row = rows[idx];
            if (!row) return;
            var detail = (row.Line || file) + " " + (row["Item #"] || "") + " " + QD.formatClock(row["Date/Time"]);
            rows.splice(idx, 1);
            writeLineRows(file, rows);
            audit("hist-delete", detail + " — " + notes);
            renderAdminHistory();
            lastHomeHtml = "";
            setStatus("Deleted history entry. " + notes);
        }

        function profilesPath() {
            return (new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "profiles.js");
        }

        function loadProfiles() {
            var path = profilesPath();
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            window.QD_DISK_PROFILES = null;
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (eP) { dbg("profiles.js: " + eP.message, false); }
            }
            profilesStore = QD.normalizeProfiles(window.QD_DISK_PROFILES);
        }

        function saveProfiles() {
            writeUtf8(profilesPath(), QD.profileDiskScript(profilesStore));
            unhidePath(profilesPath());
        }

        function plantProfiles() {
            var site = currentSite === "GARLAND" ? "GARLAND" : "VISALIA";
            if (!profilesStore[site]) profilesStore[site] = QD.emptyPlantProfiles();
            return profilesStore[site];
        }

        function profileLines() {
            return QD.linesForSite(currentSite === "GARLAND" ? "GARLAND" : "VISALIA") || [];
        }

        function ensureProfileLineTab() {
            var lines = profileLines(), i, ok = false;
            if (!lines.length) {
                profileLineTab = currentSite === "GARLAND" ? "G-COEX" : "COEX";
                return;
            }
            for (i = 0; i < lines.length; i++) if (lines[i].id === profileLineTab) ok = true;
            if (!ok) profileLineTab = lines[0].id;
        }

        function lineProfile() {
            var plant = plantProfiles();
            ensureProfileLineTab();
            if (!plant[profileLineTab]) plant[profileLineTab] = QD.emptyLineProfile();
            if (!plant[profileLineTab].structures) plant[profileLineTab].structures = [];
            if (!plant[profileLineTab].version) plant[profileLineTab].version = "1.0.0";
            return plant[profileLineTab];
        }

        function profileKey() {
            return (currentSite === "GARLAND" ? "GARLAND" : "VISALIA") + "-" + (profileLineTab || "COEX");
        }

        function profileIsBubbleLine() {
            var lines = profileLines(), i;
            for (i = 0; i < lines.length; i++) {
                if (lines[i].id === profileLineTab) return lines[i].plant === "bubble";
            }
            return false;
        }

        function markProfileDirty() {
            profileDirty = true;
            if ($("profileSaveBtn") && profileEditMode) $("profileSaveBtn").style.display = "";
        }

        function renderProfileLineTabs() {
            var box = $("profileLineTabs"), lines = profileLines(), i, html = "";
            if (!box) return;
            ensureProfileLineTab();
            for (i = 0; i < lines.length; i++) {
                html += "<button type='button'" + (lines[i].id === profileLineTab ? " class='on'" : "") + " onclick=\"setProfileLineTab('" + lines[i].id + "')\">" + esc(lines[i].label || lines[i].id) + "</button>";
            }
            box.innerHTML = html;
        }

        function setProfileLineTab(id) {
            if (profileEditMode) {
                if (profileDirty && !confirm("Discard unsaved profile edits?")) return;
                cancelProfileEditMode(true);
            }
            profileLineTab = id;
            renderProfiles();
        }

        function renderProfiles() {
            loadProfiles();
            var plantName = currentSite === "GARLAND" ? "Garland" : "Visalia";
            ensureProfileLineTab();
            var lp = lineProfile();
            var lineLbl = profileLineTab, lines = profileLines(), i;
            for (i = 0; i < lines.length; i++) if (lines[i].id === profileLineTab) lineLbl = lines[i].label || lines[i].id;
            if ($("profilePlantLabel")) $("profilePlantLabel").innerText = plantName + " · " + lineLbl;
            if ($("profileVersionLabel")) $("profileVersionLabel").innerText = "v" + (lp.version || "1.0.0");
            renderProfileLineTabs();
            if ($("profileFrontWrap")) $("profileFrontWrap").style.display = profileIsBubbleLine() ? "" : "none";
            var list = lp.structures;
            var html = "", n, st, admin = isAdmin(), editing = admin && profileEditMode;
            html += "<table class='specs'><thead><tr>";
            html += "<th rowspan='2' class='struct'>Structure</th><th rowspan='2' class='ver'>Ver</th><th rowspan='2'>Line speed</th>";
            html += "<th class='group' colspan='3'>Extruder A</th><th class='group' colspan='3'>Extruder B</th><th class='group' colspan='3'>Extruder C</th>";
            if (editing) html += "<th rowspan='2'></th>";
            html += "</tr><tr>";
            html += "<th class='num'>Speed</th><th class='num'>MP1</th><th class='num'>MP2</th>";
            html += "<th class='num'>Speed</th><th class='num'>MP1</th><th class='num'>MP2</th>";
            html += "<th class='num'>Speed</th><th class='num'>MP1</th><th class='num'>MP2</th>";
            html += "</tr></thead><tbody>";
            if (!list.length) html += "<tr><td colspan='" + (editing ? 13 : 12) + "' class='muted'>No structures yet. Add one to scaffold speeds.</td></tr>";
            for (n = 0; n < list.length; n++) {
                st = list[n];
                if (!st.version) st.version = "1.0.0";
                if (!st.A) st.A = { speed: "", meltPump1: "", meltPump2: "" };
                if (!st.B) st.B = { speed: "", meltPump1: "", meltPump2: "" };
                if (!st.C) st.C = { speed: "", meltPump1: "", meltPump2: "" };
                html += "<tr>";
                if (editing) {
                    html += "<td class='struct'><input class='struct' data-ps='" + n + "' data-pk='name' value='" + esc(st.name) + "' oninput='markProfileDirty()'></td>";
                    html += "<td class='ver'>" + esc(st.version) + "</td>";
                    html += "<td><input data-ps='" + n + "' data-pk='lineSpeed' value='" + esc(st.lineSpeed) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='A.speed' value='" + esc(st.A.speed) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='A.meltPump1' value='" + esc(st.A.meltPump1) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='A.meltPump2' value='" + esc(st.A.meltPump2) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='B.speed' value='" + esc(st.B.speed) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='B.meltPump1' value='" + esc(st.B.meltPump1) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='B.meltPump2' value='" + esc(st.B.meltPump2) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='C.speed' value='" + esc(st.C.speed) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='C.meltPump1' value='" + esc(st.C.meltPump1) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><input data-ps='" + n + "' data-pk='C.meltPump2' value='" + esc(st.C.meltPump2) + "' oninput='markProfileDirty()'></td>";
                    html += "<td><button type='button' class='danger' onclick='removeProfileStructure(" + n + ")'>Delete</button></td>";
                } else {
                    html += "<td class='struct'>" + esc(st.name) + "</td><td class='ver'>" + esc(st.version) + "</td><td>" + esc(st.lineSpeed) + "</td>";
                    html += "<td class='num'>" + esc(st.A.speed) + "</td><td class='num'>" + esc(st.A.meltPump1) + "</td><td class='num'>" + esc(st.A.meltPump2) + "</td>";
                    html += "<td class='num'>" + esc(st.B.speed) + "</td><td class='num'>" + esc(st.B.meltPump1) + "</td><td class='num'>" + esc(st.B.meltPump2) + "</td>";
                    html += "<td class='num'>" + esc(st.C.speed) + "</td><td class='num'>" + esc(st.C.meltPump1) + "</td><td class='num'>" + esc(st.C.meltPump2) + "</td>";
                }
                html += "</tr>";
            }
            html += "</tbody></table>";
            if ($("profileStructBox")) $("profileStructBox").innerHTML = "<div class='profile-scroll'>" + html + "</div>";
            if ($("profileAddWrap")) $("profileAddWrap").style.display = editing ? "" : "none";
            if ($("profileEditBtn")) $("profileEditBtn").style.display = (admin && !profileEditMode) ? "" : "none";
            if ($("profileSaveBtn")) $("profileSaveBtn").style.display = (editing && profileDirty) ? "" : "none";
            if ($("profileCancelBtn")) $("profileCancelBtn").style.display = editing ? "" : "none";
            if ($("profileEditToolbar")) $("profileEditToolbar").style.display = admin ? "" : "none";
        }

        function toggleProfileEditMode() {
            if (!requireAdmin()) return;
            profileEditMode = true;
            profileDirty = false;
            profileEditSnapshot = JSON.parse(JSON.stringify(lineProfile()));
            renderProfiles();
        }

        function cancelProfileEditMode(silent) {
            if (profileEditSnapshot) plantProfiles()[profileLineTab] = JSON.parse(JSON.stringify(profileEditSnapshot));
            profileEditMode = false;
            profileDirty = false;
            profileEditSnapshot = null;
            if (!silent) renderProfiles();
        }

        function collectProfileEditsFromDom() {
            var box = $("profileStructBox");
            if (!box) return;
            var inputs = box.getElementsByTagName("input"), n, el, idx, key, st, parts, list = lineProfile().structures;
            for (n = 0; n < inputs.length; n++) {
                el = inputs[n];
                idx = parseInt(el.getAttribute("data-ps"), 10);
                key = el.getAttribute("data-pk") || "";
                st = list[idx];
                if (!st || !key) continue;
                if (key === "name" || key === "lineSpeed") st[key] = el.value;
                else {
                    parts = key.split(".");
                    if (parts.length === 2 && st[parts[0]]) st[parts[0]][parts[1]] = el.value;
                }
            }
        }

        function structureChanged(before, after) {
            if (!before || !after) return true;
            if (String(before.name) !== String(after.name) || String(before.lineSpeed) !== String(after.lineSpeed)) return true;
            var axes = ["A", "B", "C"], fields = ["speed", "meltPump1", "meltPump2"], i, j;
            for (i = 0; i < axes.length; i++) for (j = 0; j < fields.length; j++) {
                if (String((before[axes[i]] && before[axes[i]][fields[j]]) || "") !== String((after[axes[i]] && after[axes[i]][fields[j]]) || "")) return true;
            }
            return false;
        }

        function saveProfilesWithReason() {
            if (!requireAdmin()) return;
            if (!profileEditMode) { alert("Turn on Edit mode first."); return; }
            if (!profileDirty) { alert("No changes to save."); return; }
            var why = QD.trim(window.prompt("Why are you changing this profile?", "") || "");
            if (!why) { alert("Explain why this profile is changing."); return; }
            collectProfileEditsFromDom();
            var before = profileEditSnapshot || {};
            var after = JSON.parse(JSON.stringify(lineProfile()));
            var i, bs = before.structures || [], asList = after.structures || [];
            for (i = 0; i < asList.length; i++) {
                if (!bs[i] || structureChanged(bs[i], asList[i])) {
                    asList[i].version = QD.bumpSpecVersion((bs[i] && bs[i].version) || asList[i].version || "1.0.0");
                }
            }
            after.version = QD.bumpSpecVersion(after.version || before.version || "1.0.0");
            plantProfiles()[profileLineTab] = after;
            addHistory("profile", profileKey(), why, before, after);
            saveProfiles();
            audit("profile-edit", profileKey() + " v" + after.version);
            profileEditMode = false;
            profileDirty = false;
            profileEditSnapshot = null;
            renderProfiles();
            setStatus("Saved profile " + profileKey() + " as v" + after.version + ".");
        }

        function viewProfileHistory() {
            var key = profileKey();
            var lp = lineProfile();
            var rows = QD.historyForSpec(specHistory, "profile", key);
            var html = "<h3>Profile " + esc(key) + " · v" + esc(lp.version || "1.0.0") + "</h3>";
            html += "<div class='card'><div><b>Current structures</b></div>" + profileSnapshotHtml(lp) + "</div>";
            if (!rows.length) html += "<p class='muted'>No edits yet.</p>";
            var i, r;
            for (i = rows.length - 1; i >= 0; i--) {
                r = rows[i];
                html += "<div class='card'><div><b>" + esc(r.at) + "</b> — " + esc(r.user);
                if (r.after && r.after.version) html += " · v" + esc(r.after.version);
                html += "</div><div>Why: " + esc(r.why) + "</div>" + profileSnapshotHtml(r.after || {}) + "</div>";
            }
            $("histBody").innerHTML = html;
            $("histOverlay").className = "overlay on";
        }

        function profileSnapshotHtml(lp) {
            var list = (lp && lp.structures) || [], html = "<div class='profile-scroll'><table class='specs'><thead><tr>";
            html += "<th>Structure</th><th>Ver</th><th>Line speed</th><th>A</th><th>B</th><th>C</th></tr></thead><tbody>";
            var i, st;
            if (!list.length) html += "<tr><td colspan='6' class='muted'>No structures</td></tr>";
            for (i = 0; i < list.length; i++) {
                st = list[i] || {};
                html += "<tr><td>" + esc(st.name) + "</td><td class='ver'>" + esc(st.version || "1.0.0") + "</td><td>" + esc(st.lineSpeed) + "</td>";
                html += "<td class='num'>" + esc(st.A && st.A.speed) + "/" + esc(st.A && st.A.meltPump1) + "/" + esc(st.A && st.A.meltPump2) + "</td>";
                html += "<td class='num'>" + esc(st.B && st.B.speed) + "/" + esc(st.B && st.B.meltPump1) + "/" + esc(st.B && st.B.meltPump2) + "</td>";
                html += "<td class='num'>" + esc(st.C && st.C.speed) + "/" + esc(st.C && st.C.meltPump1) + "/" + esc(st.C && st.C.meltPump2) + "</td></tr>";
            }
            html += "</tbody></table></div>";
            return html;
        }

        function addProfileStructure() {
            if (!isAdmin() || !profileEditMode) { alert("Turn on Edit mode to add structures."); return; }
            var name = QD.trim(($("newStructName") && $("newStructName").value) || "");
            if (!name) { alert("Enter a structure name."); return; }
            lineProfile().structures.push(QD.emptyCoexStructure(name));
            if ($("newStructName")) $("newStructName").value = "";
            markProfileDirty();
            renderProfiles();
        }

        function removeProfileStructure(idx) {
            if (!isAdmin() || !profileEditMode) { alert("Turn on Edit mode to delete structures."); return; }
            var list = lineProfile().structures;
            var name = list[idx] ? list[idx].name : "";
            if (!confirm("Delete structure " + (name || idx) + "?")) return;
            list.splice(idx, 1);
            markProfileDirty();
            renderProfiles();
        }


        function renderAuditTable() {
            loadAudit();
            var html = "<tr><th>When</th><th>User</th><th>Action</th><th>Detail</th></tr>";
            var i, r, n = 0;
            for (i = auditLog.length - 1; i >= 0; i--) {
                r = auditLog[i];
                if (!r) continue;
                html += "<tr><td>" + esc(r.at) + "</td><td>" + esc(r.user) + "</td><td>" + esc(r.action) + "</td><td>" + esc(r.detail) + "</td></tr>";
                n += 1;
                if (n >= 400) break;
            }
            if (!n) html += "<tr><td colspan='4' class='muted'>No audit entries yet.</td></tr>";
            if ($("auditTable")) $("auditTable").innerHTML = html;
            if ($("auditCount")) $("auditCount").innerText = n + " recent event" + (n === 1 ? "" : "s");
        }

        window.onload = function () {
            profSection("startup");
            try { profFlush("begin"); } catch (ePb) {}
            if (!claimHtaInstance()) return;
            profAdd("onload.claimHtaInstance");
            maximizeWindow();
            hideApp("");
            hideLoginFields();
            $("loginStatus").innerText = "Starting Quality Desk…";
            profAdd("onload.chrome");
            try { profFlush(); } catch (ePf) {}
            window.setTimeout(bootDesk, 0);
        };
        window.onfocus = function () {
            try { importHandoffIfPresent(true); } catch (eF) {}
        };
        function sealPlainFilesInFolder(relDir) {
            var fso, dir, e, f, path, name, raw, n = 0;
            if (!window.QD_RELEASE_CRYPT || !QD || !QD.seal) return 0;
            fso = new ActiveXObject("Scripting.FileSystemObject");
            dir = fso.BuildPath(getAppFolder(), relDir);
            if (!fso.FolderExists(dir)) return 0;
            e = new Enumerator(fso.GetFolder(dir).Files);
            for (; !e.atEnd(); e.moveNext()) {
                f = e.item();
                name = String(f.Name || "");
                if (!name || name.charAt(0) === ".") continue;
                path = f.Path;
                if (fileIsSealed(path)) continue;
                try { raw = readUtf8(path, true); } catch (eR) { raw = ""; }
                if (!raw || QD.isSealed(raw)) continue;
                try {
                    writeUtf8(path, raw);
                    n += 1;
                } catch (eS) {
                    dbg("seal " + name + ": " + eS.message, false);
                }
            }
            return n;
        }

        function sealLegacyPlainFiles() {
            var n = sealPlainFilesInFolder("results") + sealPlainFilesInFolder("aio-csv");
            if (n) dbg("Sealed " + n + " plaintext file(s) in results/aio-csv");
            return n;
        }

        function bootDesk() {
            var steps = [
                function () {
                    setBoot("Sealing local files…", 10);
                    profRun("boot.sealLegacyPlainFiles", function () { sealLegacyPlainFiles(); });
                    profRun("boot.loadAuthUsers", function () { loadAuthUsers(); });
                    profRun("boot.loadLastChecks", function () { loadLastChecks(); });
                },
                function () {
                    setBoot("Reading lookup files…", 32);
                    profRun("boot.loadAio", function () { loadAio(false, true); });
                },
                function () {
                    setBoot("Loading desk files…", 58);
                    profRun("boot.loadProfiles", function () { loadProfiles(); });
                    profRun("boot.loadInbox", function () { loadInbox(); });
                    profRun("boot.loadAudit", function () { loadAudit(); });
                },
                function () {
                    setBoot("Preparing forms…", 78);
                    profRun("boot.prepareForms", function () {
                        fillPlantChecks("newUserPlantBox", "VISALIA");
                        fillLineChecks("newUserLineBox", "VISALIA", "*");
                        fillDocLineChecks("*");
                        fillDocCheckLinkSelect();
                        syncDocTypeFields();
                        fillMspecFilterBy();
                        fillItemFilterBy();
                    });
                },
                function () {
                    setBoot("Finishing…", 92);
                    try { profRun("boot.publishSapCsv", function () { publishSapCsv(); }); } catch (eSap) {}
                    try { profRun("boot.importHandoff", function () { importHandoffIfPresent(true); }); } catch (eH) {}
                    profRun("boot.bindForm", function () { bindFormWatch(); setLine("S4"); startHandoffWatch(); });
                }
            ];
            var i = 0;
            function next() {
                if (i >= steps.length) {
                    hideBoot();
                    dbg("HTA v" + QD.VERSION + " ready");
                    return;
                }
                try { steps[i](); } catch (eBoot) { dbg("boot " + i + ": " + eBoot.message); }
                i += 1;
                try { profFlush(); } catch (ePf) {}
                window.setTimeout(next, 0);
            }
            setBoot("Starting Quality Desk…", 4);
            profAdd("boot.deskStart");
            window.setTimeout(next, 0);
        }
        window.onerror = function (msg, url, line, col, err) {
            var detail = "ERROR " + msg + " @" + line + (col != null ? ":" + col : "");
            if (url) detail += "\nURL: " + url;
            if (err && err.stack) detail += "\n" + err.stack;
            dbg(detail);
            try {
                var text = debugLines.join("\r\n");
                if (window.clipboardData && window.clipboardData.setData) {
                    window.clipboardData.setData("Text", text);
                } else if ($("debugBox")) {
                    $("debugBox").value = text;
                    $("debugBox").select();
                    document.execCommand("copy");
                }
            } catch (eCopy) {}
            try { alert("A script error occurred. The debug log was copied to the clipboard.\n\n" + msg + "\nLine " + line + "\n\nQuality Desk will now close."); } catch (eA) {}
            try { window.close(); } catch (eC) {}
            return true;
        };
    </script>
    <div id="appRoot" style="display:none">
    <header class="app">
        <div class="brand">
            <h1>Quality Desk Checks <span class="ver">v1.7.77</span></h1>
        </div>
        <div class="tools">
            <span class="session">Welcome, <span class="who" id="sessionWho"></span></span>
            <label class="theme-toggle" title="Dark / light">
                Dark
                <input id="themeToggle" type="checkbox" onchange="setTheme(this.checked?'light':'dark')">
                <span class="track"><span></span></span>
                Light
            </label>
            <button class="secondary inbox-btn" id="btnInbox" onclick="openInbox()">Inbox <span class="badge" id="inboxBadge"></span></button>
            <button class="secondary real-admin" id="btnViewOp" onclick="toggleOperatorView()">View as operator</button>
            <button class="secondary real-admin" id="btnDebug" onclick="openDebug()">Debug log</button>
            <button class="secondary" onclick="changeOwnPassword()">Password</button>
            <button class="secondary" onclick="logout('Signed out.')">Log out</button>
            <button class="secondary" onclick="openDesk(false)">History</button>
        </div>
    </header>
    <div class="wrap">
        <div id="crumbs" class="crumbs">Visalia / Home</div>
        <div id="opBanner" class="op-banner">Viewing as operator — admin tools are hidden.</div>
        <div id="status" class="status">Starting…</div>
        <div class="tabs" id="mainTabs">
            <button data-tab="checks" id="homeTabBtn" class="on" onclick="goHome()">Home</button>
            <button data-tab="users" id="usersTabBtn" class="admin-only" onclick="showTab('users')">Users</button>
            <button data-tab="mspecs" id="mspecsTabBtn" onclick="showTab('mspecs')">MSPECs</button>
            <button data-tab="items" id="itemsTabBtn" onclick="showTab('items')">Item database</button>
            <button data-tab="history" id="histTabBtn" onclick="showTab('history')">History</button>
            <!-- Profiles merged into MSPECs Bubble -->
            <button data-tab="audit" id="auditTabBtn" class="admin-only" onclick="showTab('audit')">Audit log</button>
            <span class="plant-toggle" id="plantToggle">
                <button type="button" class="secondary" id="plantSwitchBtn" onclick="goPlantPick()">Switch plant</button>
            </span>
            <button data-tab="docs" id="docsTabBtn" onclick="goDocs()">Documentation</button>
        </div>
        <div id="tabChecks" class="tabpanel on">
        <div id="screenHome" class="screen on">
            <div class="home-grid" id="homeLines"></div>
        </div>
        <div id="screenDocs" class="screen"></div>
        <div id="screenPlant" class="screen">
            <h2>Choose plant</h2>
            <div class="plant-pick">
                <button type="button" onclick="pickPlant('VISALIA')">Visalia</button>
                <button type="button" onclick="pickPlant('GARLAND')">Garland</button>
                <button type="button" class="secondary" onclick="goHome()">Cancel</button>
            </div>
        </div>
        <div id="screenReason" class="screen">
            <h2>Type of check</h2>
            <div class="reason-btns">
                <button type="button" onclick="pickReason('HOURLY')">HOURLY</button>
                <button type="button" onclick="pickReason('RETEST')">RETEST</button>
                <button type="button" onclick="pickReason('LPA')">LPA</button>
                <button type="button" onclick="pickReason('NO CHECK')">NO CHECK</button>
            </div>
            <div id="rtsStartupBtnWrap" class="reason-btns" style="display:none;margin-top:16px;">
                <button type="button" onclick="openRtsStartup()">Startup Checklist</button>
            </div>
        </div>
        <div id="screenRtsStartup" class="screen">
            <div class="card" id="rtsStartupBox"></div>
        </div>
        <div id="screenNoCheck" class="screen">
            <div class="card">
                <h2>No check</h2>
                <label class="f">Additional reason
                    <select id="noCheckReason" onchange="noCheckReason=this.value;syncSubmitBtn();">
                        <option value=""></option>
                        <option>EQUIPMENT FAILURE</option>
                        <option>NO ORDERS</option>
                        <option>LINE DOWN</option>
                        <option>PREVENTATIVE MAINTENANCE</option>
                    </select>
                </label>
                <label class="f">Notes <textarea id="noNotes" onkeyup="scheduleSubmit()"></textarea></label>
            </div>
        </div>
        <div id="screenLineUp" class="screen">
            <div class="card">
                <h2>LINE UP</h2>
                <p class="muted">The last entry was a no-check. Enter what happened, then hourly checks resume.</p>
                <label class="f">Notes <textarea id="upNotes" onkeyup="scheduleSubmit()"></textarea></label>
            </div>
        </div>
        <div id="screenItem" class="screen">
            <div class="card">
                <h2>Item #</h2>
                <label class="f">Item #
                    <input id="item" onkeyup="scheduleHits();scheduleSubmit();" onchange="onItemChange()">
                </label>
                <div class="hits" id="hits"></div>
                <button type="button" class="ok" onclick="confirmItem()">Continue</button>
                <button type="button" class="secondary" onclick="openItemModal()">Add new #</button>
            </div>
        </div>
        <div id="screenStartup" class="screen">
            <div class="card" id="startupBox"></div>
        </div>
        <div id="screenCheck" class="screen">
        <input type="hidden" id="user">
        <input type="hidden" id="reason">
        <input type="hidden" id="notes">
        <div class="lines" id="lineBtns" style="display:none">
            <button data-line="S4" class="on" onclick="setLine('S4')">S4</button>
            <button data-line="S1" onclick="setLine('S1')">S1</button>
            <button data-line="S3" onclick="setLine('S3')">S3</button>
            <button data-line="COEX" onclick="setLine('COEX')">COEX</button>
            <button data-line="MONO" onclick="setLine('MONO')">MONO</button>
            <button data-line="P1" onclick="setLine('P1')">P1</button>
            <button data-line="RTS" onclick="setLine('RTS')">RTS</button>
        </div>
        <div class="grid">
            <div class="col spec-col">
                <div class="card">
                    <h2>Item Information <span class="muted" id="lineLabel">S4</span></h2>
                    <p id="desc" class="muted" style="display:none"></p>
                    <div id="mspecWrap" style="display:none"><div class="mspec-ro">MSPEC <b id="mspecText"></b></div><input type="hidden" id="mspec"></div>
                    <div class="card spec" id="specBox"><div class="muted">Specs appear after you look up an item.</div></div>
                    <div id="resultsBox"></div>
                    <p id="thkMinMax" class="muted"></p>
                    <div class="graph-card" id="radialCard" style="display:none">
                        <h2>Centration</h2>
                        <canvas id="radialCanvas" class="radial" width="320" height="320"></canvas>
                    </div>
                    <div id="overallPf" class="pf-huge"></div>
                </div>
            </div>
            <div class="col form-col">
                <div id="formS4" class="form on">
                    <div class="card">
                        <h2>S4 entries</h2>
                        <div class="pair">
                            <div><label class="f">Bundle # <span class="req">*</span> <input id="s4bundle"></label></div>
                            <div><label class="f">Width <span class="req">*</span> <input id="s4width" onkeyup="scheduleCompute()"> <span id="widthMark"></span></label></div>
                        </div>
                        <div id="s4slitsWrap" style="display:none"><label class="f"># Slits <span class="req">*</span> <input id="s4slits" onkeyup="scheduleCompute()"></label></div>
                        <div class="pair">
                            <div><label class="f">Footage <span class="req">*</span> <input id="s4foot"></label></div>
                            <div><label class="f">Perf Roller On <select id="s4perfOn"><option></option><option>Yes</option><option>No</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <span class="req">*</span> <input id="s4md"></label></div>
                            <div><label class="f">Cell Count CD <span class="req">*</span> <input id="s4cd"></label></div>
                        </div>
                        <label class="f">Weight (g) <span class="req">*</span> <input id="s4weight" onkeyup="scheduleCompute()"></label>
                        <label class="f">Thickness T1–T13 <span class="req">*</span></label>
                        <div class="chips" id="s4chips">
                            <label class="chip"><span>T1</span><input id="s4t1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="s4t2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="s4t3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="s4t4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="s4t5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="s4t6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="s4t7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="s4t8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="s4t9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="s4t10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="s4t11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="s4t12" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T13</span><input id="s4t13" onkeyup="scheduleCompute()"></label>
                        </div>
                        <div>Average <b id="avgOut"></b> <span id="avgMark"></span> &nbsp; Range <b id="rangeOut"></b> <span id="rangeMark"></span> &nbsp; Density <b id="densOut"></b></div>
                        <div id="s4sheetWrap"><label class="f">Sheet Length <input id="s4sheet" onkeyup="scheduleCompute()"> <span id="sheetMark"></span></label></div>
                        <p class="req-note"><span class="req">*</span> = required</p>
                    </div>
                </div>
                <div id="formS1" class="form">
                    <div class="card">
                        <h2>S1 / S3 entries</h2>
                        <div class="pair">
                            <div><label class="f">Bundle # <span class="req">*</span> <input id="s1bundle"></label></div>
                            <div><label class="f">Width <span class="req">*</span> <input id="s1width" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div id="s1slitsWrap" style="display:none"><label class="f"># Slits <span class="req">*</span> <input id="s1slits" onkeyup="scheduleCompute()"></label></div>
                        <div class="pair">
                            <div><label class="f">Footage <span class="req">*</span> <input id="s1foot"></label></div>
                            <div id="s1perfWrap"><label class="f">Perf <span class="req">*</span> <input id="s1perf" onkeyup="scheduleCompute()"> <span id="perfMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Bundle Tight/Loose <select id="s1bundleFit" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                            <div><label class="f">Tape Color <select id="s1tape"><option></option><option>RED</option><option>YELLOW</option><option>GREEN</option><option>BLUE</option><option>BROWN</option><option>TAN</option><option>CLEAR</option><option>ULINE</option><option>BLACK</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <span class="req">*</span> <input id="s1md"></label></div>
                            <div><label class="f">Cell Count CD <span class="req">*</span> <input id="s1cd"></label></div>
                        </div>
                        <label class="f">Weight <span class="req">*</span> <input id="s1weight" onkeyup="scheduleCompute()"></label>
                        <label class="f">Thickness T1–T13 <span class="req">*</span></label>
                        <div class="chips">
                            <label class="chip"><span>T1</span><input id="s1t1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="s1t2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="s1t3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="s1t4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="s1t5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="s1t6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="s1t7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="s1t8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="s1t9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="s1t10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="s1t11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="s1t12" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T13</span><input id="s1t13" onkeyup="scheduleCompute()"></label>
                        </div>
                        <div class="pair" id="s1winderWrap">
                            <div><label class="f">Winder tension <span class="req">*</span> <input id="s1winder" onkeyup="scheduleCompute()"></label></div>
                            <div id="s1bumperWrap"><label class="f">Bumper roll pressure <span class="req">*</span> <input id="s1bumper" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div id="s1diamWrap"><label class="f">Diameter (ULINE only) <span class="req">*</span> <input id="s1diam" onkeyup="scheduleCompute()"></label></div>
                        <p class="req-note"><span class="req">*</span> = required</p>
                    </div>
                </div>
                <div id="formBubble" class="form">
                    <div class="card">
                        <h2>Bubble entries</h2>
                        <div id="bcohWrap"><label class="f">COH/ADH Verification <span class="req">*</span> <select id="bcoh" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                        <div class="pair" id="bpairTop">
                            <div id="bslitsWrap" style="display:none"><label class="f"># Slits <span class="req">*</span> <input id="bslits" onkeyup="scheduleCompute()"> <span id="bslitsMark"></span></label></div>
                            <div id="bwebWrap"><label class="f">Web Width <span class="req">*</span> <input id="bweb" onkeyup="scheduleCompute()"> <span id="bwebMark"></span></label></div>
                        </div>
                        <div class="pair" id="bpairMid">
                            <div id="bwidthWrap"><label class="f">Slit Width <span class="req">*</span> <input id="bwidth" onkeyup="scheduleCompute()"> <span id="bwidthMark"></span></label></div>
                            <div id="bfootageWrap"><label class="f">Footage <span class="req">*</span> <input id="bfootage" onkeyup="scheduleCompute()"> <span id="bfootMark"></span></label></div>
                        </div>
                        <div class="pair" id="bpairPerfMeta">
                            <div id="bperfwWrap"><label class="f">Perf Distance <span class="req">*</span> <input id="bperfw" onkeyup="scheduleCompute()"> <span id="bperfMark"></span></label></div>
                            <div id="bperfPad"></div>
                        </div>
                        <div class="pair" id="bperfStrWrap">
                            <div><label class="f">Perf Strength Left <span class="req">*</span> <input id="bperfLeft" onkeyup="scheduleCompute()"> <span id="bperfLeftMark"></span></label></div>
                            <div><label class="f">Perf Strength Right <span class="req">*</span> <input id="bperfRight" onkeyup="scheduleCompute()"> <span id="bperfRightMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Dead Cells and Air Transfers Post Vacuum Test <span class="req">*</span> <input id="bdeadPost" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Basis Weight <span class="req">*</span> <input id="bweight" onkeyup="scheduleCompute()"> <span id="bwtMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Color <span class="req">*</span> <select id="bcolor" onchange="syncBubbleColor();compute()"><option></option><option value="Clear" style="color:#e5e7eb">Clear</option><option value="Green" style="color:#4ade80">Green</option><option value="Pink" style="color:#f9a8d4">Pink</option><option value="Gray" style="color:#9ca3af">Gray</option></select></label></div>
                            <div><label class="f">Delam Check <span class="req">*</span> <select id="bdelam" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Work Order # <span class="req">*</span> <input id="bprod" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Bundle # <span class="req">*</span> <input id="broll" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div id="bbarcodeWrap" style="display:none"><label class="f">Barcode Label <span id="bbarcodeShow"></span></label></div>
                        <div id="bboxWrap" style="display:none"><label class="f">Box Label <span id="bboxShow"></span></label></div>
                        <div id="bdiamWrap"><label class="f">Diameter (ULINE only) <span class="req">*</span> <input id="bdiam" onkeyup="scheduleCompute()"></label></div>
                        <p class="req-note"><span class="req">*</span> = required</p>
                    </div>
                </div>
                <div id="formP1" class="form">
                    <div class="card">
                        <h2>P1 entries — head piece</h2>
                        <div class="pair">
                            <div><label class="f">Length <span class="req">*</span> <input id="plength" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Width <span class="req">*</span> <input id="pwidth" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <span class="req">*</span> <input id="pmd"></label></div>
                            <div><label class="f">Cell Count CD <span class="req">*</span> <input id="pcd"></label></div>
                        </div>
                        <label class="f">Plank Weight <span class="req">*</span> <input id="pweight" onkeyup="scheduleCompute()"></label>
                        <label class="f">Head thickness T1–T12 <span class="req">*</span></label>
                        <div class="chips" id="p1HeadChips">
                            <label class="chip"><span>T1</span><input id="pht1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="pht2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="pht3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="pht4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="pht5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="pht6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="pht7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="pht8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="pht9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="pht10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="pht11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="pht12" onkeyup="scheduleCompute()"></label>
                        </div>
                        <div>Average <b id="pavgOut"></b> &nbsp; Volume <b id="pvolOut"></b> &nbsp; Density <b id="pdensOut"></b></div>
                        <p class="req-note"><span class="req">*</span> = required</p>
                    </div>
                    <div class="card" id="p1TailWrap" style="display:none">
                        <h2>P1 entries — tail piece (double shot)</h2>
                        <div class="pair">
                            <div><label class="f">Tail Length <span class="req">*</span> <input id="ptailLength" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Tail Width <span class="req">*</span> <input id="ptailWidth" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <label class="f">Tail thickness T1–T12 <span class="req">*</span></label>
                        <div class="chips" id="p1TailChips">
                            <label class="chip"><span>T1</span><input id="ptt1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="ptt2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="ptt3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="ptt4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="ptt5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="ptt6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="ptt7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="ptt8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="ptt9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="ptt10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="ptt11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="ptt12" onkeyup="scheduleCompute()"></label>
                        </div>
                    </div>
                </div>
                <div id="formRts" class="form">
                    <div class="card">
                        <h2>RTS entries</h2>
                        <div class="pair">
                            <div>
                                <label class="f">Parent Material <span class="req">*</span>
                                    <select id="rparent" onchange="onRtsParentChange()"></select>
                                </label>
                                <a href="#" onclick="addRtsParent();return false;" style="color:#93c5fd;text-decoration:underline;font-size:12px;">Add parent material</a>
                            </div>
                            <div><label class="f date-field">Parent MFG Date <span class="req">*</span>
                                <span class="date-wrap">
                                    <input id="rdate" class="date-input" placeholder="MM/DD/YYYY" onkeyup="onRdateTyped()" onchange="onRdateTyped()" onfocus="toggleDatePicker(true)">
                                    <button type="button" class="date-btn" title="Open calendar" onclick="toggleDatePicker();return false;">Cal</button>
                                    <div id="rdatePicker" class="date-picker" style="display:none"></div>
                                </span>
                                <span id="rmfgMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Parent Shift <span class="req">*</span> <select id="rshift"><option></option><option>A</option><option>B</option><option>C</option><option>D</option></select></label></div>
                            <div><label class="f">Color <span class="req">*</span> <select id="rcolor" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Width <span class="req">*</span> <input id="rwidth" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Length <span class="req">*</span> <input id="rlength" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Blister / Delam <span class="req">*</span> <select id="rdelam" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                            <div><label class="f">Alligator Skin <span class="req">*</span> <select id="rallig" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                        <label class="f">Verify side tattoo exists <span class="req">*</span> <select id="rtattoo" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label>
                        <label class="f">Thickness points <span class="req">*</span></label>
                        <div class="pts">
                            <input id="rt1" onkeyup="scheduleCompute()"><input id="rt2" onkeyup="scheduleCompute()"><input id="rt3" onkeyup="scheduleCompute()">
                            <span id="rthkMark"></span>
                        </div>
                        <p class="req-note"><span class="req">*</span> = required</p>
                    </div>
                </div>
                <div class="card" id="checkNotesCard">
                    <label class="f">Notes <textarea id="checkNotes" onkeyup="$('notes').value=this.value;scheduleSubmit();"></textarea></label>
                </div>
            </div>
        </div>
        </div>
        </div>
        <div id="tabUsers" class="tabpanel">
            <div class="card">
                <h2>Users <span class="muted" id="userCount"></span></h2>
                <div class="pair">
                    <div class="filter-row">
                        <label class="f">Filter <input id="userFilter" onkeyup="scheduleList(renderUserTable)" oninput="scheduleList(renderUserTable)" onchange="scheduleList(renderUserTable)"></label>
                        <select id="userFilterBy" onchange="renderUserTable()"><option value="User">User</option><option value="Plant">Plant</option><option value="Lines">Lines</option></select>
                    </div>
                    <div class="admin-only">
                        <button type="button" onclick="openAddUserScreen()">Add user</button>
                    </div>
                </div>
                <div class="list-wrap"><table class="list" id="userTable"></table></div>
            </div>
        </div>
        <div id="tabMspecs" class="tabpanel">
            <div class="card">
                <h2>MSPECs <span class="muted" id="mspecCount"></span></h2>
                <div class="subtabs" id="specTabs">
                    <button data-spec="foam" class="on" onclick="setSpecTab('foam')">Foam</button>
                    <button data-spec="bubble" onclick="setSpecTab('bubble')">Bubble</button>
                    <button data-spec="p1" onclick="setSpecTab('p1')">P1</button>
                    <button data-spec="rts" onclick="setSpecTab('rts')">RTS</button>
                </div>
                <div class="admin-only edit-toolbar" id="mspecEditToolbar">
                    <button type="button" id="mspecEditBtn" onclick="setMspecEditMode(true)">Edit mode</button>
                    <button type="button" id="mspecSaveBtn" class="ok" style="display:none" onclick="saveMspecEdits()">Save</button>
                    <button type="button" id="mspecCancelBtn" class="secondary" style="display:none" onclick="setMspecEditMode(false)">Cancel</button>
                    <span class="muted">Edit values in the table. Save asks why and bumps version.</span>
                </div>
                <div class="filter-row">
                    <label class="f">Filter <input id="mspecFilter" onkeyup="scheduleList(renderMspecTable)" oninput="scheduleList(renderMspecTable)" onchange="scheduleList(renderMspecTable)"></label>
                    <select id="mspecFilterBy" onchange="renderMspecTable()"></select>
                    <button type="button" class="secondary" onclick="clearListFilter('mspecFilter', renderMspecTable)">Clear filter</button>
                </div>
                <div class="list-wrap"><table class="specs" id="mspecTable"></table></div>
                <div id="mspecProfileExtra" style="display:none;margin-top:16px;">
                    <h3>Front to back ratio</h3>
                    <div class="list-wrap">
                        <table class="list">
                            <tr><th>Item</th><th>Ratio</th></tr>
                            <tr><td>ULINE</td><td>1.75</td></tr>
                            <tr><td>Non-ULINE</td><td>1.5</td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="tabItems" class="tabpanel">
            <div class="card">
                <h2>Item database <span class="muted" id="itemCount"></span></h2>
                <div class="item-tools">
                    <div class="subtabs" id="itemTabs">
                        <button data-item="foam" class="on" onclick="setItemTab('foam')">Foam</button>
                        <button data-item="bubble" onclick="setItemTab('bubble')">Bubble</button>
                        <button data-item="p1" onclick="setItemTab('p1')">P1</button>
                        <button data-item="rts" onclick="setItemTab('rts')">RTS</button>
                    </div>
                    <button type="button" class="admin-only" onclick="openItemModal()">Add item #</button>
                </div>
                <div class="admin-only edit-toolbar" id="itemEditToolbar">
                    <button type="button" id="itemEditBtn" onclick="setItemEditMode(true)">Edit mode</button>
                    <button type="button" id="itemSaveBtn" class="ok" style="display:none" onclick="saveItemEdits()">Save</button>
                    <button type="button" id="itemCancelBtn" class="secondary" style="display:none" onclick="setItemEditMode(false)">Cancel</button>
                    <span class="muted">Edit values in the table. Save asks why and versions changed items.</span>
                </div>
                <div class="filter-row">
                    <label class="f">Filter <input id="itemFilter" onkeyup="scheduleList(renderItemTable)" oninput="scheduleList(renderItemTable)" onchange="scheduleList(renderItemTable)"></label>
                    <select id="itemFilterBy" onchange="renderItemTable()"></select>
                    <button type="button" class="secondary" onclick="clearListFilter('itemFilter', renderItemTable)">Clear filter</button>
                </div>
                <div class="list-wrap"><table class="list" id="itemTable"></table></div>
            </div>
        </div>
        <div id="tabDocs" class="tabpanel">
            <div id="docReviewWrap">
                <div class="card" id="docAckBox"></div>
            </div>
            <div id="docAdminWrap" class="card">
                <h2>Documentation <span class="muted" id="docCount"></span></h2>
                <p class="muted">Work Instructions and QANs. Assigned users must read a document when it is new, when the version changes, and again every 3 months.</p>
                <div class="admin-only">
                    <div class="pair">
                        <div><label class="f">Name <input id="docName"></label></div>
                        <div><label class="f">Line(s)</label>
                            <div class="line-checks" id="docLineBox"></div>
                        </div>
                    </div>
                    <div class="pair">
                        <div><label class="f">Type
                            <select id="docType" onchange="syncDocTypeFields()">
                                <option>Work Instruction</option>
                                <option>QAN</option>
                                <option>Construction Card</option>
                            </select>
                        </label></div>
                        <div><label class="f">Version <input id="docVer" value="1"></label></div>
                    </div>
                    <div id="docLinkedWrap" style="display:none"><label class="f">Linked items (comma-separated item #s) <input id="docLinkedItems"></label></div>
                    <div id="docCheckLinkWrap"><label class="f">Link to in Quality Check
                        <select id="docCheckLink"></select>
                    </label></div>
                    <label class="f">Link <input id="docUrl"></label>
                    <button type="button" id="docSaveBtn" onclick="saveDocForm()">Add document</button>
                </div>
                <div class="list-wrap"><table class="list" id="docTable"></table></div>
            </div>
        </div>
        <div id="tabHistory" class="tabpanel">
            <div class="card">
                <h2>History <span class="muted" id="histAdminCount"></span></h2>
                <p class="muted" id="histAdminHelp">Pick a line. Rows load in pages as you scroll. Row color follows the Pass/Fail column.</p>
                <div class="subtabs hist-line-tabs" id="histLineTabs"></div>
                <div class="admin-only edit-toolbar" id="histEditToolbar">
                    <button type="button" id="histEditBtn" onclick="setHistEditMode(true)">Edit mode</button>
                    <button type="button" id="histSaveBtn" class="ok" style="display:none" onclick="saveHistEdits()">Save</button>
                    <button type="button" id="histCancelBtn" class="secondary" style="display:none" onclick="setHistEditMode(false)">Cancel</button>
                    <span class="muted">Edit checks in the table. Save asks for notes.</span>
                </div>
                <div class="filter-row">
                    <label class="f">Filter <input id="histTextFilter" onkeyup="scheduleList(renderAdminHistory)" oninput="scheduleList(renderAdminHistory)" onchange="scheduleList(renderAdminHistory)"></label>
                    <button type="button" class="secondary" onclick="clearHistFilters()">Clear filters</button>
                </div>
                <div class="list-wrap hist-scroll" id="histAdminWrap"><table class="list hist-grid" id="histAdminTable"></table></div>
                <div class="hist-more" id="histMoreHint" style="display:none">Scroll down to load more checks.</div>
            </div>
        </div>
        <div id="tabProfiles" class="tabpanel">
            <div class="card">
                <h2>Profiles <span class="muted" id="profilePlantLabel"></span></h2>
                <div class="subtabs" id="profileLineTabs"></div>
                <div id="profileFrontWrap">
                <h3>Front to back ratio</h3>
                <div class="list-wrap">
                    <table class="list" id="frontToBackTable">
                        <tr><th>Item</th><th>Ratio</th></tr>
                        <tr><td>ULINE</td><td>1.75</td></tr>
                        <tr><td>Non-ULINE</td><td>1.5</td></tr>
                    </table>
                </div>
                </div>
                <h3>Structure speeds <span class="muted" id="profileVersionLabel"></span></h3>
<div class="admin-only edit-toolbar" id="profileEditToolbar">
                    <button type="button" id="profileEditBtn" onclick="toggleProfileEditMode()">Edit mode</button>
                    <button type="button" id="profileSaveBtn" class="ok" style="display:none" onclick="saveProfilesWithReason()">Save</button>
                    <button type="button" id="profileCancelBtn" class="secondary" style="display:none" onclick="cancelProfileEditMode()">Cancel</button>
                    <button type="button" class="secondary" onclick="viewProfileHistory()">History</button>
                </div>
                <div id="profileStructBox"></div>
                <div class="admin-only" id="profileAddWrap" style="display:none">
                    <label class="f">New structure name <input id="newStructName"></label>
                    <button type="button" onclick="addProfileStructure()">Add structure</button>
                </div>
            </div>
        </div>
        <div id="tabAudit" class="tabpanel">
            <div class="card">
                <h2>Audit log <span class="muted" id="auditCount"></span></h2>
                <p class="muted">Sign-ins, new users, password resets, submitted checks, MSPEC edits, item changes, history edits, and documentation updates.</p>
                <div class="list-wrap"><table class="list" id="auditTable"></table></div>
            </div>
        </div>
    </div>
    <div class="submit-bar" id="submitBar" onmouseover="hintMissing()" onmouseout="clearHint()">
        <button type="button" id="submitBtn" class="ghost" onclick="if(this.getAttribute('data-ready')==='1')submitCheck(); else hintMissing();">Submit check</button>
    </div>
    </div>
    <div class="overlay" id="workOverlay">
        <div class="modal work-modal">
            <h3 id="workTitle">Working</h3>
            <div class="boot-bar"><i id="workBarFill"></i></div>
            <p class="muted" id="workBarText">Please wait…</p>
        </div>
    </div>
    <div class="overlay" id="itemViewOverlay">
        <div class="modal wide">
            <h3>Item information</h3>
            <div class="card spec" id="itemViewInfo"></div>
            <div id="itemViewSpec"></div>
            <button type="button" class="secondary" onclick="closeItemView()">Close</button>
        </div>
    </div>
    <div class="overlay" id="itemOverlay">
        <div class="modal">
            <h3 id="itemModalTitle">Add item #</h3>
            <label class="f">Type <span class="req">*</span>
                <select id="newType" onchange="syncItemTypeFields()">
                    <option value="">Select type…</option>
                    <option value="BUBBLE">BUBBLE — COEX / MONO</option>
                    <option value="FOAM">FOAM — S1 / S3 / S4</option>
                    <option value="LAM">LAM — RTS</option>
                    <option value="PLANK">PLANK — P1</option>
                </select>
            </label>
            <p class="muted" id="itemTypeHint">Pick a type first.</p>
            <label class="f">Item # <span class="req">*</span> <input id="newItem"></label>
            <label class="f">Description <span class="req">*</span> <input id="newDesc"></label>
            <div id="fieldsBubble" class="type-fields">
                <label class="f">Slit Width <span class="req">*</span> <input id="newWidthB"></label>
                <label class="f"># Slits <input id="newSlits"></label>
                <label class="f">Footage <span class="req">*</span> <input id="newFootageB"></label>
                <label class="f">Perf <input id="newPerfB"></label>
                <label class="f">Bubble Type <span class="req">*</span> <input id="newBubble"></label>
                <label class="f">Color <select id="newColorB"><option></option><option value="Clear" style="color:#e5e7eb">Clear</option><option value="Green" style="color:#4ade80">Green</option><option value="Pink" style="color:#f9a8d4">Pink</option><option value="Gray" style="color:#9ca3af">Gray</option></select></label>
                <label class="f">Barcode Label <input id="newBarcode"></label>
                <label class="f">Box Label <input id="newBoxLabel"></label>
            </div>
            <div id="fieldsFoam" class="type-fields">
                <label class="f">Width <span class="req">*</span> <input id="newWidthF"></label>
                <label class="f"># Slits <input id="newSlitsF"></label>
                <label class="f">Footage <span class="req">*</span> <input id="newFootageF"></label>
                <label class="f">Perf <input id="newPerfF"></label>
                <label class="f">MSPEC <span class="req">*</span> <input id="newMspecF"></label>
            </div>
            <div id="fieldsLam" class="type-fields">
                <label class="f">Length <span class="req">*</span> <input id="newLengthL"></label>
                <label class="f">Width <span class="req">*</span> <input id="newWidthL"></label>
                <label class="f">Parent Material <input id="newParent"></label>
                <label class="f">MSPEC <input id="newMspecL"></label>
                <label class="f">Thickness <input id="newThk"></label>
            </div>
            <div id="fieldsPlank" class="type-fields">
                <label class="f">Length <span class="req">*</span> <input id="newLengthP"></label>
                <label class="f">Width <span class="req">*</span> <input id="newWidthP"></label>
                <label class="f">Density <span class="req">*</span> <input id="newDens"></label>
                <label class="f"># Shots <span class="req">*</span> <input id="newShots"></label>
                <label class="f">Soft <input id="newSoft"></label>
            </div>
            <p class="req-note"><span class="req">*</span> = required</p>
            <button type="button" class="ok" onclick="saveNewItem()">Save item</button>
            <button type="button" class="secondary" onclick="closeItemModal()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="addUserOverlay">
        <div class="modal">
            <h3>Add user</h3>
            <label class="f">New user <input id="newUser"></label>
            <label class="f">Password <input id="newUserPass" type="password"></label>
            <div class="role-checks">
                <label><input id="newUserOperator" type="checkbox" checked> Operator</label>
                <label><input id="newUserAdmin" type="checkbox"> Admin</label>
                <label><input id="newUserSupervisor" type="checkbox"> Supervisor</label>
                <label><input id="newUserLead" type="checkbox"> Lead</label>
            </div>
            <label class="f">Plant</label>
            <div class="plant-checks" id="newUserPlantBox"></div>
            <div class="line-checks" id="newUserLineBox"></div>
            <button type="button" class="ok" onclick="addUser()">Save user</button>
            <button type="button" class="secondary" onclick="closeAddUserScreen()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="specEditOverlay">
        <div class="modal">
            <h3>Edit spec</h3>
            <div id="specEditFields"></div>
            <button type="button" class="ok" onclick="saveSpecEdit()">Save change</button>
            <button type="button" class="secondary" onclick="closeSpecEdit()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="histOverlay">
        <div class="modal wide">
            <div id="histBody"></div>
            <button type="button" class="secondary" onclick="closeHistory()">Close</button>
        </div>
    </div>
    <div class="overlay" id="pwOverlay">
        <div class="modal">
            <h3 id="pwTitle">Change password</h3>
            <label class="f">Current password <input id="pwOld" type="password"></label>
            <label class="f">New password <input id="pwNew" type="password"></label>
            <label class="f">Confirm new password <input id="pwNew2" type="password"></label>
            <button type="button" class="ok" onclick="saveOwnPassword()">Save password</button>
            <button type="button" class="secondary" onclick="$('pwOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="rolesOverlay">
        <div class="modal">
            <h3>User roles</h3>
            <input type="hidden" id="roleUserName">
            <div class="role-checks">
                <label><input id="roleOperator" type="checkbox" checked disabled> Operator</label>
                <label><input id="roleAdmin" type="checkbox"> Admin</label>
                <label><input id="roleSupervisor" type="checkbox"> Supervisor</label>
                <label><input id="roleLead" type="checkbox"> Lead</label>
            </div>
            <p class="muted">Operator is the default floor role. Admin, supervisor, and lead add extra tools on top of that.</p>
            <button type="button" class="ok" onclick="saveUserRoles()">Save</button>
            <button type="button" class="secondary" onclick="$('rolesOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="histEditOverlay">
        <div class="modal wide">
            <h3>Edit history entry</h3>
            <div id="histEditFields"></div>
            <label class="f">Change notes (required) <textarea id="histEditNotes"></textarea></label>
            <button type="button" class="ok" onclick="saveHistEdit()">Save</button>
            <button type="button" class="secondary" onclick="$('histEditOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="linesOverlay">
        <div class="modal">
            <h3>Assign lines</h3>
            <input type="hidden" id="editUserName">
            <label class="f">Plant</label>
            <div class="plant-checks" id="editUserPlantBox"></div>
            <div class="line-checks" id="editUserLineBox"></div>
            <button type="button" class="ok" onclick="saveAssignedLines()">Save</button>
            <button type="button" class="secondary" onclick="$('linesOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="debugOverlay">
        <div class="modal wide">
            <h3>Debug log</h3>
            <textarea id="debugBox" readonly></textarea>
            <button type="button" class="ok" onclick="copyDebug()">Copy</button>
            <button type="button" class="secondary" onclick="debugLines=[];$('debugBox').value='';">Clear</button>
            <button type="button" class="secondary" onclick="$('debugOverlay').className='overlay'">Close</button>
        </div>
    </div>
    <div class="overlay" id="inboxOverlay">
        <div class="modal wide">
            <h3>Inbox</h3>
            <p class="muted">New user requests and forgot-password notices.</p>
            <div id="inboxBody"></div>
            <button type="button" class="secondary" onclick="closeInbox()">Close</button>
        </div>
    </div>
    <div class="overlay raise" id="newUserOverlay">
        <div class="modal">
            <h3>New User</h3>
            <p class="muted" id="nuStatus">Create a username and password. An admin must approve you before you can sign in.</p>
            <label class="f">Username <input id="nuName"></label>
            <label class="f">Password <input id="nuPass" type="password"></label>
            <label class="f">Confirm password <input id="nuPass2" type="password"></label>
            <button type="button" class="ok" onclick="requestNewUser()">Request account</button>
            <button type="button" class="secondary" onclick="$('newUserOverlay').className='overlay raise'">Cancel</button>
        </div>
    </div>
    <div class="overlay raise" id="forgotOverlay">
        <div class="modal">
            <h3>Forgot Password</h3>
            <p class="muted" id="fpStatus">Enter your username. Admins are notified and will give you a temporary password.</p>
            <label class="f">Username <input id="fpName"></label>
            <button type="button" class="ok" onclick="requestReset()">Notify admins</button>
            <button type="button" class="secondary" onclick="$('forgotOverlay').className='overlay raise'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="parentPickerOverlay">
        <div class="modal">
            <h3>Add parent material</h3>
            <label class="f">Search FOAM items <input id="parentPickerSearch" onkeyup="renderParentPickerList()"></label>
            <div class="hits" id="parentPickerList" style="display:block;max-height:280px"></div>
            <button type="button" class="secondary" onclick="$('parentPickerOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="inboxDetailOverlay">
        <div class="modal wide">
            <h3>Inbox request details</h3>
            <div id="inboxDetailBody"></div>
            <button type="button" class="secondary" onclick="$('inboxDetailOverlay').className='overlay'">Close</button>
        </div>
    </div>
    <div class="overlay" id="conCardOverlay">
        <div class="modal wide">
            <h3>Construction Card</h3>
            <div id="conCardBody"></div>
            <button type="button" class="ok" id="conCardAckBtn" onclick="ackConCard()">I have read this</button>
        </div>
    </div>
    <div class="overlay" id="failOverlay">
        <div class="modal">
            <h3>Failed check follow-up</h3>
            <p class="muted" id="failStatus">This check failed. Choose disposition before continuing.</p>
            <label class="f">Material disposition
                <select id="failDisposition">
                    <option value=""></option>
                    <option>SCRAP</option>
                    <option>QUALITY HOLD</option>
                    <option>PASS AS IS</option>
                </select>
            </label>
            <label class="f">Submit deviation for process profile?
                <select id="failDeviation" onchange="syncFailDeviation()">
                    <option value="NO">No</option>
                    <option value="YES">Yes</option>
                </select>
            </label>
            <p class="muted" id="failDevHint" style="display:none">Yes sends a deviation request to the admin inbox for approval (details expand later).</p>
            <button type="button" class="ok" onclick="submitFailFollowUp()">Continue</button>
        </div>
    </div>
</body>
</html>