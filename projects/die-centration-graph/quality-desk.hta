<html>
<head>
    <title>Quality Desk Checks</title>
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">

    <HTA:APPLICATION
        ID="QualityDeskChecks"
        APPLICATIONNAME="Quality Desk Checks"
        BORDER="thick"
        CAPTION="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        WINDOWSTATE="maximize"
        SCROLL="yes"
    />

    <style>
        body { font-family: Segoe UI, Arial; margin: 0; background: #121212; color: #f3f4f6; font-size: 15px; }
        header.app { display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; background: #1a1a1a; border-bottom: 1px solid #2a2f36; }
        h1 { margin: 0; font-size: 20px; }
        .tag { color: #9ca3af; margin: 2px 0 0; font-size: 12px; }
        .tools button, button { border: 0; border-radius: 10px; padding: 8px 14px; font-weight: 700; cursor: pointer; background: #2563eb; color: #fff; font-family: inherit; }
        button.secondary { background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        button.ok { background: #15803d; }
        button:disabled, button.ghost { opacity: .4; cursor: default; background: #3f3f46; color: #d4d4d8; }
        .wrap { padding: 14px 18px 72px; }
        .status { margin: 0 0 12px; padding: 10px 12px; background: #1f2937; border: 1px solid #334155; border-radius: 8px; white-space: pre-wrap; font-size: 13px; }
        .status.bad { background: #3f1d1d; border-color: #7f1d1d; }
        .lines { margin: 0 0 12px; }
        .lines button { margin: 0 6px 6px 0; min-width: 64px; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .lines button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        .grid { display: table; width: 100%; border-collapse: separate; border-spacing: 12px 0; }
        .col { display: table-cell; vertical-align: top; width: 50%; }
        .card { background: #1e1e1e; border: 1px solid #2a2f36; border-radius: 12px; padding: 14px; margin-bottom: 12px; }
        .card h2 { margin: 0 0 10px; font-size: 16px; }
        label.f { display: block; margin: 0 0 8px; font-size: 12px; font-weight: 700; color: #9ca3af; }
        label.f input, label.f select, label.f textarea { display: block; width: 100%; margin-top: 4px; box-sizing: border-box; padding: 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        textarea { min-height: 58px; }
        label.f.need input, label.f.need select, label.f.need textarea { border-color: #eab308; box-shadow: 0 0 0 2px rgba(234,179,8,.25); }
        .pair { display: table; width: 100%; }
        .pair > div { display: table-cell; width: 50%; padding-right: 8px; }
        .spec { font-size: 13px; }
        .spec b { display: inline-block; min-width: 110px; color: #3e4a55; }
        .spec div { margin: 3px 0; }
        .hits { border: 1px solid #3f3f46; border-radius: 8px; max-height: 160px; overflow: auto; margin-top: 4px; display: none; background: #111; }
        .hits div { padding: 6px 8px; cursor: pointer; }
        .hits div:hover { background: #1d4ed8; }
        .pts input { width: 72px; margin: 0 6px 6px 0; }
        .pf { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 8px; font-size: 12px; }
        .pass { background: #14532d; color: #86efac; }
        .fail { background: #7f1d1d; color: #fecaca; }
        .muted { color: #9ca3af; font-weight: 400; }
        .crumbs { margin: 0 0 14px; color: #9ca3af; font-size: 13px; }
        .crumbs b { color: #f3f4f6; }
        .crumbs a { color: #93c5fd; cursor: pointer; text-decoration: none; }
        .home-grid { display: block; }
        .home-line { display: inline-block; width: 220px; min-height: 110px; margin: 0 12px 12px 0; padding: 18px; vertical-align: top; background: #1e1e1e; border: 1px solid #2a2f36; border-radius: 14px; cursor: pointer; text-align: left; }
        .home-line:hover { border-color: #2563eb; }
        .home-line h3 { margin: 0 0 8px; font-size: 28px; }
        .home-line p { margin: 0; color: #9ca3af; font-size: 13px; font-weight: 400; }
        .reason-btns button { display: block; width: 320px; max-width: 100%; margin: 0 0 12px; padding: 16px; font-size: 18px; }
        .chips { margin: 8px 0; }
        .chip { display: inline-block; min-width: 54px; margin: 0 6px 8px 0; padding: 8px 8px 6px; border-radius: 999px; text-align: center; background: #262626; border: 2px solid #3f3f46; }
        .chip input { width: 48px; border: 0; background: transparent; color: #fff; text-align: center; padding: 2px 0; font-weight: 700; }
        .chip.under { background: #713f12; border-color: #eab308; }
        .chip.in { background: #14532d; border-color: #22c55e; }
        .chip.over { background: #7f1d1d; border-color: #ef4444; }
        .chip.extreme { outline: 2px solid #fff; }
        .chip span { display: block; font-size: 10px; color: #d4d4d8; }
        .results { width: 100%; border-collapse: collapse; font-size: 13px; }
        .results th, .results td { padding: 6px 8px; border-bottom: 1px solid #2a2f36; text-align: right; }
        .results th:first-child, .results td:first-child { text-align: left; color: #9ca3af; }
        .results td.ok { color: #86efac; font-weight: 700; }
        .results td.bad { color: #fca5a5; font-weight: 700; }
        .submit-bar { display: none; position: fixed; right: 18px; bottom: 16px; z-index: 12; }
        .submit-bar.on { display: block; }
        .submit-bar button { min-width: 180px; padding: 12px 20px; font-size: 16px; }
        .screen { display: none; }
        .screen.on { display: block; }
        .plant-toggle button { min-width: 96px; }
        .plant-toggle button.on { background: #0f766e; border-color: #0f766e; }
        canvas.radial { width: 320px; height: 320px; background: #111; border-radius: 12px; }
        .doc-ack { padding: 12px; border: 1px solid #334155; border-radius: 10px; margin: 0 0 10px; }
        .form { display: none; }
        .form.on { display: block; }
        .tabs { margin: 0 0 12px; }
        .tabs button { margin: 0 6px 6px 0; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .tabs button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        .tabpanel { display: none; }
        .tabpanel.on { display: block; }
        table.list { width: 100%; border-collapse: collapse; font-size: 13px; }
        table.list th, table.list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #2a2f36; vertical-align: top; }
        table.list th { color: #9ca3af; }
        .list-wrap { max-height: 520px; overflow: auto; border: 1px solid #2a2f36; border-radius: 8px; }
        .overlay { display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,23,42,.55); z-index: 20; }
        .overlay.on { display: block; }
        .overlay.login { background: #0f172a; z-index: 40; }
        .modal { width: 520px; max-width: 92%; margin: 40px auto; background: #1e1e1e; border-radius: 12px; padding: 16px; border: 1px solid #2a2f36; color: #f3f4f6; }
        .modal.wide { width: 780px; }
        .modal h3 { margin: 0 0 10px; }
        .session { font-size: 13px; color: #9ca3af; margin-right: 10px; }
        .subtabs button { margin: 0 6px 6px 0; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .subtabs button.on { background: #0f766e; color: #fff; border-color: #0f766e; }
        table.specs { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: auto; }
        table.specs th, table.specs td { text-align: left; padding: 5px 6px; border: 1px solid #2a2f36; vertical-align: top; }
        table.specs thead th { background: #1f2937; color: #9ca3af; font-weight: 700; }
        table.specs th.group { text-align: center; background: #111827; }
        table.specs th.mspec, table.specs td.mspec { width: 4.6em; max-width: 5em; white-space: nowrap; }
        table.specs td.num, table.specs th.num { width: 4.2em; text-align: right; }
        table.specs button { padding: 3px 8px; font-size: 12px; margin: 0 3px 0 0; }
        button.danger { background: #991b1b; }
        .locked { display: none; }
        .who { font-weight: 700; color: #f3f4f6; }
        .type-fields { display: none; }
        .type-fields.on { display: block; }
    </style>
    <script src="qd-check.js" type="text/javascript"></script>
    <script type="text/javascript">
        var aio = { items: [], mspecs: [], users: [], bubble: [], bubbleDead: [], p1: [], rts: [], path: '', loaded: false };
        var currentLine = 'S4';
        var currentSite = 'VISALIA';
        var currentScreen = 'home';
        var checkReason = '';
        var noCheckReason = '';
        var startupAnswers = {};
        var docsStore = { docs: [], acks: [] };
        var homeTimer = null;
        var specTab = 'foam';
        var session = { user: '', admin: false, last: 0, rec: null };
        var authUsers = [];
        var specHistory = [];
        var idleTimer = null;

        function $(id) { return document.getElementById(id); }

        function setStatus(msg, bad) {
            var el = $('status');
            el.className = bad ? 'status bad' : 'status';
            el.innerText = msg;
        }

        function getAppFolder() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.GetParentFolderName(htaFilePath());
        }

        function htaFilePath() {
            var href = String(location.href || "");
            var path = String(location.pathname || "");
            var raw = href;
            if (href.toLowerCase().indexOf("file:") === 0) raw = href.replace(/^file:\/\//i, "");
            else if (path) raw = path;
            raw = raw.replace(/^\/+/, "");
            try { raw = decodeURIComponent(raw); } catch (e) {}
            raw = raw.replace(/\//g, "\\");
            if (raw.toLowerCase().indexOf("localhost\\") === 0) raw = raw.substring(10);
            return raw;
        }

        function resultsDir() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = fso.BuildPath(getAppFolder(), QD.DISK_DIR);
            if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
            return dir;
        }

        function fileExists(path) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.FileExists(path);
        }

        function peekAttrs(path) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (!fso.FileExists(path)) return 0;
                return fso.GetFile(path).Attributes;
            } catch (e) { return 0; }
        }

        function setAttrs(path, attrs) {
            try {
                var fso = new ActiveXObject("Scripting.FileSystemObject");
                if (fso.FileExists(path)) fso.GetFile(path).Attributes = attrs;
            } catch (e) {}
        }

        function revealFile(path) {
            var prev = peekAttrs(path);
            if (prev & 6) setAttrs(path, prev & ~6);
            return prev;
        }

        function restoreAttrs(path, prev) {
            if (prev & 6) setAttrs(path, prev);
        }

        function unlockPath(path) {
            if (!fileExists(path)) return;
            setAttrs(path, 0);
            try {
                var sh = new ActiveXObject("WScript.Shell");
                sh.Run('cmd /c icacls "' + path + '" /reset >nul 2>&1', 0, true);
            } catch (e) {}
        }

        function writeUtf8(path, text) {
            var prev = revealFile(path);
            var stream = new ActiveXObject("ADODB.Stream");
            stream.Type = 2;
            stream.Charset = "utf-8";
            stream.Open();
            stream.WriteText(text);
            try {
                stream.SaveToFile(path, 2);
            } catch (e1) {
                unlockPath(path);
                stream.SaveToFile(path, 2);
            }
            stream.Close();
            restoreAttrs(path, prev);
        }

        function readUtf8(path) {
            if (!fileExists(path)) return "";
            var prev = revealFile(path);
            var text = "";
            try {
                var stream = new ActiveXObject("ADODB.Stream");
                stream.Type = 2;
                stream.Charset = "utf-8";
                stream.Open();
                stream.LoadFromFile(path);
                text = stream.ReadText();
                stream.Close();
            } catch (e1) {
                unlockPath(path);
                try {
                    var stream2 = new ActiveXObject("ADODB.Stream");
                    stream2.Type = 2;
                    stream2.Charset = "utf-8";
                    stream2.Open();
                    stream2.LoadFromFile(path);
                    text = stream2.ReadText();
                    stream2.Close();
                } catch (e2) {
                    try {
                        var fso = new ActiveXObject("Scripting.FileSystemObject");
                        var ts = fso.OpenTextFile(path, 1);
                        text = ts.AtEndOfStream ? "" : ts.ReadAll();
                        ts.Close();
                    } catch (e3) { text = ""; }
                }
            }
            restoreAttrs(path, prev);
            return text;
        }

        function protectPath(path) {
            try { if (fileExists(path)) setAttrs(path, (peekAttrs(path) | 2) & ~4); } catch (e1) {}
        }

        function usersDatPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), QD.USERS_FILE);
        }

        function historyPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "spec-history.js");
        }

        function localSpecsPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "local-specs.js");
        }

        function touchSession() {
            if (!session.user) return;
            session.last = new Date().getTime();
        }

        function checkIdle() {
            if (!session.user) return;
            if ((new Date().getTime() - session.last) >= QD.IDLE_MS) logout("Signed out after 1 hour of inactivity.");
        }

        function startIdleWatch() {
            if (idleTimer) window.clearInterval(idleTimer);
            idleTimer = window.setInterval(checkIdle, 15000);
            document.onmousemove = touchSession;
            document.onkeydown = touchSession;
            document.onclick = touchSession;
        }

        function loadAuthUsers() {
            var path = usersDatPath();
            var parsed = [];
            if (fileExists(path)) {
                try { parsed = QD.parseUsersDat(readUtf8(path)); } catch (e1) { parsed = []; }
            }
            if (parsed.length) {
                authUsers = parsed;
                return authUsers;
            }
            if (!authUsers.length) authUsers = [QD.makeUserRecord(QD.SEED_USER, "QCLAB", true, false)];
            try { saveAuthUsers(); } catch (e2) {}
            return authUsers;
        }

        function saveAuthUsers() {
            var path = usersDatPath();
            writeUtf8(path, QD.formatUsersDat(authUsers));
            protectPath(path);
        }

        function loadSpecHistory() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = historyPath();
            window.QD_SPEC_HISTORY = [];
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (e) {}
            }
            specHistory = window.QD_SPEC_HISTORY || [];
        }

        function saveSpecHistory() {
            var path = historyPath();
            writeUtf8(path, "window.QD_SPEC_HISTORY=" + JSON.stringify(specHistory) + ";");
            protectPath(path);
        }

        function addHistory(kind, key, why, before, after) {
            specHistory.push(QD.specHistoryEntry(kind, key, session.user, why, before, after));
            saveSpecHistory();
        }

        function saveLocalSpecs() {
            writeUtf8(localSpecsPath(), "window.QD_LOCAL_SPECS=" + JSON.stringify({
                mspecs: aio.mspecs, bubble: aio.bubble, bubbleDead: aio.bubbleDead, p1: aio.p1, rts: aio.rts
            }) + ";");
        }

        function applyLocalSpecs() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = localSpecsPath();
            window.QD_LOCAL_SPECS = null;
            if (!fso.FileExists(path)) return;
            try { eval(readUtf8(path)); } catch (e) { return; }
            var loc = window.QD_LOCAL_SPECS || {};
            if (loc.mspecs && loc.mspecs.length) aio.mspecs = loc.mspecs;
            if (loc.bubble && loc.bubble.length) aio.bubble = loc.bubble;
            if (loc.bubbleDead && loc.bubbleDead.length) aio.bubbleDead = loc.bubbleDead;
            if (loc.p1 && loc.p1.length) aio.p1 = loc.p1;
            if (loc.rts && loc.rts.length) aio.rts = loc.rts;
        }

        function writeManifest() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = resultsDir();
            var files = [];
            var names = ["manifest.js", "lookup.js"].concat((function () {
                var out = [], i;
                for (i = 0; i < QD.LINE_FILES.length; i++) out.push(QD.LINE_FILES[i] + ".js");
                return out;
            })());
            var i, p;
            for (i = 1; i < names.length; i++) {
                p = fso.BuildPath(dir, names[i]);
                if (fso.FileExists(p)) files.push(names[i]);
            }
            writeUtf8(fso.BuildPath(dir, "manifest.js"), QD.diskManifestScript(files));
        }

        function isAdmin() { return !!(session.user && session.admin); }

        function requireAdmin() {
            if (!isAdmin()) { alert("Only admins can do that."); return false; }
            return true;
        }

        function showApp() {
            $("loginOverlay").className = "overlay login";
            $("appRoot").style.display = "block";
            $("sessionWho").innerText = session.user + (session.admin ? " (admin)" : "");
            var adminEls = document.getElementsByTagName("*");
            var i, el;
            for (i = 0; i < adminEls.length; i++) {
                el = adminEls[i];
                if (el.className && String(el.className).indexOf("admin-only") >= 0) {
                    el.style.display = session.admin ? "" : "none";
                }
            }
            if ($("user")) $("user").value = session.user;
            startIdleWatch();
            touchSession();
        }

        function hideApp(msg) {
            session.user = "";
            session.admin = false;
            session.rec = null;
            $("appRoot").style.display = "none";
            $("loginOverlay").className = "overlay login on";
            if ($("loginPass")) $("loginPass").value = "";
            if (msg) $("loginStatus").innerText = msg;
        }

        function doLogin() {
            var name = QD.trim($("loginUser").value);
            var pass = $("loginPass").value;
            try { loadAuthUsers(); } catch (e0) {}
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec || !QD.verifyPassword(rec, pass)) {
                $("loginStatus").innerText = "Unknown user or wrong password.";
                return;
            }
            if (!rec.hash) {
                $("loginStatus").innerText = "This user has no password. An admin must set one.";
                return;
            }
            session.user = rec.name;
            session.admin = !!rec.admin;
            session.rec = rec;
            currentSite = rec.plant === "GARLAND" ? "GARLAND" : "VISALIA";
            if (rec.plant === "BOTH" || rec.admin) currentSite = "VISALIA";
            touchSession();
            $("loginStatus").innerText = "";
            $("loginOverlay").className = "overlay login";
            showApp();
            setStatus("Signed in as " + rec.name + (rec.admin ? " (admin)" : "") + ".");
            try { if (!aio.loaded) loadAio(false); } catch (e1) {
                setStatus("Signed in, but lookup files could not be opened.\n" + e1.message, true);
            }
            if (rec.mustChange) {
                $("pwOverlay").className = "overlay on";
                $("pwTitle").innerText = "Set your password";
            }
            try { renderLists(); } catch (e2) {}
            try { setSite(currentSite, true); startHomePoll(); } catch (e3) {}
            if (pendingForUser().length) goDocs(true);
            else goHome();
        }

        function logout(msg) {
            hideApp(msg || "Signed out.");
        }

        function findAio() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = ["Quality AIO.xlsm", "Quality_AIO.xlsm", "Quality AIO.xlsx"];
            var i, p;
            for (i = 0; i < names.length; i++) {
                p = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(p)) return p;
            }
            return "";
        }

        function findHtml() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var names = ["index.html", "centration.html", "qualitydesk.html"];
            var i, p;
            for (i = 0; i < names.length; i++) {
                p = fso.BuildPath(folder, names[i]);
                if (fso.FileExists(p)) return p;
            }
            return "";
        }

        function rangeValues(rng) {
            var values = rng.Value;
            var vb, r, c, r0, r1, c0, c1, row, out;
            if (values === undefined || values === null) return [];
            if (typeof values === "string" || typeof values === "number") return [[values]];
            try {
                vb = new VBArray(values);
                r0 = vb.lbound(1); r1 = vb.ubound(1);
                c0 = vb.lbound(2); c1 = vb.ubound(2);
                out = [];
                for (r = r0; r <= r1; r++) {
                    row = [];
                    for (c = c0; c <= c1; c++) row.push(vb.getItem(r, c));
                    out.push(row);
                }
                return out;
            } catch (e) {
                if (values && values.length) return values;
                return [];
            }
        }

        function sheetValues(ws) {
            return rangeValues(ws.UsedRange);
        }

        function listObjectRows(ws, tableName) {
            try {
                var lo = ws.ListObjects(tableName);
                return rowsFromValues(rangeValues(lo.Range));
            } catch (e) {
                return [];
            }
        }

        function rowsFromValues(raw, headerMap) {
            var rows = [];
            var headers = [];
            var r, c, obj, key;
            if (!raw || !raw.length) return rows;
            for (c = 0; c < raw[0].length; c++) headers.push(String(raw[0][c] == null ? "" : raw[0][c]));
            for (r = 1; r < raw.length; r++) {
                obj = {};
                for (c = 0; c < headers.length; c++) {
                    key = headerMap && headerMap[headers[c]] ? headerMap[headers[c]] : headers[c];
                    if (key) obj[key] = raw[r][c] == null ? "" : raw[r][c];
                }
                rows.push(obj);
            }
            return rows;
        }

        function rowsFromSheet(ws, headerMap) {
            return rowsFromValues(sheetValues(ws), headerMap);
        }

        function loadAioExcel(path) {
            var xl = new ActiveXObject("Excel.Application");
            var wb, items = [], mspecs = [], users = [], rts = [], p1 = [];
            xl.Visible = false;
            xl.DisplayAlerts = false;
            try { xl.AskToUpdateLinks = false; } catch (e0) {}
            try {
                wb = xl.Workbooks.Open(path, 0, true);
                items = normalizeItems(listObjectRows(wb.Worksheets("Master Database"), "Table114"));
                if (!items.length) items = normalizeItems(rowsFromSheet(wb.Worksheets("Master Database")));
                mspecs = normalizeMspecs(listObjectRows(wb.Worksheets("Master Sheet"), "Table7"));
                if (!mspecs.length) mspecs = normalizeMspecs(rowsFromSheet(wb.Worksheets("Master Sheet")));
                rts = normalizeRts(listObjectRows(wb.Worksheets("Master Sheet"), "Table86"));
                p1 = normalizeP1(listObjectRows(wb.Worksheets("Master Sheet"), "Table97"));
                users = normalizeUsers(sheetValues(wb.Worksheets("User List")));
                wb.Close(false);
            } finally {
                try { xl.Quit(); } catch (e1) {}
            }
            return { items: items, mspecs: mspecs, users: users, rts: rts, p1: p1 };
        }

        function normalizeItems(rows) {
            var out = [], i, r, item;
            for (i = 0; i < rows.length; i++) {
                r = rows[i];
                item = QD.canonItem(r["Item #"] || r["Item"] || r["Item_"] );
                if (!item) continue;
                out.push({
                    item: item,
                    type: QD.itemType({
                        type: r.Type || r.type,
                        bubbleType: r["Bubble Type"] || r.BubbleType,
                        slits: r["# Slits"] || r["Slits"],
                        shots: r["# Shots"] || r.Shots,
                        soft: r.Soft,
                        parent: r["Parent Material"] || r.Parent,
                        thickness: r.Thickness,
                        length: r.Length,
                        footage: r.Footage,
                        mspec: r.MSPEC
                    }),
                    description: QD.trim(r.Description || r["Item Description"]),
                    length: r.Length,
                    width: r.Width,
                    slits: r["# Slits"] || r["Slits"],
                    footage: r.Footage,
                    perf: r.Perf,
                    bubbleType: r["Bubble Type"] || r.BubbleType,
                    parent: r["Parent Material"] || r.Parent,
                    mspec: QD.canonMspec(r.MSPEC || r["MSPEC #"]),
                    thickness: r.Thickness,
                    density: r.Density,
                    shots: r["# Shots"] || r.Shots,
                    soft: r.Soft
                });
            }
            return out;
        }

        function normalizeMspecs(rows) {
            var out = [], i, r, key;
            for (i = 0; i < rows.length; i++) {
                r = rows[i];
                key = QD.canonMspec(r["MSPEC #"] || r.MSPEC);
                if (!key) continue;
                r["MSPEC #"] = key;
                out.push(QD.lookupToDeskRow(r));
            }
            return out;
        }

        function normalizeRts(rows) {
            var out = [], i, r, product;
            for (i = 0; i < (rows || []).length; i++) {
                r = rows[i];
                product = QD.trim(r.Product || r.product || r["Product label"]);
                if (!product || /^product$/i.test(product)) continue;
                out.push({ product: product, min: r.Min, target: r.Target, max: r.Max });
            }
            return out;
        }

        function normalizeP1(rows) {
            var out = [], i, r, thk;
            for (i = 0; i < (rows || []).length; i++) {
                r = rows[i];
                thk = QD.trim(r.Thickness || r.thickness);
                if (!thk || /^thickness$/i.test(thk)) continue;
                out.push({
                    thickness: thk,
                    density: r.Density,
                    min: r.Min,
                    max: r.Max,
                    ccMin: r["CC Min"],
                    ccMax: r["CC Max"],
                    thickMin: r["Thick Min"],
                    thickMax: r["Thick Max"],
                    thickTarget: r["Thick Target"]
                });
            }
            return out;
        }

        function normalizeUsers(values) {
            var out = [], r, v;
            if (!values) return out;
            for (r = 1; r < values.length; r++) {
                v = QD.trim(values[r][0]);
                if (v) out.push(v);
            }
            return out;
        }

        function cachePath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "aio-cache.js");
        }

        function saveAioCache() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var mtime = aio.path && fso.FileExists(aio.path) ? String(fso.GetFile(aio.path).DateLastModified) : "";
            writeUtf8(cachePath(), "window.QD_AIO=" + JSON.stringify({
                path: aio.path, mtime: mtime, items: aio.items, mspecs: aio.mspecs, users: aio.users,
                bubble: aio.bubble, bubbleDead: aio.bubbleDead, p1: aio.p1, rts: aio.rts
            }) + ";");
        }

        function loadAioCache() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = cachePath();
            if (!fso.FileExists(path)) return false;
            window.QD_AIO = null;
            eval(readUtf8(path));
            if (!window.QD_AIO || !window.QD_AIO.items || !window.QD_AIO.items.length) return false;
            if (!window.QD_AIO.mspecs || !window.QD_AIO.mspecs.length) return false;
            if (aio.path && window.QD_AIO.mtime) {
                if (fso.FileExists(aio.path) && String(fso.GetFile(aio.path).DateLastModified) !== window.QD_AIO.mtime) return false;
            }
            aio.items = window.QD_AIO.items;
            aio.mspecs = window.QD_AIO.mspecs;
            aio.users = window.QD_AIO.users || [];
            aio.bubble = window.QD_AIO.bubble || [];
            aio.bubbleDead = window.QD_AIO.bubbleDead || [];
            aio.p1 = window.QD_AIO.p1 || [];
            aio.rts = window.QD_AIO.rts || [];
            aio.loaded = true;
            return true;
        }

        function findCsvFile(names) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var folder = getAppFolder();
            var dirs = [fso.BuildPath(folder, "aio-csv"), folder];
            var d, i, p;
            for (d = 0; d < dirs.length; d++) {
                if (!fso.FolderExists(dirs[d])) continue;
                for (i = 0; i < names.length; i++) {
                    p = fso.BuildPath(dirs[d], names[i]);
                    if (fso.FileExists(p)) return p;
                }
            }
            return "";
        }

        function loadBubbleFile() {
            var path = findCsvFile(QD.CSV_FILES.bubble);
            if (!path) return { specs: [], deadCells: [], source: "" };
            var parsed = QD.parseBubbleSpecs(readUtf8(path));
            parsed.source = path;
            return parsed;
        }

        function loadAioCsv() {
            var itemPath = findCsvFile(QD.CSV_FILES.items);
            var specPath = findCsvFile(QD.CSV_FILES.mspecs);
            var userPath = findCsvFile(QD.CSV_FILES.users);
            var rtsPath = findCsvFile(QD.CSV_FILES.rts);
            var p1Path = findCsvFile(QD.CSV_FILES.p1);
            var bubble = loadBubbleFile();
            if (!itemPath && !specPath && !userPath && !rtsPath && !p1Path && !bubble.source) return null;
            var items = itemPath ? normalizeItems(QD.parseCsv(readUtf8(itemPath)).rows) : [];
            var mspecs = specPath ? normalizeMspecs(QD.parseCsv(readUtf8(specPath)).rows) : [];
            var rts = rtsPath ? QD.parseRtsSpecs(readUtf8(rtsPath)) : [];
            var p1 = p1Path ? QD.parseP1Specs(readUtf8(p1Path)) : [];
            var users = [];
            if (userPath) {
                var parsed = QD.parseCsv(readUtf8(userPath));
                var i, row, name;
                for (i = 0; i < parsed.rows.length; i++) {
                    row = parsed.rows[i];
                    name = QD.trim(row[parsed.headers[0]] || row.User || row.Name);
                    if (name && !/^enter your name/i.test(name)) users.push(name);
                }
            }
            return {
                items: items, mspecs: mspecs, users: users, rts: rts, p1: p1,
                bubble: bubble.specs || [], bubbleDead: bubble.deadCells || [],
                source: itemPath || specPath || rtsPath || p1Path || bubble.source || userPath
            };
        }

        function loadLocalExtras() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var extraItems = [], extraUsers = [];
            var ip = fso.BuildPath(resultsDir(), "local-items.js");
            var up = fso.BuildPath(resultsDir(), "local-users.js");
            window.QD_LOCAL = { items: [], users: [] };
            if (fso.FileExists(ip)) { try { eval(readUtf8(ip)); } catch (e1) {} }
            if (fso.FileExists(up)) { try { eval(readUtf8(up)); } catch (e2) {} }
            extraItems = (window.QD_LOCAL && window.QD_LOCAL.items) || [];
            extraUsers = (window.QD_LOCAL && window.QD_LOCAL.users) || [];
            aio.items = QD.mergeItems(aio.items, extraItems);
            aio.users = QD.mergeUsers(aio.users, extraUsers);
        }

        function saveLocalItems() {
            writeUtf8((new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "local-items.js"),
                "window.QD_LOCAL=window.QD_LOCAL||{items:[],users:[]};QD_LOCAL.items=" + JSON.stringify(localItemsOnly()) + ";");
        }

        function saveLocalUsers() {
            writeUtf8((new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "local-users.js"),
                "window.QD_LOCAL=window.QD_LOCAL||{items:[],users:[]};QD_LOCAL.users=" + JSON.stringify(aio.localUsers || []) + ";");
        }

        function localItemsOnly() {
            var out = [], i;
            for (i = 0; i < aio.items.length; i++) if (aio.items[i].local) out.push(aio.items[i]);
            return out;
        }

        function applySpecBundle(data) {
            aio.bubble = (data && data.bubble) || aio.bubble || [];
            aio.bubbleDead = (data && data.bubbleDead) || aio.bubbleDead || [];
            aio.p1 = (data && data.p1) || aio.p1 || [];
            aio.rts = (data && data.rts) || aio.rts || [];
        }

        function afterAioLoad(source) {
            loadLocalExtras();
            applyLocalSpecs();
            loadSpecHistory();
            aio.loaded = aio.items.length > 0 || aio.mspecs.length > 0 || aio.bubble.length > 0 || aio.p1.length > 0 || aio.rts.length > 0;
            fillUsers();
            writeLookupFile();
            ensureLineFiles();
            writeManifest();
            renderLists();
            setStatus(source);
        }

        function loadAio(force) {
            aio.path = findAio();
            aio.items = []; aio.mspecs = []; aio.users = []; aio.bubble = []; aio.bubbleDead = []; aio.p1 = []; aio.rts = []; aio.loaded = false;
            if (force) {
                try {
                    var fso = new ActiveXObject("Scripting.FileSystemObject");
                    if (fso.FileExists(cachePath())) fso.DeleteFile(cachePath(), true);
                } catch (e0) {}
            }
            var csv = loadAioCsv();
            if (csv && (csv.items.length || csv.mspecs.length || csv.users.length || csv.bubble.length || csv.p1.length || csv.rts.length)) {
                aio.items = csv.items;
                aio.mspecs = csv.mspecs;
                aio.users = csv.users;
                applySpecBundle(csv);
                afterAioLoad("Loaded lookup CSVs (" + aio.items.length + " items, " + aio.mspecs.length + " foam, " + aio.bubble.length + " bubble, " + aio.p1.length + " P1, " + aio.rts.length + " RTS).\n" + csv.source);
                return true;
            }
            if (!force && loadAioCache()) {
                afterAioLoad("Loaded specs from cache (" + aio.items.length + " items, " + aio.mspecs.length + " MSPECs).\n" + (aio.path || ""));
                return true;
            }
            if (!aio.path) {
                var bubbleOnly = loadBubbleFile();
                if (bubbleOnly.source) {
                    aio.bubble = bubbleOnly.specs;
                    aio.bubbleDead = bubbleOnly.deadCells;
                    afterAioLoad("Loaded BubbleSpecs.csv only. Export AIO tables for foam/P1/RTS items.\n" + bubbleOnly.source);
                    return true;
                }
                setStatus("No lookup data. Put Quality AIO.xlsm next to this HTA, or run ExportAioCsv to create aio-csv\\MasterDatabase.csv.\n" + getAppFolder(), true);
                renderLists();
                return false;
            }
            setStatus("Reading Quality AIO.xlsm…");
            try {
                var data = loadAioExcel(aio.path);
                aio.items = data.items;
                aio.mspecs = data.mspecs;
                aio.users = data.users;
                applySpecBundle(data);
                var extra = loadBubbleFile();
                if (extra.source) {
                    aio.bubble = extra.specs;
                    aio.bubbleDead = extra.deadCells;
                }
                if (aio.items.length) saveAioCache();
                afterAioLoad("Loaded Quality AIO (" + aio.items.length + " items, " + aio.mspecs.length + " foam MSPECs).\n" + aio.path);
                if (!aio.items.length) setStatus("Opened Quality AIO.xlsm but read 0 items. Run ExportAioCsv in the workbook and keep aio-csv next to the HTA.", true);
                return aio.items.length > 0;
            } catch (e) {
                setStatus("Could not read Quality AIO.xlsm. Excel must be installed, or export CSVs with ExportAioCsv.\n" + e.message, true);
                return false;
            }
        }

        function writeLookupFile() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            writeUtf8(fso.BuildPath(resultsDir(), "lookup.js"), QD.diskScript("lookup", {
                lookupRows: aio.mspecs,
                users: aio.users
            }));
            writeManifest();
        }

        function ensureLineFiles() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var i, key, path;
            for (i = 0; i < QD.LINE_FILES.length; i++) {
                key = QD.LINE_FILES[i];
                path = fso.BuildPath(resultsDir(), key + ".js");
                if (!fso.FileExists(path)) writeLineRows(key, []);
            }
        }

        function readLineRows(fileKey) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = fso.BuildPath(resultsDir(), fileKey + ".js");
            window.QD_DISK = { lines: {}, lookupRows: [], users: [] };
            if (!fso.FileExists(path)) return [];
            try { eval(readUtf8(path)); } catch (e) { return []; }
            return (window.QD_DISK.lines[fileKey] && window.QD_DISK.lines[fileKey].rows) || [];
        }

        function writeLineRows(fileKey, rows) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            writeUtf8(fso.BuildPath(resultsDir(), fileKey + ".js"), QD.diskScript(fileKey, {
                file: fileKey,
                rows: rows || []
            }));
            writeManifest();
        }

        function fillUsers() {
            var sel = $("user");
            if (!sel) return;
            if (sel.tagName !== "SELECT") {
                sel.value = session.user || "";
                return;
            }
            sel.options.length = 0;
            if (session.user) {
                sel.options.add(new Option(session.user, session.user));
                sel.value = session.user;
                sel.disabled = true;
            } else {
                sel.options.add(new Option("", ""));
                sel.disabled = false;
            }
        }

        function esc(s) {
            return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
        }

        function sessionUser() {
            return session.rec || QD.findUserRecord(authUsers, session.user);
        }

        function docsPath() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            return fso.BuildPath(resultsDir(), "docs.js");
        }

        function loadDocs() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var path = docsPath();
            window.QD_DOCS = { docs: [], acks: [] };
            if (fso.FileExists(path)) {
                try { eval(readUtf8(path)); } catch (e) {}
            }
            docsStore = window.QD_DOCS || { docs: [], acks: [] };
            if (!docsStore.docs) docsStore.docs = [];
            if (!docsStore.acks) docsStore.acks = [];
        }

        function saveDocs() {
            writeUtf8(docsPath(), "window.QD_DOCS=" + JSON.stringify(docsStore) + ";");
        }

        function assignedLineIds() {
            var out = [], list = QD.linesForSite(currentSite), i;
            for (i = 0; i < list.length; i++) {
                if (QD.userCanSeeLine(sessionUser(), list[i].id, currentSite)) out.push(list[i].id);
            }
            return out;
        }

        function pendingForUser() {
            loadDocs();
            var labels = [], ids = assignedLineIds(), i;
            for (i = 0; i < ids.length; i++) labels.push(QD.lineLabel(ids[i], currentSite));
            return QD.pendingDocs(docsStore.docs, docsStore.acks, session.user, labels.concat(ids));
        }

        function lastRowFor(lineId) {
            var info = QD.lineInfo(lineId, currentSite);
            if (!info) return null;
            var rows = readLineRows(info.file);
            return rows.length ? rows[rows.length - 1] : null;
        }

        function setSite(site, force) {
            var sit = String(site || 'VISALIA').toUpperCase();
            if (!QD.userCanSeeSite(sessionUser(), sit) && !force) return;
            currentSite = sit;
            if ($("plantVis")) {
                $("plantVis").className = sit === "VISALIA" ? "on" : "";
                $("plantVis").style.display = QD.userCanSeeSite(sessionUser(), "VISALIA") ? "" : "none";
            }
            if ($("plantGar")) {
                $("plantGar").className = sit === "GARLAND" ? "on" : "";
                $("plantGar").style.display = QD.userCanSeeSite(sessionUser(), "GARLAND") ? "" : "none";
            }
            if (sit === "GARLAND") specTab = "bubble";
            renderCrumbs();
            renderHome();
            renderLists();
            renderDocTable();
        }

        function renderCrumbs() {
            var el = $("crumbs");
            if (!el) return;
            var site = currentSite === "GARLAND" ? "Garland" : "Visalia";
            var label = QD.lineLabel(currentLine, currentSite);
            var html = "<a onclick=\"goHome()\">" + site + "</a> / <a onclick=\"goHome()\">Home</a>";
            if (currentScreen !== "home" && currentScreen !== "docs") html += " / <a onclick=\"goReason()\">Quality check</a> / <b>" + esc(label) + "</b>";
            el.innerHTML = html;
        }

        function showScreen(id) {
            currentScreen = id;
            var map = { home: "screenHome", docs: "screenDocs", reason: "screenReason", nocheck: "screenNoCheck", lineup: "screenLineUp", itempick: "screenItem", startup: "screenStartup", checkform: "screenCheck" };
            var key, el;
            for (key in map) {
                if (!map.hasOwnProperty(key)) continue;
                el = $(map[key]);
                if (el) el.className = "screen" + (key === id ? " on" : "");
            }
            if ($("submitBar")) $("submitBar").className = "submit-bar" + (id === "nocheck" || id === "lineup" || id === "checkform" ? " on" : "");
            renderCrumbs();
            syncSubmitBtn();
        }

        function goHome() {
            if (pendingForUser().length) { goDocs(true); return; }
            showTab("checks");
            showScreen("home");
            renderHome();
        }

        function goDocs(blocking) {
            showTab("docs");
            showScreen("docs");
            renderDocAck(blocking);
        }

        function goReason() {
            if (pendingForUser().length) { goDocs(true); return; }
            showTab("checks");
            var last = lastRowFor(currentLine);
            if (QD.needsLineUp(last)) {
                checkReason = "LINE UP";
                if ($("reason")) $("reason").value = "LINE UP";
                showScreen("lineup");
                return;
            }
            checkReason = "";
            showScreen("reason");
        }

        function pickReason(reason) {
            checkReason = reason;
            if ($("reason")) $("reason").value = reason;
            if (reason === "NO CHECK") {
                noCheckReason = "";
                if ($("noCheckReason")) $("noCheckReason").selectedIndex = 0;
                showScreen("nocheck");
                return;
            }
            showScreen("itempick");
            if ($("item")) { $("item").value = ""; $("item").focus(); }
            $("hits").style.display = "none";
        }

        function confirmItem() {
            var it = selectedItem();
            if (!it) { setStatus("Enter an item # for this line.", true); return; }
            if (!QD.itemAllowedOnLine(it, currentLine, currentSite)) {
                setStatus("That item is not for " + QD.lineLabel(currentLine, currentSite) + ".", true);
                return;
            }
            var last = lastRowFor(currentLine);
            if (QD.needsStartup(last, it.item, new Date())) {
                startupAnswers = {};
                renderStartup();
                showScreen("startup");
                return;
            }
            enterCheckForm();
        }

        function renderStartup() {
            var html = "<h2>Startup checklist</h2><p class='muted'>Required because this is a new item or a new shift (7AM–3PM, 3PM–11PM, 11PM–7AM).</p>", i, row;
            for (i = 0; i < QD.STARTUP_ITEMS.length; i++) {
                row = QD.STARTUP_ITEMS[i];
                html += "<label class='f'>" + esc(row.text);
                html += " <select id='su_" + row.id + "' onchange='startupChanged()'><option value=''></option><option value='YES'>Yes</option><option value='NO'>No</option></select></label>";
            }
            html += "<button type='button' class='ok' id='startupNext' disabled onclick='finishStartup()'>Continue to check</button>";
            $("startupBox").innerHTML = html;
        }

        function startupChanged() {
            var i, row, el;
            for (i = 0; i < QD.STARTUP_ITEMS.length; i++) {
                row = QD.STARTUP_ITEMS[i];
                el = $("su_" + row.id);
                startupAnswers[row.id] = el ? el.value : "";
            }
            if ($("startupNext")) $("startupNext").disabled = !QD.startupComplete(startupAnswers);
        }

        function finishStartup() {
            if (!QD.startupComplete(startupAnswers)) { setStatus("Answer Yes on every startup question.", true); return; }
            enterCheckForm();
        }

        function enterCheckForm() {
            setLine(currentLine);
            if ($("mspecWrap")) $("mspecWrap").style.display = QD.hasMspec(currentLine, currentSite) ? "block" : "none";
            onItemChange();
            showScreen("checkform");
        }

        function renderHome() {
            var box = $("homeLines");
            if (!box) return;
            var list = QD.linesForSite(currentSite);
            var html = "", i, info, last;
            for (i = 0; i < list.length; i++) {
                info = list[i];
                if (!QD.userCanSeeLine(sessionUser(), info.id, currentSite)) continue;
                last = lastRowFor(info.id);
                html += "<div class='home-line' onclick=\"openLine('" + info.id + "')\"><h3>" + esc(info.label) + "</h3><p>" + esc(QD.lastCheckLabel(last)) + "</p></div>";
            }
            if (!html) html = "<p class='muted'>No lines assigned to you at this plant.</p>";
            box.innerHTML = html;
            renderCrumbs();
        }

        function openLine(id) {
            currentLine = id;
            setLine(id);
            goReason();
        }

        function startHomePoll() {
            if (homeTimer) window.clearInterval(homeTimer);
            homeTimer = window.setInterval(function () {
                if (currentScreen === "home" && $("tabChecks") && $("tabChecks").className.indexOf("on") >= 0) renderHome();
            }, 20000);
        }

        function openDocLink(url) {
            if (!url) return;
            try { (new ActiveXObject("WScript.Shell")).Run('"' + url + '"', 1, false); }
            catch (e1) {
                try { (new ActiveXObject("WScript.Shell")).Run('cmd /c start "" "' + url + '"', 0, false); } catch (e2) {}
            }
        }

        function renderDocAck(blocking) {
            var pending = pendingForUser();
            var html = blocking ? "<h2>Documents to review</h2><p class='muted'>Open each document, then confirm you read it. Checks stay locked until this is done. Review again every 3 months, or when the version changes.</p>" : "<h2>My documents</h2>";
            var i, d;
            if (!pending.length && blocking) html += "<p>You are caught up.</p><button type='button' class='ok' onclick='goHome()'>Continue</button>";
            for (i = 0; i < pending.length; i++) {
                d = pending[i];
                html += "<div class='doc-ack'><b>" + esc(d.name) + "</b> · " + esc(d.type) + " · " + esc(d.line) + " · v" + esc(d.version);
                html += "<div><button type='button' class='secondary' onclick=\"openDocLink('" + String(d.url || '').replace(/'/g, "") + "')\">Open document</button> ";
                html += "<button type='button' class='ok' onclick=\"ackDoc('" + String(d.id).replace(/'/g, "") + "')\">I have read this</button></div></div>";
            }
            if ($("docAckBox")) $("docAckBox").innerHTML = html;
        }

        function ackDoc(id) {
            loadDocs();
            var i, d = null;
            for (i = 0; i < docsStore.docs.length; i++) if (docsStore.docs[i].id === id) d = docsStore.docs[i];
            if (!d) return;
            openDocLink(d.url);
            docsStore.acks.push({ docId: d.id, version: d.version, user: session.user, at: (new Date()).toISOString() });
            saveDocs();
            if (pendingForUser().length) renderDocAck(true);
            else goHome();
        }

        function renderDocTable() {
            loadDocs();
            var html = "<tr><th>Name</th><th>Line</th><th>Type</th><th>Link</th><th>Version</th>";
            if (session.admin) html += "<th></th>";
            html += "</tr>";
            var i, d, n = 0;
            for (i = 0; i < docsStore.docs.length; i++) {
                d = docsStore.docs[i];
                html += "<tr><td>" + esc(d.name) + "</td><td>" + esc(d.line) + "</td><td>" + esc(d.type) + "</td><td><a href='#' onclick=\"openDocLink('" + String(d.url || '').replace(/'/g, "") + "');return false;\">Open</a></td><td>" + esc(d.version) + "</td>";
                if (session.admin) html += "<td><button type='button' class='secondary' onclick=\"bumpDoc('" + String(d.id).replace(/'/g, "") + "')\">Bump version</button><button type='button' class='danger' onclick=\"deleteDoc('" + String(d.id).replace(/'/g, "") + "')\">Delete</button></td>";
                html += "</tr>";
                n += 1;
            }
            if ($("docTable")) $("docTable").innerHTML = html;
            if ($("docCount")) $("docCount").innerText = n + " document" + (n === 1 ? "" : "s");
        }

        function addDoc() {
            if (!requireAdmin()) return;
            var name = QD.trim($("docName").value);
            var line = $("docLine").value;
            var type = $("docType").value;
            var url = QD.trim($("docUrl").value);
            var ver = QD.trim($("docVer").value) || "1";
            if (!name || !url) { setStatus("Document name and link are required.", true); return; }
            loadDocs();
            docsStore.docs.push({ id: "d" + (new Date()).getTime(), name: name, line: line, type: type, url: url, version: ver });
            saveDocs();
            $("docName").value = ""; $("docUrl").value = "";
            renderDocTable();
        }

        function bumpDoc(id) {
            if (!requireAdmin()) return;
            loadDocs();
            var i, d, n;
            for (i = 0; i < docsStore.docs.length; i++) {
                if (docsStore.docs[i].id === id) {
                    d = docsStore.docs[i];
                    n = parseFloat(d.version);
                    d.version = isFinite(n) ? String(n + 1) : String(d.version) + ".1";
                }
            }
            saveDocs();
            renderDocTable();
        }

        function deleteDoc(id) {
            if (!requireAdmin()) return;
            if (!confirm("Delete this document?")) return;
            loadDocs();
            var i, next = [];
            for (i = 0; i < docsStore.docs.length; i++) if (docsStore.docs[i].id !== id) next.push(docsStore.docs[i]);
            docsStore.docs = next;
            saveDocs();
            renderDocTable();
        }

        function collectLiveInput() {
            var calc = compute();
            var input = collectCheckInput(calc);
            input.user = session.user;
            input.reason = checkReason || val("reason");
            input.noCheckReason = noCheckReason || val("noCheckReason");
            if (input.reason === "NO CHECK") input.notes = val("noNotes") || val("notes");
            else if (input.reason === "LINE UP") input.notes = val("upNotes") || val("notes");
            else input.notes = val("checkNotes") || val("notes");
            return input;
        }

        function missingFieldIds() {
            var reason = checkReason || val("reason");
            var input = collectLiveInput();
            var miss = QD.missingCheckFields(currentLine, reason, input);
            var map = {
                "Additional reason": "noCheckReason",
                "Notes": (reason === "NO CHECK" ? "noNotes" : (reason === "LINE UP" ? "upNotes" : "notes")),
                "Item #": "item",
                "Bundle #": currentLine === "S4" ? "s4bundle" : "s1bundle",
                "Slit/Width": "s4width",
                "Width": currentLine === "S4" ? "s4width" : (QD.lineInfo(currentLine, currentSite) && QD.lineInfo(currentLine, currentSite).form === "p1" ? "pwidth" : (QD.lineInfo(currentLine, currentSite) && QD.lineInfo(currentLine, currentSite).form === "rts" ? "rwidth" : (QD.lineInfo(currentLine, currentSite) && QD.lineInfo(currentLine, currentSite).form === "bubble" ? "bwidth" : "s1width"))),
                "Footage": currentLine === "S4" ? "s4foot" : "s1foot",
                "Cell Count MD": currentLine === "S4" ? "s4md" : "s1md",
                "Cell Count CD": currentLine === "S4" ? "s4cd" : "s1cd",
                "Weight (g)": "s4weight",
                "Weight": currentLine.indexOf("COEX") >= 0 || currentLine.indexOf("MONO") >= 0 ? "bweight" : "s1weight",
                "Thickness points": currentLine === "S4" ? "s4t1" : "s1t1",
                "Perf": "s1perf",
                "Product Verification": "bprod",
                "COH/ADH Verification": "bcoh",
                "Post-Visual Inspection": "bpostv",
                "# Slits": "bslits",
                "Perf Width": "bperfw",
                "Perf Tester Results": "btester",
                "Dead Cell Pre": "bdeadPre",
                "Dead Cell Post": "bdeadPost",
                "Length": currentLine === "P1" ? "plength" : "rlength",
                "Plank Weight": "pweight",
                "P1": "phead", "P2": "pend1", "P3": "pend2", "P4": "ptail",
                "Parent Material": "rparent",
                "Parent MFG Date": "rdate",
                "Parent Shift": "rshift",
                "Color": "rcolor",
                "Delamination": "rdelam",
                "Blistering": "rdelam",
                "Alligator Skin": "rallig",
                "T Point 1": "rt1", "T Point 2": "rt2", "T Point 3": "rt3"
            };
            var ids = [], i, id;
            for (i = 0; i < miss.length; i++) {
                id = map[miss[i]];
                if (id) ids.push(id);
            }
            return { miss: miss, ids: ids };
        }

        function hintMissing() {
            var info = missingFieldIds(), i, el, lab;
            clearHint();
            for (i = 0; i < info.ids.length; i++) {
                el = $(info.ids[i]);
                if (!el) continue;
                lab = el.parentNode;
                if (lab && lab.tagName === "LABEL") lab.className = String(lab.className || "") + " need";
                else el.style.borderColor = "#eab308";
            }
        }

        function clearHint() {
            var labs = document.getElementsByTagName("label"), i;
            for (i = 0; i < labs.length; i++) labs[i].className = String(labs[i].className || "").replace(/\s*need/g, "");
        }

        function syncSubmitBtn() {
            var btn = $("submitBtn");
            if (!btn) return;
            var info = missingFieldIds();
            var ready = info.miss.length === 0;
            btn.className = ready ? "ok" : "ghost";
            btn.setAttribute("data-ready", ready ? "1" : "0");
        }

        function showTab(id) {
            var i, tabs = $("mainTabs").getElementsByTagName("button");
            for (i = 0; i < tabs.length; i++) tabs[i].className = (tabs[i].getAttribute("data-tab") === id) ? "on" : "";
            $("tabChecks").className = "tabpanel" + (id === "checks" ? " on" : "");
            $("tabUsers").className = "tabpanel" + (id === "users" ? " on" : "");
            $("tabMspecs").className = "tabpanel" + (id === "mspecs" ? " on" : "");
            $("tabItems").className = "tabpanel" + (id === "items" ? " on" : "");
            if ($("tabDocs")) $("tabDocs").className = "tabpanel" + (id === "docs" ? " on" : "");
            if (id === "mspecs" && currentSite === "GARLAND") setSpecTab("bubble");
            if (id === "docs") renderDocTable();
            if (id !== "checks") renderLists();
            if ($("submitBar") && id !== "checks") $("submitBar").className = "submit-bar";
        }

        function renderLists() {
            renderUserTable();
            renderMspecTable();
            renderItemTable();
        }

        function histBtn(kind, key) {
            return "<button type='button' class='secondary' onclick=\"viewHistory('" + esc(kind) + "','" + String(key).replace(/'/g, "") + "')\">View history</button>";
        }

        function editBtn(kind, key) {
            if (!session.admin) return "";
            return "<button type='button' onclick=\"openSpecEdit('" + esc(kind) + "','" + String(key).replace(/'/g, "") + "')\">Edit</button>";
        }

        function renderUserTable() {
            loadAuthUsers();
            var q = ($("userFilter") && $("userFilter").value || "").toLowerCase();
            var html = "<tr><th>User</th><th>Admin</th><th>Plant</th><th>Lines</th><th>Password</th>";
            if (session.admin) html += "<th></th>";
            html += "</tr>";
            var i, u, n = 0;
            for (i = 0; i < authUsers.length; i++) {
                u = authUsers[i];
                if (currentSite === "GARLAND" && String(u.plant || "").toUpperCase() === "VISALIA" && !u.admin) continue;
                if (currentSite === "VISALIA" && String(u.plant || "").toUpperCase() === "GARLAND" && !u.admin) continue;
                if (q && String(u.name).toLowerCase().indexOf(q) < 0) continue;
                html += "<tr><td>" + esc(u.name) + "</td><td>" + (u.admin ? "Yes" : "") + "</td><td>" + esc(u.plant || "VISALIA") + "</td><td>" + esc(u.lines || "*") + "</td><td>" + (u.hash ? "Set" : "Missing") + "</td>";
                if (session.admin) {
                    html += "<td>";
                    html += "<button type='button' class='secondary' onclick=\"toggleAdmin('" + String(u.name).replace(/'/g, "") + "')\">" + (u.admin ? "Remove admin" : "Make admin") + "</button>";
                    html += "<button type='button' class='secondary' onclick=\"resetUserPass('" + String(u.name).replace(/'/g, "") + "')\">Set password</button>";
                    html += "<button type='button' class='secondary' onclick=\"assignUserLines('" + String(u.name).replace(/'/g, "") + "')\">Lines</button>";
                    if (String(u.name).toUpperCase() !== String(session.user).toUpperCase()) {
                        html += "<button type='button' class='danger' onclick=\"deleteUser('" + String(u.name).replace(/'/g, "") + "')\">Delete</button>";
                    }
                    html += "</td>";
                }
                html += "</tr>";
                n += 1;
            }
            if ($("userTable")) $("userTable").innerHTML = html;
            if ($("userCount")) $("userCount").innerText = n + " user" + (n === 1 ? "" : "s");
        }

        function setSpecTab(id) {
            specTab = id;
            var i, tabs = $("specTabs").getElementsByTagName("button");
            for (i = 0; i < tabs.length; i++) tabs[i].className = (tabs[i].getAttribute("data-spec") === id) ? "on" : "";
            renderMspecTable();
        }

        function renderMspecTable() {
            if ($("specTabs")) {
                var btns = $("specTabs").getElementsByTagName("button"), i;
                for (i = 0; i < btns.length; i++) {
                    if (currentSite === "GARLAND") btns[i].style.display = btns[i].getAttribute("data-spec") === "bubble" ? "" : "none";
                    else btns[i].style.display = "";
                }
            }
            if (currentSite === "GARLAND") specTab = "bubble";
            if (specTab === "bubble") return renderBubbleTable();
            if (specTab === "p1") return renderP1Table();
            if (specTab === "rts") return renderRtsTable();
            var q = ($("mspecFilter") && $("mspecFilter").value || "").toLowerCase();
            var html = "<thead><tr>";
            html += "<th class='mspec' rowspan='2'>MSPEC</th><th rowspan='2'>AF#</th>";
            html += "<th class='group' colspan='3'>Gauge</th><th rowspan='2'>Range</th>";
            html += "<th class='group' colspan='2'>Cell</th><th class='group' colspan='3'>Density</th>";
            html += "<th rowspan='2'></th></tr><tr>";
            html += "<th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th>";
            html += "<th class='num'>Min</th><th class='num'>Max</th>";
            html += "<th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th></tr></thead><tbody>";
            var i, r, key, n = 0;
            for (i = 0; i < aio.mspecs.length; i++) {
                r = aio.mspecs[i];
                key = String(r["MSPEC #"] || "");
                if (q && (key.toLowerCase().indexOf(q) < 0 && String(r["AF#"] || "").toLowerCase().indexOf(q) < 0)) continue;
                html += "<tr><td class='mspec'>" + esc(key) + "</td><td>" + esc(r["AF#"]) + "</td>";
                html += "<td class='num'>" + esc(r["Lower Control"]) + "</td><td class='num'>" + esc(r.Target) + "</td><td class='num'>" + esc(r["Upper Control"]) + "</td>";
                html += "<td class='num'>" + esc(r["Thickness Range Max"]) + "</td>";
                html += "<td class='num'>" + esc(r["Cell Count Min"]) + "</td><td class='num'>" + esc(r["Cell Count Max"]) + "</td>";
                html += "<td class='num'>" + esc(r["Density Min"]) + "</td><td class='num'>" + esc(r["Density Target"]) + "</td><td class='num'>" + esc(r["Density Max"]) + "</td>";
                html += "<td>" + editBtn("foam", key) + histBtn("foam", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if ($("mspecTable")) { $("mspecTable").className = "specs"; $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " foam MSPEC" + (n === 1 ? "" : "s");
        }

        function renderBubbleTable() {
            var q = ($("mspecFilter") && $("mspecFilter").value || "").toLowerCase();
            var html = "<thead><tr><th>Line</th><th>Abbr</th><th>Product</th><th>Calc gauge</th>";
            html += "<th class='group' colspan='3'>Weight</th><th></th></tr>";
            html += "<tr><th></th><th></th><th></th><th></th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th></th></tr></thead><tbody>";
            var i, r, key, n = 0, blob;
            for (i = 0; i < aio.bubble.length; i++) {
                r = aio.bubble[i];
                key = QD.bubbleKey(r);
                blob = (r.family + " " + r.abbreviation + " " + r.product).toLowerCase();
                if (q && blob.indexOf(q) < 0) continue;
                html += "<tr><td>" + esc(r.family) + "</td><td>" + esc(r.abbreviation) + "</td><td>" + esc(r.product) + "</td><td class='num'>" + esc(r.calcGauge) + "</td>";
                html += "<td class='num'>" + esc(r.min) + "</td><td class='num'>" + esc(r.target) + "</td><td class='num'>" + esc(r.max) + "</td>";
                html += "<td>" + editBtn("bubble", key) + histBtn("bubble", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if (aio.bubbleDead.length) {
                html += "<thead><tr><th colspan='8'>Max dead cells</th></tr><tr><th colspan='2'>Type</th><th colspan='3'>Abbreviations</th><th class='num'>Max</th><th colspan='2'></th></tr></thead><tbody>";
                for (i = 0; i < aio.bubbleDead.length; i++) {
                    r = aio.bubbleDead[i];
                    html += "<tr><td colspan='2'>" + esc(r.bubbleType) + "</td><td colspan='3'>" + esc(r.abbreviations) + "</td><td class='num'>" + esc(r.maxDead) + "</td><td colspan='2'></td></tr>";
                }
                html += "</tbody>";
            }
            if ($("mspecTable")) { $("mspecTable").className = "specs"; $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " bubble spec" + (n === 1 ? "" : "s");
        }

        function renderP1Table() {
            var q = ($("mspecFilter") && $("mspecFilter").value || "").toLowerCase();
            var html = "<thead><tr><th>Thickness</th><th class='group' colspan='3'>Density</th><th class='group' colspan='2'>Cell</th><th class='group' colspan='3'>Thickness</th><th></th></tr>";
            html += "<tr><th></th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th class='num'>Min</th><th class='num'>Max</th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th></th></tr></thead><tbody>";
            var i, r, key, n = 0;
            for (i = 0; i < aio.p1.length; i++) {
                r = aio.p1[i];
                key = QD.p1Key(r);
                if (q && (String(r.thickness) + " " + String(r.density)).toLowerCase().indexOf(q) < 0) continue;
                html += "<tr><td>" + esc(r.thickness) + "</td><td class='num'>" + esc(r.min) + "</td><td class='num'>" + esc(r.density) + "</td><td class='num'>" + esc(r.max) + "</td>";
                html += "<td class='num'>" + esc(r.ccMin) + "</td><td class='num'>" + esc(r.ccMax) + "</td>";
                html += "<td class='num'>" + esc(r.thickMin) + "</td><td class='num'>" + esc(r.thickTarget) + "</td><td class='num'>" + esc(r.thickMax) + "</td>";
                html += "<td>" + editBtn("p1", key) + histBtn("p1", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if ($("mspecTable")) { $("mspecTable").className = "specs"; $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " P1 spec" + (n === 1 ? "" : "s");
        }

        function renderRtsTable() {
            var q = ($("mspecFilter") && $("mspecFilter").value || "").toLowerCase();
            var html = "<thead><tr><th>Product</th><th class='group' colspan='3'>Thickness</th><th></th></tr>";
            html += "<tr><th></th><th class='num'>Min</th><th class='num'>Target</th><th class='num'>Max</th><th></th></tr></thead><tbody>";
            var i, r, key, n = 0;
            for (i = 0; i < aio.rts.length; i++) {
                r = aio.rts[i];
                key = QD.rtsKey(r);
                if (q && String(r.product).toLowerCase().indexOf(q) < 0) continue;
                html += "<tr><td>" + esc(r.product) + "</td><td class='num'>" + esc(r.min) + "</td><td class='num'>" + esc(r.target) + "</td><td class='num'>" + esc(r.max) + "</td>";
                html += "<td>" + editBtn("rts", key) + histBtn("rts", key) + "</td></tr>";
                n += 1;
            }
            html += "</tbody>";
            if ($("mspecTable")) { $("mspecTable").className = "specs"; $("mspecTable").innerHTML = html; }
            if ($("mspecCount")) $("mspecCount").innerText = n + " RTS spec" + (n === 1 ? "" : "s");
        }

        function renderItemTable() {
            var q = ($("itemFilter") && $("itemFilter").value || "").toLowerCase();
            var html = "<tr><th>Item #</th><th>Type</th><th>Description</th><th>MSPEC</th><th>Width</th><th>Length</th><th>Footage</th><th>Perf</th>";
            if (session.admin) html += "<th></th>";
            html += "</tr>";
            var i, it, n = 0, typ;
            for (i = 0; i < aio.items.length; i++) {
                it = aio.items[i];
                if (it.deleted) continue;
                typ = QD.itemType(it);
                if (currentSite === "GARLAND" && typ !== "BUBBLE") continue;
                if (q && String(it.item).toLowerCase().indexOf(q) < 0 && String(it.description || "").toLowerCase().indexOf(q) < 0 && typ.toLowerCase().indexOf(q) < 0) continue;
                html += "<tr><td>" + esc(it.item) + "</td><td>" + esc(typ) + "</td><td>" + esc(it.description) + "</td><td>" + esc(it.mspec) + "</td><td>" + esc(it.width) + "</td><td>" + esc(it.length) + "</td><td>" + esc(it.footage) + "</td><td>" + esc(it.perf) + "</td>";
                if (session.admin) {
                    html += "<td><button type='button' onclick=\"openItemModal('" + String(it.item).replace(/'/g, "") + "',true)\">Edit</button>";
                    html += "<button type='button' class='danger' onclick=\"deleteItem('" + String(it.item).replace(/'/g, "") + "')\">Delete</button></td>";
                }
                html += "</tr>";
                n += 1;
            }
            if ($("itemTable")) $("itemTable").innerHTML = html;
            if ($("itemCount")) $("itemCount").innerText = n + " item" + (n === 1 ? "" : "s");
        }

        function addUser() {
            if (!requireAdmin()) return;
            var name = QD.trim($("newUser").value);
            var pass = $("newUserPass") ? $("newUserPass").value : "";
            var admin = $("newUserAdmin") && $("newUserAdmin").checked;
            if (!name) { setStatus("Type a user name.", true); return; }
            if (!pass) { setStatus("Every user must have a password.", true); return; }
            loadAuthUsers();
            if (QD.findUserRecord(authUsers, name)) { setStatus("User already exists.", true); return; }
            var plant = $("newUserPlant") ? $("newUserPlant").value : currentSite;
            var lines = $("newUserLines") ? QD.trim($("newUserLines").value) || "*" : "*";
            authUsers.push(QD.makeUserRecord(name, pass, admin, false, plant, lines));
            saveAuthUsers();
            aio.users = QD.mergeUsers(aio.users, [name]);
            aio.localUsers = QD.mergeUsers(aio.localUsers || [], [name]);
            $("newUser").value = "";
            if ($("newUserPass")) $("newUserPass").value = "";
            if ($("newUserAdmin")) $("newUserAdmin").checked = false;
            saveLocalUsers();
            renderUserTable();
            setStatus("Added user " + name + ". They can sign in now.");
        }

        function assignUserLines(name) {
            if (!requireAdmin()) return;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            var plant = prompt("Plant: VISALIA, GARLAND, or BOTH", rec.plant || "VISALIA");
            if (plant == null) return;
            var lines = prompt("Lines this user can see. Use * for all, or S4,S1,S3,COEX,MONO,P1,RTS", rec.lines || "*");
            if (lines == null) return;
            rec.plant = String(plant || "VISALIA").toUpperCase();
            rec.lines = QD.trim(lines) || "*";
            saveAuthUsers();
            renderUserTable();
        }

        function toggleAdmin(name) {
            if (!requireAdmin()) return;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            if (String(rec.name).toUpperCase() === String(session.user).toUpperCase() && rec.admin) {
                alert("You cannot remove your own admin access.");
                return;
            }
            rec.admin = !rec.admin;
            saveAuthUsers();
            renderUserTable();
        }

        function resetUserPass(name) {
            if (!requireAdmin()) return;
            var pass = prompt("New password for " + name + ":");
            if (pass == null) return;
            if (!QD.trim(pass)) { alert("Password is required."); return; }
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, name);
            if (!rec) return;
            var next = QD.makeUserRecord(name, pass, rec.admin, false);
            rec.salt = next.salt;
            rec.hash = next.hash;
            rec.mustChange = false;
            saveAuthUsers();
            renderUserTable();
            setStatus("Password set for " + name);
        }

        function deleteUser(name) {
            if (!requireAdmin()) return;
            if (!confirm("Delete user " + name + "?")) return;
            loadAuthUsers();
            var i, next = [];
            for (i = 0; i < authUsers.length; i++) if (String(authUsers[i].name).toUpperCase() !== String(name).toUpperCase()) next.push(authUsers[i]);
            authUsers = next;
            saveAuthUsers();
            renderUserTable();
        }

        function changeOwnPassword() {
            $("pwOverlay").className = "overlay on";
            $("pwTitle").innerText = "Change password";
            $("pwOld").value = "";
            $("pwNew").value = "";
            $("pwNew2").value = "";
        }

        function saveOwnPassword() {
            var oldp = $("pwOld").value;
            var a = $("pwNew").value;
            var b = $("pwNew2").value;
            loadAuthUsers();
            var rec = QD.findUserRecord(authUsers, session.user);
            if (!rec) return;
            if (rec.hash && !rec.mustChange && !QD.verifyPassword(rec, oldp)) {
                alert("Current password is wrong.");
                return;
            }
            if (!QD.trim(a)) { alert("New password is required."); return; }
            if (a !== b) { alert("New passwords do not match."); return; }
            var next = QD.makeUserRecord(rec.name, a, rec.admin, false);
            rec.salt = next.salt;
            rec.hash = next.hash;
            rec.mustChange = false;
            saveAuthUsers();
            $("pwOverlay").className = "overlay";
            setStatus("Password saved.");
        }

        function findSpecRow(kind, key) {
            var i;
            if (kind === "foam") {
                for (i = 0; i < aio.mspecs.length; i++) if (QD.foamKey(aio.mspecs[i]) === key) return aio.mspecs[i];
            } else if (kind === "bubble") {
                for (i = 0; i < aio.bubble.length; i++) if (QD.bubbleKey(aio.bubble[i]) === key) return aio.bubble[i];
            } else if (kind === "p1") {
                for (i = 0; i < aio.p1.length; i++) if (QD.p1Key(aio.p1[i]) === key) return aio.p1[i];
            } else if (kind === "rts") {
                for (i = 0; i < aio.rts.length; i++) if (QD.rtsKey(aio.rts[i]) === key) return aio.rts[i];
            }
            return null;
        }

        function specFields(kind) {
            if (kind === "foam") return [
                { key: "AF#", label: "AF#" }, { key: "Lower Control", label: "Gauge min" }, { key: "Target", label: "Gauge target" },
                { key: "Upper Control", label: "Gauge max" }, { key: "Thickness Range Max", label: "Range max" },
                { key: "Cell Count Min", label: "Cell min" }, { key: "Cell Count Max", label: "Cell max" },
                { key: "Density Min", label: "Density min" }, { key: "Density Target", label: "Density target" }, { key: "Density Max", label: "Density max" }
            ];
            if (kind === "bubble") return [
                { key: "product", label: "Product" }, { key: "calcGauge", label: "Calc gauge" },
                { key: "min", label: "Min" }, { key: "target", label: "Target" }, { key: "max", label: "Max" }
            ];
            if (kind === "p1") return [
                { key: "density", label: "Density target" }, { key: "min", label: "Density min" }, { key: "max", label: "Density max" },
                { key: "ccMin", label: "Cell min" }, { key: "ccMax", label: "Cell max" },
                { key: "thickMin", label: "Thick min" }, { key: "thickTarget", label: "Thick target" }, { key: "thickMax", label: "Thick max" }
            ];
            return [
                { key: "min", label: "Min" }, { key: "target", label: "Target" }, { key: "max", label: "Max" }
            ];
        }

        var specEdit = { kind: "", key: "", before: null };

        function openSpecEdit(kind, key) {
            if (!requireAdmin()) return;
            var row = findSpecRow(kind, key);
            if (!row) return;
            specEdit.kind = kind;
            specEdit.key = key;
            specEdit.before = JSON.parse(JSON.stringify(row));
            var fields = specFields(kind);
            var html = "<p class='muted'>Editing " + esc(kind) + " " + esc(key) + "</p>", i, f;
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                html += "<label class='f'>" + esc(f.label) + " <input id='se_" + f.key.replace(/\s+/g, "_") + "' value='" + esc(row[f.key]) + "'></label>";
            }
            html += "<label class='f'>Why are you changing this? <textarea id='se_why'></textarea></label>";
            $("specEditFields").innerHTML = html;
            $("specEditOverlay").className = "overlay on";
        }

        function closeSpecEdit() { $("specEditOverlay").className = "overlay"; }

        function saveSpecEdit() {
            if (!requireAdmin()) return;
            var why = QD.trim($("se_why") ? $("se_why").value : "");
            if (!why) { alert("Explain why this spec is changing."); return; }
            var row = findSpecRow(specEdit.kind, specEdit.key);
            if (!row) return;
            var fields = specFields(specEdit.kind);
            var i, f, el, after = {};
            for (i = 0; i < fields.length; i++) {
                f = fields[i];
                el = $("se_" + f.key.replace(/\s+/g, "_"));
                if (el) row[f.key] = el.value;
                after[f.key] = row[f.key];
            }
            addHistory(specEdit.kind, specEdit.key, why, specEdit.before, after);
            if (specHistory.length === 1 || !QD.historyForSpec(specHistory, specEdit.kind, specEdit.key).length) {}
            saveLocalSpecs();
            closeSpecEdit();
            renderMspecTable();
            setStatus("Saved " + specEdit.kind + " spec " + specEdit.key + ".");
        }

        function viewHistory(kind, key) {
            var rows = QD.historyForSpec(specHistory, kind, key);
            var html = "<h3>" + esc(kind) + " " + esc(key) + "</h3>";
            if (!rows.length) html += "<p class='muted'>No edits yet. Created from the imported spec file.</p>";
            var i, r;
            for (i = rows.length - 1; i >= 0; i--) {
                r = rows[i];
                html += "<div class='card'><div><b>" + esc(r.at) + "</b> — " + esc(r.user) + "</div>";
                html += "<div>Why: " + esc(r.why) + "</div></div>";
            }
            $("histBody").innerHTML = html;
            $("histOverlay").className = "overlay on";
        }

        function closeHistory() { $("histOverlay").className = "overlay"; }

        function openItemModal(preset, editing) {
            $("newItem").value = preset || $("item").value || "";
            $("newDesc").value = "";
            setv("newMspecF", ""); setv("newMspecL", "");
            setv("newWidthB", ""); setv("newWidthF", ""); setv("newWidthL", ""); setv("newWidthP", "");
            setv("newLengthL", ""); setv("newLengthP", "");
            setv("newFootageB", ""); setv("newFootageF", "");
            setv("newPerfB", ""); setv("newPerfF", "");
            setv("newSlits", ""); setv("newBubble", ""); setv("newParent", "");
            setv("newThk", ""); setv("newDens", ""); setv("newShots", ""); setv("newSoft", "");
            $("newType").value = editing ? "" : (QD.lineItemType(QD.resolveLineId(currentSite, currentLine)) || "");
            $("itemModalTitle").innerText = editing ? "Edit item #" : "Add item #";
            if (editing && preset) {
                var it = QD.findItem(aio.items, preset);
                if (it) {
                    $("newType").value = QD.itemType(it);
                    $("newDesc").value = it.description || "";
                    setv("newMspecF", it.mspec); setv("newMspecL", it.mspec);
                    setv("newWidthB", it.width); setv("newWidthF", it.width); setv("newWidthL", it.width); setv("newWidthP", it.width);
                    setv("newLengthL", it.length); setv("newLengthP", it.length);
                    setv("newFootageB", it.footage); setv("newFootageF", it.footage);
                    setv("newPerfB", it.perf); setv("newPerfF", it.perf);
                    setv("newSlits", it.slits); setv("newBubble", it.bubbleType); setv("newParent", it.parent);
                    setv("newThk", it.thickness); setv("newDens", it.density); setv("newShots", it.shots); setv("newSoft", it.soft);
                }
            }
            syncItemTypeFields();
            $("itemOverlay").className = "overlay on";
            $("newType").focus();
        }

        function syncItemTypeFields() {
            var t = $("newType").value;
            $("fieldsBubble").className = "type-fields" + (t === "BUBBLE" ? " on" : "");
            $("fieldsFoam").className = "type-fields" + (t === "FOAM" ? " on" : "");
            $("fieldsLam").className = "type-fields" + (t === "LAM" ? " on" : "");
            $("fieldsPlank").className = "type-fields" + (t === "PLANK" ? " on" : "");
            $("itemTypeHint").innerText = t && QD.ITEM_TYPES[t] ? ("Used on " + QD.ITEM_TYPES[t].lines) : "Pick a type first.";
        }

        function setv(id, v) { var el = $(id); if (el) el.value = v == null ? "" : v; }
        function getv(id) { var el = $(id); return el ? el.value : ""; }

        function closeItemModal() { $("itemOverlay").className = "overlay"; }

        function saveNewItem() {
            var item = QD.canonItem($("newItem").value);
            var typ = $("newType").value;
            if (!typ) { alert("Pick a type first."); return; }
            if (!item) { alert("Item # is required."); return; }
            var rec = {
                item: item,
                type: typ,
                description: QD.trim($("newDesc").value),
                mspec: typ === "FOAM" ? QD.canonMspec(getv("newMspecF")) : (typ === "LAM" ? QD.canonMspec(getv("newMspecL")) : ""),
                width: typ === "BUBBLE" ? getv("newWidthB") : typ === "FOAM" ? getv("newWidthF") : typ === "LAM" ? getv("newWidthL") : getv("newWidthP"),
                length: typ === "LAM" ? getv("newLengthL") : typ === "PLANK" ? getv("newLengthP") : "",
                footage: typ === "BUBBLE" ? getv("newFootageB") : typ === "FOAM" ? getv("newFootageF") : "",
                perf: typ === "BUBBLE" ? getv("newPerfB") : typ === "FOAM" ? getv("newPerfF") : "",
                slits: typ === "BUBBLE" ? getv("newSlits") : "",
                bubbleType: typ === "BUBBLE" ? getv("newBubble") : "",
                parent: typ === "LAM" ? getv("newParent") : "",
                thickness: typ === "LAM" ? getv("newThk") : "",
                density: typ === "PLANK" ? getv("newDens") : "",
                shots: typ === "PLANK" ? getv("newShots") : "",
                soft: typ === "PLANK" ? getv("newSoft") : "",
                local: true
            };
            aio.items = QD.mergeItems(aio.items, [rec]);
            saveLocalItems();
            closeItemModal();
            $("item").value = item;
            renderLists();
            onItemChange();
            setStatus("Saved item " + item + " (" + typ + ")");
        }

        function deleteItem(item) {
            if (!requireAdmin()) return;
            if (!confirm("Delete item " + item + "?")) return;
            var i, it;
            for (i = 0; i < aio.items.length; i++) {
                it = aio.items[i];
                if (QD.canonItem(it.item) === QD.canonItem(item)) it.deleted = true;
            }
            aio.items = QD.mergeItems(aio.items, []);
            var extra = localItemsOnly();
            extra.push({ item: item, deleted: true, local: true });
            writeUtf8((new ActiveXObject("Scripting.FileSystemObject")).BuildPath(resultsDir(), "local-items.js"),
                "window.QD_LOCAL=window.QD_LOCAL||{items:[],users:[]};QD_LOCAL.items=" + JSON.stringify(extra) + ";");
            renderLists();
            setStatus("Deleted item " + item);
        }

        function fillReasons() {
            var sel = $("reason");
            if (!sel) return;
            if (sel.tagName !== "SELECT") {
                if (checkReason) sel.value = checkReason;
                return;
            }
            var info = QD.lineInfo(currentLine, currentSite);
            var list = QD.REASONS[(info && info.reasons) || "foam"];
            var i, cur = sel.value;
            sel.options.length = 0;
            for (i = 0; i < list.length; i++) sel.options.add(new Option(list[i], list[i]));
            if (cur) sel.value = cur;
        }

        function setLine(id) {
            currentLine = QD.resolveLineId(currentSite, id);
            var info = QD.lineInfo(currentLine, currentSite);
            var form = info ? info.form : "";
            var i, btns = document.getElementById("lineBtns");
            if (btns) {
                btns = btns.getElementsByTagName("button");
                for (i = 0; i < btns.length; i++) btns[i].className = (btns[i].getAttribute("data-line") === info.label) ? "on" : "";
            }
            if ($("formS4")) $("formS4").className = "form" + (form === "s4" ? " on" : "");
            if ($("formS1")) $("formS1").className = "form" + (form === "s1s3" ? " on" : "");
            if ($("formBubble")) $("formBubble").className = "form" + (form === "bubble" ? " on" : "");
            if ($("formP1")) $("formP1").className = "form" + (form === "p1" ? " on" : "");
            if ($("formRts")) $("formRts").className = "form" + (form === "rts" ? " on" : "");
            if ($("lineLabel")) $("lineLabel").innerText = info ? info.label : id;
            fillReasons();
            if ($("item")) onItemChange();
        }

        function selectedItem() {
            return QD.findItem(aio.items, $("item").value);
        }

        function selectedSpec() {
            var it = selectedItem();
            var mspec = it ? it.mspec : "";
            if ($("mspec").value) mspec = $("mspec").value;
            return QD.findMspec(aio.mspecs, mspec);
        }

        function showHits() {
            var box = $("hits");
            var q = $("item").value;
            var hits = QD.searchItems(aio.items, q, 20, QD.lineItemType(QD.resolveLineId(currentSite, currentLine)));
            var html = "", i, it;
            for (i = 0; i < hits.length; i++) {
                it = hits[i];
                html += "<div onclick=\"pickItem('" + String(it.item).replace(/'/g, "") + "')\">" + it.item + " — " + (it.description || "") + "</div>";
            }
            box.innerHTML = html || "<div class='muted'>No matching items</div>";
            box.style.display = q ? "block" : "none";
        }

        function pickItem(item) {
            $("item").value = item;
            $("hits").style.display = "none";
            onItemChange();
        }

        function specLine(label, value) {
            if (value == null || value === "") return "";
            return "<div><b>" + label + "</b> " + value + "</div>";
        }

        function onItemChange() {
            var it = selectedItem();
            var spec = selectedSpec();
            var info = QD.lineInfo(currentLine, currentSite);
            $("desc").innerText = it ? (it.description || "") : "";
            $("mspec").value = it && it.mspec ? it.mspec : $("mspec").value;
            spec = selectedSpec();
            var html = "";
            if (!it) html = "<div class='muted'>Type an item # from Quality AIO.</div>";
            else {
                html += specLine("Item", it.item);
                html += specLine("Description", it.description);
                html += specLine("MSPEC", it.mspec);
                html += specLine("Width", it.width);
                html += specLine("Length", it.length);
                html += specLine("Footage", it.footage);
                html += specLine("Perf", it.perf);
                html += specLine("Bubble type", it.bubbleType);
                html += specLine("Parent", it.parent);
                html += specLine("# Shots", it.shots);
                html += specLine("Soft", it.soft);
            }
            if (spec) {
                html += "<div style='margin-top:8px'><b>Master Sheet</b></div>";
                html += specLine("Gauge", (spec["Lower Control"] || "") + " / " + (spec.Target || "") + " / " + (spec["Upper Control"] || ""));
                html += specLine("Range max", spec["Thickness Range Max"]);
                html += specLine("Cell count", (spec["Cell Count Min"] || "") + " – " + (spec["Cell Count Max"] || ""));
                html += specLine("Density", (spec["Density Min"] || "") + " / " + (spec["Density Target"] || "") + " / " + (spec["Density Max"] || ""));
            }
            if (info && info.form === "bubble" && it) {
                var bs = QD.findBubbleSpec(aio.bubble, currentLine, it.bubbleType);
                var bw = bs ? { min: bs.min, target: bs.target, max: bs.max } : QD.matchBubbleWeight(currentLine, it.bubbleType);
                var dead = QD.deadCellMaxFromFile(aio.bubbleDead, it.bubbleType);
                if (!isFinite(dead)) dead = QD.deadCellMax(it.bubbleType);
                if (bw) html += specLine("Weight", bw.min + " / " + bw.target + " / " + bw.max);
                if (isFinite(dead)) html += specLine("Max dead cells", dead);
            }
            $("specBox").innerHTML = html;
            compute();
        }

        function val(id) { return $(id) ? $(id).value : ""; }

        function collectPoints(prefix, n) {
            var out = [], i;
            for (i = 1; i <= n; i++) out.push(val(prefix + i));
            return out;
        }

        function mark(id, pf) {
            var el = $(id);
            if (!el) return;
            el.innerText = pf || "";
            el.className = "pf " + (String(pf).toLowerCase() === "fail" ? "fail" : (pf ? "pass" : ""));
        }

        function paintThickness(pts, lo, hi, range, rmax, dens, spec, it, widthPf, pf) {
            var prefix = currentLine === "S4" ? "s4t" : "s1t";
            var ext = QD.pointExtremes(pts);
            var i, el, wrap, band, filled = 0;
            for (i = 0; i < 13; i++) {
                el = $(prefix + (i + 1));
                if (!el) continue;
                wrap = el.parentNode;
                band = QD.pointBand(pts[i], lo, hi);
                if (QD.trim(pts[i]) !== "") filled += 1;
                if (wrap && wrap.className && String(wrap.className).indexOf("chip") >= 0) {
                    wrap.className = "chip" + (band ? " " + band : "") + (filled === 13 && (i === ext.minIndex || i === ext.maxIndex) ? " extreme" : "");
                } else {
                    el.style.background = band === "over" ? "#7f1d1d" : (band === "under" ? "#713f12" : (band === "in" ? "#14532d" : ""));
                    el.style.color = "#fff";
                }
            }
            if ($("thkMinMax")) {
                $("thkMinMax").innerHTML = filled === 13 && ext.minIndex >= 0
                    ? ("MIN <b>" + ext.min.toFixed(3) + " (T" + (ext.minIndex + 1) + ")</b> &nbsp; MAX <b>" + ext.max.toFixed(3) + " (T" + (ext.maxIndex + 1) + ")</b>")
                    : "";
            }
            var html = "<table class='results'><tr><th></th><th>MIN</th><th>TARGET</th><th>MAX</th><th>RESULT</th></tr>";
            function row(label, mn, tg, mx, res, ok) {
                html += "<tr><td>" + label + "</td><td>" + (isFinite(mn) ? mn : "—") + "</td><td>" + (isFinite(tg) ? tg : "—") + "</td><td>" + (isFinite(mx) ? mx : "—") + "</td><td class='" + (ok === false ? "bad" : "ok") + "'>" + (res == null || res === "" ? "—" : res) + "</td></tr>";
            }
            var avg = QD.avg(pts);
            row("Thk avg", lo, spec ? QD.num(spec.Target) : NaN, hi, isFinite(avg) ? avg.toFixed(3) : "", QD.inRange(avg, lo, hi) !== false);
            row("Thk range", NaN, NaN, rmax, isFinite(range) ? range.toFixed(1) : "", !isFinite(range) || !isFinite(rmax) || range <= rmax);
            var dlo = spec ? QD.num(spec["Density Min"]) : NaN, dt = spec ? QD.num(spec["Density Target"]) : NaN, dhi = spec ? QD.num(spec["Density Max"]) : NaN;
            row("Density", dlo, dt, dhi, isFinite(dens) ? dens.toFixed(3) : "", QD.inRange(dens, dlo, dhi) !== false);
            row("Width", it ? QD.num(it.width) - (currentLine === "S4" ? 1.5 : 0.5) : NaN, it ? QD.num(it.width) : NaN, NaN, val(currentLine === "S4" ? "s4width" : "s1width"), widthPf !== false);
            html += "</table>";
            if ($("resultsBox")) $("resultsBox").innerHTML = html;
            var cv = $("radialCanvas");
            if (cv && (currentLine === "S4" || currentLine === "S1" || currentLine === "S3")) {
                cv.style.display = "block";
                try { QD.drawCentration(cv, pts, lo, hi); } catch (e) {}
            } else if (cv) cv.style.display = "none";
        }

        function compute() {
            var info = QD.lineInfo(currentLine, currentSite);
            var spec = selectedSpec();
            var it = selectedItem();
            var flags = [];
            var avg, range, dens, pf;
            if (!info) return {};
            if (info.form === "s4" || info.form === "s1s3") {
                var pts = collectPoints(info.form === "s4" ? "s4t" : "s1t", 13);
                avg = QD.avg(pts);
                range = QD.rangeMil(pts);
                dens = info.form === "s4" ? QD.densityS4(val("s4weight"), avg) : QD.densityS1(val("s1weight"), avg);
                $("avgOut").innerText = isFinite(avg) ? avg.toFixed(4) : "";
                $("rangeOut").innerText = isFinite(range) ? range.toFixed(1) : "";
                $("densOut").innerText = isFinite(dens) ? dens.toFixed(3) : "";
                var lo = spec ? QD.num(spec["Lower Control"]) : NaN;
                var hi = spec ? QD.num(spec["Upper Control"]) : NaN;
                var rmax = spec ? QD.num(spec["Thickness Range Max"]) : NaN;
                var widthTarget = it ? QD.num(it.width) : NaN;
                var widthMin = isFinite(widthTarget) ? widthTarget - (info.form === "s4" ? 1.5 : 0.5) : NaN;
                var widthPf = QD.inRange(val(info.form === "s4" ? "s4width" : "s1width"), widthMin, Infinity);
                flags.push(QD.pf(widthPf));
                mark("widthMark", QD.pf(widthPf));
                var avgPf = QD.inRange(avg, lo, hi);
                flags.push(QD.pf(avgPf));
                mark("avgMark", QD.pf(avgPf));
                var rangePf = !isFinite(range) || !isFinite(rmax) ? null : range <= rmax;
                flags.push(QD.pf(rangePf));
                mark("rangeMark", QD.pf(rangePf));
                if (info.form === "s4") {
                    var lenMin = it ? QD.num(it.length) : NaN;
                    var lenPf = val("s4sheet") === "" ? null : QD.inRange(val("s4sheet"), lenMin, Infinity);
                    flags.push(QD.pf(lenPf));
                    mark("sheetMark", QD.pf(lenPf));
                }
                if (info.form === "s1s3") {
                    var perfT = it ? QD.num(it.perf) : NaN;
                    var pad = isFinite(perfT) && perfT > 20 ? 0.5 : 0.25;
                    var perfPf = val("s1perf") === "" || !isFinite(perfT) || perfT === 0 ? null : QD.inRange(val("s1perf"), perfT - pad, perfT + pad);
                    flags.push(QD.pf(perfPf));
                    mark("perfMark", QD.pf(perfPf));
                    if (val("s1bundleFit") === "FAIL") flags.push("Fail");
                    if (val("s1diamPf") === "Fail") flags.push("Fail");
                }
                pf = QD.overallFromFlags(currentLine, val("reason") || checkReason, flags);
                $("pfOut").innerText = pf;
                $("pfOut").className = "pf " + (String(pf).toLowerCase() === "fail" ? "fail" : "pass");
                paintThickness(pts, lo, hi, range, rmax, dens, spec, it, widthPf, pf);
                try { syncSubmitBtn(); } catch (e0) {}
                return { avg: avg, range: range, density: dens, passFail: pf, points: pts, widthPf: QD.pf(widthPf) };
            }
            if (info.form === "bubble") {
                var bs = it ? QD.findBubbleSpec(aio.bubble, currentLine, it.bubbleType) : null;
                var bw = bs ? { min: QD.num(bs.min), target: QD.num(bs.target), max: QD.num(bs.max) } : (it ? QD.matchBubbleWeight(currentLine, it.bubbleType) : null);
                var deadMax = it ? QD.deadCellMaxFromFile(aio.bubbleDead, it.bubbleType) : NaN;
                if (!isFinite(deadMax) && it) deadMax = QD.deadCellMax(it.bubbleType);
                var wPf = it && it.width ? QD.inRange(val("bwidth"), QD.num(it.width) - 0.25, QD.num(it.width) + 0.25) : null;
                var fPf = it && it.footage ? QD.inRange(val("bfootage"), QD.num(it.footage), Infinity) : null;
                var pTarget = it ? QD.num(it.perf) : NaN;
                var pPf = !isFinite(pTarget) ? "N/A" : QD.pf(QD.inRange(val("bperfw"), pTarget - 0.25, pTarget + 0.25));
                var tester = QD.num(val("btester"));
                var tPf = val("btester") === "" ? "" : QD.pf(!(tester < 11 || tester > 15));
                var wtPf = bw ? QD.pf(QD.inRange(val("bweight"), bw.min, Infinity)) : "";
                var pre = (QD.num(val("bdeadPre")) || 0) + (QD.num(val("bairPre")) || 0);
                var post = (QD.num(val("bdeadPost")) || 0) + (QD.num(val("bairPost")) || 0);
                var prePf = isFinite(deadMax) ? QD.pf(pre <= deadMax) : "";
                var postPf = isFinite(deadMax) ? QD.pf(post <= deadMax) : "";
                flags = [QD.pf(wPf), QD.pf(fPf), pPf, tPf, wtPf, prePf, postPf, val("bprod"), val("bcoh"), val("bpostv"), val("bdiamPf")];
                pf = QD.overallFromFlags(currentLine, val("reason"), flags);
                $("bpfOut").innerText = pf;
                mark("bwidthMark", QD.pf(wPf));
                mark("bfootMark", QD.pf(fPf));
                mark("bperfMark", pPf);
                mark("btestMark", tPf);
                mark("bwtMark", wtPf);
                try { syncSubmitBtn(); } catch (eB) {}
                return { passFail: pf, widthPf: QD.pf(wPf), footagePf: QD.pf(fPf), perfWidthPf: pPf, perfTesterPf: tPf, weightPf: wtPf, prePf: prePf, postPf: postPf, deadMax: deadMax };
            }
            if (info.form === "p1") {
                var head = QD.num(val("phead")), e1 = QD.num(val("pend1")), e2 = QD.num(val("pend2")), tail = QD.num(val("ptail"));
                var avgS = QD.avg([head, e1, e2, tail]);
                var length = QD.num(val("plength")), width = QD.num(val("pwidth")), wt = QD.num(val("pweight"));
                var vol = (isFinite(avgS) && isFinite(length) && isFinite(width)) ? (avgS * width * length) / 6912 : NaN;
                dens = (isFinite(wt) && isFinite(vol) && vol) ? wt / vol : NaN;
                var lenT = it ? QD.num(it.length) : NaN;
                var widT = it ? QD.num(it.width) : NaN;
                var densT = spec ? QD.num(spec["Density Min"] || spec["Density Target"] || it && it.density) : QD.num(it && it.density);
                var lPf = QD.pf(QD.inRange(length, lenT, isFinite(lenT) ? lenT + 5 : NaN));
                var wPf2 = QD.pf(QD.inRange(width, widT, isFinite(widT) ? widT + 5 : NaN));
                var dPf = QD.pf(!isFinite(dens) || !isFinite(densT) ? null : dens >= densT);
                flags = [lPf, wPf2, dPf];
                pf = QD.overallFromFlags(currentLine, val("reason"), flags);
                $("pavgOut").innerText = isFinite(avgS) ? avgS.toFixed(3) : "";
                $("pvolOut").innerText = isFinite(vol) ? vol.toFixed(3) : "";
                $("pdensOut").innerText = isFinite(dens) ? dens.toFixed(3) : "";
                $("ppfOut").innerText = pf;
                return { passFail: pf, avgSingle: avgS, volume: vol, density: dens, lengthPf: lPf, widthPf: wPf2, densityPf: dPf, head: val("phead"), end1: val("pend1"), end2: val("pend2"), tail: val("ptail") };
            }
            if (info.form === "rts") {
                var t1 = QD.num(val("rt1")), t2 = QD.num(val("rt2")), t3 = QD.num(val("rt3"));
                var thkLo = spec ? QD.num(spec["Lower Control"] || spec.Target) : NaN;
                var thkHi = spec ? QD.num(spec["Upper Control"] || spec.Target) : NaN;
                if (!isFinite(thkLo) && it) thkLo = QD.num(it.thickness);
                if (!isFinite(thkHi) && it) thkHi = QD.num(it.thickness);
                var thkPf = QD.pf(QD.inRange(t1, thkLo, thkHi) !== false && QD.inRange(t2, thkLo, thkHi) !== false && QD.inRange(t3, thkLo, thkHi) !== false);
                var widT2 = it ? QD.num(it.width) : NaN;
                var lenT2 = it ? QD.num(it.length) : NaN;
                var wPf3 = QD.pf(QD.inRange(val("rwidth"), widT2, Infinity));
                var lPf2 = QD.pf(QD.inRange(val("rlength"), lenT2, Infinity));
                flags = [thkPf, wPf3, lPf2, val("rdelam"), val("rblister"), val("rallig")];
                pf = QD.overallFromFlags(currentLine, val("reason"), flags);
                $("rpfOut").innerText = pf;
                mark("rthkMark", thkPf);
                return { passFail: pf, t1: val("rt1"), t2: val("rt2"), t3: val("rt3"), thkPf: thkPf, widthPf: wPf3, lengthPf: lPf2 };
            }
            try { syncSubmitBtn(); } catch (e9) {}
            return {};
        }

        function collectCheckInput(calc) {
            var info = QD.lineInfo(currentLine, currentSite);
            var it = selectedItem();
            var spec = selectedSpec();
            var reason = val("reason");
            var input = {
                line: currentLine,
                item: val("item"),
                description: it ? it.description : $("desc").innerText,
                mspec: spec ? spec["MSPEC #"] : val("mspec"),
                user: session.user || val("user"),
                reason: reason,
                notes: val("notes"),
                passFail: calc.passFail
            };
            if (info.form === "s4") {
                input.bundle = val("s4bundle"); input.width = val("s4width"); input.footage = val("s4foot");
                input.weight = val("s4weight");
                input.perfOn = val("s4perfOn"); input.cellMd = val("s4md"); input.cellCd = val("s4cd");
                input.avg = calc.avg; input.range = calc.range; input.density = calc.density;
                input.points = calc.points; input.talc = val("s4talc"); input.sheetLength = val("s4sheet");
            } else if (info.form === "s1s3") {
                input.bundle = val("s1bundle"); input.width = val("s1width"); input.footage = val("s1foot");
                input.weight = val("s1weight");
                input.perf = val("s1perf"); input.bundleFit = val("s1bundleFit"); input.tape = val("s1tape");
                input.cellMd = val("s1md"); input.cellCd = val("s1cd");
                input.avg = calc.avg; input.range = calc.range; input.density = calc.density;
                input.points = calc.points; input.diameter = val("s1diam"); input.diameterPf = val("s1diamPf");
            } else if (info.form === "bubble") {
                input.productVf = val("bprod"); input.cohAdh = val("bcoh"); input.postVisual = val("bpostv");
                input.slits = val("bslits"); input.width = val("bwidth"); input.footage = val("bfootage");
                input.perfWidth = val("bperfw"); input.perfTester = val("btester"); input.weight = val("bweight");
                input.diameter = val("bdiam"); input.diameterPf = val("bdiamPf");
                input.deadPre = val("bdeadPre"); input.airPre = val("bairPre"); input.deadPost = val("bdeadPost"); input.airPost = val("bairPost");
                input.widthPf = calc.widthPf; input.footagePf = calc.footagePf; input.perfWidthPf = calc.perfWidthPf;
                input.perfTesterPf = calc.perfTesterPf; input.weightPf = calc.weightPf; input.prePf = calc.prePf; input.postPf = calc.postPf;
                input.deadMax = calc.deadMax;
            } else if (info.form === "p1") {
                input.length = val("plength"); input.width = val("pwidth"); input.cellMd = val("pmd"); input.cellCd = val("pcd");
                input.weight = val("pweight"); input.volume = calc.volume; input.density = calc.density;
                input.avgSingle = calc.avgSingle; input.head = calc.head; input.end1 = calc.end1; input.end2 = calc.end2; input.tail = calc.tail;
                input.lengthPf = calc.lengthPf; input.widthPf = calc.widthPf; input.densityPf = calc.densityPf;
            } else if (info.form === "rts") {
                input.parent = val("rparent"); input.parentDate = val("rdate"); input.shift = val("rshift");
                input.width = val("rwidth"); input.length = val("rlength"); input.color = val("rcolor");
                input.delam = val("rdelam"); input.blister = val("rblister") || val("rdelam"); input.alligator = val("rallig");
                input.t1 = calc.t1; input.t2 = calc.t2; input.t3 = calc.t3;
                input.thkPf = calc.thkPf; input.widthPf = calc.widthPf; input.lengthPf = calc.lengthPf;
            }
            return input;
        }

        function clearCheckForm() {
            var ids = ["item", "mspec", "notes", "s4bundle", "s4width", "s4foot", "s4md", "s4cd", "s4weight", "s4talc", "s4sheet",
                "s1bundle", "s1width", "s1foot", "s1perf", "s1md", "s1cd", "s1weight", "s1diam",
                "bslits", "bwidth", "bfootage", "bperfw", "btester", "bweight", "bdiam", "bdeadPre", "bairPre", "bdeadPost", "bairPost",
                "plength", "pwidth", "pmd", "pcd", "pweight", "phead", "pend1", "pend2", "ptail",
                "rparent", "rdate", "rwidth", "rlength", "rcolor", "rt1", "rt2", "rt3"];
            var i, el, p;
            for (i = 0; i < ids.length; i++) { el = $(ids[i]); if (el) el.value = ""; }
            for (i = 1; i <= 13; i++) {
                el = $("s4t" + i); if (el) el.value = "";
                el = $("s1t" + i); if (el) el.value = "";
            }
            var sels = ["s4perfOn", "s1bundleFit", "s1tape", "s1diamPf", "bprod", "bcoh", "bpostv", "bdiamPf", "rshift", "rdelam", "rallig"];
            for (i = 0; i < sels.length; i++) { el = $(sels[i]); if (el) el.selectedIndex = 0; }
            $("desc").innerText = "";
            $("specBox").innerHTML = "<div class='muted'>Specs appear after you look up an item.</div>";
            $("hits").style.display = "none";
            fillUsers();
            compute();
        }

        function submitCheck() {
            if (!session.user) { setStatus("Sign in first.", true); return; }
            if (pendingForUser().length) { goDocs(true); return; }
            var info = QD.lineInfo(currentLine, currentSite);
            var it = selectedItem();
            var calc = compute();
            var reason = checkReason || val("reason");
            var input = collectLiveInput();
            input.passFail = calc.passFail || (reason === "NO CHECK" ? (input.noCheckReason || "NO CHECK") : (reason === "LINE UP" ? "LINE UP" : calc.passFail));
            if (reason === "NO CHECK") {
                input.reason = "NO CHECK";
                input.notes = val("noNotes");
            }
            if (reason === "LINE UP") {
                input.reason = "LINE UP";
                input.notes = val("upNotes");
            }
            var missing = QD.missingCheckFields(currentLine, reason, input);
            if (missing.length) {
                hintMissing();
                setStatus("Fill required fields before submit: " + missing.join(", ") + ".", true);
                return;
            }
            if (!QD.skipReason(currentLine, reason) && !it) { setStatus("Look up an item # from Quality AIO.", true); return; }
            if (!QD.skipReason(currentLine, reason) && it && !QD.itemAllowedOnLine(it, currentLine, currentSite)) {
                setStatus("That item is not for this line.", true);
                return;
            }
            if (!aio.loaded && !QD.skipReason(currentLine, reason)) { setStatus("Load Quality AIO.xlsm first.", true); return; }
            var row = QD.buildRow(input);
            if (row && input.noCheckReason) row["No Check Reason"] = input.noCheckReason;
            if (row) row.__site = currentSite;
            var rows = QD.appendLineRows(readLineRows(info.file), row);
            writeLineRows(info.file, rows);
            writeLookupFile();
            clearCheckForm();
            checkReason = "";
            noCheckReason = "";
            setStatus("Saved " + QD.lineLabel(currentLine, currentSite) + " check.");
            goHome();
        }

        function toFileUrl(winPath) {
            var parts = String(winPath).replace(/\\/g, "/").split("/");
            var out = [], i;
            for (i = 0; i < parts.length; i++) {
                if (i === 0 && /^[A-Za-z]:$/.test(parts[i])) out.push(parts[i]);
                else out.push(encodeURIComponent(parts[i]));
            }
            return "file:///" + out.join("/");
        }

        function findEdge() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var cands = [
                "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
                "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"
            ];
            var i;
            for (i = 0; i < cands.length; i++) if (fso.FileExists(cands[i])) return cands[i];
            return "msedge";
        }

        function edgeProfileDir() {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var dir = fso.BuildPath(getAppFolder(), "edge-profile");
            if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
            return dir;
        }

        function deskIsOpen(htmlPath) {
            try {
                var loc = GetObject("winmgmts:\\\\.\\root\\cimv2");
                var q = loc.ExecQuery("SELECT CommandLine FROM Win32_Process WHERE Name='msedge.exe'");
                var en = new Enumerator(q);
                var folder = getAppFolder().toLowerCase();
                var html = String(htmlPath || "").toLowerCase();
                var htmlUrl = html.replace(/\\/g, "/");
                var folderUrl = folder.replace(/\\/g, "/");
                var profile = edgeProfileDir().toLowerCase();
                var profileUrl = profile.replace(/\\/g, "/");
                for (; !en.atEnd(); en.moveNext()) {
                    var cmd = String(en.item().CommandLine || "").toLowerCase();
                    if (!cmd) continue;
                    if (cmd.indexOf(profile) >= 0 || cmd.indexOf(profileUrl) >= 0) return true;
                    if (html && (cmd.indexOf(html) >= 0 || cmd.indexOf(htmlUrl) >= 0)) return true;
                    if ((cmd.indexOf(folder) >= 0 || cmd.indexOf(folderUrl) >= 0) && (cmd.indexOf(".html") >= 0 || cmd.indexOf("--app") >= 0)) return true;
                }
            } catch (e) {}
            return false;
        }

        function openDesk(quietIfOpen) {
            var htmlPath = findHtml();
            if (!htmlPath) { setStatus("index.html or centration.html not found next to this HTA.", true); return; }
            if (deskIsOpen(htmlPath)) {
                if (!quietIfOpen) setStatus("Quality Desk is already open. Use Reload from disk on that window.");
                try { (new ActiveXObject("WScript.Shell")).AppActivate("Quality Desk"); } catch (e) {}
                return;
            }
            var url = toFileUrl(htmlPath);
            var edge = findEdge();
            var profile = edgeProfileDir();
            var shell = new ActiveXObject("WScript.Shell");
            try { shell.Run('"' + edge + '" --user-data-dir="' + profile + '" --app="' + url + '"', 1, false); }
            catch (e1) {
                try { shell.Run('cmd /c start "" "' + htmlPath + '"', 0, false); }
                catch (e2) { setStatus("Could not open Quality Desk.\n" + htmlPath, true); }
            }
        }

        window.onload = function () {
            try { window.resizeTo(Math.min(1280, screen.availWidth), Math.min(860, screen.availHeight)); } catch (e) {}
            try { loadAuthUsers(); } catch (e1) {}
            try { loadSpecHistory(); } catch (e2) {}
            setLine("S4");
            hideApp("");
            $("loginStatus").innerText = "Sign in to use Quality Desk Checks. Session ends after 1 hour idle.";
            if ($("loginUser")) $("loginUser").focus();
        };
    </script>
</head>
<body>
    <div id="loginOverlay" class="overlay login on">
        <div class="modal">
            <h3>Sign in</h3>
            <p class="muted" id="loginStatus">Sign in to use Quality Desk Checks.</p>
            <label class="f">User <input id="loginUser"></label>
            <label class="f">Password <input id="loginPass" type="password" onkeydown="if(event.keyCode==13)doLogin()"></label>
            <button type="button" class="ok" onclick="doLogin()">Sign in</button>
            <p class="muted">First run creates admin GWEXLER. Sessions end after 1 hour idle. Passwords are stored hashed and hidden on this PC.</p>
        </div>
    </div>
    <div id="appRoot" style="display:none">
    <header class="app">
        <div>
            <h1>Quality Desk Checks</h1>
            <p class="tag">Home → line → check. Review History in Quality Desk.</p>
        </div>
        <div class="tools">
            <span class="session">Signed in as <span class="who" id="sessionWho"></span></span>
            <button class="secondary" onclick="changeOwnPassword()">Password</button>
            <button class="secondary" onclick="logout('Signed out.')">Log out</button>
            <button class="secondary" onclick="loadAio(true)">Reload AIO</button>
            <button class="secondary" onclick="openDesk(false)">History</button>
        </div>
    </header>
    <div class="wrap">
        <div id="crumbs" class="crumbs">Visalia / Home</div>
        <div id="status" class="status">Starting…</div>
        <div class="tabs" id="mainTabs">
            <button data-tab="checks" class="on" onclick="goHome()">Home</button>
            <button data-tab="users" onclick="showTab('users')">Users</button>
            <button data-tab="mspecs" onclick="showTab('mspecs')">MSPECs</button>
            <button data-tab="items" onclick="showTab('items')">Item database</button>
            <span class="plant-toggle">
                <button id="plantVis" class="on" onclick="setSite('VISALIA')">Visalia</button>
                <button id="plantGar" onclick="setSite('GARLAND')">Garland</button>
            </span>
            <button data-tab="docs" onclick="showTab('docs')">Documentation</button>
        </div>
        <div id="tabChecks" class="tabpanel on">
        <div id="screenHome" class="screen on">
            <div class="home-grid" id="homeLines"></div>
        </div>
        <div id="screenDocs" class="screen">
            <div id="docAckBox"></div>
        </div>
        <div id="screenReason" class="screen">
            <h2>Type of check</h2>
            <div class="reason-btns">
                <button type="button" onclick="pickReason('HOURLY')">HOURLY</button>
                <button type="button" onclick="pickReason('RETEST')">RETEST</button>
                <button type="button" onclick="pickReason('NO CHECK')">NO CHECK</button>
            </div>
        </div>
        <div id="screenNoCheck" class="screen">
            <div class="card">
                <h2>No check</h2>
                <label class="f">Additional reason
                    <select id="noCheckReason" onchange="noCheckReason=this.value;syncSubmitBtn();">
                        <option value=""></option>
                        <option>EQUIPMENT FAILURE</option>
                        <option>NO ORDERS</option>
                        <option>LINE DOWN</option>
                        <option>PREVENTATIVE MAINTENANCE</option>
                    </select>
                </label>
                <label class="f">Notes <textarea id="noNotes" onkeyup="syncSubmitBtn()"></textarea></label>
            </div>
        </div>
        <div id="screenLineUp" class="screen">
            <div class="card">
                <h2>LINE UP</h2>
                <p class="muted">The last entry was a no-check. Enter what happened, then hourly checks resume.</p>
                <label class="f">Notes <textarea id="upNotes" onkeyup="syncSubmitBtn()"></textarea></label>
            </div>
        </div>
        <div id="screenItem" class="screen">
            <div class="card">
                <h2>Item #</h2>
                <label class="f">Item #
                    <input id="item" onkeyup="showHits();syncSubmitBtn();" onchange="onItemChange()">
                </label>
                <div class="hits" id="hits"></div>
                <button type="button" class="ok" onclick="confirmItem()">Continue</button>
                <button type="button" class="secondary" onclick="openItemModal()">Add new #</button>
            </div>
        </div>
        <div id="screenStartup" class="screen">
            <div class="card" id="startupBox"></div>
        </div>
        <div id="screenCheck" class="screen">
        <input type="hidden" id="user">
        <input type="hidden" id="reason">
        <input type="hidden" id="notes">
        <div class="lines" id="lineBtns" style="display:none">
            <button data-line="S4" class="on" onclick="setLine('S4')">S4</button>
            <button data-line="S1" onclick="setLine('S1')">S1</button>
            <button data-line="S3" onclick="setLine('S3')">S3</button>
            <button data-line="COEX" onclick="setLine('COEX')">COEX</button>
            <button data-line="MONO" onclick="setLine('MONO')">MONO</button>
            <button data-line="P1" onclick="setLine('P1')">P1</button>
            <button data-line="RTS" onclick="setLine('RTS')">RTS</button>
        </div>
        <div class="grid">
            <div class="col">
                <div class="card">
                    <h2>Item / specs <span class="muted" id="lineLabel">S4</span></h2>
                    <p id="desc" class="muted"></p>
                    <div id="mspecWrap"><label class="f">MSPEC <input id="mspec" onchange="onItemChange()"></label></div>
                    <div class="card spec" id="specBox"><div class="muted">Specs appear after you look up an item.</div></div>
                    <div id="resultsBox"></div>
                    <canvas id="radialCanvas" class="radial" width="320" height="320"></canvas>
                    <p id="thkMinMax" class="muted"></p>
                    <label class="f">Notes <textarea id="checkNotes" onkeyup="$('notes').value=this.value;syncSubmitBtn();"></textarea></label>
                </div>
            </div>
            <div class="col">
                <div id="formS4" class="form on">
                    <div class="card">
                        <h2>S4 entries</h2>
                        <div class="pair">
                            <div><label class="f">Bundle # <input id="s4bundle"></label></div>
                            <div><label class="f">Slit/Width <input id="s4width" onkeyup="compute()"> <span id="widthMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Footage <input id="s4foot"></label></div>
                            <div><label class="f">Perf Roller On <select id="s4perfOn"><option></option><option>Yes</option><option>No</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <input id="s4md"></label></div>
                            <div><label class="f">Cell Count CD <input id="s4cd"></label></div>
                        </div>
                        <label class="f">Weight (g) <input id="s4weight" onkeyup="compute()"></label>
                        <label class="f">Thickness T1–T13</label>
                        <div class="chips" id="s4chips">
                            <label class="chip"><span>T1</span><input id="s4t1" onkeyup="compute()"></label>
                            <label class="chip"><span>T2</span><input id="s4t2" onkeyup="compute()"></label>
                            <label class="chip"><span>T3</span><input id="s4t3" onkeyup="compute()"></label>
                            <label class="chip"><span>T4</span><input id="s4t4" onkeyup="compute()"></label>
                            <label class="chip"><span>T5</span><input id="s4t5" onkeyup="compute()"></label>
                            <label class="chip"><span>T6</span><input id="s4t6" onkeyup="compute()"></label>
                            <label class="chip"><span>T7</span><input id="s4t7" onkeyup="compute()"></label>
                            <label class="chip"><span>T8</span><input id="s4t8" onkeyup="compute()"></label>
                            <label class="chip"><span>T9</span><input id="s4t9" onkeyup="compute()"></label>
                            <label class="chip"><span>T10</span><input id="s4t10" onkeyup="compute()"></label>
                            <label class="chip"><span>T11</span><input id="s4t11" onkeyup="compute()"></label>
                            <label class="chip"><span>T12</span><input id="s4t12" onkeyup="compute()"></label>
                            <label class="chip"><span>T13</span><input id="s4t13" onkeyup="compute()"></label>
                        </div>
                        <div>Average <b id="avgOut"></b> <span id="avgMark"></span> &nbsp; Range <b id="rangeOut"></b> <span id="rangeMark"></span> &nbsp; Density <b id="densOut"></b></div>
                        <div class="pair">
                            <div><label class="f">Talc Reading <input id="s4talc"></label></div>
                            <div><label class="f">Sheet Length <input id="s4sheet" onkeyup="compute()"> <span id="sheetMark"></span></label></div>
                        </div>
                        <p>Pass/Fail <span id="pfOut" class="pf"></span></p>
                    </div>
                </div>
                <div id="formS1" class="form">
                    <div class="card">
                        <h2>S1 / S3 entries</h2>
                        <div class="pair">
                            <div><label class="f">Bundle # <input id="s1bundle"></label></div>
                            <div><label class="f">Width <input id="s1width" onkeyup="compute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Footage <input id="s1foot"></label></div>
                            <div><label class="f">Perf <input id="s1perf" onkeyup="compute()"> <span id="perfMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Bundle Tight/Loose <select id="s1bundleFit" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                            <div><label class="f">Tape Color <select id="s1tape"><option></option><option>RED</option><option>YELLOW</option><option>GREEN</option><option>BLUE</option><option>BROWN</option><option>TAN</option><option>CLEAR</option><option>ULINE</option><option>BLACK</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <input id="s1md"></label></div>
                            <div><label class="f">Cell Count CD <input id="s1cd"></label></div>
                        </div>
                        <label class="f">Weight <input id="s1weight" onkeyup="compute()"></label>
                        <label class="f">Thickness T1–T13</label>
                        <div class="chips">
                            <label class="chip"><span>T1</span><input id="s1t1" onkeyup="compute()"></label>
                            <label class="chip"><span>T2</span><input id="s1t2" onkeyup="compute()"></label>
                            <label class="chip"><span>T3</span><input id="s1t3" onkeyup="compute()"></label>
                            <label class="chip"><span>T4</span><input id="s1t4" onkeyup="compute()"></label>
                            <label class="chip"><span>T5</span><input id="s1t5" onkeyup="compute()"></label>
                            <label class="chip"><span>T6</span><input id="s1t6" onkeyup="compute()"></label>
                            <label class="chip"><span>T7</span><input id="s1t7" onkeyup="compute()"></label>
                            <label class="chip"><span>T8</span><input id="s1t8" onkeyup="compute()"></label>
                            <label class="chip"><span>T9</span><input id="s1t9" onkeyup="compute()"></label>
                            <label class="chip"><span>T10</span><input id="s1t10" onkeyup="compute()"></label>
                            <label class="chip"><span>T11</span><input id="s1t11" onkeyup="compute()"></label>
                            <label class="chip"><span>T12</span><input id="s1t12" onkeyup="compute()"></label>
                            <label class="chip"><span>T13</span><input id="s1t13" onkeyup="compute()"></label>
                        </div>
                        <div class="pair">
                            <div><label class="f">Diameter (ULINE only) <input id="s1diam"></label></div>
                            <div><label class="f">Diameter Pass/Fail <select id="s1diamPf" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                    </div>
                </div>
                <div id="formBubble" class="form">
                    <div class="card">
                        <h2>Bubble entries</h2>
                        <div class="pair">
                            <div><label class="f">Product Verification <select id="bprod" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                            <div><label class="f">COH/ADH Verification <select id="bcoh" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                        </div>
                        <label class="f">Post-Visual Inspection <select id="bpostv" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label>
                        <div class="pair">
                            <div><label class="f"># Slits <input id="bslits"></label></div>
                            <div><label class="f">Width <input id="bwidth" onkeyup="compute()"> <span id="bwidthMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Footage <input id="bfootage" onkeyup="compute()"> <span id="bfootMark"></span></label></div>
                            <div><label class="f">Perf Width <input id="bperfw" onkeyup="compute()"> <span id="bperfMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Perf Tester Results <input id="btester" onkeyup="compute()"> <span id="btestMark"></span></label></div>
                            <div><label class="f">Gram Weight <input id="bweight" onkeyup="compute()"> <span id="bwtMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Dead Cells / Air Transfers Pre <input id="bdeadPre" onkeyup="compute()"></label></div>
                            <div><label class="f"># Air Transfers Pre <input id="bairPre" onkeyup="compute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Dead Cells / Air Transfers Post <input id="bdeadPost" onkeyup="compute()"></label></div>
                            <div><label class="f"># Air Transfers Post <input id="bairPost" onkeyup="compute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Diameter (ULINE only) <input id="bdiam"></label></div>
                            <div><label class="f">Diameter P/F <select id="bdiamPf" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                        </div>
                        <p>Pass/Fail <span id="bpfOut" class="pf"></span></p>
                    </div>
                </div>
                <div id="formP1" class="form">
                    <div class="card">
                        <h2>P1 entries</h2>
                        <div class="pair">
                            <div><label class="f">Length <input id="plength" onkeyup="compute()"></label></div>
                            <div><label class="f">Width <input id="pwidth" onkeyup="compute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <input id="pmd"></label></div>
                            <div><label class="f">Cell Count CD <input id="pcd"></label></div>
                        </div>
                        <label class="f">Plank Weight <input id="pweight" onkeyup="compute()"></label>
                        <div class="pair">
                            <div><label class="f">Head <input id="phead" onkeyup="compute()"></label></div>
                            <div><label class="f">End 1 <input id="pend1" onkeyup="compute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">End 2 <input id="pend2" onkeyup="compute()"></label></div>
                            <div><label class="f">Tail <input id="ptail" onkeyup="compute()"></label></div>
                        </div>
                        <div>Average <b id="pavgOut"></b> &nbsp; Volume <b id="pvolOut"></b> &nbsp; Density <b id="pdensOut"></b></div>
                        <p>Pass/Fail <span id="ppfOut" class="pf"></span></p>
                    </div>
                </div>
                <div id="formRts" class="form">
                    <div class="card">
                        <h2>RTS entries</h2>
                        <div class="pair">
                            <div><label class="f">Parent Material <input id="rparent"></label></div>
                            <div><label class="f">Parent MFG Date <input id="rdate"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Parent Shift <select id="rshift"><option></option><option>A</option><option>B</option><option>C</option><option>D</option></select></label></div>
                            <div><label class="f">Color <select id="rcolor" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Width <input id="rwidth" onkeyup="compute()"></label></div>
                            <div><label class="f">Length <input id="rlength" onkeyup="compute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Blister / Delam <select id="rdelam" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                            <div><label class="f">Alligator Skin <select id="rallig" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                        <input type="hidden" id="rblister" value="">
                        <label class="f">Thickness points</label>
                        <div class="pts">
                            <input id="rt1" onkeyup="compute()"><input id="rt2" onkeyup="compute()"><input id="rt3" onkeyup="compute()">
                            <span id="rthkMark"></span>
                        </div>
                        <p>Pass/Fail <span id="rpfOut" class="pf"></span></p>
                    </div>
                </div>
            </div>
        </div>
        </div>
        </div>
        <div id="tabUsers" class="tabpanel">
            <div class="card">
                <h2>Users <span class="muted" id="userCount"></span></h2>
                <div class="pair">
                    <div><label class="f">Filter <input id="userFilter" onkeyup="renderUserTable()"></label></div>
                    <div class="admin-only">
                        <label class="f">New user <input id="newUser"></label>
                        <label class="f">Password <input id="newUserPass" type="password"></label>
                        <label class="f"><input id="newUserAdmin" type="checkbox"> Admin</label>
                        <label class="f">Plant
                            <select id="newUserPlant">
                                <option value="VISALIA">VISALIA</option>
                                <option value="GARLAND">GARLAND</option>
                                <option value="BOTH">BOTH</option>
                            </select>
                        </label>
                        <label class="f">Lines (* or S4,S1,COEX…) <input id="newUserLines" value="*"></label>
                        <button type="button" onclick="addUser()">Add user</button>
                    </div>
                </div>
                <div class="list-wrap"><table class="list" id="userTable"></table></div>
            </div>
        </div>
        <div id="tabMspecs" class="tabpanel">
            <div class="card">
                <h2>MSPECs <span class="muted" id="mspecCount"></span></h2>
                <div class="subtabs" id="specTabs">
                    <button data-spec="foam" class="on" onclick="setSpecTab('foam')">Foam</button>
                    <button data-spec="bubble" onclick="setSpecTab('bubble')">Bubble</button>
                    <button data-spec="p1" onclick="setSpecTab('p1')">P1</button>
                    <button data-spec="rts" onclick="setSpecTab('rts')">RTS</button>
                </div>
                <label class="f">Filter <input id="mspecFilter" onkeyup="renderMspecTable()"></label>
                <div class="list-wrap"><table class="specs" id="mspecTable"></table></div>
            </div>
        </div>
        <div id="tabItems" class="tabpanel">
            <div class="card">
                <h2>Item database <span class="muted" id="itemCount"></span></h2>
                <div class="pair">
                    <div><label class="f">Filter <input id="itemFilter" onkeyup="renderItemTable()"></label></div>
                    <div><button type="button" onclick="openItemModal()">Add item #</button></div>
                </div>
                <div class="list-wrap"><table class="list" id="itemTable"></table></div>
            </div>
        </div>
        <div id="tabDocs" class="tabpanel">
            <div class="card">
                <h2>Documentation <span class="muted" id="docCount"></span></h2>
                <p class="muted">Work Instructions and QANs. Assigned users must read a document when it is new, when the version changes, and again every 3 months.</p>
                <div class="admin-only">
                    <div class="pair">
                        <div><label class="f">Name <input id="docName"></label></div>
                        <div><label class="f">Line
                            <select id="docLine">
                                <option value="*">All lines</option>
                                <option>S4</option><option>S1</option><option>S3</option>
                                <option>COEX</option><option>MONO</option>
                                <option>P1</option><option>RTS</option>
                            </select>
                        </label></div>
                    </div>
                    <div class="pair">
                        <div><label class="f">Type
                            <select id="docType">
                                <option>Work Instruction</option>
                                <option>QAN</option>
                            </select>
                        </label></div>
                        <div><label class="f">Version <input id="docVer" value="1"></label></div>
                    </div>
                    <label class="f">Link <input id="docUrl"></label>
                    <button type="button" onclick="addDoc()">Add document</button>
                </div>
                <div class="list-wrap"><table class="list" id="docTable"></table></div>
            </div>
        </div>
    </div>
    <div class="submit-bar" id="submitBar" onmouseover="hintMissing()" onmouseout="clearHint()">
        <button type="button" id="submitBtn" class="ghost" onclick="if(this.getAttribute('data-ready')==='1')submitCheck(); else hintMissing();">Submit check</button>
    </div>
    </div>
    <div class="overlay" id="itemOverlay">
        <div class="modal">
            <h3 id="itemModalTitle">Add item #</h3>
            <label class="f">Type
                <select id="newType" onchange="syncItemTypeFields()">
                    <option value="">Select type…</option>
                    <option value="BUBBLE">BUBBLE — COEX / MONO</option>
                    <option value="FOAM">FOAM — S1 / S3 / S4</option>
                    <option value="LAM">LAM — RTS</option>
                    <option value="PLANK">PLANK — P1</option>
                </select>
            </label>
            <p class="muted" id="itemTypeHint">Pick a type first.</p>
            <label class="f">Item # <input id="newItem"></label>
            <label class="f">Description <input id="newDesc"></label>
            <div id="fieldsBubble" class="type-fields">
                <label class="f">Width <input id="newWidthB"></label>
                <label class="f"># Slits <input id="newSlits"></label>
                <label class="f">Footage <input id="newFootageB"></label>
                <label class="f">Perf <input id="newPerfB"></label>
                <label class="f">Bubble Type <input id="newBubble"></label>
            </div>
            <div id="fieldsFoam" class="type-fields">
                <label class="f">Width <input id="newWidthF"></label>
                <label class="f">Footage <input id="newFootageF"></label>
                <label class="f">Perf <input id="newPerfF"></label>
                <label class="f">MSPEC <input id="newMspecF"></label>
            </div>
            <div id="fieldsLam" class="type-fields">
                <label class="f">Length <input id="newLengthL"></label>
                <label class="f">Width <input id="newWidthL"></label>
                <label class="f">Parent Material <input id="newParent"></label>
                <label class="f">MSPEC <input id="newMspecL"></label>
                <label class="f">Thickness <input id="newThk"></label>
            </div>
            <div id="fieldsPlank" class="type-fields">
                <label class="f">Length <input id="newLengthP"></label>
                <label class="f">Width <input id="newWidthP"></label>
                <label class="f">Density <input id="newDens"></label>
                <label class="f"># Shots <input id="newShots"></label>
                <label class="f">Soft <input id="newSoft"></label>
            </div>
            <button type="button" class="ok" onclick="saveNewItem()">Save item</button>
            <button type="button" class="secondary" onclick="closeItemModal()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="specEditOverlay">
        <div class="modal">
            <h3>Edit spec</h3>
            <div id="specEditFields"></div>
            <button type="button" class="ok" onclick="saveSpecEdit()">Save change</button>
            <button type="button" class="secondary" onclick="closeSpecEdit()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="histOverlay">
        <div class="modal wide">
            <div id="histBody"></div>
            <button type="button" class="secondary" onclick="closeHistory()">Close</button>
        </div>
    </div>
    <div class="overlay" id="pwOverlay">
        <div class="modal">
            <h3 id="pwTitle">Change password</h3>
            <label class="f">Current password <input id="pwOld" type="password"></label>
            <label class="f">New password <input id="pwNew" type="password"></label>
            <label class="f">Confirm new password <input id="pwNew2" type="password"></label>
            <button type="button" class="ok" onclick="saveOwnPassword()">Save password</button>
            <button type="button" class="secondary" onclick="$('pwOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
</body>
</html>
