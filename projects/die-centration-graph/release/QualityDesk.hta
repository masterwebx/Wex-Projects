EVKLbxik+MJ#c0K^Ek`bi@#@&~~,PP,~P,PP,[8ovJ_K)P-E,_~pG .AIj(}1PQ~rP.+m[HJbp@#@&PP,P,~P,8I@#@&P~~,PP,~hbxNKA W	+MDGD~x,0;x1OkKx~cs/oS~!Ds~,sbxnBP1WVBP.D*P`@#@&P~~,PP,~P,PP7C.P9+DlrV~x,J3I"6I,J~Q,:/L~3PEP@$E,_~^k	+P3Pv^W^PZ',x;s^Pg,E)rP_,^GV,),JE#I@#@&P~P,~P,P~~,PkW~vE.V*~9+Omk^P_{Prwx`IJ),J~Q,ED^I@#@&PP,~~P,P,P~PrW,`nDM~[LPn.MR/OC13bP9nDlr^P3'Pr-	EP3PnDMRdOmm3p@#@&,PP,~~P,P,P~N8LvNnYmrV*i@#@&,PP~~,P~P,~,Y.HPP@#@&,P,~P,P~P,P~~,PP7CD,Y+XO~',N4;oJr	+dRNGk	`EwM-xEbp@#@&P,~,P~,P,PP,P,~Pb0~`SkU[KhR1ska4Wm.[fmYmP'[~Abx[WS m^k28KlD[9mYCRknDfCDl*P	@#@&,~P,P~P,P~~,PP,~P,PPSrUNKhcmsk28Kl.NGCYmRdnDflOCvJP+XOr~~D+XY#p@#@&~P,P~P,P~~,PP,~P)P+^dnPb0,`y`E[4;o~G6r#b~P@#@&~~,P~P,~,P~,P,PP,P,~^vJ[+(EL$K6J* \mVE~xPD+XYI@#@&~,P~P,~P,P~~,PP~~,P~^vE9+8!o~W6r#cd+^+^Yv#I@#@&PP,~P,PP,~~P,P,P~P~~9W^EsnxDRnamZGhslUNvE1W2HJ*i@#@&P,~P,P~P,P~~,PP,N@#@&PP,~~P,P,P~PN~1lOm4~`ZG2H#P`N@#@&~P,~,P~,P,PPDDH~	,ls+MYcEzP/1.kaYP..WMPKm^E..N P:4+,Nn8!oPsGTPAlk~1W2b+9PYKPD4+,mska4GCMNR'U-	JP3~h/TP3PE-UJbxnPr~_,VrUP_~E'xwx5;mVrDX,f+k3,Ak^V~xKh~^^W/ J*iP)~^lDm4Pc+)b,	N@#@&~P,P~~,PP~~,Y.X,`,hr	NKhR1VKd+v#IP)P^CDmt,c+;#PPN@#@&,P,P~P~~,P~PMnY!DU~DDEnI@#@&~P,~,P~,8p@#@&,P,~@#@&vfXlAA==^#~@</script>
</head>
<body>
    <div id="loginOverlay" class="overlay login on">
        <div class="modal">
            <h3>Sign in</h3>
            <p class="muted" id="loginStatus">Sign in to use Quality Desk Checks.</p>
            <label class="f">User <input id="loginUser"></label>
            <label class="f">Password <input id="loginPass" type="password" onkeydown="if(event.keyCode==13)doLogin()"></label>
            <button type="button" class="ok" onclick="doLogin()">Sign in</button>
            <div class="login-extra">
                <button type="button" class="secondary" onclick="openNewUserForm()">New User</button>
                <button type="button" class="secondary" onclick="openForgotForm()">Forgot Password</button>
            </div>
            <p class="muted">First run creates admin GWEXLER. Sessions end after 1 hour idle. Passwords are stored hashed and hidden on this PC. New users wait for admin approval. Forgot Password notifies admins, who issue a temporary password.</p>
        </div>
    </div>
    <div id="appRoot" style="display:none">
    <header class="app">
        <div class="brand">
            <h1>Quality Desk Checks <span class="ver">v1.7.53</span></h1>
        </div>
        <div class="tools">
            <span class="session">Signed in as <span class="who" id="sessionWho"></span></span>
            <label class="theme-toggle" title="Dark / light">
                Dark
                <input id="themeToggle" type="checkbox" onchange="setTheme(this.checked?'light':'dark')">
                <span class="track"><span></span></span>
                Light
            </label>
            <button class="secondary inbox-btn" id="btnInbox" onclick="openInbox()">Inbox <span class="badge" id="inboxBadge"></span></button>
            <button class="secondary real-admin" id="btnViewOp" onclick="toggleOperatorView()">View as operator</button>
            <button class="secondary real-admin" id="btnDebug" onclick="openDebug()">Debug log</button>
            <button class="secondary" onclick="changeOwnPassword()">Password</button>
            <button class="secondary" onclick="logout('Signed out.')">Log out</button>
            <button class="secondary" onclick="openDesk(false)">History</button>
        </div>
    </header>
    <div class="wrap">
        <div id="crumbs" class="crumbs">Visalia / Home</div>
        <div id="opBanner" class="op-banner">Viewing as operator — admin tools are hidden.</div>
        <div id="status" class="status">Starting…</div>
        <div class="tabs" id="mainTabs">
            <button data-tab="checks" id="homeTabBtn" class="on" onclick="goHome()">Home</button>
            <button data-tab="lookup" id="lookupTabBtn" onclick="showTab('lookup')">Item lookup</button>
            <button data-tab="users" id="usersTabBtn" class="admin-only" onclick="showTab('users')">Users</button>
            <button data-tab="mspecs" id="mspecsTabBtn" onclick="showTab('mspecs')">MSPECs</button>
            <button data-tab="items" id="itemsTabBtn" onclick="showTab('items')">Item database</button>
            <button data-tab="audit" id="auditTabBtn" class="admin-only" onclick="showTab('audit')">Audit log</button>
            <span class="plant-toggle" id="plantToggle">
                <button type="button" class="secondary" id="plantSwitchBtn" onclick="goPlantPick()">Switch plant</button>
            </span>
            <button data-tab="docs" id="docsTabBtn" onclick="goDocs()">Documentation</button>
        </div>
        <div id="tabChecks" class="tabpanel on">
        <div id="screenHome" class="screen on">
            <div class="home-grid" id="homeLines"></div>
        </div>
        <div id="screenDocs" class="screen"></div>
        <div id="screenPlant" class="screen">
            <h2>Choose plant</h2>
            <div class="plant-pick">
                <button type="button" onclick="pickPlant('VISALIA')">Visalia</button>
                <button type="button" onclick="pickPlant('GARLAND')">Garland</button>
                <button type="button" class="secondary" onclick="goHome()">Cancel</button>
            </div>
        </div>
        <div id="screenReason" class="screen">
            <h2>Type of check</h2>
            <div class="reason-btns">
                <button type="button" onclick="pickReason('HOURLY')">HOURLY</button>
                <button type="button" onclick="pickReason('RETEST')">RETEST</button>
                <button type="button" onclick="pickReason('NO CHECK')">NO CHECK</button>
            </div>
            <div id="rtsStartupBtnWrap" style="display:none;margin-top:16px;">
                <button type="button" onclick="openRtsStartup()">Startup Checklist</button>
            </div>
        </div>
        <div id="screenRtsStartup" class="screen">
            <div class="card" id="rtsStartupBox"></div>
        </div>
        <div id="screenNoCheck" class="screen">
            <div class="card">
                <h2>No check</h2>
                <label class="f">Additional reason
                    <select id="noCheckReason" onchange="noCheckReason=this.value;syncSubmitBtn();">
                        <option value=""></option>
                        <option>EQUIPMENT FAILURE</option>
                        <option>NO ORDERS</option>
                        <option>LINE DOWN</option>
                        <option>PREVENTATIVE MAINTENANCE</option>
                    </select>
                </label>
                <label class="f">Notes <textarea id="noNotes" onkeyup="scheduleSubmit()"></textarea></label>
            </div>
        </div>
        <div id="screenLineUp" class="screen">
            <div class="card">
                <h2>LINE UP</h2>
                <p class="muted">The last entry was a no-check. Enter what happened, then hourly checks resume.</p>
                <label class="f">Notes <textarea id="upNotes" onkeyup="scheduleSubmit()"></textarea></label>
            </div>
        </div>
        <div id="screenItem" class="screen">
            <div class="card">
                <h2>Item #</h2>
                <label class="f">Item #
                    <input id="item" onkeyup="scheduleHits();scheduleSubmit();" onchange="onItemChange()">
                </label>
                <div class="hits" id="hits"></div>
                <button type="button" class="ok" onclick="confirmItem()">Continue</button>
                <button type="button" class="secondary" onclick="openItemModal()">Add new #</button>
            </div>
        </div>
        <div id="screenStartup" class="screen">
            <div class="card" id="startupBox"></div>
        </div>
        <div id="screenCheck" class="screen">
        <input type="hidden" id="user">
        <input type="hidden" id="reason">
        <input type="hidden" id="notes">
        <div class="lines" id="lineBtns" style="display:none">
            <button data-line="S4" class="on" onclick="setLine('S4')">S4</button>
            <button data-line="S1" onclick="setLine('S1')">S1</button>
            <button data-line="S3" onclick="setLine('S3')">S3</button>
            <button data-line="COEX" onclick="setLine('COEX')">COEX</button>
            <button data-line="MONO" onclick="setLine('MONO')">MONO</button>
            <button data-line="P1" onclick="setLine('P1')">P1</button>
            <button data-line="RTS" onclick="setLine('RTS')">RTS</button>
        </div>
        <div class="grid">
            <div class="col spec-col">
                <div class="card">
                    <h2>Item Information <span class="muted" id="lineLabel">S4</span></h2>
                    <p id="desc" class="muted" style="display:none"></p>
                    <div id="mspecWrap" style="display:none"><div class="mspec-ro">MSPEC <b id="mspecText"></b></div><input type="hidden" id="mspec"></div>
                    <div class="card spec" id="specBox"><div class="muted">Specs appear after you look up an item.</div></div>
                    <div id="resultsBox"></div>
                    <p id="thkMinMax" class="muted"></p>
                    <div class="graph-card" id="radialCard" style="display:none">
                        <h2>Centration</h2>
                        <canvas id="radialCanvas" class="radial" width="260" height="260"></canvas>
                    </div>
                    <div id="overallPf" class="pf-huge"></div>
                </div>
            </div>
            <div class="col form-col">
                <div id="formS4" class="form on">
                    <div class="card">
                        <h2>S4 entries</h2>
                        <div class="pair">
                            <div><label class="f">Bundle # <input id="s4bundle"></label></div>
                            <div><label class="f">Width <input id="s4width" onkeyup="scheduleCompute()"> <span id="widthMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Footage <input id="s4foot"></label></div>
                            <div><label class="f">Perf Roller On <select id="s4perfOn"><option></option><option>Yes</option><option>No</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <input id="s4md"></label></div>
                            <div><label class="f">Cell Count CD <input id="s4cd"></label></div>
                        </div>
                        <label class="f">Weight (g) <input id="s4weight" onkeyup="scheduleCompute()"></label>
                        <label class="f">Thickness T1–T13</label>
                        <div class="chips" id="s4chips">
                            <label class="chip"><span>T1</span><input id="s4t1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="s4t2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="s4t3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="s4t4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="s4t5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="s4t6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="s4t7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="s4t8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="s4t9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="s4t10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="s4t11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="s4t12" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T13</span><input id="s4t13" onkeyup="scheduleCompute()"></label>
                        </div>
                        <div>Average <b id="avgOut"></b> <span id="avgMark"></span> &nbsp; Range <b id="rangeOut"></b> <span id="rangeMark"></span> &nbsp; Density <b id="densOut"></b></div>
                        <div id="s4sheetWrap"><label class="f">Sheet Length <input id="s4sheet" onkeyup="scheduleCompute()"> <span id="sheetMark"></span></label></div>
                    </div>
                </div>
                <div id="formS1" class="form">
                    <div class="card">
                        <h2>S1 / S3 entries</h2>
                        <div class="pair">
                            <div><label class="f">Bundle # <input id="s1bundle"></label></div>
                            <div><label class="f">Width <input id="s1width" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Footage <input id="s1foot"></label></div>
                            <div id="s1perfWrap"><label class="f">Perf <input id="s1perf" onkeyup="scheduleCompute()"> <span id="perfMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Bundle Tight/Loose <select id="s1bundleFit" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                            <div><label class="f">Tape Color <select id="s1tape"><option></option><option>RED</option><option>YELLOW</option><option>GREEN</option><option>BLUE</option><option>BROWN</option><option>TAN</option><option>CLEAR</option><option>ULINE</option><option>BLACK</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <input id="s1md"></label></div>
                            <div><label class="f">Cell Count CD <input id="s1cd"></label></div>
                        </div>
                        <label class="f">Weight <input id="s1weight" onkeyup="scheduleCompute()"></label>
                        <label class="f">Thickness T1–T13</label>
                        <div class="chips">
                            <label class="chip"><span>T1</span><input id="s1t1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="s1t2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="s1t3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="s1t4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="s1t5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="s1t6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="s1t7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="s1t8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="s1t9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="s1t10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="s1t11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="s1t12" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T13</span><input id="s1t13" onkeyup="scheduleCompute()"></label>
                        </div>
                        <div class="pair" id="s1winderWrap">
                            <div><label class="f">Winder tension <input id="s1winder" onkeyup="scheduleCompute()"></label></div>
                            <div id="s1bumperWrap"><label class="f">Bumper roll pressure <input id="s1bumper" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div id="s1diamWrap"><label class="f">Diameter (ULINE only) <input id="s1diam" onkeyup="scheduleCompute()"></label></div>
                    </div>
                </div>
                <div id="formBubble" class="form">
                    <div class="card">
                        <h2>Bubble entries</h2>
                        <div class="pair">
                            <div><label class="f">Dead Cells Pre <input id="bdeadPre" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Dead Cells Post <input id="bdeadPost" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div id="bpostvWrap"><label class="f">Post-Visual Inspection <select id="bpostv" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                        <div id="bcohWrap"><label class="f">COH/ADH Verification <select id="bcoh" onchange="compute()"><option></option><option>PASS</option><option>FAIL</option></select></label></div>
                        <div class="pair">
                            <div><label class="f">Width <input id="bwidth" onkeyup="scheduleCompute()"> <span id="bwidthMark"></span></label></div>
                            <div><label class="f">Footage <input id="bfootage" onkeyup="scheduleCompute()"> <span id="bfootMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div id="bperfwWrap"><label class="f">Perf Width <input id="bperfw" onkeyup="scheduleCompute()"> <span id="bperfMark"></span></label></div>
                            <div id="btesterWrap"><label class="f">Perf Tester Results <input id="btester" onkeyup="scheduleCompute()"> <span id="btestMark"></span></label></div>
                        </div>
                        <label class="f">Gram Weight <input id="bweight" onkeyup="scheduleCompute()"> <span id="bwtMark"></span></label>
                        <div id="bdiamWrap"><label class="f">Diameter (ULINE only) <input id="bdiam" onkeyup="scheduleCompute()"></label></div>
                    </div>
                </div>
                <div id="formP1" class="form">
                    <div class="card">
                        <h2>P1 entries — head piece</h2>
                        <div class="pair">
                            <div><label class="f">Length <input id="plength" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Width <input id="pwidth" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Cell Count MD <input id="pmd"></label></div>
                            <div><label class="f">Cell Count CD <input id="pcd"></label></div>
                        </div>
                        <label class="f">Plank Weight <input id="pweight" onkeyup="scheduleCompute()"></label>
                        <label class="f">Head thickness T1–T12</label>
                        <div class="chips" id="p1HeadChips">
                            <label class="chip"><span>T1</span><input id="pht1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="pht2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="pht3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="pht4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="pht5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="pht6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="pht7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="pht8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="pht9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="pht10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="pht11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="pht12" onkeyup="scheduleCompute()"></label>
                        </div>
                        <div>Average <b id="pavgOut"></b> &nbsp; Volume <b id="pvolOut"></b> &nbsp; Density <b id="pdensOut"></b></div>
                    </div>
                    <div class="card" id="p1TailWrap" style="display:none">
                        <h2>P1 entries — tail piece (double shot)</h2>
                        <div class="pair">
                            <div><label class="f">Tail Length <input id="ptailLength" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Tail Width <input id="ptailWidth" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <label class="f">Tail thickness T1–T12</label>
                        <div class="chips" id="p1TailChips">
                            <label class="chip"><span>T1</span><input id="ptt1" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T2</span><input id="ptt2" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T3</span><input id="ptt3" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T4</span><input id="ptt4" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T5</span><input id="ptt5" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T6</span><input id="ptt6" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T7</span><input id="ptt7" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T8</span><input id="ptt8" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T9</span><input id="ptt9" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T10</span><input id="ptt10" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T11</span><input id="ptt11" onkeyup="scheduleCompute()"></label>
                            <label class="chip"><span>T12</span><input id="ptt12" onkeyup="scheduleCompute()"></label>
                        </div>
                    </div>
                </div>
                <div id="formRts" class="form">
                    <div class="card">
                        <h2>RTS entries</h2>
                        <div class="pair">
                            <div>
                                <label class="f">Parent Material
                                    <select id="rparent" onchange="onRtsParentChange()"></select>
                                </label>
                                <a href="#" onclick="addRtsParent();return false;" style="color:#93c5fd;text-decoration:underline;font-size:12px;">Add parent material</a>
                            </div>
                            <div><label class="f date-field">Parent MFG Date
                                <span class="date-wrap">
                                    <input id="rdate" class="date-input" placeholder="MM/DD/YYYY" onkeyup="onRdateTyped()" onchange="onRdateTyped()" onfocus="toggleDatePicker(true)">
                                    <button type="button" class="date-btn" title="Open calendar" onclick="toggleDatePicker();return false;">Cal</button>
                                    <div id="rdatePicker" class="date-picker" style="display:none"></div>
                                </span>
                                <span id="rmfgMark"></span></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Parent Shift <select id="rshift"><option></option><option>A</option><option>B</option><option>C</option><option>D</option></select></label></div>
                            <div><label class="f">Color <select id="rcolor" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Width <input id="rwidth" onkeyup="scheduleCompute()"></label></div>
                            <div><label class="f">Length <input id="rlength" onkeyup="scheduleCompute()"></label></div>
                        </div>
                        <div class="pair">
                            <div><label class="f">Blister / Delam <select id="rdelam" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                            <div><label class="f">Alligator Skin <select id="rallig" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label></div>
                        </div>
                        <label class="f">Verify side tattoo exists <select id="rtattoo" onchange="compute()"><option></option><option>Pass</option><option>Fail</option></select></label>
                        <label class="f">Thickness points</label>
                        <div class="pts">
                            <input id="rt1" onkeyup="scheduleCompute()"><input id="rt2" onkeyup="scheduleCompute()"><input id="rt3" onkeyup="scheduleCompute()">
                            <span id="rthkMark"></span>
                        </div>
                    </div>
                </div>
                <div class="card" id="checkNotesCard">
                    <label class="f">Notes <textarea id="checkNotes" onkeyup="$('notes').value=this.value;scheduleSubmit();"></textarea></label>
                </div>
            </div>
        </div>
        </div>
        </div>
        <div id="tabLookup" class="tabpanel">
            <div class="card lookup-card">
                <h2>Item lookup</h2>
                <p class="muted">Look up an item # without starting a quality check.</p>
                <label class="f">Item #
                    <input id="lookupItem" onkeyup="scheduleLookup()" onchange="renderLookup()">
                </label>
                <div class="hits" id="lookupHits"></div>
                <div class="card spec" id="lookupCard"><div class="muted">Type an item # to see description and specs.</div></div>
            </div>
        </div>
        <div id="tabUsers" class="tabpanel">
            <div class="card">
                <h2>Users <span class="muted" id="userCount"></span></h2>
                <div class="pair">
                    <div><label class="f">Filter <input id="userFilter" onkeyup="scheduleList(renderUserTable)">
                        <select id="userFilterBy" onchange="renderUserTable()"><option value="User">User</option><option value="Plant">Plant</option><option value="Lines">Lines</option></select>
                    </label></div>
                    <div class="admin-only">
                        <label class="f">New user <input id="newUser"></label>
                        <label class="f">Password <input id="newUserPass" type="password"></label>
                        <div class="role-checks">
                            <label><input id="newUserAdmin" type="checkbox"> Admin</label>
                            <label><input id="newUserSupervisor" type="checkbox"> Supervisor</label>
                            <label><input id="newUserLead" type="checkbox"> Lead</label>
                        </div>
                        <label class="f">Plant</label>
                        <div class="plant-checks" id="newUserPlantBox"></div>
                        <div class="line-checks" id="newUserLineBox"></div>
                        <button type="button" onclick="addUser()">Add user</button>
                    </div>
                </div>
                <div class="list-wrap"><table class="list" id="userTable"></table></div>
            </div>
        </div>
        <div id="tabMspecs" class="tabpanel">
            <div class="card">
                <h2>MSPECs <span class="muted" id="mspecCount"></span></h2>
                <div class="subtabs" id="specTabs">
                    <button data-spec="foam" class="on" onclick="setSpecTab('foam')">Foam</button>
                    <button data-spec="bubble" onclick="setSpecTab('bubble')">Bubble</button>
                    <button data-spec="p1" onclick="setSpecTab('p1')">P1</button>
                    <button data-spec="rts" onclick="setSpecTab('rts')">RTS</button>
                </div>
                <label class="f">Filter <input id="mspecFilter" onkeyup="scheduleList(renderMspecTable)">
                    <select id="mspecFilterBy" onchange="renderMspecTable()"></select>
                </label>
                <div class="list-wrap"><table class="specs" id="mspecTable"></table></div>
            </div>
        </div>
        <div id="tabItems" class="tabpanel">
            <div class="card">
                <h2>Item database <span class="muted" id="itemCount"></span></h2>
                <div class="subtabs" id="itemTabs">
                    <button data-item="foam" class="on" onclick="setItemTab('foam')">Foam</button>
                    <button data-item="bubble" onclick="setItemTab('bubble')">Bubble</button>
                    <button data-item="p1" onclick="setItemTab('p1')">P1</button>
                    <button data-item="rts" onclick="setItemTab('rts')">RTS</button>
                </div>
                <div class="pair">
                    <div><label class="f">Filter <input id="itemFilter" onkeyup="scheduleList(renderItemTable)">
                        <select id="itemFilterBy" onchange="renderItemTable()"></select>
                    </label></div>
                    <div><button type="button" onclick="openItemModal()">Add item #</button></div>
                </div>
                <div class="list-wrap"><table class="list" id="itemTable"></table></div>
            </div>
        </div>
        <div id="tabDocs" class="tabpanel">
            <div id="docReviewWrap">
                <div class="card" id="docAckBox"></div>
            </div>
            <div id="docAdminWrap" class="card">
                <h2>Documentation <span class="muted" id="docCount"></span></h2>
                <p class="muted">Work Instructions and QANs. Assigned users must read a document when it is new, when the version changes, and again every 3 months.</p>
                <div class="admin-only">
                    <div class="pair">
                        <div><label class="f">Name <input id="docName"></label></div>
                        <div><label class="f">Line(s)</label>
                            <div class="line-checks" id="docLineBox"></div>
                        </div>
                    </div>
                    <div class="pair">
                        <div><label class="f">Type
                            <select id="docType" onchange="syncDocTypeFields()">
                                <option>Work Instruction</option>
                                <option>QAN</option>
                                <option>Construction Card</option>
                            </select>
                        </label></div>
                        <div><label class="f">Version <input id="docVer" value="1"></label></div>
                    </div>
                    <div id="docLinkedWrap" style="display:none"><label class="f">Linked items (comma-separated item #s) <input id="docLinkedItems"></label></div>
                    <div id="docCheckLinkWrap"><label class="f">Link to in Quality Check
                        <select id="docCheckLink"></select>
                    </label></div>
                    <label class="f">Link <input id="docUrl"></label>
                    <button type="button" id="docSaveBtn" onclick="saveDocForm()">Add document</button>
                </div>
                <div class="list-wrap"><table class="list" id="docTable"></table></div>
            </div>
        </div>
        <div id="tabAudit" class="tabpanel">
            <div class="card">
                <h2>Audit log <span class="muted" id="auditCount"></span></h2>
                <p class="muted">Sign-ins, new users, password resets, submitted checks, MSPEC edits, item changes, and documentation updates.</p>
                <div class="list-wrap"><table class="list" id="auditTable"></table></div>
            </div>
        </div>
    </div>
    <div class="submit-bar" id="submitBar" onmouseover="hintMissing()" onmouseout="clearHint()">
        <button type="button" id="submitBtn" class="ghost" onclick="if(this.getAttribute('data-ready')==='1')submitCheck(); else hintMissing();">Submit check</button>
    </div>
    </div>
    <div class="overlay" id="itemOverlay">
        <div class="modal">
            <h3 id="itemModalTitle">Add item #</h3>
            <label class="f">Type
                <select id="newType" onchange="syncItemTypeFields()">
                    <option value="">Select type…</option>
                    <option value="BUBBLE">BUBBLE — COEX / MONO</option>
                    <option value="FOAM">FOAM — S1 / S3 / S4</option>
                    <option value="LAM">LAM — RTS</option>
                    <option value="PLANK">PLANK — P1</option>
                </select>
            </label>
            <p class="muted" id="itemTypeHint">Pick a type first.</p>
            <label class="f">Item # <input id="newItem"></label>
            <label class="f">Description <input id="newDesc"></label>
            <div id="fieldsBubble" class="type-fields">
                <label class="f">Width <input id="newWidthB"></label>
                <label class="f"># Slits <input id="newSlits"></label>
                <label class="f">Footage <input id="newFootageB"></label>
                <label class="f">Perf <input id="newPerfB"></label>
                <label class="f">Bubble Type <input id="newBubble"></label>
            </div>
            <div id="fieldsFoam" class="type-fields">
                <label class="f">Width <input id="newWidthF"></label>
                <label class="f">Footage <input id="newFootageF"></label>
                <label class="f">Perf <input id="newPerfF"></label>
                <label class="f">MSPEC <input id="newMspecF"></label>
            </div>
            <div id="fieldsLam" class="type-fields">
                <label class="f">Length <input id="newLengthL"></label>
                <label class="f">Width <input id="newWidthL"></label>
                <label class="f">Parent Material <input id="newParent"></label>
                <label class="f">MSPEC <input id="newMspecL"></label>
                <label class="f">Thickness <input id="newThk"></label>
            </div>
            <div id="fieldsPlank" class="type-fields">
                <label class="f">Length <input id="newLengthP"></label>
                <label class="f">Width <input id="newWidthP"></label>
                <label class="f">Density <input id="newDens"></label>
                <label class="f"># Shots <input id="newShots"></label>
                <label class="f">Soft <input id="newSoft"></label>
            </div>
            <button type="button" class="ok" onclick="saveNewItem()">Save item</button>
            <button type="button" class="secondary" onclick="closeItemModal()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="specEditOverlay">
        <div class="modal">
            <h3>Edit spec</h3>
            <div id="specEditFields"></div>
            <button type="button" class="ok" onclick="saveSpecEdit()">Save change</button>
            <button type="button" class="secondary" onclick="closeSpecEdit()">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="histOverlay">
        <div class="modal wide">
            <div id="histBody"></div>
            <button type="button" class="secondary" onclick="closeHistory()">Close</button>
        </div>
    </div>
    <div class="overlay" id="pwOverlay">
        <div class="modal">
            <h3 id="pwTitle">Change password</h3>
            <label class="f">Current password <input id="pwOld" type="password"></label>
            <label class="f">New password <input id="pwNew" type="password"></label>
            <label class="f">Confirm new password <input id="pwNew2" type="password"></label>
            <button type="button" class="ok" onclick="saveOwnPassword()">Save password</button>
            <button type="button" class="secondary" onclick="$('pwOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="linesOverlay">
        <div class="modal">
            <h3>Assign lines</h3>
            <input type="hidden" id="editUserName">
            <label class="f">Plant</label>
            <div class="plant-checks" id="editUserPlantBox"></div>
            <div class="line-checks" id="editUserLineBox"></div>
            <button type="button" class="ok" onclick="saveAssignedLines()">Save</button>
            <button type="button" class="secondary" onclick="$('linesOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="debugOverlay">
        <div class="modal wide">
            <h3>Debug log</h3>
            <textarea id="debugBox" readonly></textarea>
            <button type="button" class="ok" onclick="copyDebug()">Copy</button>
            <button type="button" class="secondary" onclick="debugLines=[];$('debugBox').value='';">Clear</button>
            <button type="button" class="secondary" onclick="$('debugOverlay').className='overlay'">Close</button>
        </div>
    </div>
    <div class="overlay" id="inboxOverlay">
        <div class="modal wide">
            <h3>Inbox</h3>
            <p class="muted">New user requests and forgot-password notices.</p>
            <div id="inboxBody"></div>
            <button type="button" class="secondary" onclick="closeInbox()">Close</button>
        </div>
    </div>
    <div class="overlay raise" id="newUserOverlay">
        <div class="modal">
            <h3>New User</h3>
            <p class="muted" id="nuStatus">Create a username and password. An admin must approve you before you can sign in.</p>
            <label class="f">Username <input id="nuName"></label>
            <label class="f">Password <input id="nuPass" type="password"></label>
            <label class="f">Confirm password <input id="nuPass2" type="password"></label>
            <button type="button" class="ok" onclick="requestNewUser()">Request account</button>
            <button type="button" class="secondary" onclick="$('newUserOverlay').className='overlay raise'">Cancel</button>
        </div>
    </div>
    <div class="overlay raise" id="forgotOverlay">
        <div class="modal">
            <h3>Forgot Password</h3>
            <p class="muted" id="fpStatus">Enter your username. Admins are notified and will give you a temporary password.</p>
            <label class="f">Username <input id="fpName"></label>
            <button type="button" class="ok" onclick="requestReset()">Notify admins</button>
            <button type="button" class="secondary" onclick="$('forgotOverlay').className='overlay raise'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="parentPickerOverlay">
        <div class="modal">
            <h3>Add parent material</h3>
            <label class="f">Search FOAM items <input id="parentPickerSearch" onkeyup="renderParentPickerList()"></label>
            <div class="hits" id="parentPickerList" style="display:block;max-height:280px"></div>
            <button type="button" class="secondary" onclick="$('parentPickerOverlay').className='overlay'">Cancel</button>
        </div>
    </div>
    <div class="overlay" id="inboxDetailOverlay">
        <div class="modal wide">
            <h3>Inbox request details</h3>
            <div id="inboxDetailBody"></div>
            <button type="button" class="secondary" onclick="$('inboxDetailOverlay').className='overlay'">Close</button>
        </div>
    </div>
    <div class="overlay" id="conCardOverlay">
        <div class="modal wide">
            <h3>Construction Card</h3>
            <div id="conCardBody"></div>
            <button type="button" class="ok" id="conCardAckBtn" onclick="ackConCard()">I have read this</button>
        </div>
    </div>
    <div class="overlay" id="failOverlay">
        <div class="modal">
            <h3>Failed check follow-up</h3>
            <p class="muted" id="failStatus">This check failed. Choose disposition before continuing.</p>
            <label class="f">Material disposition
                <select id="failDisposition">
                    <option value=""></option>
                    <option>SCRAP</option>
                    <option>QUALITY HOLD</option>
                    <option>PASS AS IS</option>
                </select>
            </label>
            <label class="f">Submit deviation for process profile?
                <select id="failDeviation" onchange="syncFailDeviation()">
                    <option value="NO">No</option>
                    <option value="YES">Yes</option>
                </select>
            </label>
            <p class="muted" id="failDevHint" style="display:none">Yes sends a deviation request to the admin inbox for approval (details expand later).</p>
            <button type="button" class="ok" onclick="submitFailFollowUp()">Continue</button>
        </div>
    </div>
</body>
</html>