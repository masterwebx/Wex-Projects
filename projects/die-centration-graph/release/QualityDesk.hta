<html>
<head>
    <title>Quality Desk Checks</title>
    <meta http-equiv="X-UA-Compatible" content="IE=11">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">

    <HTA:APPLICATION
        ID="QualityDeskChecks"
        APPLICATIONNAME="Quality Desk Checks"
        BORDER="thick"
        CAPTION="yes"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        WINDOWSTATE="maximize"
        SCROLL="yes"
    />

    <style>
        html, body { background: #5c6370; height: 100%; margin: 0; }
        body { font-family: Segoe UI, Arial; color: #f3f4f6; font-size: 15px; }
        html.qd-app, body.qd-app { background: #121212; }
        #appRoot { min-height: 100%; background: #121212; }
        header.app { padding: 12px 18px; background: #1a1a1a; border-bottom: 1px solid #2a2f36; overflow: hidden; }
        header.app .brand { float: left; }
        header.app .tools { float: right; }
        h1 { margin: 0; font-size: 20px; }
        h1 .ver { margin-left: 8px; font-size: 13px; color: #9ca3af; font-weight: 700; }
        .tools button, button { border: 0; border-radius: 10px; padding: 8px 14px; font-weight: 700; cursor: pointer; background: #2563eb; color: #fff; font-family: inherit; margin-left: 6px; }
        button.secondary { background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        button.ok { background: #15803d; }
        button:disabled, button.ghost { filter: alpha(opacity=40); opacity: .4; cursor: default; background: #3f3f46; color: #d4d4d8; }
        .wrap { padding: 14px 18px 72px; }
        .status { margin: 0 0 12px; padding: 10px 12px; background: #1f2937; border: 1px solid #334155; border-radius: 8px; white-space: pre-wrap; font-size: 13px; }
        .status.bad { background: #3f1d1d; border-color: #7f1d1d; }
        .lines { margin: 0 0 12px; }
        .lines button { margin: 0 6px 6px 0; min-width: 64px; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .lines button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        .grid { display: table; width: 100%; border-collapse: separate; border-spacing: 12px 0; }
        .col { display: table-cell; vertical-align: top; }
        .col.spec-col { width: 46%; }
        .col.form-col { width: 54%; }
        .col.graph-col { width: 38%; }
        .card { background: #1e1e1e; border: 1px solid #2a2f36; border-radius: 12px; padding: 14px; margin-bottom: 12px; }
        .card h2 { margin: 0 0 10px; font-size: 16px; }
        label.f { display: block; margin: 0 0 8px; font-size: 12px; font-weight: 700; color: #9ca3af; }
        label.f input, label.f select, label.f textarea { display: block; width: 100%; margin-top: 4px; box-sizing: border-box; padding: 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        textarea { min-height: 58px; }
        label.f.need input, label.f.need select, label.f.need textarea {
            border-color: #eab308 !important;
            outline: 2px solid #eab308;
        }
        label.f.need { color: #fbbf24; }
        .date-wrap { position: relative; display: block; }
        .date-wrap input.date-input { display: block; width: 100%; margin-top: 4px; box-sizing: border-box; padding: 8px 36px 8px 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        .date-wrap .date-btn { position: absolute; right: 4px; top: 22px; margin: 0; padding: 4px 8px; font-size: 14px; line-height: 1; background: #262626; border: 1px solid #3f3f46; }
        .date-picker { position: absolute; z-index: 40; left: 0; top: 100%; margin-top: 4px; width: 260px; background: #1a1a1a; border: 2px solid #3f3f46; border-radius: 10px; padding: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.45); }
        .date-picker .dp-head { overflow: hidden; margin-bottom: 8px; }
        .date-picker .dp-head button { float: left; margin: 0 4px 0 0; padding: 4px 10px; background: #262626; }
        .date-picker .dp-title { float: left; width: 140px; text-align: center; font-weight: 700; padding-top: 6px; font-size: 13px; }
        .date-picker .dp-head .dp-next { float: right; margin: 0; }
        .date-picker table { width: 100%; border-collapse: collapse; }
        .date-picker th { color: #9ca3af; font-size: 11px; padding: 4px 0; }
        .date-picker td { text-align: center; padding: 2px; }
        .date-picker td button { width: 100%; margin: 0; padding: 6px 0; background: #262626; font-size: 12px; border-radius: 6px; }
        .date-picker td button.on { background: #2563eb; }
        .date-picker td button.muted { color: #6b7280; }
        .date-picker .dp-foot { margin-top: 8px; overflow: hidden; }
        .date-picker .dp-foot button { margin: 0 6px 0 0; padding: 6px 10px; font-size: 12px; }
        body.light .date-wrap input.date-input { background: #fff; color: #111827; border-color: #d1d5db; }
        body.light .date-wrap .date-btn, body.light .date-picker { background: #fff; border-color: #d1d5db; color: #111827; }
        body.light .date-picker td button, body.light .date-picker .dp-head button { background: #f3f4f6; color: #111827; }
        .date-pick { white-space: nowrap; }
        .date-pick input { display: inline-block; width: 130px; margin-top: 4px; vertical-align: middle; }
        .date-pick button { display: inline-block; margin: 4px 0 0 6px; padding: 8px 12px; vertical-align: middle; }
        table.cal { border-collapse: collapse; width: 100%; margin: 8px 0; }
        table.cal th { padding: 6px; font-size: 12px; color: #9ca3af; }
        table.cal td { padding: 8px; text-align: center; cursor: pointer; border-radius: 8px; }
        table.cal td:hover { background: #2563eb; color: #fff; }
        table.cal td.off { color: #52525b; cursor: default; }
        table.cal td.off:hover { background: transparent; color: #52525b; }
        table.cal td.today { outline: 2px solid #eab308; }
        table.cal td.sel { background: #15803d; color: #fff; }
        .pair { display: table; width: 100%; }
        .pair > div { display: table-cell; width: 50%; padding-right: 8px; }
        .spec { font-size: 13px; }
        .spec b { display: inline-block; min-width: 110px; color: #9ca3af; }
        .spec div { margin: 3px 0; }
        .hits { border: 1px solid #3f3f46; border-radius: 8px; max-height: 160px; overflow: auto; margin-top: 4px; display: none; background: #111; }
        .hits div { padding: 6px 8px; cursor: pointer; }
        .hits div:hover { background: #1d4ed8; color: #fff; }
        .pts input { width: 72px; margin: 0 6px 6px 0; }
        .pf { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 8px; font-size: 12px; }
        .pass { background: #14532d; color: #86efac; }
        .fail { background: #7f1d1d; color: #fecaca; }
        .muted { color: #9ca3af; font-weight: 400; }
        .crumbs { margin: 0 0 14px; color: #9ca3af; font-size: 13px; }
        .crumbs b { color: #f3f4f6; }
        .crumbs a { color: #93c5fd; cursor: pointer; text-decoration: none; }
        .home-grid { display: block; }
        .home-line { display: inline-block; width: 220px; min-height: 110px; margin: 0 12px 12px 0; padding: 18px; vertical-align: top; background: #1e1e1e; border: 1px solid #2a2f36; border-radius: 14px; cursor: pointer; text-align: left; }
        .home-line:hover { border-color: #2563eb; }
        .home-line h3 { margin: 0 0 8px; font-size: 28px; }
        .home-line p { margin: 0; color: #9ca3af; font-size: 13px; font-weight: 400; }
        .reason-btns button { display: block; width: 320px; max-width: 100%; margin: 0 0 12px; padding: 16px; font-size: 18px; }
        .chips { margin: 8px 0; }
        .chip { display: inline-block; min-width: 72px; margin: 0 6px 8px 0; padding: 8px 8px 6px; border-radius: 999px; text-align: center; background: #262626; border: 2px solid #3f3f46; }
        .chip input { width: 48px; border: 0; background: transparent; color: #f3f4f6; text-align: center; padding: 2px 0; font-weight: 700; }
        .chip.under { background: #713f12; border-color: #eab308; }
        .chip.in { background: #14532d; border-color: #22c55e; }
        .chip.over { background: #7f1d1d; border-color: #ef4444; }
        .chip.extreme { outline: 2px solid #fff; }
        .chip.need { border-color: #eab308; outline: 2px solid #eab308; }
        .chip span { display: block; font-size: 9px; color: #d4d4d8; }
        .chip span.ex { color: #fbbf24; font-weight: 800; }
        .pf-huge { display: none; margin: 16px 0 8px; padding: 18px 20px; border-radius: 14px; font-size: 42px; font-weight: 800; text-align: center; letter-spacing: 0.04em; }
        .pf-huge.on { display: block; }
        .pf-huge.pass { background: #14532d; color: #86efac; }
        .pf-huge.fail { background: #7f1d1d; color: #fecaca; }
        .home-line.tone-green h3, .home-line.tone-green p { color: #86efac; }
        .home-line.tone-red h3, .home-line.tone-red p { color: #fca5a5; }
        .home-line.tone-gray h3, .home-line.tone-gray p { color: #9ca3af; }
        .plant-pick button { display: block; width: 360px; max-width: 100%; margin: 0 0 14px; padding: 22px; font-size: 22px; }
        .results { width: 100%; border-collapse: collapse; font-size: 13px; }
        .results th, .results td { padding: 6px 8px; border-bottom: 1px solid #2a2f36; text-align: right; }
        .results th:first-child, .results td:first-child { text-align: left; color: #9ca3af; }
        .results td.ok { color: #86efac; font-weight: 700; }
        .results td.bad { color: #fca5a5; font-weight: 700; }
        .submit-bar { display: none; position: fixed; right: 18px; bottom: 16px; z-index: 12; }
        .submit-bar.on { display: block; }
        .submit-bar button { min-width: 180px; padding: 12px 20px; font-size: 16px; }
        .screen { display: none; }
        .screen.on { display: block; }
        .plant-toggle { margin-left: 10px; }
        .plant-toggle button { min-width: 96px; }
        .plant-toggle button.on { background: #0f766e; border-color: #0f766e; color: #fff; }
        .graph-card { text-align: center; }
        canvas.radial { width: 260px; height: 260px; background: #111; border-radius: 12px; }
        .doc-ack { padding: 12px; border: 1px solid #334155; border-radius: 10px; margin: 0 0 10px; }
        .form { display: none; }
        .form.on { display: block; }
        .tabs { margin: 0 0 12px; }
        .tabs button { margin: 0 6px 6px 0; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .tabs button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        .tabpanel { display: none; }
        .tabpanel.on { display: block; }
        table.list { width: 100%; border-collapse: collapse; font-size: 13px; }
        table.list th, table.list td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #2a2f36; vertical-align: top; }
        table.list th { color: #9ca3af; }
        .list-wrap { max-height: 520px; overflow: auto; border: 1px solid #2a2f36; border-radius: 8px; }
        .overlay { display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); z-index: 20; }
        .overlay.on { display: block; }
        .overlay.login { background: #5c6370; z-index: 40; }
        .overlay.login .modal { background: #6b7280; border-color: #9ca3af; color: #f9fafb; box-shadow: 0 18px 40px rgba(15,23,42,.28); margin-top: 10vh; }
        .overlay.login .modal h3 { color: #f9fafb; letter-spacing: 0.02em; margin-bottom: 6px; }
        .overlay.login .muted { color: #e5e7eb; }
        .overlay.login label.f { color: #e5e7eb; }
        .overlay.login label.f input { background: #4b5563; color: #f9fafb; border-color: #9ca3af; }
        .overlay.login button.ok { background: #374151; border: 1px solid #9ca3af; }
        .overlay.login button.secondary { background: #4b5563; color: #f9fafb; border-color: #9ca3af; }
        .login-kicker { font-size: 11px; letter-spacing: 0.18em; font-weight: 800; color: #d1d5db; margin: 0 0 8px; }
        .overlay.raise { z-index: 50; }
        .filter-row { margin: 0 0 10px; }
        .filter-row .f { display: inline-block; width: auto; margin: 0 10px 0 0; vertical-align: middle; }
        .filter-row input, .filter-row select { display: inline-block; width: auto; min-width: 140px; margin: 4px 8px 0 0; vertical-align: middle; padding: 8px; border: 2px solid #3f3f46; border-radius: 8px; font: inherit; background: #111; color: #f3f4f6; }
        .item-tools { margin: 0 0 10px; }
        .item-tools .subtabs { display: inline-block; vertical-align: middle; }
        .item-tools > button { margin: 0 6px 6px 0; vertical-align: middle; }
        .modal { width: 520px; max-width: 92%; margin: 40px auto; background: #1e1e1e; border-radius: 12px; padding: 16px; border: 1px solid #2a2f36; color: #f3f4f6; }
        .modal.wide { width: 780px; }
        .modal h3 { margin: 0 0 10px; }
        .session { font-size: 13px; color: #9ca3af; margin-right: 6px; }
        .subtabs button { margin: 0 6px 6px 0; background: #262626; color: #f3f4f6; border: 2px solid #3f3f46; }
        .subtabs button.on { background: #0f766e; color: #fff; border-color: #0f766e; }
        table.specs { width: 100%; border-collapse: collapse; font-size: 12px; }
        table.specs th, table.specs td { text-align: left; padding: 5px 6px; border: 1px solid #2a2f36; vertical-align: top; }
        table.specs thead th { background: #1f2937; color: #9ca3af; font-weight: 700; }
        table.specs th.group { text-align: center; background: #111827; }
        table.specs th.mspec, table.specs td.mspec { width: 4.6em; white-space: nowrap; }
        table.specs td.num, table.specs th.num { width: 4.2em; text-align: right; }
        table.specs button { padding: 3px 8px; font-size: 12px; margin: 0 3px 0 0; }
        button.danger { background: #991b1b; }
        .locked { display: none; }
        .who { font-weight: 700; color: #f3f4f6; }
        .type-fields { display: none; }
        .type-fields.on { display: block; }
        .theme-toggle { display: inline-block; margin: 0 8px; color: #9ca3af; font-size: 12px; font-weight: 700; cursor: pointer; vertical-align: middle; }
        .theme-toggle input { display: none; }
        .theme-toggle .track { display: inline-block; position: relative; width: 42px; height: 22px; background: #3f3f46; border-radius: 999px; border: 1px solid #3f3f46; vertical-align: middle; margin: 0 6px; }
        .theme-toggle .track span { display: block; position: absolute; left: 2px; top: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fbbf24; }
        body.light .theme-toggle .track { background: #93c5fd; }
        body.light .theme-toggle .track span { left: 22px; background: #fff; }
        .lookup-card { width: 720px; max-width: 100%; }
        .mspec-ro { margin: 0 0 10px; font-size: 12px; font-weight: 700; color: #9ca3af; }
        .mspec-ro b { display: inline-block; margin-left: 8px; padding: 6px 10px; border-radius: 8px; background: #111; color: #f3f4f6; border: 2px solid #3f3f46; font-size: 15px; }
        .line-checks label { display: inline-block; margin: 0 12px 8px 0; color: #f3f4f6; font-size: 13px; font-weight: 600; }
        .line-checks input { margin-right: 4px; }
        .role-checks, .plant-checks { margin: 8px 0 12px; }
        .role-checks label, .plant-checks label { display: inline-block; margin: 0 12px 8px 0; color: #f3f4f6; font-size: 13px; font-weight: 600; }
        .role-checks input, .plant-checks input { margin-right: 4px; }
        table.results td.neutral { color: #9ca3af; }
        .op-banner { display: none; margin: 0 0 12px; padding: 8px 12px; background: #1e3a5f; border-radius: 8px; color: #93c5fd; font-size: 13px; }
        .op-banner.on { display: block; }
        #debugBox { width: 100%; height: 280px; box-sizing: border-box; font-family: Consolas, monospace; font-size: 12px; background: #0b1220; color: #d1fae5; border: 1px solid #334155; }
        .login-extra { margin-top: 14px; }
        .login-extra button { margin: 0 6px 0 0; }
        .boot-progress { margin-top: 16px; display: none; }
        .boot-progress.on { display: block; }
        .boot-bar { height: 10px; background: #4b5563; border-radius: 999px; overflow: hidden; border: 1px solid #9ca3af; }
        .boot-bar i { display: block; height: 100%; width: 0; background: #93c5fd; }
        .boot-progress p { margin: 8px 0 0; font-size: 12px; color: #e5e7eb; }
        .work-modal .boot-bar { border-color: #3f3f46; background: #262626; }
        .work-modal .boot-bar i { background: #2563eb; }
        .inbox-btn { position: relative; }
        .badge { display: none; min-width: 16px; padding: 1px 6px; margin-left: 6px; border-radius: 999px; background: #dc2626; color: #fff; font-size: 11px; }
        .badge.on { display: inline-block; }
        .hist-changed { background: #713f12; color: #fde68a; font-weight: 700; }
        .hist-grid td { padding: 4px 8px; }

        html.qd-app.light, body.qd-app.light, body.light { background: #e8edf3; color: #111827; }
        body.qd-app.light #appRoot, body.light #appRoot { background: #e8edf3; }
        body.light header.app { background: #fff; border-bottom-color: #d1d5db; }
        body.light h1 .ver, body.light .muted, body.light .crumbs, body.light .session, body.light label.f, body.light .theme-toggle, body.light table.list th, body.light .results th:first-child, body.light .results td:first-child, body.light .mspec-ro, body.light .spec b { color: #4b5563; }
        body.light .crumbs b, body.light .who { color: #111827; }
        body.light .crumbs a { color: #1d4ed8; }
        body.light button.secondary { background: #e5e7eb; color: #111827; border-color: #d1d5db; }
        body.light .status { background: #eff6ff; border-color: #93c5fd; color: #1e3a8a; }
        body.light .status.bad { background: #fee2e2; border-color: #fca5a5; color: #991b1b; }
        body.light .card, body.light .home-line, body.light .modal { background: #fff; border-color: #d1d5db; color: #111827; }
        body.light label.f input, body.light label.f select, body.light label.f textarea, body.light .hits, body.light canvas.radial, body.light .mspec-ro b, body.light .filter-row input, body.light .filter-row select { background: #fff; color: #111827; border-color: #d1d5db; }
        body.light .tabs button, body.light .subtabs button, body.light .lines button { background: #e5e7eb; color: #111827; border-color: #d1d5db; }
        body.light .tabs button.on, body.light .lines button.on { background: #2563eb; color: #fff; border-color: #2563eb; }
        body.light .chip { background: #f3f4f6; border-color: #d1d5db; }
        body.light .chip input { color: #111827; }
        body.light .chip.under { background: #fef3c7; }
        body.light .chip.in { background: #dcfce7; }
        body.light .chip.over { background: #fee2e2; }
        body.light .chip.extreme { outline-color: #111827; }
        body.light .chip.need { border-color: #d97706; outline-color: #d97706; }
        body.light .hist-changed { background: #fef3c7; color: #92400e; }
        body.light .pass { background: #dcfce7; color: #166534; }
        body.light .fail { background: #fee2e2; color: #991b1b; }
        body.light .pf-huge.pass { background: #dcfce7; color: #166534; }
        body.light .pf-huge.fail { background: #fee2e2; color: #991b1b; }
        body.light .chip span.ex { color: #b45309; }
        body.light .home-line.tone-green h3, body.light .home-line.tone-green p { color: #166534; }
        body.light .home-line.tone-red h3, body.light .home-line.tone-red p { color: #b91c1c; }
        body.light .home-line.tone-gray h3, body.light .home-line.tone-gray p { color: #6b7280; }
        body.light .results th, body.light .results td, body.light table.list th, body.light table.list td, body.light table.specs th, body.light table.specs td, body.light .list-wrap { border-color: #e5e7eb; }
        body.light .results td.ok { color: #166534; }
        body.light .results td.bad { color: #b91c1c; }
        body.light table.specs thead th { background: #f3f4f6; color: #4b5563; }
        body.light table.specs th.group { background: #e5e7eb; }
        body.light .overlay.login { background: #5c6370; }
        body.light .overlay.login .modal { background: #6b7280; border-color: #9ca3af; color: #f9fafb; }
        body.light .overlay.login .muted, body.light .overlay.login label.f { color: #e5e7eb; }
        body.light .overlay.login label.f input { background: #4b5563; color: #f9fafb; border-color: #9ca3af; }
        body.light .line-checks label { color: #111827; }
        body.light .role-checks label, body.light .plant-checks label { color: #111827; }
        body.light .op-banner { background: #dbeafe; color: #1e3a8a; }
        body.light #debugBox { background: #111827; color: #d1fae5; }
    </style>
</head>
<body>
    <div id="loginOverlay" class="overlay login on">
        <div class="modal">
            <div class="login-kicker">WEX QUALITY</div>
            <h3>Quality Desk Checks</h3>
            <p class="muted" id="loginStatus">Sign in to look up items and submit floor checks. Open History any time to review results.</p>
            <label class="f">User <input id="loginUser"></label>
            <label class="f">Password <input id="loginPass" type="password" onkeydown="if(event.keyCode==13)doLogin()"></label>
            <button type="button" class="ok" onclick="doLogin()">Sign in</button>
            <div class="login-extra">
                <button type="button" class="secondary" onclick="openNewUserForm()">New User</button>
                <button type="button" class="secondary" onclick="openForgotForm()">Forgot Password</button>
                <button type="button" class="secondary" onclick="openDesk(false)">History</button>
            </div>
            <p class="muted">New accounts wait for an admin to approve. Sessions end after 1 hour idle. Passwords stay hashed on this PC.</p>
            <div id="bootProgress" class="boot-progress">
                <div class="boot-bar"><i id="bootBarFill"></i></div>
                <p id="bootBarText">Starting…</p>
            </div>
        </div>
    </div>
