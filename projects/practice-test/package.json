{
  "name": "practice-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/Wex-Projects/projects/practice-test/dist/",
    "build:pages": "npm run build",
    "build:exam": "node scripts/build-amt-exam.mjs",
    "categorize:exam": "node scripts/categorize-amt-exam.mjs",
    "preview": "vite preview --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "jsdom": "^26.1.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
